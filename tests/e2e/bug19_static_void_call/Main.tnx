// Bug 19: Class::method(obj, …) on a Nothing method emitted
// "%tmp.N = call void …" — named void calls are invalid IR.
// Found by the stdlib smoke gate (Trie::insert, Env::setVar, …).
// expect: 5
// expect: ok

import bug19_static_void_call;

class Main
{
    fnc main() -> Int32 {
        const c: bug19_static_void_call = bug19_static_void_call::mk();
        bug19_static_void_call::voidy(c, 5);
        println("ok");
        return 0;
    }
}

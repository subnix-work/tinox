// WebSocket phase 2+3 (tasklist.md): handshake + frame codec over a real
// loopback conn. Client side sends hand-built (masked) golden frames
// via the binary-safe primitives; server side uses the websocket.tnx API.
// Covers: 101 handshake with the RFC 6455 example key, small text frame,
// ping->automatic pong, the 126 length path (200 bytes) in both directions,
// payload length 0, exact 125/126 boundary of the length encoding (5.2),
// close echo, handshake rejection (wrong version -> accept == -1).
// expect: ok-accept
// expect: 1
// expect: Hi!
// expect: ok-echo
// expect: x
// expect: ok-pong
// expect: 1 200 65
// expect: ok-big
// expect: ok-empty
// expect: ok-125
// expect: ok-boundary126
// expect: 8
// expect: ok-close
// expect: ok-reject

import tinox.core.websocket;
import tinox.core.socket;

class Main
{
    fnc main() -> Int32 {
        let srv = WsServer::listen(47614);
        if (srv < 0) {
            println("bind failed");
            return 1;
        }

        // --- Handshake (client sends first, then accept: single-threaded) ---
        let cfd = socketCreateTcp();
        socketConnect(cfd, "127.0.0.1", 47614);
        let cconn = httpConnFromFd(cfd);
        httpConnSendRaw(cconn, "GET /chat HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n");
        let conn = WsServer::accept(srv);
        if (conn <= 0) {
            println("handshake failed");
            return 1;
        }
        let resp = httpConnReadRequest(cconn);
        if (resp.contains("101")) {
            if (resp.contains("s3pPLMBiTxaQ9kYGzzhZRbK+xOo=")) {
                println("ok-accept");
            }
        }

        // --- Text frame "Hi!", mask [1,2,3,4] ---
        httpConnWriteBytes(cconn, [129, 131, 1, 2, 3, 4, 73, 107, 34]);
        let f1 = Ws::readMessage(conn);
        println(f1.opcode.toString());
        println(Ws::text(f1));

        // Echo back: [0x81, 3, 'H','i','!']
        Ws::sendText(conn, Ws::text(f1));
        let echo = httpConnReadN(cconn, 5);
        if (echo.len() == 5) {
            if (echo[0] == 129) {
                if (echo[1] == 3) {
                    if (echo[2] == 72) {
                        println("ok-echo");
                    }
                }
            }
        }

        // --- Ping "ab" + text "x" in one go: readMessage pongs automatically ---
        httpConnWriteBytes(cconn, [137, 130, 1, 2, 3, 4, 96, 96, 129, 129, 1, 2, 3, 4, 121]);
        let f2 = Ws::readMessage(conn);
        println(Ws::text(f2));
        let pong = httpConnReadN(cconn, 4);
        if (pong.len() == 4) {
            if (pong[0] == 138) {
                if (pong[1] == 2) {
                    if (pong[2] == 97) {
                        if (pong[3] == 98) {
                            println("ok-pong");
                        }
                    }
                }
            }
        }

        // --- 126 length path: 200×'A', mask [0,0,0,0] ---
        var big: List<Int64> = [129, 254, 0, 200, 0, 0, 0, 0];
        for i in 0..200 {
            big.push(65);
        }
        httpConnWriteBytes(cconn, big);
        let f3 = Ws::readMessage(conn);
        println(f3.opcode.toString() + " " + f3.payload.len().toString() + " " + f3.payload[0].toString());

        // Reverse direction: 200×'B' as binary — header [0x82, 126, 0, 200]
        var bigOut: List<Int64> = [];
        for i in 0..200 {
            bigOut.push(66);
        }
        Ws::sendBinary(conn, bigOut);
        let hdr = httpConnReadN(cconn, 4);
        let body = httpConnReadN(cconn, 200);
        if (hdr[0] == 130) {
            if (hdr[1] == 126) {
                if (hdr[2] == 0) {
                    if (hdr[3] == 200) {
                        if (body.len() == 200) {
                            if (body[199] == 66) {
                                println("ok-big");
                            }
                        }
                    }
                }
            }
        }

        // --- 5.2 boundary case: payload length 0 (empty text frame), mask [9,9,9,9] ---
        httpConnWriteBytes(cconn, [129, 128, 9, 9, 9, 9]);
        let fEmpty = Ws::readMessage(conn);
        if (fEmpty.opcode == 1) {
            if (fEmpty.payload.len() == 0) {
                if (Ws::text(fEmpty) == "") {
                    Ws::sendText(conn, "");
                    let emptyEcho = httpConnReadN(cconn, 2);
                    if (emptyEcho.len() == 2) {
                        if (emptyEcho[0] == 129) {
                            if (emptyEcho[1] == 0) {
                                println("ok-empty");
                            }
                        }
                    }
                }
            }
        }

        // --- 5.2 boundary case: exactly 125 bytes (last value before the 126 extension) ---
        var out125: List<Int64> = [];
        for i in 0..125 {
            out125.push(67);
        }
        Ws::sendBinary(conn, out125);
        let hdr125 = httpConnReadN(cconn, 2);
        let body125 = httpConnReadN(cconn, 125);
        if (hdr125[0] == 130) {
            if (hdr125[1] == 125) {
                if (body125.len() == 125) {
                    if (body125[124] == 67) {
                        println("ok-125");
                    }
                }
            }
        }

        // --- 5.2 boundary case: exactly 126 bytes (first value WITH 16-bit extension) ---
        var out126: List<Int64> = [];
        for i in 0..126 {
            out126.push(68);
        }
        Ws::sendBinary(conn, out126);
        let hdr126 = httpConnReadN(cconn, 4);
        let body126 = httpConnReadN(cconn, 126);
        if (hdr126[0] == 130) {
            if (hdr126[1] == 126) {
                if (hdr126[2] == 0) {
                    if (hdr126[3] == 126) {
                        if (body126.len() == 126) {
                            if (body126[125] == 68) {
                                println("ok-boundary126");
                            }
                        }
                    }
                }
            }
        }

        // --- Close 1000: readMessage acknowledges with close and returns opcode 8 ---
        httpConnWriteBytes(cconn, [136, 130, 1, 2, 3, 4, 2, 234]);
        let f4 = Ws::readMessage(conn);
        println(f4.opcode.toString());
        let closeEcho = httpConnReadN(cconn, 4);
        if (closeEcho[0] == 136) {
            if (closeEcho[1] == 2) {
                if (closeEcho[2] == 3) {
                    if (closeEcho[3] == 232) {
                        println("ok-close");
                    }
                }
            }
        }
        Ws::close(conn);
        httpConnClose(cconn);

        // --- Handshake rejection: wrong version -> accept == -1 ---
        let cfd2 = socketCreateTcp();
        socketConnect(cfd2, "127.0.0.1", 47614);
        let cconn2 = httpConnFromFd(cfd2);
        httpConnSendRaw(cconn2, "GET / HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 8\r\n\r\n");
        let rejected = WsServer::accept(srv);
        if (rejected == -1) {
            println("ok-reject");
        }
        httpConnClose(cconn2);
        httpServerClose(srv);
        return 0;
    }
}

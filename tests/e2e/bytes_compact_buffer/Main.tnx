// Compact byte buffers (tinox.core.bytes): bounds, slices, conversions,
// embedded-NUL / all-256-values round trip through a file (whole-file and
// chunked) and over a real loopback TCP connection with bounded streaming.
// expect: basic len=4 get=0,255,0,7
// expect: slice=2 first=0 second=7 empty=0
// expect: concat=6 equals=true differs=false
// expect: text=hello len=5 roundtrip=true
// expect: list-adapter=true
// expect: file-roundtrip=true size=1024
// expect: chunked-roundtrip=true chunks=1024,1024,1024,0
// expect: stream-sent=300000
// expect: stream-received=300000 identical=true nuls=true
// expect: done

import tinox.core.bytes;

extern fn socketCreateTcp() -> Int64;
extern fn socketConnect(fd: Int64, host: String, port: Int64) -> Bool;
extern fn httpConnFromFd(fd: Int64) -> Int64;
extern fn httpConnClose(conn: Int64);

class Main
{
    fnc pattern(n: Int64) -> Bytes {
        const b: Bytes = Bytes::new(n);
        var i: Int64 = 0;
        while i < n
        {
            b.set(i, (i * 7 + i / 256) % 256);
            i = i + 1;
        }
        return b;
    }

    async fnc server(srv: Int64, path: String) -> Int64 {
        const conn = httpServerAcceptConnHandle(srv);
        const reader = ByteReader::open(path);
        const sent = reader.copyToConn(conn, 4096);
        httpConnClose(conn);
        return sent;
    }

    fnc main() -> Int32 {
        const b: Bytes = Bytes::new(4);
        b.set(1, 255);
        b.set(3, 7);
        println("basic len=" + b.len().toString() + " get=" + b.get(0).toString() + "," + b.get(1).toString() + "," + b.get(2).toString() + "," + b.get(3).toString());

        const s: Bytes = b.slice(2, 4);
        const e: Bytes = b.slice(1, 1);
        println("slice=" + s.len().toString() + " first=" + s.get(0).toString() + " second=" + s.get(1).toString() + " empty=" + e.len().toString());

        const c: Bytes = b.concat(s);
        println("concat=" + c.len().toString() + " equals=" + b.equals(Bytes::fromList(b.toList())).toString() + " differs=" + b.equals(s).toString());

        const t: Bytes = Bytes::fromText("hello");
        println("text=" + t.toText() + " len=" + t.len().toString() + " roundtrip=" + (t.toText() == "hello").toString());

        const l: List<Int64> = [0, 1, 255];
        const fl: Bytes = Bytes::fromList(l);
        const fl2: List<Int64> = fl.toList();
        println("list-adapter=" + (fl.len() == 3 && fl2[2] == 255).toString());

        const dir: String = "/tmp/tinox_bytes_compact_e2e";
        dirDelete(dir);
        dirCreate(dir);
        const p: String = dir + "/all.bin";
        const data: Bytes = Main::pattern(1024);
        data.writeFile(p);
        const back: Bytes = Bytes::readFile(p);
        println("file-roundtrip=" + data.equals(back).toString() + " size=" + back.len().toString());

        const w = ByteWriter::open(dir + "/chunked.bin");
        w.write(data);
        w.write(data);
        w.write(data);
        w.close();
        const r = ByteReader::open(dir + "/chunked.bin");
        const c1 = r.read(1024);
        const c2 = r.read(1024);
        const c3 = r.read(1024);
        const c4 = r.read(1024);
        r.close();
        println("chunked-roundtrip=" + (c1.equals(data) && c2.equals(data) && c3.equals(data)).toString() + " chunks=" + c1.len().toString() + "," + c2.len().toString() + "," + c3.len().toString() + "," + c4.len().toString());

        const big: Bytes = Main::pattern(300000);
        const bigPath: String = dir + "/big.bin";
        big.writeFile(bigPath);
        const srv = httpServerCreate(0);
        const port = httpServerBoundPort(srv);
        const handle = spawn Main::server(srv, bigPath);
        const fd = socketCreateTcp();
        socketConnect(fd, "127.0.0.1", port);
        const conn = httpConnFromFd(fd);
        const got: Bytes = Bytes::readFromConn(conn, 300000);
        const sent = await handle;
        println("stream-sent=" + sent.toString());
        var nuls: Bool = false;
        var i: Int64 = 0;
        while i < got.len()
        {
            if got.get(i) == 0
            {
                nuls = true;
            }
            i = i + 1;
        }
        println("stream-received=" + got.len().toString() + " identical=" + big.equals(got).toString() + " nuls=" + nuls.toString());
        httpConnClose(conn);
        httpServerClose(srv);
        dirDelete(dir);
        println("done");
        return 0;
    }
}

// B1 phase 4: typed named struct types also for generic specializations
// (Box__i64, Box__i8P …). The types come into existence on-demand in the middle of
// emission and are spliced in BEFORE all function bodies via the @@SPEC_TYPES@@
// marker (a forward-referenced named type is opaque/unsized and would be
// rejected by the verifier). Test: typed field access (read + assignment) on two
// different specializations yields correct values.
// expect: 42
// expect: 5
// expect: 7
// expect: 100

import typed_generic_layout;

class Main
{
    fnc main() -> Int32 {
        const a: typed_generic_layout<Int64> = typed_generic_layout::make(42);
        println(typed_generic_layout::get(a).toString());        // 42 — T field (i64 slot) via typed read
        typed_generic_layout::setCount(a, 5);                      // typed assignment on Box__i64.count
        println(typed_generic_layout::getCount(a).toString());    // 5

        // second specialization — the same named type Box__i64 is reused
        const b: typed_generic_layout<Int64> = typed_generic_layout::make(7);
        println(typed_generic_layout::get(b).toString());        // 7
        b.count = 100;                            // direct typed assignment
        println(b.count.toString());             // 100
        return 0;
    }
}

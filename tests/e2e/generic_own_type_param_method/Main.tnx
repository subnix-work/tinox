// Own-type-param instance methods on a generic class (`fn transform<U>(...)`
// on `Box<T>`, and the stdlib's `Option<T>.map<U>`/`.andThen<U>`) — regression
// test for issue #153: these had NO instance-dispatch codegen path at all
// (class specialization skipped emitting them, and the only monomorphization
// path that existed was static-call-only and never bound `self`), so any
// call — in either call style — was an internal-compiler-error.
// expect: v
// expect: mapped
// expect: false
// expect: chained
import tinox.core.option;

import Box;

class Main
{
    fnc main() -> Int32 {
        const b: Box<Int64> = Box<Int64> { value: 7 };
        const b2: Box<String> = b.transform(fnc(x: Int64) -> String { return "v"; });
        println(b2.get());

        const o: Option<Int64> = Option<Int64>::some(41);
        const o2: Option<String> = o.map(fnc(x: Int64) -> String { return "mapped"; });
        if (o2.isSome()) {
            println(o2.unwrap());
        }
        const n: Option<Int64> = Option<Int64>::none();
        const n2: Option<String> = n.map(fnc(x: Int64) -> String { return "nope"; });
        println(n2.isSome());

        const o3: Option<Int64> = Option<Int64>::some(5);
        const o4: Option<String> = o3.andThen(fnc(x: Int64) -> Option<String> {
            return Option<String>::some("chained");
        });
        println(o4.unwrap());
        return 0;
    }
}

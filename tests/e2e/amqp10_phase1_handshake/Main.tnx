// AMQP-1.0 Phase 1 (tasklist.md): transport dial + protocol header
// handshake over a real loopback conn. Same pattern as
// amqp_phase1_handshake.tnx (0-9-1): this file plays both roles —
// Amqp10 (the client module under test) connects, a hand-scripted
// "fake broker" (server role via httpServerCreate/
// httpServerAcceptConnHandle) reads the header and answers deliberately.
// Unlike 0-9-1: success = the broker echoes back EXACTLY the same 8-byte
// header (§2.2), not a frame-type octet.
// expect: ok-dial-refused
// expect: ok-amqp-header-bytes
// expect: ok-handshake-success
// expect: ok-sasl-header-bytes
// expect: ok-handshake-mismatch
// expect: ok-handshake-eof

import tinox.core.amqp10;
import tinox.core.socket;

class Main
{
    fnc main() -> Int32 {
        // --- dial() against a port with no listener: fast, hard failure ---
        let refused = Amqp10::dial("127.0.0.1", 39219);
        if (refused == -1) {
            println("ok-dial-refused");
        }

        let srv = httpServerCreate(0);
        let port = httpServerBoundPort(srv);
        if (srv < 0) {
            println("bind failed");
            return 1;
        }

        // --- Check the AMQP header bytes ---
        let conn1 = Amqp10::dial("127.0.0.1", port);
        Amqp10::sendAmqpProtocolHeader(conn1);
        let sconn1 = httpServerAcceptConnHandle(srv);
        let hdr1 = httpConnReadN(sconn1, 8);
        if (hdr1.len() == 8) {
            if (hdr1[0] == 65) {
                if (hdr1[1] == 77) {
                    if (hdr1[2] == 81) {
                        if (hdr1[3] == 80) {
                            if (hdr1[4] == 0) {
                                if (hdr1[5] == 1) {
                                    if (hdr1[6] == 0) {
                                        if (hdr1[7] == 0) {
                                            println("ok-amqp-header-bytes");
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // Success path: the fake broker echoes back exactly the same header
        httpConnWriteBytes(sconn1, [65, 77, 81, 80, 0, 1, 0, 0]);
        if (Amqp10::checkProtocolHeaderEcho(conn1, [65, 77, 81, 80, 0, 1, 0, 0])) {
            println("ok-handshake-success");
        }
        httpConnClose(conn1);
        httpConnClose(sconn1);

        // --- Check the SASL header bytes ---
        let conn2 = Amqp10::dial("127.0.0.1", port);
        Amqp10::sendSaslProtocolHeader(conn2);
        let sconn2 = httpServerAcceptConnHandle(srv);
        let hdr2 = httpConnReadN(sconn2, 8);
        if (hdr2.len() == 8) {
            if (hdr2[4] == 3) {
                if (hdr2[5] == 1) {
                    if (hdr2[6] == 0) {
                        if (hdr2[7] == 0) {
                            println("ok-sasl-header-bytes");
                        }
                    }
                }
            }
        }

        // --- Mismatch path: the fake broker proposes a different version ---
        httpConnWriteBytes(sconn2, [65, 77, 81, 80, 3, 9, 9, 9]);
        if (!Amqp10::checkProtocolHeaderEcho(conn2, [65, 77, 81, 80, 3, 1, 0, 0])) {
            println("ok-handshake-mismatch");
        }
        httpConnClose(conn2);
        httpConnClose(sconn2);

        // --- EOF path: the fake broker closes immediately without answering ---
        let conn3 = Amqp10::dial("127.0.0.1", port);
        Amqp10::sendAmqpProtocolHeader(conn3);
        let sconn3 = httpServerAcceptConnHandle(srv);
        httpConnReadN(sconn3, 8);
        httpConnClose(sconn3);
        if (!Amqp10::checkProtocolHeaderEcho(conn3, [65, 77, 81, 80, 0, 1, 0, 0])) {
            println("ok-handshake-eof");
        }
        httpConnClose(conn3);

        httpServerClose(srv);
        return 0;
    }
}

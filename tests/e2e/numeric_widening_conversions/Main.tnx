// Regression test for #453: value-preserving widening and int literals in
// float context are converted with the right instruction.
// expect: 5
// expect: 200
// expect: 200
// expect: 3000000000
// expect: 1.5
// expect: 7
// expect: 1.5
// expect: 200
// expect: 7
class Main
{
    fnc half(x: Float64) -> Float64
    {
        return x / 2.0
    }

    fnc wide() -> Int64
    {
        const f: UInt8 = 200
        return f
    }

    fnc main() -> Int32
    {
        const d: Float64 = 5
        println(d)
        const f: UInt8 = 200
        const i: Int64 = f
        println(i)
        const h: Int32 = f
        println(h)
        const u: UInt32 = 3000000000
        const l: Int64 = u
        println(l)
        const s: Float32 = 1.5
        const t: Float64 = s
        println(t)
        var v: Float64 = 1
        v = 7
        println(v)
        println(Main::half(3))
        println(Main::wide())
        const k: Int32 = 7
        println(k)
        return 0
    }
}

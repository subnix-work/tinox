// Regression test for the Stopwatch bug found while writing the #116 GC
// benchmark: stop() never recorded a stop time, so elapsed() unconditionally
// returned 0 once running was false -- the "start(); ...; stop(); print
// elapsed()" pattern every caller would reasonably reach for always printed
// 0. Fixed by having stop() freeze a stopTime and elapsed() report
// stopTime - startTime while not running.
// expect: not-running-before-start=0
// expect: elapsed-after-stop-nonzero=true
// expect: elapsed-frozen-after-second-check=true

import tinox.core.time;

class Main
{
    fnc main() -> Int32
    {
        const fresh = Time::newStopwatch();
        println("not-running-before-start=${fresh.elapsed()}");

        const sw = Time::newStopwatch();
        sw.start();
        Time::sleep(20);
        sw.stop();

        const firstRead: Int64 = sw.elapsed();
        println("elapsed-after-stop-nonzero=${firstRead > 0}");

        // elapsed() must keep returning the same frozen value on repeated
        // calls after stop(), not silently reset to 0 or keep advancing.
        Time::sleep(20);
        const secondRead: Int64 = sw.elapsed();
        println("elapsed-frozen-after-second-check=${secondRead == firstRead}");

        return 0;
    }
}

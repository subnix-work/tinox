// WebSocket message fragmentation (RFC 6455 §5.4, issue #120): a Text/Binary
// start frame with FIN=0, zero or more continuation frames (opcode 0), the
// last one with FIN=1, must be reassembled by Ws::readMessage into a single
// WsFrame carrying the start frame's opcode and the concatenated payload.
// expect: ok-accept
// expect: 1
// expect: Hello!
// expect: ok-ping-mid-fragment
// expect: ok-bare-continuation
// expect: ok-new-message-mid-fragment

import tinox.core.websocket;
import tinox.core.socket;

class Main
{
    fnc main() -> Int32 {
        let srv = WsServer::listen(47632);
        if (srv < 0) {
            println("bind failed");
            return 1;
        }

        let cfd = socketCreateTcp();
        socketConnect(cfd, "127.0.0.1", 47632);
        let cconn = httpConnFromFd(cfd);
        httpConnSendRaw(cconn, "GET /chat HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n");
        let conn = WsServer::accept(srv);
        let resp = httpConnReadRequest(cconn);
        if (resp.contains("101")) {
            println("ok-accept");
        }

        // --- Three-fragment text message "Hello!" = "He" + "ll" + "o!" ---
        // Start frame: FIN=0, opcode=1 (text), masked "He" with mask [1,1,1,1]
        httpConnWriteBytes(cconn, [1, 130, 1, 1, 1, 1, 73, 100]);
        // Continuation: FIN=0, opcode=0, masked "ll" with mask [2,2,2,2]
        httpConnWriteBytes(cconn, [0, 130, 2, 2, 2, 2, 110, 110]);
        // Final continuation: FIN=1, opcode=0, masked "o!" with mask [3,3,3,3]
        httpConnWriteBytes(cconn, [128, 130, 3, 3, 3, 3, 108, 34]);
        let f1 = Ws::readMessage(conn);
        println(f1.opcode.toString());
        println(Ws::text(f1));

        // --- A Ping frame injected mid-fragmentation must not disturb assembly ---
        // Start frame: FIN=0, opcode=2 (binary), masked [9] with mask [0,0,0,0]
        httpConnWriteBytes(cconn, [2, 129, 0, 0, 0, 0, 9]);
        // Ping in between: FIN=1, opcode=9, masked "" (empty payload)
        httpConnWriteBytes(cconn, [137, 128, 0, 0, 0, 0]);
        // Final continuation: FIN=1, opcode=0, masked [8] with mask [0,0,0,0]
        httpConnWriteBytes(cconn, [128, 129, 0, 0, 0, 0, 8]);
        let f2 = Ws::readMessage(conn);
        let pong = httpConnReadN(cconn, 2);
        if (f2.opcode == 2) {
            if (f2.payload.len() == 2) {
                if (f2.payload[0] == 9) {
                    if (f2.payload[1] == 8) {
                        if (pong[0] == 138) {
                            if (pong[1] == 0) {
                                println("ok-ping-mid-fragment");
                            }
                        }
                    }
                }
            }
        }

        // --- A bare continuation frame with no preceding start frame is a
        //     protocol error: Close(1002) + readMessage returns opcode -2 ---
        httpConnWriteBytes(cconn, [128, 128, 0, 0, 0, 0]);
        let f3 = Ws::readMessage(conn);
        let closeFrame1 = httpConnReadN(cconn, 4);
        if (f3.opcode == -2) {
            if (closeFrame1[0] == 136) {
                if (closeFrame1[2] == 3) {
                    if (closeFrame1[3] == 234) {
                        println("ok-bare-continuation");
                    }
                }
            }
        }
        Ws::close(conn);
        httpConnClose(cconn);

        // --- A new Text frame arriving mid-fragmentation (before the previous
        //     message's final continuation) is also a protocol error ---
        let cfd2 = socketCreateTcp();
        socketConnect(cfd2, "127.0.0.1", 47632);
        let cconn2 = httpConnFromFd(cfd2);
        httpConnSendRaw(cconn2, "GET /chat HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n");
        let conn2 = WsServer::accept(srv);
        httpConnReadRequest(cconn2);
        // Start frame: FIN=0, opcode=1 (text)
        httpConnWriteBytes(cconn2, [1, 129, 0, 0, 0, 0, 65]);
        // Another start frame instead of a continuation: FIN=0, opcode=1
        httpConnWriteBytes(cconn2, [1, 129, 0, 0, 0, 0, 66]);
        let f4 = Ws::readMessage(conn2);
        let closeFrame2 = httpConnReadN(cconn2, 4);
        if (f4.opcode == -2) {
            if (closeFrame2[0] == 136) {
                if (closeFrame2[2] == 3) {
                    if (closeFrame2[3] == 234) {
                        println("ok-new-message-mid-fragment");
                    }
                }
            }
        }
        Ws::close(conn2);
        httpConnClose(cconn2);

        httpServerClose(srv);
        return 0;
    }
}

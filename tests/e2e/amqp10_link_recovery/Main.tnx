// Issue 80: link recovery/resumption — attachWithRecovery() reports to the
// broker the delivery tags this session still remembers as unsettled
// (from an earlier session); the broker compares that against its own
// view and returns its OWN unsettled field in the attach response
// (Amqp10Link.recoveredUnsettledTags). Covers: plain attach() stays
// unchanged (empty unsettled field, as before), plus both directions of
// the reconciliation — a tag reported by the client that the broker
// CONFIRMS (still open), and one the broker rejects as already settled
// (missing from the response).
// expect: ok-plain-attach-no-unsettled
// expect: ok-recovery-tag-confirmed
// expect: ok-recovery-tag-not-reoffered
// expect: ok-broker-saw-unsettled-map

import tinox.core.amqp10;
import tinox.core.socket;

class Main
{

    async fnc recoveryBroker(srv: Int64) -> Int64 {
        let sconn = httpServerAcceptConnHandle(srv);

        // --- SASL header + negotiation (PLAIN) ---
        httpConnReadN(sconn, 8);
        httpConnWriteBytes(sconn, [65, 77, 81, 80, 3, 1, 0, 0]);
        let mechBody = Amqp10::encodePerformative(0x40, [Amqp10Value::ListVal([Amqp10Value::SymbolVal("PLAIN")])]);
        Amqp10::writeFrame(sconn, 1, 0, mechBody);
        Amqp10::readFrame(sconn);
        Amqp10::writeFrame(sconn, 1, 0, Amqp10::encodePerformative(0x44, [Amqp10Value::UByteVal(0)]));

        // --- AMQP header ---
        httpConnReadN(sconn, 8);
        httpConnWriteBytes(sconn, [65, 77, 81, 80, 0, 1, 0, 0]);

        // --- open / open-ok ---
        Amqp10::readFrame(sconn);
        var openFields: List<Amqp10Value> = [
            Amqp10Value::StrVal("fake-broker"), Amqp10Value::NullVal,
            Amqp10Value::UIntVal(131072), Amqp10Value::UShortVal(2047)
        ];
        Amqp10::writeFrame(sconn, 0, 0, Amqp10::encodePerformative(0x10, openFields));

        // --- begin / begin-ok ---
        let fBegin = Amqp10::readFrame(sconn);
        var beginFields: List<Amqp10Value> = [
            Amqp10Value::UShortVal(fBegin.chanId), Amqp10Value::UIntVal(0),
            Amqp10Value::UIntVal(2147483647), Amqp10Value::UIntVal(2147483647)
        ];
        Amqp10::writeFrame(sconn, 0, fBegin.chanId, Amqp10::encodePerformative(0x11, beginFields));

        // --- attach 1: plain attach() without recovery — the unsettled field
        // MUST be NullVal (position 7), unchanged behavior. ---
        let fAttach1 = Amqp10::readFrame(sconn);
        let pAttach1 = Amqp10::decodePerformative(fAttach1.body);
        var plainNoUnsettled: Bool = false;
        if (pAttach1.fields.len() > 7) {
            match pAttach1.fields[7] { NullVal => { plainNoUnsettled = true; } _ => {} }
        }
        Amqp10::writeFrame(sconn, 0, fBegin.chanId, Amqp10::encodePerformative(0x12, pAttach1.fields));
        let fDetach1 = Amqp10::readFrame(sconn);
        let pDetach1 = Amqp10::decodePerformative(fDetach1.body);
        Amqp10::writeFrame(sconn, 0, fBegin.chanId, Amqp10::encodePerformative(0x16, pDetach1.fields));

        // --- attach 2: attachWithRecovery() with TWO reported tags. The
        // broker confirms tag A (still open) and rejects tag B (already
        // settled from the broker's point of view) — tests BOTH
        // reconciliation cases in a single attach cycle. ---
        let fAttach2 = Amqp10::readFrame(sconn);
        let pAttach2 = Amqp10::decodePerformative(fAttach2.body);
        var sawTagA: Bool = false;
        var sawTagB: Bool = false;
        var unsettledPairCount: Int64 = 0;
        if (pAttach2.fields.len() > 7) {
            match pAttach2.fields[7] {
                MapVal(pairs) => {
                    unsettledPairCount = pairs.len() / 2;
                    var i: Int64 = 0;
                    while i + 1 < pairs.len() {
                        match pairs[i] {
                            BinaryVal(tag) => {
                                if (tag.len() == 1) {
                                    if (tag[0] == 65) { sawTagA = true; }
                                    if (tag[0] == 66) { sawTagB = true; }
                                }
                            }
                            _ => {}
                        }
                        i = i + 2;
                    }
                }
                _ => {}
            }
        }
        // Broker response: only tag A in its own unsettled field (tag B is
        // considered long settled and is NOT re-offered).
        var respFields: List<Amqp10Value> = [];
        for i in 0..pAttach2.fields.len() {
            respFields.push(pAttach2.fields[i]);
        }
        respFields[7] = Amqp10Value::MapVal([Amqp10Value::BinaryVal([65]), Amqp10Value::NullVal]);
        Amqp10::writeFrame(sconn, 0, fBegin.chanId, Amqp10::encodePerformative(0x12, respFields));

        httpConnClose(sconn);

        var result: Int64 = 0;
        if (plainNoUnsettled) { if (sawTagA) { if (sawTagB) { if (unsettledPairCount == 2) {
            result = 1;
        } } } }
        return result;
    }


    fnc main() -> Int32 {
        let srv = httpServerCreate(0);
        let port = httpServerBoundPort(srv);
        if (srv < 0) {
            println("bind failed");
            return 1;
        }
        let handle = spawn recoveryBroker(srv);

        let conn = Amqp10Connection::connect("127.0.0.1", port, "guest", "guest");
        if (conn.conn <= 0) {
            println("connect failed: " + conn.errorMessage);
            return 1;
        }
        let session = Amqp10Session::begin(conn);

        // --- Plain attach() without recovery ---
        let link1 = Amqp10Link::attach(session, "plain-link", true, "queue-a");
        if (link1.recoveredUnsettledTags.len() == 0) {
            println("ok-plain-attach-no-unsettled");
        }
        link1.detach();

        // --- attachWithRecovery() with two previously-unsettled reported tags ---
        var priorTags: List<List<Int64>> = [[65], [66]];
        let link2 = Amqp10Link::attachWithRecovery(session, "recovery-link", true, "queue-a", priorTags);
        var tagAConfirmed: Bool = false;
        var tagBReoffered: Bool = false;
        for i in 0..link2.recoveredUnsettledTags.len() {
            let tag = link2.recoveredUnsettledTags[i];
            if (tag.len() == 1) {
                if (tag[0] == 65) { tagAConfirmed = true; }
                if (tag[0] == 66) { tagBReoffered = true; }
            }
        }
        if (tagAConfirmed) {
            println("ok-recovery-tag-confirmed");
        }
        if (!tagBReoffered) {
            println("ok-recovery-tag-not-reoffered");
        }

        let brokerOk = await handle;
        if (brokerOk == 1) {
            println("ok-broker-saw-unsettled-map");
        }

        conn.close();
        httpServerClose(srv);
        return 0;
    }
}

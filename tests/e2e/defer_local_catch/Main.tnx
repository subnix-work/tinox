// Regression test for the exception-semantics gap last left over in bugs.md
// (Bug 41, "deliberately still open"): defer scopes registered INSIDE a
// try body did not run when the error was caught LOCALLY (in the same
// function) -- Bug 41 only covered escaping the entire frame (throw -> ret),
// not the more common case of throw -> catch INSIDE the same function
// (br instead of ret). Fixed: codegen.rs now emits, before every jump to a
// local catch_bb, the defer scopes that have been opened since entering the
// corresponding try body (emit_unwind_defers_to).
// expect: A2
// expect: A1
// expect: A-caught
// expect: B-inner-defer
// expect: B-caught
// expect: B-after-try
// expect: B-outer-defer
// expect: C-nested-defer
// expect: C-try-defer
// expect: C-caught
// expect: D-inner-defer
// expect: D-finally
// expect: D-outer-caught

class Main
{
    fnc risky() -> Nothing {
        throw "boom"
    }


    // Case A: multiple defers in the same scope -> LIFO (last registered,
    // first executed), even when the jump to the catch stays local.
    fnc multiDefer() -> Nothing {
        try {
            defer { println("A1") }
            defer { println("A2") }
            risky()
        } catch e: String {
            println("A-caught")
        }
    }


    // Case B: a defer BEFORE the try (function scope) must NOT run
    // prematurely -- only the try-internal defer should run before the
    // catch, the outer one only at the actual end of the function.
    fnc outerDeferNotEarly() -> Nothing {
        defer { println("B-outer-defer") }
        try {
            defer { println("B-inner-defer") }
            risky()
        } catch e: String {
            println("B-caught")
        }
        println("B-after-try")
    }


    // Case C: nested blocks inside the try -- both scopes must run before
    // the catch, innermost first.
    fnc nestedBlocks() -> Nothing {
        try {
            defer { println("C-try-defer") }
            {
                defer { println("C-nested-defer") }
                risky()
            }
        } catch e: String {
            println("C-caught")
        }
    }


    // Case D: a try without its own catch (only finally) inside an
    // OUTER try/catch -- defer runs BEFORE finally, finally BEFORE the
    // re-throw to the outer catch, no double run of the inner defer.
    fnc nestedTryFinally() -> Nothing {
        try {
            try {
                defer { println("D-inner-defer") }
                risky()
            } finally {
                println("D-finally")
            }
        } catch e: String {
            println("D-outer-caught")
        }
    }


    fnc main() -> Int32 {
        multiDefer()
        outerDeferNotEarly()
        nestedBlocks()
        nestedTryFinally()
        return 0
    }
}

// AMQP-0-9-1 phase 5.2 (tasklist.md): `shortstr` length limit.
// AMQP-0-9-1 `shortstr` values (queue/exchange/routing-key names,
// content-type) have a 1-byte length prefix -> hard maximum of
// 255 bytes. Testing this limit uncovered a real bug (see
// bugs.md, a neighbor find of "Bug 66", no separate bug entry needed):
// `AmqpWriter091::shortstr()` wrote the length unmasked via
// `octet(s.len())`, which for > 255 bytes, due to the `& 0xFF` in `octet()`,
// still produced a length prefix that was too SMALL, while the full
// raw bytes still followed -- a corrupted frame instead of a hard
// error (a violation of "no silent garbage"). Fixed: `shortstr()`
// now sets a `tooLong` flag (`hasError()`), which `declareQueue`/
// `bindQueue`/`consume`/`publish` check BEFORE sending and instead
// abort hard with an empty result + `errorMessage` -- no byte goes
// on the wire in this case.
//
// Deliberately WITHOUT a network/spawn broker: the check itself is purely
// client-side (no frame is ever sent), an `AmqpChannel091` with
// dummy handles (`conn`/`chanId` = -1) is enough. This also avoids Bug 68
// (bugs.md) -- a non-deterministic async-runtime instability
// that was found when combining long shortstr values with spawn/await
// (see amqp_edge_cases.tnx).
//
// The 255-byte boundary case (valid, NOT rejected) was additionally
// verified live against real RabbitMQ (queue.declare + queue.bind with
// 255-byte names, successful), see tasklist.md log, phase 5.2.
// expect: ok-declare-boundary-valid
// expect: ok-declare-rejected
// expect: ok-bind-rejected
// expect: ok-consume-rejected
// expect: ok-publish-rejected

import tinox.core.amqp091;

class Main
{
    fnc makeName(n: Int64) -> String {
        var s: String = "";
        var i: Int64 = 0;
        while i < n {
            s = s + "q";
            i = i + 1;
        }
        return s;
    }


    /*
     * Builds an AmqpChannel091 with dummy handles (conn/chanId = -1), WITHOUT
     * a real dispatcher (issue #123 introduced a background task that
     * normally `open()` starts, but which deliberately does not exist here,
     * see the file comment above on "no network/spawn broker"). Previously,
     * a `conn <= 0` in the raw `Amqp091::readFrame()` let a reading
     * method call simply return immediately with frameType -1; since
     * channel reads go through `recv this.inbox`, a channel that is NEVER
     * fed would block forever (no dispatcher task ever sends anything
     * into it). Pre-filling the inbox here once with exactly the synthetic
     * "connection closed" frame that the dispatcher would send on a
     * real EOF reproduces the old behavior without a real
     * network.
     */
    fnc dummyChannel091() -> AmqpChannel091
    {
        let inbox: Channel<AmqpFrame091> = channel;
        send inbox -> AmqpFrame091 { frameType: -1, chanId: 0, payload: [] };
        return AmqpChannel091 { conn: -1, chanId: -1, frameMax: 4096, errorMessage: "", confirmsEnabled: false, lastDeliveryTag: 0, inbox: inbox };
    }


    fnc main() -> Int32 {
        let name255 = makeName(255);
        let name256 = makeName(256);

        // Boundary case: exactly 255 bytes -- MUST be treated as valid
        // (dial does fail, conn=-1, but the shortstr length check
        // itself must NOT trigger; in this case the encoding reaches the
        // point BEFORE sending without an error message).
        let chBoundary = dummyChannel091();
        let rBoundary = chBoundary.declareQueue(name255, true, false, false);
        // conn=-1 naturally makes the actual network call fail
        // (no real socket) -- the ONLY thing that matters is that the length
        // check itself does NOT trigger (the "too long" error message must not
        // appear; any other error is expected and irrelevant here).
        if (!chBoundary.errorMessage.contains("too long")) {
            println("ok-declare-boundary-valid");
        }

        // 256 bytes: beyond the shortstr maximum -- must be rejected hard
        // on the client side.
        let ch1 = dummyChannel091();
        let r1 = ch1.declareQueue(name256, true, false, false);
        if (r1 == "") {
            if (ch1.errorMessage.len() > 0) {
                println("ok-declare-rejected");
            }
        }

        let ch2 = dummyChannel091();
        let r2 = ch2.bindQueue(name256, "x", "y");
        if (r2 == false) {
            if (ch2.errorMessage.len() > 0) {
                println("ok-bind-rejected");
            }
        }

        let ch3 = dummyChannel091();
        let r3 = ch3.consume(name256);
        if (r3 == "") {
            if (ch3.errorMessage.len() > 0) {
                println("ok-consume-rejected");
            }
        }

        let ch4 = dummyChannel091();
        var body: List<Int64> = [];
        ch4.publish(name256, "y", body, "");
        if (ch4.errorMessage.len() > 0) {
            println("ok-publish-rejected");
        }

        return 0;
    }
}

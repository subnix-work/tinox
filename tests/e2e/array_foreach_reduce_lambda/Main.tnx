// Array.forEach(lambda) and Array.reduce(init, lambda): forEach calls the
// closure as void (the value is discarded), reduce carries an accumulator
// of the start value's type through the loop (Int64, Float64, and String
// covered).
// expect: 1
// expect: 2
// expect: 3
// expect: 6
// expect: 6.5
// expect: a|bb|ccc
// expect: 60
class Main
{
    fnc main() -> Int32 {
        const xs = [1, 2, 3];

        // forEach (capturing would also be allowed; plain print here)
        xs.forEach(x => println(x.toString()));

        // reduce Int64
        const total = xs.reduce(0, (acc, x) => acc + x);
        println(total.toString());

        // reduce Float64 (accumulator type = init type double)
        const fs = [1.0, 2.5, 3.0];
        const fsum = fs.reduce(0.0, (a, x) => a + x);
        println(fsum.toString());

        // reduce String (accumulator i8*, capturing separator)
        const sep = "|";
        const joined = ["a", "bb", "ccc"].reduce("", (acc, w) => {
            if (acc.len() == 0) {
                return w;
            }
            return acc + sep + w;
        });
        println(joined);

        // reduce with a capturing factor
        const factor = 10;
        const scaled = xs.reduce(0, (acc, x) => acc + x * factor);
        println(scaled.toString());
        return 0;
    }
}

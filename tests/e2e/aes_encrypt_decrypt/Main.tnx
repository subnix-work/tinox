// Issue 74: Crypto::aesEncrypt/aesDecrypt threw "not implemented" as a
// deliberate placeholder (a weak substitute like XOR would have silently
// undermined the promise the method name makes). Implemented as AES-256-GCM
// (authenticated encryption) via OpenSSL, key derived from an
// arbitrary-length key string via SHA-256, random 12-byte nonce per call,
// hex-encoded nonce||ciphertext||tag as the return value.
// expect-contains: match:true
// expect-contains: nonces-differ:true
// expect-contains: wrong-key-throws:true
// expect-contains: tampered-throws:true
// expect-contains: empty-roundtrip:true
// expect-contains: empty-cipher-len:56

import tinox.core.crypto;

class Main
{
    fnc main() -> Int32 {
        let plaintext: String = "Hello, AES-256-GCM! This plaintext is longer than one AES block (16 bytes) to exercise multi-block GCM.";
        let key: String = "correct horse battery staple";

        let ciphertext: String = Crypto::aesEncrypt(plaintext, key);
        let decrypted: String = Crypto::aesDecrypt(ciphertext, key);
        println("match:" + (decrypted == plaintext).toString());

        // Two encryptions of the same plaintext must differ (random nonce per call).
        let ciphertext2: String = Crypto::aesEncrypt(plaintext, key);
        println("nonces-differ:" + (ciphertext != ciphertext2).toString());

        // Wrong key must fail loudly (GCM auth tag mismatch), never silently
        // return wrong plaintext.
        var wrongKeyThrew: Bool = false;
        try {
            Crypto::aesDecrypt(ciphertext, "a completely different key");
        } catch e: String {
            wrongKeyThrew = true;
        }
        println("wrong-key-throws:" + wrongKeyThrew.toString());

        // A single flipped hex nibble in the ciphertext must also fail loudly.
        // Flip to a value guaranteed to differ from the original (not a fixed
        // "0" — that would coincidentally match ~1/16 of the time and defeat
        // the test) instead of overwriting with a constant.
        var tamperedThrew: Bool = false;
        let firstNibble: String = ciphertext.substring(0, 1);
        var flipped: String = "0";
        if (firstNibble == "0") {
            flipped = "1";
        }
        let tampered: String = flipped + ciphertext.substring(1, ciphertext.len());
        try {
            Crypto::aesDecrypt(tampered, key);
        } catch e: String {
            tamperedThrew = true;
        }
        println("tampered-throws:" + tamperedThrew.toString());

        // Empty-plaintext boundary case: the decrypted result is itself an empty
        // string, which must not be confused with the internal error sentinel.
        let emptyCipher: String = Crypto::aesEncrypt("", key);
        let emptyPlain: String = Crypto::aesDecrypt(emptyCipher, key);
        println("empty-roundtrip:" + (emptyPlain == "").toString());
        println("empty-cipher-len:" + emptyCipher.len().toString());

        return 0;
    }
}

// Typecheck→codegen type table (TESTPLAN phase 4, steps 2+3): containers from
// expressions without a codegen heuristic (match as a value, let-bound m.get,
// split/keys/first without an allowlist) are typed precisely per element.
// expect: 3
// expect: 2
// expect: 3
// expect: 5
// expect: 2
// expect: aa
// expect: bbb
// expect: 4
// expect: cd
// expect: k
class Main
{
    fnc main() -> Int32 {
        const n = 1;
        const xs = match n { 1 => ["aa", "bbb"], _ => ["z"] };
        println(xs[1].len());
        for s in xs { println(s.len()); }
        const m = @{"k" => "hello"};
        println(m.get("k").len());
        // let-bound m.get on a map with a container value (marker via the table,
        // annotation wins against type-erased Map::new)
        var lm: Map<String, List<String>> = Map::new();
        lm.insert("k", ["aa", "bbb"]);
        const vals = lm.get("k");
        println(vals.len());
        for s in vals { println(s); }
        // split/keys/first without a codegen allowlist (marker from signatures/override)
        const parts = "ab,cd".split(",");
        println(parts[0].len() + parts.first().len());
        println(parts.last());
        println(lm.keys()[0]);
        return 0;
    }
}

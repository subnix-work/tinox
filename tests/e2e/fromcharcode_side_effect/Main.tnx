// Regression for Bug 66 (bugs.md): fromCharCode(expression with side effects)
// evaluated the argument twice (codegen generically pre-generates all call
// arguments, the fromCharCode branch additionally called gen_expr on args[0]
// again). For a method call that mutates internal state, the state advanced
// twice and the first read value was lost.
// expect: A
// expect: 1
// expect: AB
// expect: 2

import fromcharcode_side_effect;

class Main
{
    fnc main() -> Int32 {
        const c1 = fromcharcode_side_effect::new([65, 66]);
        const ch = fromCharCode(c1.next());
        println(ch);
        println(c1.pos.toString());

        // Loop: read two characters and concatenate them — covers the
        // original discovery site (string concatenation in a loop).
        const c2 = fromcharcode_side_effect::new([65, 66]);
        var s: String = "";
        for i in 0..2 {
            s = s + fromCharCode(c2.next());
        }
        println(s);
        println(c2.pos.toString());

        return 0;
    }
}

// WebSocket permessage-deflate (RFC 7692, issue #122): a client offering
// `Sec-WebSocket-Extensions: permessage-deflate` gets it accepted (with
// client_no_context_takeover; server_no_context_takeover, this module's
// deliberate always-stateless negotiation choice — see Ws.tnx's module
// comment). Verifies both directions:
//   - client->server: a hand-compressed, masked, RSV1 frame is correctly
//     decompressed by Ws::readMessage.
//   - server->client: Ws::sendText on a compression-negotiated connection
//     sets RSV1 and produces a payload that independently decompresses
//     (via the same tinoxInflateRaw the server itself uses) back to the
//     original text.
// A second connection that does NOT offer the extension confirms the
// response omits it and frames are sent uncompressed (RSV1=0), i.e.
// negotiation is genuinely per-connection, not a global switch.
// expect: ok-negotiated
// expect: ok-client-to-server-compressed
// expect: ok-fragmented-compressed
// expect: ok-server-to-client-compressed
// expect: ok-not-negotiated
// expect: ok-uncompressed-when-not-negotiated

import tinox.core.websocket;
import tinox.core.socket;

class Main
{
    fnc main() -> Int32 {
        // Issue #229: was a hardcoded literal port (47640), the one e2e
        // fixture apparently missed by the "Dynamic Ports for e2e Test
        // Fixtures" migration every other fixture already went through --
        // WsServer::listen delegates straight to httpServerCreate, so
        // listen(0) + httpServerBoundPort works exactly the same way
        // those other fixtures already rely on.
        let srv = WsServer::listen(0);
        if (srv < 0) {
            println("bind failed");
            return 1;
        }
        let port = httpServerBoundPort(srv);

        // --- Connection 1: offers permessage-deflate ---
        let cfd = socketCreateTcp();
        socketConnect(cfd, "127.0.0.1", port);
        let cconn = httpConnFromFd(cfd);
        httpConnSendRaw(cconn, "GET /chat HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Extensions: permessage-deflate\r\n\r\n");
        let conn = WsServer::accept(srv);
        let resp = httpConnReadRequest(cconn);
        if (resp.contains("101")) {
            if (resp.contains("permessage-deflate")) {
                println("ok-negotiated");
            }
        }

        // Client -> server: compress "Hello, World! Hello, World! Hello, World!"
        // ourselves, mask it, set RSV1, send as a single unfragmented frame.
        let msg1 = "Hello, World! Hello, World! Hello, World!";
        var raw1: List<Int64> = [];
        for i in 0..msg1.len() {
            raw1.push(msg1.charCodeAt(i) & 0xFF);
        }
        let compressed1 = tinoxDeflateRaw(raw1);
        var frame1: List<Int64> = [];
        frame1.push(0xC0 | 1); // FIN=1, RSV1=1, opcode=1 (text)
        let n1 = compressed1.len();
        frame1.push(0x80 | n1); // masked, assumes n1 < 126 (true for this short message)
        let mask1: List<Int64> = [5, 5, 5, 5];
        for i in 0..4 {
            frame1.push(mask1[i]);
        }
        for i in 0..n1 {
            frame1.push(compressed1[i] ^ mask1[i % 4]);
        }
        httpConnWriteBytes(cconn, frame1);

        let f1 = Ws::readMessage(conn);
        if (f1.opcode == 1) {
            if (Ws::text(f1) == msg1) {
                println("ok-client-to-server-compressed");
            }
        }

        // Client -> server, fragmented: RSV1 belongs to the whole message,
        // not each frame — set only on the first frame, continuation frames
        // carry the rest of the SAME compressed bytestream unmodified.
        // Ws::readMessage must accumulate the raw (still-compressed) bytes
        // across both fragments and decompress exactly once, at the end.
        let msgFrag = "fragmented compressed message payload, part one and part two";
        var rawFrag: List<Int64> = [];
        for i in 0..msgFrag.len() {
            rawFrag.push(msgFrag.charCodeAt(i) & 0xFF);
        }
        let compressedFrag = tinoxDeflateRaw(rawFrag);
        let splitAt = compressedFrag.len() / 2;
        var part1: List<Int64> = [];
        var part2: List<Int64> = [];
        for i in 0..splitAt {
            part1.push(compressedFrag[i]);
        }
        for i in splitAt..compressedFrag.len() {
            part2.push(compressedFrag[i]);
        }
        let maskFrag: List<Int64> = [7, 7, 7, 7];

        var startFrame: List<Int64> = [];
        startFrame.push(0x40 | 1); // FIN=0, RSV1=1, opcode=1 (text)
        startFrame.push(0x80 | part1.len());
        for i in 0..4 { startFrame.push(maskFrag[i]); }
        for i in 0..part1.len() { startFrame.push(part1[i] ^ maskFrag[i % 4]); }
        httpConnWriteBytes(cconn, startFrame);

        var contFrame: List<Int64> = [];
        contFrame.push(0x80 | 0); // FIN=1, RSV1=0, opcode=0 (continuation)
        contFrame.push(0x80 | part2.len());
        for i in 0..4 { contFrame.push(maskFrag[i]); }
        for i in 0..part2.len() { contFrame.push(part2[i] ^ maskFrag[i % 4]); }
        httpConnWriteBytes(cconn, contFrame);

        let fFrag = Ws::readMessage(conn);
        if (fFrag.opcode == 1) {
            if (Ws::text(fFrag) == msgFrag) {
                println("ok-fragmented-compressed");
            }
        }

        // Server -> client: sendText must compress + set RSV1 since this
        // connection negotiated the extension. Read the raw frame ourselves
        // (not via Ws::readFrame — the "client" side here deliberately stays
        // at the raw-bytes level to independently verify RSV1/compression,
        // not just trust the same code path being tested) and decompress
        // with the same primitive the server uses, to confirm correctness
        // without relying on WsClient (which never offers the extension).
        let msg2 = "server reply server reply server reply";
        Ws::sendText(conn, msg2);
        let hdr2 = httpConnReadN(cconn, 2);
        let rsv1Bit = hdr2[0] & 0x40;
        var plen2: Int64 = hdr2[1] & 0x7F;
        let payload2 = httpConnReadN(cconn, plen2);
        if (rsv1Bit != 0) {
            let decompressed2 = tinoxInflateRaw(payload2);
            if (wsLastInflateOk()) {
                var text2: String = "";
                for i in 0..decompressed2.len() {
                    text2 = text2 + fromCharCode(decompressed2[i]);
                }
                if (text2 == msg2) {
                    println("ok-server-to-client-compressed");
                }
            }
        }

        httpConnClose(cconn);
        Ws::close(conn);

        // --- Connection 2: does NOT offer permessage-deflate ---
        let cfd2 = socketCreateTcp();
        socketConnect(cfd2, "127.0.0.1", port);
        let cconn2 = httpConnFromFd(cfd2);
        httpConnSendRaw(cconn2, "GET /chat HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n");
        let conn2 = WsServer::accept(srv);
        let resp2 = httpConnReadRequest(cconn2);
        if (resp2.contains("101")) {
            if (!resp2.contains("permessage-deflate")) {
                println("ok-not-negotiated");
            }
        }

        let msg3 = "plain message";
        Ws::sendText(conn2, msg3);
        let hdr3 = httpConnReadN(cconn2, 2);
        let rsv1Bit3 = hdr3[0] & 0x40;
        var plen3: Int64 = hdr3[1] & 0x7F;
        let payload3 = httpConnReadN(cconn2, plen3);
        var text3: String = "";
        for i in 0..payload3.len() {
            text3 = text3 + fromCharCode(payload3[i]);
        }
        if (rsv1Bit3 == 0) {
            if (text3 == msg3) {
                println("ok-uncompressed-when-not-negotiated");
            }
        }

        httpConnClose(cconn2);
        Ws::close(conn2);
        httpServerClose(srv);
        return 0;
    }
}

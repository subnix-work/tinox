// db: CREATE TABLE scores (id INTEGER PRIMARY KEY AUTOINCREMENT, player TEXT NOT NULL, points INTEGER NOT NULL);
// db: INSERT INTO scores (player, points) VALUES ('Alice', 100), ('Bob', 300), ('Carol', 200), ('Dave', 150);
// expect: 2
// expect: Carol
// expect: Dave

import tinox.core.db;

import orm_sqlite_order_desc_offset;

class Main
{
    fnc main() -> Int32
    {
        let ranked: List<orm_sqlite_order_desc_offset> = DB::of(orm_sqlite_order_desc_offset)
            .orderByDesc(s => s.points)
            .offset(1)
            .limit(2)
            .list();
        println(ranked.len());
        println(ranked[0].player);
        println(ranked[1].player);
        return 0;
    }
}

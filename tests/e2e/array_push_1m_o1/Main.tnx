// expect: 1000000
// expect: 499999500000

class Main
{
    fnc main() -> Int32
    {
        var xs: List<Int64> = []
        var i = 0
        while i < 1000000 {
            xs.push(i)
            i += 1
        }
        var s = 0
        for x in xs { s += x }
        println(xs.len())
        println(s)
        return 0
    }
}

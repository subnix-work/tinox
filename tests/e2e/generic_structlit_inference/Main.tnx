import Box;
import Pair;

// B2 step 2 (continued): type-argument inference for generic struct
// literals. The typecheck unifies the field initializers against the
// unerased field declaration types (`Box { value: "x" }` → Named("Box",[String]))
// and codegen emits the literal as a specialization (Box__i8P) instead
// of the generic base. Covers the unannotated AND the previously equally
// broken annotated case (the annotation was overwritten by the literal
// path), plus two type params. Bindings to scope type params
// (T→U in the generic body) are deliberately excluded (guard).
// expect: hallo
// expect: 5
// expect: 42
// expect: hi
// expect: 2
// expect: 7
// expect: eins
// expect: 2.5

class Main
{
    fnc main() -> Int32 {
        // Unannotated: T=String from the initializer
        const bs = Box { value: "hallo" };
        println(bs.value);                    // hallo
        println(bs.value.len().toString());  // 5

        // Unannotated: T=Int64
        const bi = Box { value: 42 };
        println(bi.value.toString());        // 42

        // Annotated (was also broken: literal path overwrote the annotation)
        const ba: Box<String> = Box { value: "hi" };
        println(ba.value);                    // hi
        println(ba.value.len().toString());  // 2

        // var path
        var bv = Box { value: 7 };
        println(bv.value.toString());        // 7

        // Two type params bound independently
        const p = Pair { a: "eins", b: 2.5 };
        println(p.a);                         // eins
        println(p.b.toString());             // 2.5
        return 0;
    }
}

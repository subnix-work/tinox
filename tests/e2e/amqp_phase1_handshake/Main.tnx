// AMQP-0-9-1 phase 1 (tasklist.md): transport dial + protocol header
// handshake over a real loopback connection. This file plays both roles:
// Amqp091 (the client module under test) connects, and a hand-scripted
// "fake broker" here (the server role via httpServerCreate/
// httpServerAcceptConnHandle) reads the header and responds deliberately
// with success or mismatch bytes. Send/read are deliberately in separate
// Amqp091 methods (sendProtocolHeader/checkHandshakeResponse) instead of a
// blocking round-trip function, so that client and server steps can be
// interleaved in a single thread (the same pattern as
// ws_handshake_frames.tnx).
// expect: ok-dial-refused
// expect: ok-header-bytes
// expect: ok-handshake-success
// expect: ok-handshake-mismatch
// expect: ok-handshake-eof

import tinox.core.amqp091;
import tinox.core.socket;

class Main
{
    fnc main() -> Int32 {
        // --- dial() against a port with no listener: fast, hard failure ---
        let refused = Amqp091::dial("127.0.0.1", 39218);
        if (refused == -1) {
            println("ok-dial-refused");
        }

        let srv = httpServerCreate(0);
        let port = httpServerBoundPort(srv);
        if (srv < 0) {
            println("bind failed");
            return 1;
        }

        // --- Success path: fake broker responds with byte 1 (start of a
        // METHOD frame, like a real connection.start) ---
        let conn1 = Amqp091::dial("127.0.0.1", port);
        Amqp091::sendProtocolHeader(conn1);
        let sconn1 = httpServerAcceptConnHandle(srv);
        let hdr1 = httpConnReadN(sconn1, 8);
        if (hdr1.len() == 8) {
            if (hdr1[0] == 65) {
                if (hdr1[1] == 77) {
                    if (hdr1[2] == 81) {
                        if (hdr1[3] == 80) {
                            if (hdr1[4] == 0) {
                                if (hdr1[5] == 0) {
                                    if (hdr1[6] == 9) {
                                        if (hdr1[7] == 1) {
                                            println("ok-header-bytes");
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        httpConnWriteBytes(sconn1, [1]);
        if (Amqp091::checkHandshakeResponse(conn1)) {
            println("ok-handshake-success");
        }
        httpConnClose(conn1);
        httpConnClose(sconn1);

        // --- Mismatch path: fake broker echoes the protocol header back
        // (first byte 'A' = 65, no frame-type octet) ---
        let conn2 = Amqp091::dial("127.0.0.1", port);
        Amqp091::sendProtocolHeader(conn2);
        let sconn2 = httpServerAcceptConnHandle(srv);
        httpConnReadN(sconn2, 8);
        httpConnWriteBytes(sconn2, [65, 77, 81, 80, 0, 0, 9, 1]);
        if (!Amqp091::checkHandshakeResponse(conn2)) {
            println("ok-handshake-mismatch");
        }
        httpConnClose(conn2);
        httpConnClose(sconn2);

        // --- EOF path: fake broker closes immediately without responding ---
        let conn3 = Amqp091::dial("127.0.0.1", port);
        Amqp091::sendProtocolHeader(conn3);
        let sconn3 = httpServerAcceptConnHandle(srv);
        httpConnReadN(sconn3, 8);
        httpConnClose(sconn3);
        if (!Amqp091::checkHandshakeResponse(conn3)) {
            println("ok-handshake-eof");
        }
        httpConnClose(conn3);

        httpServerClose(srv);
        return 0;
    }
}

// db: CREATE TABLE items (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, note TEXT NOT NULL);
// expect-exit: 1
// expect-contains: NOT NULL constraint failed: items.note
// expect-contains: ORM save failed for table 'items'

import tinox.core.db;

import orm_sqlite_save_null_string;

class Main
{
    fnc main() -> Int32
    {
        const b = new orm_sqlite_save_null_string();
        b.name = "beta";
        DB::of(orm_sqlite_save_null_string).save(b);
        println("saved, should not be reached");
        return 0;
    }
}

// expect: 99
// expect: 37

class Main
{
    fnc abs_val(n: Int64) -> Int64
    {
        if (n < 0) { return -n; }
        return n;
    }

    fnc max_val(a: Int64, b: Int64) -> Int64
    {
        if (a > b) { return a; }
        return b;
    }

    fnc main() -> Int32
    {
        println(abs_val(-99));
        println(max_val(13, 37));
        return 0;
    }
}

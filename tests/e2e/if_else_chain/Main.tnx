// expect: negative
// expect: zero
// expect: positive

class Main
{
    fnc classify(n: Int64) -> String
    {
        if (n < 0) { return "negative"; }
        else if (n == 0) { return "zero"; }
        else { return "positive"; }
    }

    fnc main() -> Int32
    {
        println(classify(-5));
        println(classify(0));
        println(classify(42));
        return 0;
    }
}

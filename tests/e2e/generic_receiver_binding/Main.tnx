// Bug 52: a generic instance method WITHOUT a T parameter (fn get() -> T),
// called as Class::get(obj), must derive its specialization from the
// receiver marker (bs: generic_receiver_binding<String> -> Box__i8P), not fall back to the i64
// default. Previously generic_receiver_binding::get(bs) incorrectly called Box__i64_get and
// printed the String pointer as a number (silent garbage). Covers String,
// Int64, and Float64 receivers.
// expect: hi
// expect: 42
// expect: 3.5

import generic_receiver_binding;

class Main
{
    fnc main() -> Int32 {
        const bs: generic_receiver_binding<String> = generic_receiver_binding::make("hi");
        println(generic_receiver_binding::get(bs));               // hi — Box__i8P (receiver binding)

        const bi: generic_receiver_binding<Int64> = generic_receiver_binding::make(42);
        println(generic_receiver_binding::get(bi).toString());    // 42 — Box__i64

        const bf: generic_receiver_binding<Float64> = generic_receiver_binding::make(3.5);
        println(generic_receiver_binding::get(bf).toString());    // 3.5 — Box__double
        return 0;
    }
}

// Bug 60 / #466: toFloat() validates the whole string (strtod) and aborts on
// invalid input instead of returning garbage or a silent 0; isFloat() lets
// callers check first.
// expect: 3.14
// expect: -2.5
// expect: 1500
// expect: false
// expect: false
// expect: true
class Main
{
    fnc main() -> Int32 {
        println("3.14".toFloat().toString())     // 3.14
        println("-2.5".toFloat().toString())      // -2.5
        println("1.5e3".toFloat().toString())     // 1500 (scientific)
        println("xyz".isFloat())                  // false
        println("12.5abc".isFloat())              // false (trailing garbage)
        println("12.5".isFloat())                 // true
        return 0
    }
}

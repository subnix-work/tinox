// Bug 8: const ks = map.keys() did not type elements as String
// expect: x
// expect: 1
class Main
{
    fnc main() -> Int32 {
        var m: Map<String, Int64> = Map::new();
        m.insert("x", 1);
        const ks = m.keys();
        for k in ks {
            println(k);
            println(k.len());
        }
        return 0;
    }
}

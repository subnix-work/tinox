// AMQP-1.0 Phase 3 (tasklist.md): frame codec + performative envelope.
// In-memory encode/decode round trip for encodePerformative/decodePerformative
// (no connection needed) + real frame round trip over a loopback conn
// (same pattern as amqp_frame_codec.tnx for 0-9-1) + protocol error
// cases (size < 8, doff < 2, headerBytes > size, payload cap, EOF) + extended
// header skip (doff > 2, AMQP-1.0-specific, no 0-9-1 equivalent).
// expect: ok-performative-roundtrip
// expect: ok-performative-multi-field
// expect: ok-performative-bad-shape
// expect: ok-frame-roundtrip
// expect: ok-frame-extended-header-skip
// expect: ok-frame-bad-size
// expect: ok-frame-bad-doff
// expect: ok-frame-header-exceeds-size
// expect: ok-frame-cap
// expect: ok-frame-eof

import tinox.core.amqp10;
import tinox.core.socket;

class Main
{
    fnc main() -> Int32 {
        // --- Performative envelope: in-memory round trip ---
        let body1 = Amqp10::encodePerformative(0x10, [Amqp10Value::StrVal("container-id")]);
        let p1 = Amqp10::decodePerformative(body1);
        if (p1.descriptor == 0x10) {
            if (p1.fields.len() == 1) {
                match p1.fields[0] {
                    StrVal(s) => { if (s == "container-id") { println("ok-performative-roundtrip"); } }
                    _ => {}
                }
            }
        }

        // --- Multiple positional fields of mixed type ---
        var fields2: List<Amqp10Value> = [
            Amqp10Value::UShortVal(2047),
            Amqp10Value::UIntVal(131072),
            Amqp10Value::BoolVal(true)
        ];
        let body2 = Amqp10::encodePerformative(0x13, fields2); // flow
        let p2 = Amqp10::decodePerformative(body2);
        if (p2.descriptor == 0x13) {
            if (p2.fields.len() == 3) {
                var ok1: Bool = false;
                var ok2: Bool = false;
                var ok3: Bool = false;
                match p2.fields[0] { UShortVal(n) => { ok1 = n == 2047; } _ => {} }
                match p2.fields[1] { UIntVal(n) => { ok2 = n == 131072; } _ => {} }
                match p2.fields[2] { BoolVal(b) => { ok3 = b; } _ => {} }
                if (ok1) { if (ok2) { if (ok3) { println("ok-performative-multi-field"); } } }
            }
        }

        // --- Broken structure: not a described type, just a raw UIntVal ---
        let w3 = Amqp10Writer::new();
        w3.writeUint(42);
        let p3 = Amqp10::decodePerformative(w3.bytes);
        if (p3.descriptor == -1) {
            if (p3.fields.len() == 0) {
                println("ok-performative-bad-shape");
            }
        }

        // --- Real frame round trip over loopback ---
        let srv = httpServerCreate(0);
        let port = httpServerBoundPort(srv);
        if (srv < 0) {
            println("bind failed");
            return 1;
        }
        let cfd = socketCreateTcp();
        socketConnect(cfd, "127.0.0.1", port);
        let cconn = httpConnFromFd(cfd);
        let sconn = httpServerAcceptConnHandle(srv);

        let openBody = Amqp10::encodePerformative(0x10, [Amqp10Value::StrVal("tinox-client")]);
        Amqp10::writeFrame(cconn, 0, 0, openBody);
        let f = Amqp10::readFrame(sconn);
        if (f.frameType == 0) {
            if (f.chanId == 0) {
                let decoded = Amqp10::decodePerformative(f.body);
                if (decoded.descriptor == 0x10) {
                    match decoded.fields[0] {
                        StrVal(s) => { if (s == "tinox-client") { println("ok-frame-roundtrip"); } }
                        _ => {}
                    }
                }
            }
        }

        // --- Extended header (doff=3): 4 filler bytes are skipped ---
        // size=14 (8 fixed header + 4 extended + 2 body), doff=3, type=0, chanId=0
        httpConnWriteBytes(cconn, [0, 0, 0, 14, 3, 0, 0, 0, 0xAA, 0xBB, 0xCC, 0xDD, 9, 9]);
        let fExt = Amqp10::readFrame(sconn);
        if (fExt.frameType == 0) {
            if (fExt.body.len() == 2) {
                if (fExt.body[0] == 9) {
                    if (fExt.body[1] == 9) {
                        println("ok-frame-extended-header-skip");
                    }
                }
            }
        }

        // --- Protocol error: size < 8 (smaller than the fixed header) ---
        httpConnWriteBytes(cconn, [0, 0, 0, 4, 2, 0, 0, 0]);
        let fBadSize = Amqp10::readFrame(sconn);
        if (fBadSize.frameType == -2) {
            println("ok-frame-bad-size");
        }

        // --- Protocol error: doff < 2 (the header can't be smaller than 8 bytes) ---
        httpConnWriteBytes(cconn, [0, 0, 0, 8, 1, 0, 0, 0]);
        let fBadDoff = Amqp10::readFrame(sconn);
        if (fBadDoff.frameType == -2) {
            println("ok-frame-bad-doff");
        }

        // --- Protocol error: doff*4 (header) larger than size (total size) ---
        httpConnWriteBytes(cconn, [0, 0, 0, 8, 3, 0, 0, 0]);
        let fHdrExceeds = Amqp10::readFrame(sconn);
        if (fHdrExceeds.frameType == -2) {
            println("ok-frame-header-exceeds-size");
        }

        // --- Payload cap exceeded (> 16 MB, no actual read of the huge amount) ---
        httpConnWriteBytes(cconn, [1, 0, 0, 16, 2, 0, 0, 0]);
        let fCap = Amqp10::readFrame(sconn);
        if (fCap.frameType == -2) {
            println("ok-frame-cap");
        }

        httpConnClose(cconn);
        let fEof = Amqp10::readFrame(sconn);
        if (fEof.frameType == -1) {
            println("ok-frame-eof");
        }

        httpConnClose(sconn);
        httpServerClose(srv);
        return 0;
    }
}

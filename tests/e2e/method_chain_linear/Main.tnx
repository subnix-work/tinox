// Method-chain typing is linear, not exponential (Bug 50): a deep
// chain `c.n().n()…` caused O(2^n) typecheck time, because the receiver was
// inferred twice per level (directly + via check_call). infer_type now
// memoizes via the node id. A 60-deep chain used to hang in practice (minutes);
// now it compiles instantly. The test verifies the correctness of the
// result — the chain still produces the expected value unchanged.
// expect: 42

import method_chain_linear;

class Main
{
    fnc main() -> Int32 {
        const c: method_chain_linear = method_chain_linear::make(42);
        // 60-deep method chain — previously exponential in the typecheck
        const r: Int64 = c.self_().self_().self_().self_().self_().self_().self_().self_()
                        .self_().self_().self_().self_().self_().self_().self_().self_()
                        .self_().self_().self_().self_().self_().self_().self_().self_()
                        .self_().self_().self_().self_().self_().self_().self_().self_()
                        .self_().self_().self_().self_().self_().self_().self_().self_()
                        .self_().self_().self_().self_().self_().self_().self_().self_()
                        .self_().self_().self_().self_().self_().self_().self_().self_()
                        .self_().self_().self_().self_().get();
        println(r.toString());
        return 0;
    }
}

// Immediate throw unwinding (Bug 40): a throw doesn't just stop its own
// function, it propagates immediately through intermediate frames and out of
// loops up to the next try. Previously, intermediate frames and loops kept
// running with default values until the next try boundary.
// expect: iter 0
// expect: iter 1
// expect: iter 2
// expect: caught from loop: boom
// expect: a catches: from c
// expect: a done
// expect: caught: negative
// expect: done

class Main
{
    fnc c() -> Nothing { throw "from c"; }

    fnc b() -> Nothing { c(); println("b after c (never)"); }


    fnc helper(i: Int64) -> Nothing {
        if (i == 3) { throw "boom"; }
        println("iter " + i.toString());
    }


    fnc compute(x: Int64) -> Int64 {
        if (x < 0) { throw "negative"; }
        return x * 2;
    }


    fnc useCompute() -> Int64 {
        let r: Int64 = compute(0 - 5);
        println("after compute (never)");   // skipped — immediate unwinding
        return r;
    }


    fnc main() -> Int32 {
        // Unwinding out of a loop into a try
        try {
            var i: Int64 = 0;
            while i < 10 {
                helper(i);
                i = i + 1;
            }
            println("never reached (loop)");
        } catch e: String {
            println("caught from loop: " + e);
        }

        // Multi-frame unwinding: c -> b (no try) -> caught here
        try {
            b();
            println("after b (never)");
        } catch e: String {
            println("a catches: " + e);
        }
        println("a done");

        // Return-value function throws, caller catches
        try {
            let v: Int64 = useCompute();
            println(v.toString());
        } catch e: String {
            println("caught: " + e);
        }

        println("done");
        return 0;
    }
}

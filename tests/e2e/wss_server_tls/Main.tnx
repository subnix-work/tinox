// Issue 73: WSS (WsServer::listenTls/acceptTls) was only verified manually
// so far. Automates it against the shared self-signed test cert (tests/
// fixtures/tls, copied into the workdir by the harness via `// tls-fixture`):
// positive path (verify=false) does a real WS handshake + text-frame
// roundtrip over TLS; negative path (verify=true) must correctly reject the
// same self-signed cert.
// expect-contains: ok-accept
// expect-contains: ok-echo
// expect-contains: ok-verify-reject
// tls-fixture

import tinox.core.websocket;
import tinox.core.socket;

class Main
{

    async fnc acceptOnce(srv: Int64) -> Int64 {
        let conn: Int64 = WsServer::acceptTls(srv);
        if (conn <= 0) {
            return -1;
        }
        let f: WsFrame = Ws::readMessage(conn);
        Ws::sendText(conn, Ws::text(f));
        return conn;
    }



    // acceptTls() is a one-shot call (no built-in loop, unlike HttpServer::
    // listenTls) — the negative-path connection attempt below needs its OWN
    // spawned accept, otherwise the client's TLS handshake blocks forever
    // waiting for a server that never calls accept() at all.
    async fnc acceptRejected(srv: Int64) -> Int64 {
        return WsServer::acceptTls(srv);
    }


    fnc main() -> Int32 {
        // listenTls() only binds (like listen()) — no accept-loop race, unlike
        // HttpServer::listenTls which binds AND loops in one blocking call.
        let srv: Int64 = WsServer::listenTls(47701, "tls_cert.pem", "tls_key.pem");
        if (srv < 0) {
            println("bind failed");
            return 1;
        }
        let handle = spawn acceptOnce(srv);

        // --- Positive path: verify=false accepts the self-signed test cert ---
        let cfd: Int64 = socketCreateTcp();
        socketConnect(cfd, "127.0.0.1", 47701);
        let cconn: Int64 = httpConnFromFdTls(cfd, "localhost", false);
        if (cconn < 0) {
            println("tls handshake failed");
            return 1;
        }
        httpConnSendRaw(cconn, "GET /chat HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n");
        let resp: String = httpConnReadRequest(cconn);
        if (resp.contains("101")) {
            if (resp.contains("s3pPLMBiTxaQ9kYGzzhZRbK+xOo=")) {
                println("ok-accept");
            }
        }

        // Text frame "Hi!", mask [1,2,3,4] — server echoes it back.
        httpConnWriteBytes(cconn, [129, 131, 1, 2, 3, 4, 73, 107, 34]);
        let echo = httpConnReadN(cconn, 5);
        if (echo.len() == 5) {
            if (echo[0] == 129) {
                if (echo[1] == 3) {
                    println("ok-echo");
                }
            }
        }
        httpConnClose(cconn);
        let srvConn = await handle;

        // --- Negative path: verify=true must reject the self-signed cert ---
        let handle2 = spawn acceptRejected(srv);
        let cfd2: Int64 = socketCreateTcp();
        socketConnect(cfd2, "127.0.0.1", 47701);
        let cconn2: Int64 = httpConnFromFdTls(cfd2, "localhost", true);
        if (cconn2 < 0) {
            println("ok-verify-reject");
        }
        let srvRejected = await handle2;

        return 0;
    }
}

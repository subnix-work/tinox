// Recursion depth guard (Bug 49): a deeply nested expression just below the
// limit must compile cleanly (the large compiler stack + MAX_RECURSION_DEPTH
// prevent the stack overflow that pathologically deep input used to trigger).
// This test checks the legitimate side — that moderate nesting (here ~40
// levels of parentheses and ~30 nested ifs) is NOT falsely rejected.
// expect: deep: 7
// expect: nested if ok

class Main
{
    fnc deep() -> Int64 {
        // 40-fold parenthesized expression — legitimate, must pass
        return ((((((((((((((((((((((((((((((((((((((((7))))))))))))))))))))))))))))))))))))))));
    }


    fnc nested(n: Int64) -> String {
        // nested if chain
        if (n == 1) { if (n == 1) { if (n == 1) { if (n == 1) { if (n == 1) {
            return "nested if ok";
        } } } } }
        return "?";
    }


    fnc main() -> Int32 {
        println("deep: " + deep().toString());
        println(nested(1));
        return 0;
    }
}

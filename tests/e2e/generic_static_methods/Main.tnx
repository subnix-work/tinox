// Generic static methods: explicit type arguments (deserialize<generic_static_methods>,
// T::fromJson substitution) and inference from arguments (serialize, also List<T>)
// expect: {"id":7,"name":"Alice"}
// expect: 7
// expect: Alice
// expect: [{"id":1,"name":"A"},{"id":2,"name":"B"}]
import tinox.core.json;

import generic_static_methods;

class Main
{
    fnc main() -> Int32 {
        const u = generic_static_methods { id: 7, name: "Alice" };
        const j: String = Json::serialize(u);
        println(j);
        const back: generic_static_methods = Json::deserialize<generic_static_methods>(j);
        println(back.id);
        println(back.name);
        const users: List<generic_static_methods> = [generic_static_methods { id: 1, name: "A" }, generic_static_methods { id: 2, name: "B" }];
        println(Json::serialize(users));
        return 0;
    }
}

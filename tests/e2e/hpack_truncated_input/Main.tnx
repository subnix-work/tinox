// expect: truncated-int
// expect: truncated-string
// expect: ok

import tinox.core.hpack
class Main
{
    fnc main() -> Int32
    {
        // Literal-without-indexing (0x1f = 4-bit prefix 15, i.e. "more bytes
        // follow") whose name index continues for two more bytes, landing the
        // string-literal decode exactly at the end of the buffer — found by
        // fuzz/hpack (issue #111): used to crash the whole process (unchecked
        // data[offset] in decodeInt/decodeStr on a truncated header block),
        // not just fail this one decode.
        const truncated: List<Int64> = [31, 154, 10]
        const dynTable1: HpackDynTable = HpackDynTable::new(4096)
        try
        {
            Hpack::decode(truncated, dynTable1)
            println("accepted")
        }
        catch (error: String)
        {
            println("truncated-int")
        }

        // decodeStr with a declared string length far longer than the
        // remaining buffer must stop at the buffer end, not read past it.
        const truncatedStr: List<Int64> = [0, 250]
        const dynTable2: HpackDynTable = HpackDynTable::new(4096)
        try
        {
            Hpack::decode(truncatedStr, dynTable2)
            println("accepted")
        }
        catch (error: String)
        {
            println("truncated-string")
        }

        println("ok")
        return 0
    }
}

import IntBox;
import Acc;
import Box;

// `this` in an instance method called via `Class::method(obj, ...)`:
// the leading arg IS self. Previously the static-dispatch path prepended a
// null self and passed the object as an extra arg -> `this.field`
// read the null pointer -> segfault (Bug 38). Covers non-generic, generic,
// and obj+additional-params. Additionally (Bug 39): a direct `.toString()` on the
// generic return value of an instance method WITH a T param — the
// binding inference must skip the leading object arg, otherwise T gets bound
// against the object pointer (i64*) instead of against the real arg (i64) → wrong
// pointer specialization → unresolvable @toString.
// expect: 42
// expect: 5
// expect: 8
// expect: 7
// expect: 99
// expect: 123

class Main
{
    fnc main() -> Int32 {
        // non-generic, this.value via ::
        const b: IntBox = IntBox::wrap(42);
        println(IntBox::get(b).toString());        // 42 (obj == self)

        // obj + additional declared param
        const a: Acc = Acc::make();
        println(Acc::addAndGet(a, 5).toString());  // 5
        println(Acc::addAndGet(a, 3).toString());  // 8

        // generic, this.value via ::
        const g: Box<Int64> = Box::wrap(7);
        println(Box::get(g).toString());           // 7

        const h: Box<Int64> = Box::wrap(99);
        println(Box::get(h).toString());           // 99

        // generic, T param, direct .toString() on the return value (Bug 39)
        println(Box::setAndGet(h, 123).toString()); // 123
        return 0;
    }
}

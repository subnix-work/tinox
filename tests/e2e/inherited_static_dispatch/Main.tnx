import Base;
import Derived;

// Inherited method via `Class::method(obj)` (Bug 44): Derived::getN(d) previously
// called a non-emitted @Derived_getN (only @Base_getN exists) -> invalid
// IR. Fix: the static dispatch resolves the key via method_impl to the
// defining ancestor (like the dot syntax already did). Covers: inherited
// method without/with param and overridden method (child version).
// expect: 7
// expect: 15
// expect: derived

class Main
{
    fnc main() -> Int32 {
        const d: Derived = Derived::makeD();
        println(Derived::getN(d).toString());      // inherited -> 7
        println(Derived::add(d, 8).toString());    // inherited with param -> 7+8=15
        println(Derived::label(d));                // override -> derived
        return 0;
    }
}

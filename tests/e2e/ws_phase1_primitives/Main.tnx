// WebSocket phase 1 (tasklist.md 1.1–1.3): SHA-1 + wsAcceptKey + binary-safe
// conn primitives. SHA-1 vectors from RFC 3174 (empty, "abc") plus a
// multi-block input (128×"a"); wsAcceptKey against the RFC 6455 example
// (dGhlIHNhbXBsZSBub25jZQ== → s3pPLMBiTxaQ9kYGzzhZRbK+xOo=). Then loopback:
// bytes WITH NUL (72,0,255,7,200) through httpConnWriteBytes/httpConnReadN in
// both directions — exactly the case where the C-string primitives break.
// expect: da39a3ee5e6b4b0d3255bfef95601890afd80709
// expect: a9993e364706816aba3e25717850c26c9cd0d89d
// expect: ad5b3fdbcb526778c2839d2f151ea753995e26a0
// expect: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=
// expect: 5
// expect: 72 0 255 7 200
// expect: 3
// expect: 0 128 0

import tinox.core.crypto;
import tinox.core.socket;

class Main
{
    fnc main() -> Int32 {
        // SHA-1 test vectors
        println(Crypto::sha1(""));
        println(Crypto::sha1("abc"));
        var longInput: String = "";
        for i in 0..128 {
            longInput = longInput + "a";
        }
        println(Crypto::sha1(longInput));

        // Sec-WebSocket-Accept (RFC 6455 §1.3 example)
        println(wsAcceptKey("dGhlIHNhbXBsZSBub25jZQ=="));

        // Loopback: server + client in the same process (the backlog holds the pending
        // connection, so connect-before-accept works single-threaded).
        let srv = httpServerCreate(0);
        let port = httpServerBoundPort(srv);
        if (srv < 0) {
            println("bind failed");
            return 1;
        }
        let cfd = socketCreateTcp();
        if (!socketConnect(cfd, "127.0.0.1", port)) {
            println("connect failed");
            return 1;
        }
        let sconn = httpServerAcceptConnHandle(srv);
        let cconn = httpConnFromFd(cfd);

        // Client → server: 5 bytes incl. NUL and 0xFF
        let out = [72, 0, 255, 7, 200];
        httpConnWriteBytes(cconn, out);
        let got = httpConnReadN(sconn, 5);
        println(got.len().toString());
        println(got[0].toString() + " " + got[1].toString() + " " + got[2].toString() + " " + got[3].toString() + " " + got[4].toString());

        // Server → client: NUL at the start and end
        let back = [0, 128, 0];
        httpConnWriteBytes(sconn, back);
        let got2 = httpConnReadN(cconn, 3);
        println(got2.len().toString());
        println(got2[0].toString() + " " + got2[1].toString() + " " + got2[2].toString());

        httpConnClose(sconn);
        httpConnClose(cconn);
        httpServerClose(srv);
        return 0;
    }
}

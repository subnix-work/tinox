// expect: 1
// expect: 10
// expect: 3
// expect: 31
// expect: 154
// expect: 10

import tinox.core.hpack;
class Main
{
    fnc main() -> Int32
    {
        // Encode integer 10 with 5-bit prefix → single byte 10
        const r1: List<Int64> = Hpack::encodeInt(10, 5, 0);
        println(r1.len());
        println(r1[0]);
        // Encode integer 1337 with 5-bit prefix → [31, 154, 10] per RFC 7541 §C.1.3
        const r2: List<Int64> = Hpack::encodeInt(1337, 5, 0);
        println(r2.len());
        println(r2[0]);
        println(r2[1]);
        println(r2[2]);
        return 0;
    }
}

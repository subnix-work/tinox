// SMTP client (issue #134): SmtpClient::connect + authPlain + send against
// a real RFC 5321 line-based protocol responder (spawn = real thread, same
// pattern as ws_client.tnx/amqp091_heartbeat.tnx). Exercises EHLO, AUTH
// PLAIN's NUL-safe base64 encoding (correct accept AND correct reject of
// wrong credentials), and MAIL FROM/RCPT TO/DATA with RFC 5321 §4.5.2
// dot-stuffing on a body that deliberately includes a line starting with
// "." -- the fake server below un-stuffs it and compares the reconstructed
// body byte-for-byte against what was actually sent, so a dot-stuffing bug
// in either direction would surface as a body mismatch, not just "some
// bytes arrived". STARTTLS itself is verified manually against a real,
// independent SMTP server (aiosmtpd) rather than here -- automating it
// would need a new server-side "upgrade an already-accepted plaintext conn
// to TLS in place" runtime primitive that nothing else needs yet; not
// worth adding solely to self-test a client feature already verified
// against a genuinely independent implementation.
// expect: connected
// expect: bad auth ok (should be false): false
// expect: good auth ok (should be true): true
// expect: send ok: true
// expect: body match: true

import tinox.core.smtp;
import tinox.core.base64;
import tinox.core.socket;

class Main
{
    async fnc fakeServer(srv: Int64) -> Int64 {
        let conn = httpServerAcceptConnHandle(srv);
        if (conn <= 0) {
            return 0;
        }
        httpConnSendRaw(conn, "220 fake.smtp.test ESMTP\r\n");
        httpConnReadLine(conn); // EHLO localhost
        httpConnSendRaw(conn, "250-fake.smtp.test\r\n250 AUTH PLAIN\r\n");

        // --- AUTH PLAIN: reject wrong credentials, accept right ones ---
        // The server always validates against the one correct
        // ("testuser"/"testpass") — the first client attempt deliberately
        // sends the wrong password, so it must be rejected; the second
        // sends the right one and must be accepted.
        let authLine1 = httpConnReadLine(conn); // "AUTH PLAIN <base64>"
        let payload1 = authLine1.substring(11, authLine1.len());
        let decoded1 = Base64::decodeBytes(payload1);
        if (Main::checkAuth(decoded1, "testuser", "testpass")) {
            httpConnSendRaw(conn, "235 OK\r\n");
        } else {
            httpConnSendRaw(conn, "535 Authentication failed\r\n");
        }

        let authLine2 = httpConnReadLine(conn);
        let payload2 = authLine2.substring(11, authLine2.len());
        let decoded2 = Base64::decodeBytes(payload2);
        if (Main::checkAuth(decoded2, "testuser", "testpass")) {
            httpConnSendRaw(conn, "235 OK\r\n");
        } else {
            httpConnSendRaw(conn, "535 Authentication failed\r\n");
        }

        // --- MAIL FROM / RCPT TO / DATA ---
        httpConnReadLine(conn); // MAIL FROM:<...>
        httpConnSendRaw(conn, "250 OK\r\n");
        httpConnReadLine(conn); // RCPT TO:<...>
        httpConnSendRaw(conn, "250 OK\r\n");
        httpConnReadLine(conn); // DATA
        httpConnSendRaw(conn, "354 End data with <CR><LF>.<CR><LF>\r\n");

        var received: String = "";
        var done: Bool = false;
        while !done {
            let line = httpConnReadLine(conn);
            if (line == ".") {
                done = true;
            } else {
                var actual = line;
                if (line.startsWith("..")) {
                    actual = line.substring(1, line.len());
                }
                received = received + actual + "\n";
            }
        }
        httpConnSendRaw(conn, "250 OK: queued\r\n");
        httpConnClose(conn);

        let expected = "From: sender@example.org\nTo: recipient@example.org\nSubject: Dot Test\n\nline one\n.dotline\nline three\n";
        if (received == expected) {
            return 1;
        }
        return 0;
    }

    fnc checkAuth(decoded: List<Int64>, user: String, pass: String) -> Bool {
        var expected: List<Int64> = [];
        expected.push(0);
        var i: Int64 = 0;
        while i < user.len() {
            expected.push(user.charCodeAt(i));
            i = i + 1;
        }
        expected.push(0);
        var j: Int64 = 0;
        while j < pass.len() {
            expected.push(pass.charCodeAt(j));
            j = j + 1;
        }
        if (decoded.len() != expected.len()) {
            return false;
        }
        var k: Int64 = 0;
        while k < decoded.len() {
            if (decoded[k] != expected[k]) {
                return false;
            }
            k = k + 1;
        }
        return true;
    }

    fnc main() -> Int32 {
        let srv = httpServerCreate(0);
        let port = httpServerBoundPort(srv);
        if (srv < 0) {
            println("bind failed");
            return 1;
        }
        let handle = spawn fakeServer(srv);

        let client: SmtpClient = SmtpClient::connect("127.0.0.1", port);
        if (client.conn <= 0) {
            println("connect failed: " + client.errorMessage);
            return 1;
        }
        println("connected");

        let badAuth: Bool = client.authPlain("testuser", "wrongpass");
        println("bad auth ok (should be false): " + badAuth.toString());

        let goodAuth: Bool = client.authPlain("testuser", "testpass");
        println("good auth ok (should be true): " + goodAuth.toString());

        let ok: Bool = client.send("sender@example.org", ["recipient@example.org"], "Dot Test", "line one\n.dotline\nline three");
        println("send ok: " + ok.toString());
        client.close();

        let bodyMatch = await handle;
        println("body match: " + (bodyMatch == 1).toString());
        return 0;
    }
}

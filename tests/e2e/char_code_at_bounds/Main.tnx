// Bug 54: charCodeAt(idx) read past the end of the string with an unchecked
// inline load → garbage value (pointer as a number) on out-of-bounds. Now a
// bounds-checked runtime call that returns -1 for an invalid index. Valid
// indices remain unchanged.
// expect: 65
// expect: 67
// expect: -1
// expect: -1
// expect: -1

class Main
{
    fnc main() -> Int32 {
        println("ABC".charCodeAt(0).toString())     // 65 (A)
        println("ABC".charCodeAt(2).toString())     // 67 (C)
        println("ABC".charCodeAt(100).toString())   // -1 (out of bounds, was garbage)
        println("ABC".charCodeAt(0 - 1).toString()) // -1 (negative)
        println("".charCodeAt(0).toString())        // -1 (empty string)
        return 0
    }
}

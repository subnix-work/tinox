// AMQP-0-9-1 phase 5.2 (tasklist.md): edge cases beyond the
// normal path from phase 3/4 -- body splitting across multiple frames in
// BOTH directions (publish() AND nextMessage()) and empty message bodies
// (0 body frames, spec-compliant). Structurally based on
// amqp_publish_consume_loopback.tnx (spawn/await fake broker), but with
// `frame-max=100` in the negotiation (instead of the standard 131072), so
// that the 250-byte test body actually MUST be split
// (chunkSize = frameMax - 8 = 92 -> 3 frames).
//
// Note on test construction: an earlier version of this test
// combined a `queue.declare` call with a very long name
// (~150-255 bytes) WITH a client-side rejected `declareQueue` call
// (>255 bytes, see the `AmqpWriter091::shortstr()` length limit further
// below) in the same spawn/await flow. That exposed a self-contained,
// non-deterministic crash in the async runtime (Bug 68,
// bugs.md) -- NOT in the AMQP code, reproducible even completely without
// AMQP semantics. This test therefore deliberately sticks to short,
// realistic names; the `shortstr` length limit itself is
// tested network-free/deterministically in amqp_shortstr_limits.tnx, and the
// 255-byte boundary-value variant is additionally verified live against real
// RabbitMQ (see tasklist.md log, phase 5.2).
//
// Workaround for Bug 67 (bugs.md, async fn -> Bool loses the return type):
// fakeBroker returns Int64 (0/1) instead of Bool.
// expect: ok-declare
// expect: ok-bind
// expect: ok-qos
// expect: ok-consume
// expect: ok-empty-body
// expect: ok-multiframe-body
// expect: ok-message
// expect: ok-broker-saw-all

import tinox.core.amqp091;
import tinox.core.socket;

class Main
{

    async fnc fakeBroker(srv: Int64) -> Int64 {
        let sconn = httpServerAcceptConnHandle(srv);
        httpConnReadN(sconn, 8); // protocol header

        // --- Negotiation (like amqp_connection_negotiation.tnx) ---
        let w1 = AmqpWriter091::new();
        w1.octet(0);
        w1.octet(9);
        var emptyProps: Map<String, AmqpFieldValue091> = Map::new();
        w1.fieldTable(emptyProps);
        w1.longstr("PLAIN");
        w1.longstr("en_US");
        Amqp091::writeFrame(sconn, 1, 0, Amqp091::encodeMethodPayload(10, 10, w1.bytes));
        Amqp091::readFrame(sconn); // start-ok

        let w2 = AmqpWriter091::new();
        w2.short(2047);
        w2.long(100);
        w2.short(60);
        Amqp091::writeFrame(sconn, 1, 0, Amqp091::encodeMethodPayload(10, 30, w2.bytes));
        Amqp091::readFrame(sconn); // tune-ok
        Amqp091::readFrame(sconn); // open

        let w3 = AmqpWriter091::new();
        w3.shortstr("");
        Amqp091::writeFrame(sconn, 1, 0, Amqp091::encodeMethodPayload(10, 41, w3.bytes));

        Amqp091::readFrame(sconn); // channel.open
        let w4 = AmqpWriter091::new();
        w4.longstr("");
        Amqp091::writeFrame(sconn, 1, 1, Amqp091::encodeMethodPayload(20, 11, w4.bytes));

        // --- queue.declare -> declare-ok (mirrors the requested name) ---
        let fDecl = Amqp091::readFrame(sconn);
        let mDecl = Amqp091::decodeMethodPayload(fDecl.payload);
        let declArgs = AmqpReader091::new(mDecl.args);
        declArgs.short(); // reserved-1
        let queueName = declArgs.shortstr();
        var ok1: Bool = mDecl.classId == 50 && mDecl.methodId == 10;

        let wDeclOk = AmqpWriter091::new();
        wDeclOk.shortstr(queueName);
        wDeclOk.long(0); // message-count
        wDeclOk.long(0); // consumer-count
        Amqp091::writeFrame(sconn, 1, 1, Amqp091::encodeMethodPayload(50, 11, wDeclOk.bytes));

        // --- queue.bind -> bind-ok ---
        let fBind = Amqp091::readFrame(sconn);
        let mBind = Amqp091::decodeMethodPayload(fBind.payload);
        var ok2: Bool = mBind.classId == 50 && mBind.methodId == 20;
        Amqp091::writeFrame(sconn, 1, 1, Amqp091::encodeMethodPayload(50, 21, []));

        // --- basic.qos -> qos-ok ---
        let fQos = Amqp091::readFrame(sconn);
        let mQos = Amqp091::decodeMethodPayload(fQos.payload);
        var ok3: Bool = mQos.classId == 60 && mQos.methodId == 10;
        Amqp091::writeFrame(sconn, 1, 1, Amqp091::encodeMethodPayload(60, 11, []));

        // --- basic.publish #1: empty body (0 body frames expected) ---
        let fPub0 = Amqp091::readFrame(sconn);
        Amqp091::decodeMethodPayload(fPub0.payload);
        let fHdr0 = Amqp091::readFrame(sconn);
        let hr0 = AmqpReader091::new(fHdr0.payload);
        hr0.short();
        hr0.short();
        let bodySize0 = hr0.longlong();
        var ok0: Bool = bodySize0 == 0;

        // --- basic.publish #2 (method) + content header + body, spread
        // across multiple frames (frame-max=100) ---
        let fPub = Amqp091::readFrame(sconn);
        let mPub = Amqp091::decodeMethodPayload(fPub.payload);
        var ok4: Bool = mPub.classId == 60 && mPub.methodId == 40;

        let fHdr = Amqp091::readFrame(sconn);
        var ok5: Bool = fHdr.frameType == 2;
        let hr = AmqpReader091::new(fHdr.payload);
        hr.short(); // class-id
        hr.short(); // weight
        let bodySize = hr.longlong();

        var body: List<Int64> = [];
        var frameCount: Int64 = 0;
        while body.len() < bodySize {
            let fBody = Amqp091::readFrame(sconn);
            for i in 0..fBody.payload.len() {
                body.push(fBody.payload[i]);
            }
            frameCount = frameCount + 1;
        }
        var ok4b: Bool = frameCount > 1;

        // --- basic.consume -> consume-ok ---
        let fCons = Amqp091::readFrame(sconn);
        let mCons = Amqp091::decodeMethodPayload(fCons.payload);
        var ok6: Bool = mCons.classId == 60 && mCons.methodId == 20;
        let wConsOk = AmqpWriter091::new();
        wConsOk.shortstr("fake-consumer-tag");
        Amqp091::writeFrame(sconn, 1, 1, Amqp091::encodeMethodPayload(60, 21, wConsOk.bytes));

        // --- basic.deliver #1: mirror back the empty body ---
        let wDeliver0 = AmqpWriter091::new();
        wDeliver0.shortstr("fake-consumer-tag");
        wDeliver0.longlong(1);
        wDeliver0.octet(0);
        wDeliver0.shortstr("");
        wDeliver0.shortstr(queueName);
        Amqp091::writeFrame(sconn, 1, 1, Amqp091::encodeMethodPayload(60, 60, wDeliver0.bytes));
        let wDeliverHdr0 = AmqpWriter091::new();
        wDeliverHdr0.short(60);
        wDeliverHdr0.short(0);
        wDeliverHdr0.longlong(0);
        wDeliverHdr0.short(0);
        Amqp091::writeFrame(sconn, 2, 1, wDeliverHdr0.bytes);
        // 0 body frames, spec-compliant.

        // --- basic.deliver #2 (method) + content header + body, mirrors the
        // previously received publish body back, again spread across multiple
        // frames ---
        let wDeliver = AmqpWriter091::new();
        wDeliver.shortstr("fake-consumer-tag");
        wDeliver.longlong(2); // delivery-tag
        wDeliver.octet(0);    // redelivered flag
        wDeliver.shortstr("");
        wDeliver.shortstr(queueName);
        Amqp091::writeFrame(sconn, 1, 1, Amqp091::encodeMethodPayload(60, 60, wDeliver.bytes));

        let wDeliverHdr = AmqpWriter091::new();
        wDeliverHdr.short(60);
        wDeliverHdr.short(0);
        wDeliverHdr.longlong(body.len());
        wDeliverHdr.short(32768); // content-type only
        wDeliverHdr.shortstr("text/plain");
        Amqp091::writeFrame(sconn, 2, 1, wDeliverHdr.bytes);

        var dOffset: Int64 = 0;
        var dChunkSize: Int64 = 92;
        let dn = body.len();
        while dOffset < dn {
            var dEnd: Int64 = dOffset + dChunkSize;
            if (dEnd > dn) {
                dEnd = dn;
            }
            var dChunk: List<Int64> = [];
            for i in dOffset..dEnd {
                dChunk.push(body[i]);
            }
            Amqp091::writeFrame(sconn, 3, 1, dChunk);
            dOffset = dEnd;
        }

        // --- expect two basic.ack ---
        let fAck0 = Amqp091::readFrame(sconn);
        let mAck0 = Amqp091::decodeMethodPayload(fAck0.payload);
        var ok7a: Bool = mAck0.classId == 60 && mAck0.methodId == 80;
        let fAck = Amqp091::readFrame(sconn);
        let mAck = Amqp091::decodeMethodPayload(fAck.payload);
        var ok7: Bool = mAck.classId == 60 && mAck.methodId == 80 && ok7a;

        httpConnClose(sconn);

        var allOk: Int64 = 0;
        if (ok0) {
            if (ok1) {
                if (ok2) {
                    if (ok3) {
                        if (ok4) {
                            if (ok4b) {
                                if (ok5) {
                                    if (ok6) {
                                        if (ok7) {
                                            allOk = 1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        return allOk;
    }


    fnc main() -> Int32 {
        let srv = httpServerCreate(0);
        let port = httpServerBoundPort(srv);
        if (srv < 0) {
            println("bind failed");
            return 1;
        }
        let handle = spawn fakeBroker(srv);

        let c = AmqpConnection091::connect("127.0.0.1", port, "/", "guest", "guest");
        let ch = AmqpChannel091::open(c);

        let queueName = ch.declareQueue("loopback-test-queue", true, false, false);
        let bound = ch.bindQueue(queueName, "amq.direct", queueName);
        let qosOk = ch.qos(5);

        var emptyBody: List<Int64> = [];
        ch.publish("amq.direct", queueName, emptyBody, "text/plain");

        var body: List<Int64> = [];
        for i in 0..250 {
            body.push(i % 256);
        }
        ch.publish("amq.direct", queueName, body, "text/plain");

        let tag = ch.consume(queueName);
        let m0 = ch.nextMessage();
        var emptyOk: Bool = m0.ok && m0.body.len() == 0;
        if (emptyOk) {
            ch.ack(m0.deliveryTag);
        }

        let m = ch.nextMessage();
        var contentOk: Bool = m.ok && m.body.len() == 250;
        if (contentOk) {
            for i in 0..250 {
                if (m.body[i] != (i % 256)) {
                    contentOk = false;
                }
            }
        }
        if (contentOk) {
            ch.ack(m.deliveryTag);
        }

        let brokerOk = await handle;

        if (queueName == "loopback-test-queue") {
            println("ok-declare");
        }
        if (bound) {
            println("ok-bind");
        }
        if (qosOk) {
            println("ok-qos");
        }
        if (tag == "fake-consumer-tag") {
            println("ok-consume");
        }
        if (emptyOk) {
            println("ok-empty-body");
        }
        if (contentOk) {
            println("ok-multiframe-body");
        }
        if (m.ok) {
            if (m.contentType == "text/plain") {
                if (m.routingKey == queueName) {
                    println("ok-message");
                }
            }
        }
        if (brokerOk == 1) {
            println("ok-broker-saw-all");
        }

        httpServerClose(srv);
        return 0;
    }
}

// Bug 61: .toString() on an i32/i16/i8 value (after `x as Int32`, on an
// Int32 field or an Int32 variable) produced invalid IR (undefined
// @toString) → ICE. The dispatch guard excluded small int widths; now
// included + sext to i64 before tinox_int_to_string. Three codegen sites.
// expect: 705032704
// expect: 3
// expect: 42
// expect: 7

import small_int_tostring;

class Main
{
    fnc main() -> Int32 {
        println((5000000000 as Int32).toString());   // Int64->Int32 wrap
        println((3.5 as Int32).toString());           // Float->Int32 trunc
        const a: Int32 = 42;
        println(a.toString());                         // Int32 variable
        const c: small_int_tostring = small_int_tostring { n: 7 };
        println(c.n.toString());                       // Int32 field read
        return 0;
    }
}

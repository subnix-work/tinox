// Bug 62: an i32/i16/i8 value (e.g. an Int32 parameter), stored into a field or
// array, produced `store i64 %v` with an i32 value → type-mismatched IR
// (ICE). coerce_to_i64 let small int widths pass through unchanged (else → val);
// now they get sign-extended to i64 (the 8-byte slot) via sext.
// Uncovered while testing Bug 61.
// expect: 1000
// expect: 42
// expect: 1001

import small_int_field_store;

class Main
{
    fnc main() -> Int32 {
        const c: small_int_field_store = small_int_field_store::make(1000, 42);   // i32/i16 parameters in field store
        println(c.n.toString());         // 1000
        println(c.m.toString());         // 42
        println((c.n + 1).toString());   // 1001
        return 0;
    }
}

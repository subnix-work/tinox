// Issue 71: throw unwinding only operated at statement granularity (Bug 40) — in
// a compound expression like `a() + b()`, `b()` would still run even
// though `a()` had already thrown; the check only kicked in at the next
// statement boundary. Fixed: gen_expr now checks after EVERY throwing
// sub-expression immediately, not only at the end of the statement.
// expect: caught binary: boom-a
// expect: caught call-args: boom-a
// expect: caught array-lit: boom-a
// expect: caught method-args: boom-a
// expect: caught nested: boom-a
// expect: done

import throw_substatement_unwinding;

class Main
{
    fnc a() -> Int64 { throw "boom-a"; }
    fnc b() -> Int64 { println("b ran (should NOT happen)"); return 1; }

    fnc sum(x: Int64, y: Int64) -> Int64 { return x + y; }

    fnc main() -> Int32 {
        // Binary expression: a() throws, b() must not run anymore.
        try {
            const r: Int64 = a() + b();
            println("unreached:" + r.toString());
        } catch e: String {
            println("caught binary: " + e);
        }

        // Function arguments: a() as the first argument throws, b() (the second
        // argument) must not be evaluated anymore.
        try {
            const r: Int64 = sum(a(), b());
            println("unreached:" + r.toString());
        } catch e: String {
            println("caught call-args: " + e);
        }

        // Array literal: same rule for elements after a throwing element.
        try {
            const xs: List<Int64> = [a(), b()];
            println("unreached:" + xs.len().toString());
        } catch e: String {
            println("caught array-lit: " + e);
        }

        // Method-call arguments.
        try {
            const acc: throw_substatement_unwinding = throw_substatement_unwinding { total: 0 };
            const r: Int64 = acc.add(a(), b());
            println("unreached:" + r.toString());
        } catch e: String {
            println("caught method-args: " + e);
        }

        // Nested: the throwing call itself sits as an ARGUMENT in an
        // inner call (sum(a(), b())); the OUTER second argument
        // (b() again) must not be evaluated anymore either, just like the inner one.
        try {
            const r: Int64 = sum(sum(a(), b()), b());
            println("unreached:" + r.toString());
        } catch e: String {
            println("caught nested: " + e);
        }

        println("done");
        return 0;
    }
}

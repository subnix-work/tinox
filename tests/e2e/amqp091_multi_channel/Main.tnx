// AMQP-0-9-1 multi-channel routing (issue #123): before this fix, every
// synchronous call (declareQueue/qos/consume/...) read directly off the
// shared socket and trusted that the NEXT frame on the wire was its own
// reply -- correct with one channel, wrong the moment a second channel has
// independent traffic. This test reproduces exactly that scenario: while
// channel 1's declareQueue() is blocked waiting for its reply, the broker
// deliberately sends channel 2's UNSOLICITED basic.deliver frames (method +
// content-header + body) first, and only THEN replies to channel 1's
// request. Without correct per-channel routing (a background dispatcher
// keying frames by chanId into per-channel inboxes, not "whatever's next
// on the wire"), channel 1's declareQueue() would misinterpret channel 2's
// basic.deliver as its own queue.declare-ok and fail with a spurious
// "expected queue.declare-ok, got class=60 method=60" error.
//
// Channel 1's declareQueue() (main thread) and channel 2's consume() +
// nextMessage() (spawned thread) run genuinely concurrently over the SAME
// connection, so the two requests can hit the wire in either order --
// the broker dispatches each by its actual method/class, not by an
// assumed sequence.
// expect: ok-chan1-id
// expect: ok-chan2-id
// expect: ok-chan1-not-confused
// expect: ok-chan2-message
// expect: ok-broker-saw-all

import tinox.core.amqp091;
import tinox.core.socket;

class Main
{

    async fnc fakeBroker(srv: Int64) -> Int64 {
        let sconn = httpServerAcceptConnHandle(srv);
        httpConnReadN(sconn, 8); // protocol header

        let w1 = AmqpWriter091::new();
        w1.octet(0);
        w1.octet(9);
        var emptyProps: Map<String, AmqpFieldValue091> = Map::new();
        w1.fieldTable(emptyProps);
        w1.longstr("PLAIN");
        w1.longstr("en_US");
        Amqp091::writeFrame(sconn, 1, 0, Amqp091::encodeMethodPayload(10, 10, w1.bytes));
        Amqp091::readFrame(sconn); // start-ok

        let w2 = AmqpWriter091::new();
        w2.short(2047);
        w2.long(131072);
        w2.short(60);
        Amqp091::writeFrame(sconn, 1, 0, Amqp091::encodeMethodPayload(10, 30, w2.bytes));
        Amqp091::readFrame(sconn); // tune-ok
        Amqp091::readFrame(sconn); // open

        let w3 = AmqpWriter091::new();
        w3.shortstr("");
        Amqp091::writeFrame(sconn, 1, 0, Amqp091::encodeMethodPayload(10, 41, w3.bytes));

        // --- channel 1 open ---
        let fOpen1 = Amqp091::readFrame(sconn);
        var chan1Ok: Bool = fOpen1.chanId == 1;
        let w4 = AmqpWriter091::new();
        w4.longstr("");
        Amqp091::writeFrame(sconn, 1, 1, Amqp091::encodeMethodPayload(20, 11, w4.bytes));

        // --- channel 2 open ---
        let fOpen2 = Amqp091::readFrame(sconn);
        var chan2Ok: Bool = fOpen2.chanId == 2;
        let w5 = AmqpWriter091::new();
        w5.longstr("");
        Amqp091::writeFrame(sconn, 1, 2, Amqp091::encodeMethodPayload(20, 11, w5.bytes));

        // --- channel 1's queue.declare and channel 2's basic.consume are
        // sent from two separate client threads sharing one connection (see
        // main() below), so they can hit the wire in either order -- read
        // two frames and dispatch each by its actual class/method, not by an
        // assumed sequence. queue.declare is deliberately NOT answered yet:
        // channel 1's declareQueue() is left blocked, waiting on its own
        // inbox, while the broker below sends channel 2 traffic first.
        var declChanOk: Bool = false;
        var consChanOk: Bool = false;
        for i in 0..2 {
            let f = Amqp091::readFrame(sconn);
            let mf = Amqp091::decodeMethodPayload(f.payload);
            if (mf.classId == 50 && mf.methodId == 10) {
                declChanOk = f.chanId == 1;
            }
            if (mf.classId == 60 && mf.methodId == 20) {
                consChanOk = f.chanId == 2;
                let wConsOk = AmqpWriter091::new();
                wConsOk.shortstr("chan2-consumer");
                Amqp091::writeFrame(sconn, 1, 2, Amqp091::encodeMethodPayload(60, 21, wConsOk.bytes));
            }
        }

        // --- channel 2: UNSOLICITED basic.deliver, sent WHILE channel 1's
        // declareQueue() is still blocked waiting for ITS reply. This is the
        // exact race: if routing were broken, channel 1 would receive this
        // frame instead of its own queue.declare-ok. ---
        let wDeliver = AmqpWriter091::new();
        wDeliver.shortstr("chan2-consumer");
        wDeliver.longlong(1);
        wDeliver.octet(0);
        wDeliver.shortstr("");
        wDeliver.shortstr("chan2-queue");
        Amqp091::writeFrame(sconn, 1, 2, Amqp091::encodeMethodPayload(60, 60, wDeliver.bytes));

        var body: List<Int64> = [];
        let msg = "chan2-payload";
        for i in 0..msg.len() {
            body.push(msg.charCodeAt(i) & 0xFF);
        }
        let wHdr = AmqpWriter091::new();
        wHdr.short(60);
        wHdr.short(0);
        wHdr.longlong(body.len());
        wHdr.short(0); // no properties set
        Amqp091::writeFrame(sconn, 2, 2, wHdr.bytes);
        Amqp091::writeFrame(sconn, 3, 2, body);

        // --- ONLY NOW reply to channel 1's still-pending queue.declare ---
        let wDeclOk = AmqpWriter091::new();
        wDeclOk.shortstr("chan1-queue");
        wDeclOk.long(0);
        wDeclOk.long(0);
        Amqp091::writeFrame(sconn, 1, 1, Amqp091::encodeMethodPayload(50, 11, wDeclOk.bytes));

        // --- expect channel 2's basic.ack for the delivered message ---
        let fAck = Amqp091::readFrame(sconn);
        var ackChanOk: Bool = fAck.chanId == 2;
        let mAck = Amqp091::decodeMethodPayload(fAck.payload);
        var ackMethodOk: Bool = mAck.classId == 60 && mAck.methodId == 80;

        httpConnClose(sconn);

        var allOk: Int64 = 0;
        if (chan1Ok) {
            if (chan2Ok) {
                if (declChanOk) {
                    if (consChanOk) {
                        if (ackChanOk) {
                            if (ackMethodOk) {
                                allOk = 1;
                            }
                        }
                    }
                }
            }
        }
        return allOk;
    }



    /*
     * Runs concurrently with channel 1's declareQueue() in the main thread
     * (see main() below) — exactly the scenario that issue #123 would have
     * broken: independent traffic on a second channel while another channel
     * is synchronously waiting for its own reply.
     */
    async fnc consumeChan2(ch2: AmqpChannel091) -> Int64 {
        ch2.consume("chan2-queue");
        let m = ch2.nextMessage();
        if (m.ok) {
            var received: String = "";
            for i in 0..m.body.len() {
                received = received + fromCharCode(m.body[i]);
            }
            if (received == "chan2-payload") {
                ch2.ack(m.deliveryTag);
                return 1;
            }
        }
        return 0;
    }


    fnc main() -> Int32 {
        let srv = httpServerCreate(0);
        let port = httpServerBoundPort(srv);
        if (srv < 0) {
            println("bind failed");
            return 1;
        }
        let brokerHandle = spawn fakeBroker(srv);

        let c = AmqpConnection091::connect("127.0.0.1", port, "/", "guest", "guest");
        let ch1 = AmqpChannel091::open(c);
        let ch2 = AmqpChannel091::open(c);

        if (ch1.chanId == 1) {
            println("ok-chan1-id");
        }
        if (ch2.chanId == 2) {
            println("ok-chan2-id");
        }

        let chan2Handle = spawn consumeChan2(ch2);

        // Blocks on ch1's own inbox while the broker (see fakeBroker above)
        // pushes channel 2 traffic first -- must still return channel 1's
        // OWN reply, not misinterpret channel 2's basic.deliver.
        let queueName = ch1.declareQueue("chan1-queue", true, false, false);
        if (queueName == "chan1-queue") {
            if (ch1.errorMessage == "") {
                println("ok-chan1-not-confused");
            }
        }

        let chan2Result = await chan2Handle;
        if (chan2Result == 1) {
            println("ok-chan2-message");
        }

        let brokerOk = await brokerHandle;
        if (brokerOk == 1) {
            println("ok-broker-saw-all");
        }

        httpServerClose(srv);
        return 0;
    }
}

// Integer/float literals that exceed the value range used to be
// silent garbage: the lexer silently turned it into a 0 via unwrap_or(0) (Bug 51).
// This test checks the legitimate side — that valid boundary and base literals
// (i64-max, hex, binary, octal, underscores, float, suffix, i64::MIN+1) lex and
// compute correctly. The overflow rejection itself is checked via fuzz/unit tests
// (an e2e test cannot express an expected compile error).
// expect: 9223372036854775807
// expect: 255
// expect: 10
// expect: 493
// expect: 1000000
// expect: -9223372036854775807
// expect: 3.14

class Main
{
    fnc main() -> Int32 {
        println((9223372036854775807).toString());   // i64-max
        println((0xFF).toString());                    // hex -> 255
        println((0b1010).toString());                  // binary -> 10
        println((0o755).toString());                   // octal -> 493
        println((1_000_000).toString());               // underscores
        println((-9223372036854775807).toString());    // i64::MIN+1
        const f: Float64 = 3.14f64;                       // float with suffix
        println(f.toString());
        return 0;
    }
}

// MessagePack (issue #136): Msgpack::encode/decode round-trip covering
// every core type this codec supports (null/bool/int incl. negative and
// int64-max/int64-min-adjacent magnitudes/float/string incl. a >255-byte
// payload to force the str16 length-prefix width/array/nested object),
// plus a truncated-input safety check (a declared length far exceeding
// the actual remaining bytes must fail cleanly, not hang or read out of
// bounds -- see MsgpackReader's bounds checks). The wire format itself is
// verified independently against Python's `msgpack` library (a completely
// separate implementation) manually this session in both directions
// (Tinox-encoded bytes decoded correctly by Python; Python-encoded bytes
// decoded correctly by Tinox, including every int width/negative fixint/
// nested map+array/empty collections) -- see the closing issue comment
// for that verification. A dedicated libFuzzer harness (fuzz/msgpack/,
// same driver-module technique as fuzz/hpack) additionally fuzzes the
// decoder against a seed corpus generated by that same real msgpack
// library.
// expect: true
// expect: true
// expect: true
// expect: true
// expect: true
// expect: true
// expect: true
// expect: true
// expect: true

import tinox.core.msgpack;

class Main
{
    fnc main() -> Int32
    {
        var fields: Map<String, MsgpackValue> = Map::new();
        fields["str"] = MsgpackValue { kind: "string", stringValue: "hello", intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() };
        fields["int_small"] = MsgpackValue { kind: "int", stringValue: "", intValue: 42, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() };
        fields["int_neg"] = MsgpackValue { kind: "int", stringValue: "", intValue: -12345, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() };
        fields["int_max"] = MsgpackValue { kind: "int", stringValue: "", intValue: 9223372036854775807, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() };
        fields["int_min"] = MsgpackValue { kind: "int", stringValue: "", intValue: -9223372036854775807, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() };
        fields["float"] = MsgpackValue { kind: "float", stringValue: "", intValue: 0, floatValue: 2.71828, boolValue: false, arrayValue: [], objectValue: Map::new() };
        fields["bool_t"] = MsgpackValue { kind: "bool", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: true, arrayValue: [], objectValue: Map::new() };
        fields["bool_f"] = MsgpackValue { kind: "bool", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() };
        fields["nothing"] = MsgpackValue { kind: "null", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() };

        var longStr: String = "";
        var i: Int64 = 0;
        while i < 300 {
            longStr = longStr + "y";
            i = i + 1;
        }
        fields["longstr"] = MsgpackValue { kind: "string", stringValue: longStr, intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() };

        var arr: List<MsgpackValue> = [];
        var j: Int64 = 0;
        while j < 5 {
            arr.push(MsgpackValue { kind: "int", stringValue: "", intValue: j * j, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() });
            j = j + 1;
        }
        fields["arr"] = MsgpackValue { kind: "array", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: arr, objectValue: Map::new() };

        var innerFields: Map<String, MsgpackValue> = Map::new();
        innerFields["nested_key"] = MsgpackValue { kind: "string", stringValue: "nested_value", intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() };
        fields["obj"] = MsgpackValue { kind: "object", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: innerFields };

        let root: MsgpackValue = MsgpackValue { kind: "object", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: fields };
        let bytes: List<Int64> = Msgpack::encode(root);
        let decoded: MsgpackValue = Msgpack::decode(bytes);

        println(decoded.getField("str").getString() == "hello");
        println(decoded.getField("int_neg").getInt() == -12345);
        println(decoded.getField("int_max").getInt() == 9223372036854775807);
        println(decoded.getField("float").getFloat() == 2.71828);
        println(decoded.getField("nothing").isNull());
        println(decoded.getField("longstr").getString().len() == 300);
        println(decoded.getField("arr").asArray()[4].getInt() == 16);
        println(decoded.getField("obj").getField("nested_key").getString() == "nested_value");

        // Truncated input: a str32 tag declaring a ~4-billion-byte string
        // with nothing following must fail cleanly (isNull), not hang or
        // read out of bounds.
        var truncated: List<Int64> = [0xdb, 0xff, 0xff, 0xff, 0xff];
        let badResult: MsgpackValue = Msgpack::decode(truncated);
        if (!badResult.isNull()) {
            println(false);
        }

        // Regression guard (found via fuzzing, see the module doc comment
        // on Msgpack::decodeString): decodeString originally built its
        // result via `s = s + fromCharCode(byte)` in a loop, which is
        // O(n^2) over a string of length n (every `+` on a Tinox string
        // reallocates+copies both operands). Confirmed quadratic before
        // the fix (100k bytes: ~0.9s, 200k bytes: ~3.2s); confirmed fixed
        // (500k bytes: ~3ms). This builds a 100,000-byte str32 payload
        // (well past the size that made the pre-fix version visibly slow)
        // via List<Int64>::push() -- itself genuinely O(1) amortized, so
        // this construction step isn't the thing being tested -- encodes
        // and decodes it, and checks the round trip is exact. Correctness
        // aside, a reintroduction of the O(n^2) bug here would make this
        // whole e2e case run noticeably slower (multiple seconds instead
        // of milliseconds), likely enough on its own to be noticed even
        // without a hard timing assertion.
        var bigBytes: List<Int64> = [];
        var n: Int64 = 0;
        while n < 100000 {
            bigBytes.push(65 + (n % 26));
            n = n + 1;
        }
        let bigStrValue: MsgpackValue = MsgpackValue { kind: "string", stringValue: tinoxBytesToString(bigBytes), intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() };
        let bigEncoded: List<Int64> = Msgpack::encode(bigStrValue);
        let bigDecoded: MsgpackValue = Msgpack::decode(bigEncoded);
        println(bigDecoded.getString().len() == 100000 && bigDecoded.getString().charCodeAt(0) == 65 && bigDecoded.getString().charCodeAt(99999) == 65 + (99999 % 26));

        return 0;
    }
}

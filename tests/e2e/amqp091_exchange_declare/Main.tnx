// AMQP-0-9-1 exchange.declare (issue #124): AmqpChannel091::declareExchange
// against a simulated broker (spawn, like amqp_publish_consume_loopback.tnx)
// — one successful declare (verifies name/type/durable-bit on the wire,
// then exchange.declare-ok), one broker-rejected declare (channel.close
// with reply-code 406, mirroring a real "exchange exists with different
// type" PRECONDITION_FAILED) to confirm declareExchange surfaces the
// failure instead of returning true.
// expect: ok-declare
// expect: ok-reject
// expect: ok-args-seen

import tinox.core.amqp091;
import tinox.core.socket;

class Main
{

    async fnc fakeBroker(srv: Int64) -> Int64 {
        const sconn = httpServerAcceptConnHandle(srv);
        httpConnReadN(sconn, 8); // protocol header

        const w1 = AmqpWriter091::new();
        w1.octet(0);
        w1.octet(9);
        var emptyProps: Map<String, AmqpFieldValue091> = Map::new();
        w1.fieldTable(emptyProps);
        w1.longstr("PLAIN");
        w1.longstr("en_US");
        Amqp091::writeFrame(sconn, 1, 0, Amqp091::encodeMethodPayload(10, 10, w1.bytes));
        Amqp091::readFrame(sconn); // start-ok

        const w2 = AmqpWriter091::new();
        w2.short(2047);
        w2.long(131072);
        w2.short(60);
        Amqp091::writeFrame(sconn, 1, 0, Amqp091::encodeMethodPayload(10, 30, w2.bytes));
        Amqp091::readFrame(sconn); // tune-ok
        Amqp091::readFrame(sconn); // open

        const w3 = AmqpWriter091::new();
        w3.shortstr("");
        Amqp091::writeFrame(sconn, 1, 0, Amqp091::encodeMethodPayload(10, 41, w3.bytes));

        Amqp091::readFrame(sconn); // channel.open
        const w4 = AmqpWriter091::new();
        w4.longstr("");
        Amqp091::writeFrame(sconn, 1, 1, Amqp091::encodeMethodPayload(20, 11, w4.bytes));

        // --- exchange.declare -> declare-ok ---
        const fDecl = Amqp091::readFrame(sconn);
        const mDecl = Amqp091::decodeMethodPayload(fDecl.payload);
        var argsOk: Bool = false;
        if (mDecl.classId == 40) {
            if (mDecl.methodId == 10) {
                const r = AmqpReader091::new(mDecl.args);
                r.short(); // reserved-1
                const name = r.shortstr();
                const exType = r.shortstr();
                const flags = r.octet();
                if (name == "my-exchange") {
                    if (exType == "topic") {
                        if ((flags & 2) != 0) { // durable bit set
                            argsOk = true;
                        }
                    }
                }
            }
        }
        Amqp091::writeFrame(sconn, 1, 1, Amqp091::encodeMethodPayload(40, 11, [])); // declare-ok, no args

        // --- second exchange.declare -> broker rejects via channel.close ---
        Amqp091::readFrame(sconn); // exchange.declare (unchecked, only care about the rejection path)
        const wClose = AmqpWriter091::new();
        wClose.short(406); // reply-code: PRECONDITION_FAILED
        wClose.shortstr("PRECONDITION_FAILED - inequivalent arg 'type'");
        wClose.short(40); // class-id
        wClose.short(10); // method-id
        Amqp091::writeFrame(sconn, 1, 1, Amqp091::encodeMethodPayload(20, 40, wClose.bytes));
        Amqp091::readFrame(sconn); // expect channel.close-ok

        httpConnClose(sconn);

        if (argsOk) {
            return 1;
        }
        return 0;
    }


    fnc main() -> Int32 {
        const srv = httpServerCreate(0);
        const port = httpServerBoundPort(srv);
        if (srv < 0) {
            println("bind failed");
            return 1;
        }
        const handle = spawn fakeBroker(srv);

        const c = AmqpConnection091::connect("127.0.0.1", port, "/", "guest", "guest");
        const ch = AmqpChannel091::open(c);

        const declared = ch.declareExchange("my-exchange", "topic", true, false);
        if (declared) {
            println("ok-declare");
        }

        const rejected = ch.declareExchange("my-exchange", "direct", false, false);
        if (!rejected) {
            if (ch.errorMessage.contains("PRECONDITION_FAILED")) {
                println("ok-reject");
            }
        }

        const brokerSawArgs = await handle;
        if (brokerSawArgs == 1) {
            println("ok-args-seen");
        }

        httpServerClose(srv);
        return 0;
    }
}

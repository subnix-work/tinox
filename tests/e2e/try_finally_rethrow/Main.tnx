// try-finally WITHOUT catch (Bug 42): finally runs, then the error is
// re-thrown (propagated) instead of being silently swallowed. Previously this
// case didn't compile at all (missing terminator in the empty-catches branch -> invalid IR).
// Covers: re-throw into an outer catch, the normal path without an error (no
// re-throw), and that try-catch-finally with a caught error does NOT re-throw.
// expect: before throw
// expect: finally A
// expect: outer catch: error
// expect: in try
// expect: finally B
// expect: after try normal
// expect: caught: x
// expect: finally C
// expect: after catch

class Main
{
    fnc risky() -> Nothing {
        try {
            println("before throw")
            throw "error"
            println("after throw (never)")
        } finally {
            println("finally A")
        }
        println("after try (never — re-propagated)")
    }


    fnc noError() -> Nothing {
        try {
            println("in try")
        } finally {
            println("finally B")
        }
        println("after try normal")
    }


    fnc caught() -> Nothing {
        try {
            throw "x"
        } catch e: String {
            println("caught: " + e)
        } finally {
            println("finally C")
        }
        println("after catch")
    }


    fnc main() -> Int32 {
        try { risky() } catch e: String { println("outer catch: " + e) }
        noError()
        caught()
        return 0
    }
}

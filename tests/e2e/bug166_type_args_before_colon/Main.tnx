// Bug 166: `Class<T>::method(...)` (explicit type args written BEFORE ::)
// silently discarded the type args during parsing -- for a static
// factory whose params never mention T at all (Result::err(message:
// String) -> Result<T>, T appears only in the return type), the return
// type stayed unresolved and codegen generated invalid LLVM IR (call to
// an undefined monomorphized symbol). The identical call with an
// intermediate `let: Result<Int64>` annotation always worked (the
// annotation, not the call, provided T) -- this covers both the
// previously-broken bare-chain case and the previously-working
// let-annotated case side by side, plus nested generics before `::`
// (`Result<List<Int64>>`, exercises `>>` tokenization) and a case where
// value-argument-based inference (Result::ok's `value: T` param) and the
// explicit type arg both apply and must agree.
// expect: bad
// expect: bad2
// expect: true
// expect: nested
// expect: true
// expect: 42

import tinox.core.result;
import tinox.core.option;

class Main {
    fnc main() -> Int32 {
        // The original bug repro: no intermediate let, T only ever
        // appears in the explicit <Int64> the user wrote.
        println(Result<Int64>::err("bad").getError());

        // Same call shape via an intermediate let annotation -- was
        // already working before this fix, must keep working.
        const r: Result<Int64> = Result<Int64>::err("bad2");
        println(r.getError());

        // A different generic class, chained without a let.
        println(Option<Int64>::none().isNone().toString());

        // Nested generic type arg before :: (>> tokenization).
        const nested: Result<List<Int64>> = Result<List<Int64>>::err("nested");
        println(nested.getError());
        println(nested.isErr().toString());

        // Explicit type arg AND value-based inference both apply here
        // (Result::ok's `value: T` param) -- must agree, not conflict.
        println(Result<Int64>::ok(42).unwrap().toString());

        return 0;
    }
}

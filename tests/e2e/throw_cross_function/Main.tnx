// Cross-function throw: throw without a local try propagates to the
// next try in the caller (via @__tinox_err)
// expect: caught: broken
// expect: cleanup
// expect: ok: 5
// expect: done
class Main
{
    fnc divide(a: Int64, b: Int64) -> Int64 {
        if (b == 0) {
            throw "broken";
        }
        return a / b;
    }


    fnc main() -> Int32 {
        try {
            let r = divide(10, 0);
            println("unreachable");
        }
        catch e: String {
            println("caught: " + e);
        }
        finally {
            println("cleanup");
        }
        try {
            let r2 = divide(10, 2);
            println("ok: " + r2.toString());
        }
        catch e: String {
            println("nope");
        }
        println("done");
        return 0;
    }
}

// Bugs 58/59 (continuation of bounds hardening): string index `s[i]` did an
// unchecked inline load (like charCodeAt before Bug 54) — now bounds-checked (-1 on
// out-of-range). `first()`/`last()` read element 0 resp. len-1 (for an empty array
// = -1, a read before the buffer!) unchecked — now via tinox_array_get (hard
// error on an empty array). Here are the valid paths + string OOB → -1.
// expect: 104
// expect: -1
// expect: 10,30
// expect: a,c

class Main
{
    fnc main() -> Int32 {
        // String index: valid + out-of-bounds
        const s: String = "hi";
        println(s[0].toString());        // 104 (h)
        println(s[100].toString());      // -1 (out of bounds, used to be 0/garbage)

        // first()/last() on Int and String arrays (valid)
        const xs: List<Int64> = [10, 20, 30];
        println(xs.first().toString() + "," + xs.last().toString());   // 10,30
        const ss: List<String> = ["a", "b", "c"];
        println(ss.first() + "," + ss.last());                          // a,c
        return 0;
    }
}

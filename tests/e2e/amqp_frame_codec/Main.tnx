// AMQP-0-9-1 Phase 2 (tasklist.md): frame codec + field-value encoder.
// Pure round-trip test (encoder -> decoder) for the low-level building
// blocks, plus a loopback test for readFrame/writeFrame over a real conn
// (pattern like ws_handshake_frames.tnx) and the hardening paths (missing
// 0xCE terminator, payload cap, EOF).
// expect: ok-shortstr
// expect: ok-longstr
// expect: ok-fieldtable-mixed
// expect: ok-nested-table
// expect: ok-array
// expect: ok-unknown-tag
// expect: ok-method-envelope
// expect: ok-frame-roundtrip
// expect: ok-frame-badend
// expect: ok-frame-cap
// expect: ok-frame-eof

import tinox.core.amqp091;
import tinox.core.socket;

class Main
{
    fnc main() -> Int32 {
        // --- shortstr / longstr round trip ---
        let w1 = AmqpWriter091::new();
        w1.shortstr("hi");
        let r1 = AmqpReader091::new(w1.bytes);
        if (r1.shortstr() == "hi") {
            if (r1.pos == w1.bytes.len()) {
                println("ok-shortstr");
            }
        }

        let w2 = AmqpWriter091::new();
        w2.longstr("a longer string value");
        let r2 = AmqpReader091::new(w2.bytes);
        if (r2.longstr() == "a longer string value") {
            if (r2.pos == w2.bytes.len()) {
                println("ok-longstr");
            }
        }

        // --- field table with mixed types ---
        var mixed: Map<String, AmqpFieldValue091> = Map::new();
        mixed.insert("flag", AmqpFieldValue091::BoolVal(true));
        mixed.insert("small", AmqpFieldValue091::Int32Val(-42));
        mixed.insert("big", AmqpFieldValue091::Int64Val(9000000000));
        mixed.insert("name", AmqpFieldValue091::StrVal("tinox"));
        mixed.insert("when", AmqpFieldValue091::TimestampVal(1700000000));
        mixed.insert("nothing", AmqpFieldValue091::VoidVal);

        let w3 = AmqpWriter091::new();
        w3.fieldValue(AmqpFieldValue091::TableVal(mixed));
        let r3 = AmqpReader091::new(w3.bytes);
        let decoded3 = r3.fieldValue();
        match decoded3 {
            TableVal(t) => {
                if (t.len() == 6) {
                    var flagOk: Bool = false;
                    match t.get("flag") { BoolVal(b) => { flagOk = b; } _ => {} }
                    var smallOk: Bool = false;
                    match t.get("small") { Int32Val(n) => { smallOk = n == -42; } _ => {} }
                    var bigOk: Bool = false;
                    match t.get("big") { Int64Val(n) => { bigOk = n == 9000000000; } _ => {} }
                    var nameOk: Bool = false;
                    match t.get("name") { StrVal(s) => { nameOk = s == "tinox"; } _ => {} }
                    var whenOk: Bool = false;
                    match t.get("when") { TimestampVal(ts) => { whenOk = ts == 1700000000; } _ => {} }
                    var voidOk: Bool = false;
                    match t.get("nothing") { VoidVal => { voidOk = true; } _ => {} }
                    if (flagOk) {
                        if (smallOk) {
                            if (bigOk) {
                                if (nameOk) {
                                    if (whenOk) {
                                        if (voidOk) {
                                            println("ok-fieldtable-mixed");
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            _ => {}
        }

        // --- nested field table (e.g. like "capabilities" in
        // server-properties) ---
        var inner: Map<String, AmqpFieldValue091> = Map::new();
        inner.insert("publisher_confirms", AmqpFieldValue091::BoolVal(true));
        var outer: Map<String, AmqpFieldValue091> = Map::new();
        outer.insert("capabilities", AmqpFieldValue091::TableVal(inner));

        let w4 = AmqpWriter091::new();
        w4.fieldValue(AmqpFieldValue091::TableVal(outer));
        let r4 = AmqpReader091::new(w4.bytes);
        match r4.fieldValue() {
            TableVal(t) => {
                match t.get("capabilities") {
                    TableVal(inner2) => {
                        match inner2.get("publisher_confirms") {
                            BoolVal(b) => { if (b) { println("ok-nested-table"); } }
                            _ => {}
                        }
                    }
                    _ => {}
                }
            }
            _ => {}
        }

        // --- field array ---
        let arr: List<AmqpFieldValue091> = [AmqpFieldValue091::Int32Val(1), AmqpFieldValue091::Int32Val(2), AmqpFieldValue091::StrVal("x")];
        let w5 = AmqpWriter091::new();
        w5.fieldValue(AmqpFieldValue091::ArrayVal(arr));
        let r5 = AmqpReader091::new(w5.bytes);
        match r5.fieldValue() {
            ArrayVal(a) => {
                if (a.len() == 3) {
                    println("ok-array");
                }
            }
            _ => {}
        }

        // --- unknown type marker: hard ErrorVal instead of guessing ---
        let badBytes: List<Int64> = [90]; // 'Z', not a known type marker
        let r6 = AmqpReader091::new(badBytes);
        match r6.fieldValue() {
            ErrorVal(_msg) => { println("ok-unknown-tag"); }
            _ => {}
        }

        // --- method frame envelope round trip ---
        let args: List<Int64> = [1, 2, 3, 4, 5];
        let payload = Amqp091::encodeMethodPayload(10, 10, args);
        let mf = Amqp091::decodeMethodPayload(payload);
        if (mf.classId == 10) {
            if (mf.methodId == 10) {
                if (mf.args.len() == 5) {
                    if (mf.args[4] == 5) {
                        println("ok-method-envelope");
                    }
                }
            }
        }

        // --- readFrame/writeFrame over a real loopback conn ---
        let srv = httpServerCreate(0);
        let port = httpServerBoundPort(srv);
        if (srv < 0) {
            println("bind failed");
            return 1;
        }

        let cfd = socketCreateTcp();
        socketConnect(cfd, "127.0.0.1", port);
        let cconn = httpConnFromFd(cfd);
        let sconn = httpServerAcceptConnHandle(srv);

        // Client -> server
        let framePayload: List<Int64> = [10, 10, 1, 2, 3];
        Amqp091::writeFrame(cconn, 1, 0, framePayload);
        let f = Amqp091::readFrame(sconn);
        if (f.frameType == 1) {
            if (f.chanId == 0) {
                if (f.payload.len() == 5) {
                    if (f.payload[4] == 3) {
                        println("ok-frame-roundtrip");
                    }
                }
            }
        }

        // --- protocol error: wrong frame terminator instead of 0xCE ---
        httpConnWriteBytes(cconn, [1, 0, 0, 0, 0, 0, 1, 42, 0xFF]);
        let fBad = Amqp091::readFrame(sconn);
        if (fBad.frameType == -2) {
            println("ok-frame-badend");
        }

        // --- payload cap exceeded (size > 16 MB, no actual read) ---
        httpConnWriteBytes(cconn, [1, 0, 0, 127, 255, 255, 255]);
        let fCap = Amqp091::readFrame(sconn);
        if (fCap.frameType == -2) {
            println("ok-frame-cap");
        }

        httpConnClose(cconn);
        let fEof = Amqp091::readFrame(sconn);
        if (fEof.frameType == -1) {
            println("ok-frame-eof");
        }

        httpConnClose(sconn);
        httpServerClose(srv);
        return 0;
    }
}

// Regression test for the JSON arena lifetime bug documented in bugs.md
// (Bug 24 finding, "important find along the way"): Json::parse() returned
// JsonValue pointers into a `__thread`-local arena buffer, whose "used"
// counter was reset to 0 on EVERY Json::parse() call -- a value from an
// EARLIER parse() call, whose reference lived longer (e.g. a
// payload assembled from several individual parse() calls, one field
// per call), was overwritten by new allocations on the next parse() on the
// same thread -- silent garbage
// (observed as an empty string). Fixed: JsonValue node/map/string
// data now each live individually on the normal GC heap instead of in a
// rewindable arena buffer (runtime.c, json_arena_alloc).
// expect: exp=9999999999
// expect: sub=hello-world-value-1234567890
// expect: ok-not-corrupted-string
// expect: nested=42
// expect: ok-not-corrupted-object
// expect: arr-sum=6
// expect: ok-not-corrupted-array

import tinox.core.json;

class Main
{
    fnc main() -> Int32 {
        // Case 1: simple string value, whose getString() is only read AFTER a
        // second, independent parse() call -- exactly the
        // "decoded[\"sub\"].getString()" pattern from the original finding.
        let subVal = Json::parse("\"hello-world-value-1234567890\"");
        let expVal = Json::parse("9999999999");
        println("exp=" + expVal.getInt().toString());
        let subStr = subVal.getString();
        println("sub=" + subStr);
        if (subStr == "hello-world-value-1234567890") {
            println("ok-not-corrupted-string");
        }

        // Case 2: an object (map node + keys), whose nested fields
        // are only read after SEVERAL further parse() calls.
        let objVal = Json::parse("{\"inner\": 42, \"tag\": \"keep-me\"}");
        Json::parse("1");
        Json::parse("[1,2,3,4,5]");
        Json::parse("\"throwaway\"");
        println("nested=" + objVal.getField("inner").getInt().toString());
        if (objVal.getField("tag").getString() == "keep-me") {
            println("ok-not-corrupted-object");
        }

        // Case 3: an int array (JSON_INT_ARRAY fast path, also
        // arena-based), whose values are only read after a further
        // parse() call.
        let arrVal = Json::parse("[1, 2, 3]");
        Json::parse("{\"a\": 1, \"b\": 2, \"c\": 3}");
        let arr = Json::intArrayFromJson(arrVal);
        var sum: Int64 = 0;
        for i in 0..arr.len() {
            sum = sum + arr[i];
        }
        println("arr-sum=" + sum.toString());
        if (sum == 6) {
            println("ok-not-corrupted-array");
        }

        return 0;
    }
}

// Bug 65: a lambda nested inside a lambda lost its definition — the outer
// gen_lambda reset self.lambda_ir to the state BEFORE the outer lambda
// and discarded the inner lambda emitted during body generation → its
// @__lambda_N reference was undefined (ICE). Fix preserves the inner lambdas.
// expect: 21
// expect: 117
class Main
{
    fnc main() -> Int32 {
        // doubly nested
        const outer: fnc(Int64) -> Int64 = fnc(x: Int64) -> Int64 {
            const inner: fnc(Int64) -> Int64 = fnc(y: Int64) -> Int64 { return y * 2; };
            return inner(x) + 1;
        };
        println(outer(10).toString());   // inner(10)=20, +1 = 21

        // triply nested
        const a: fnc() -> Int64 = fnc() -> Int64 {
            const b: fnc() -> Int64 = fnc() -> Int64 {
                const c: fnc() -> Int64 = fnc() -> Int64 { return 7; };
                return c() + 10;
            };
            return b() + 100;
        };
        println(a().toString());          // 7 -> 17 -> 117
        return 0;
    }
}

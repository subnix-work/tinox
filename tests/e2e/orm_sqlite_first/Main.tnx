// db: CREATE TABLE users (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, age INTEGER NOT NULL);
// db: INSERT INTO users (name, age) VALUES ('Alice', 30), ('Bob', 25), ('Carol', 35);
// expect: Carol
// expect: 35
// expect: missing: 0::0
// expect: 0
// expect: 0

import tinox.core.db;

import orm_sqlite_first;

class Main
{
    fnc main() -> Int32
    {
        let u: orm_sqlite_first = DB::of(orm_sqlite_first)
            .filter(u => u.name == "Carol")
            .first();
        println(u.name);
        println(u.age);
        let none: orm_sqlite_first = DB::of(orm_sqlite_first)
            .filter(u => u.name == "does-not-exist").first();
        println("missing: " + none.id.toString() + ":" + none.name + ":" + none.age.toString());
        let rows: List<orm_sqlite_first> = DB::of(orm_sqlite_first)
            .filter(u => u.name == "does-not-exist").list();
        println(rows.len());
        println(DB::of(orm_sqlite_first).filter(u => u.name == "does-not-exist").count());
        return 0;
    }
}

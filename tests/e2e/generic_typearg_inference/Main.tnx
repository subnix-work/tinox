import Box;
import Pair;

// B2 step 2: type-argument inference for unannotated bindings.
// `const bi = Box::make(42)` derives T=Int from the args (typecheck unification
// of unerased params × arg types) and codegen carries the specialization
// (Box__i64) through the typed-value bridge up to the let/var marker — the
// connection between the two type systems probed in Bug 53. Covers let + var,
// Int64/String/Float64, two type params, and chained access without a binding.
// expect: 42
// expect: hi
// expect: 2
// expect: 3.5
// expect: 7
// expect: 1
// expect: x
// expect: 9

class Main
{
    fnc main() -> Int32 {
        // let without annotation: T=Int64 from the argument
        const bi = Box::make(42);
        println(bi.value.toString());        // 42

        // T=String: direct field read + method on the resolved T
        const bs = Box::make("hi");
        println(bs.value);                    // hi
        println(bs.value.len().toString());  // 2

        // T=Float64
        const bf = Box::make(3.5);
        println(bf.value.toString());        // 3.5

        // var path uses the same bridge
        var vi = Box::make(7);
        println(vi.value.toString());        // 7

        // Two type params bound independently (A=Int64, B=String)
        const p = Pair::make(1, "x");
        println(p.a.toString());             // 1
        println(p.b);                         // x

        // Chained access without a binding: marker directly on the call expression
        println(Box::make(9).value.toString()); // 9
        return 0;
    }
}

// Issue 79: AMQP 1.0 transactions (txn-id, declare/discharge, §4 of the
// transactions extension). A simulated broker (spawn) implements a
// minimal transaction coordinator: declare -> declared(txn-id), publish
// marked with a TransactionalState (the broker verifies the descriptor +
// txn-id in the transfer-state field), discharge -> accepted. Covers
// both discharge outcomes (commit AND rollback) as well as
// ackTransactional() on the receiving side.
// expect: ok-connect
// expect: broker-saw-declare:true
// expect: ok-declared
// expect: broker-saw-txn-transfer:true
// expect: broker-saw-commit-discharge:true
// expect: ok-commit-discharge
// expect: broker-saw-rollback-discharge:true
// expect: ok-rollback-discharge
// expect: broker-saw-txn-disposition:true
// expect: ok-broker-saw-all

import tinox.core.amqp10;
import tinox.core.socket;

class Main
{

    async fnc txnBroker(srv: Int64) -> Int64 {
        let sconn = httpServerAcceptConnHandle(srv);

        // --- SASL header + negotiation (PLAIN) ---
        httpConnReadN(sconn, 8);
        httpConnWriteBytes(sconn, [65, 77, 81, 80, 3, 1, 0, 0]);
        Amqp10::writeFrame(sconn, 1, 0, Amqp10::encodePerformative(0x40, [Amqp10Value::ListVal([Amqp10Value::SymbolVal("PLAIN")])]));
        Amqp10::readFrame(sconn);
        Amqp10::writeFrame(sconn, 1, 0, Amqp10::encodePerformative(0x44, [Amqp10Value::UByteVal(0)]));

        // --- AMQP header ---
        httpConnReadN(sconn, 8);
        httpConnWriteBytes(sconn, [65, 77, 81, 80, 0, 1, 0, 0]);

        // --- open / open-ok ---
        Amqp10::readFrame(sconn);
        var openFields: List<Amqp10Value> = [
            Amqp10Value::StrVal("fake-broker"), Amqp10Value::NullVal,
            Amqp10Value::UIntVal(131072), Amqp10Value::UShortVal(2047)
        ];
        Amqp10::writeFrame(sconn, 0, 0, Amqp10::encodePerformative(0x10, openFields));

        // --- begin / begin-ok ---
        let fBegin = Amqp10::readFrame(sconn);
        var beginFields: List<Amqp10Value> = [
            Amqp10Value::UShortVal(fBegin.chanId), Amqp10Value::UIntVal(0),
            Amqp10Value::UIntVal(2147483647), Amqp10Value::UIntVal(2147483647)
        ];
        Amqp10::writeFrame(sconn, 0, fBegin.chanId, Amqp10::encodePerformative(0x11, beginFields));

        // --- attach (coordinator link) / attach-ok ---
        let fAttachCoord = Amqp10::readFrame(sconn);
        let pAttachCoord = Amqp10::decodePerformative(fAttachCoord.body);
        Amqp10::writeFrame(sconn, 0, fBegin.chanId, Amqp10::encodePerformative(0x12, pAttachCoord.fields));

        // --- attach (normal sender link for the transactional message) / attach-ok + flow ---
        let fAttachPub = Amqp10::readFrame(sconn);
        let pAttachPub = Amqp10::decodePerformative(fAttachPub.body);
        var pubHandle: Int64 = -1;
        if (pAttachPub.fields.len() > 1) { match pAttachPub.fields[1] { UIntVal(n) => { pubHandle = n; } _ => {} } }
        Amqp10::writeFrame(sconn, 0, fBegin.chanId, Amqp10::encodePerformative(0x12, pAttachPub.fields));
        // The flow for pubLink is deliberately NOT sent here, right after the
        // attach-ok: the client only reads it later, during
        // publishTransactional() (awaitFlow() internally) — if it were sent
        // now already, it would still be UNREAD in the socket buffer at the
        // next readFrame() (expecting declare()'s response) and would be
        // wrongly read AS the declared disposition (the same trap already
        // found in Issue 78's test — avoided here proactively instead of
        // being discovered only through a failure).

        // --- Receive declare (transfer on the coordinator link) ---
        let fDeclare = Amqp10::readFrame(sconn);
        let pDeclareXfer = Amqp10::decodePerformative(fDeclare.body);
        var declareDeliveryId: Int64 = -1;
        if (pDeclareXfer.fields.len() > 1) { match pDeclareXfer.fields[1] { UIntVal(n) => { declareDeliveryId = n; } _ => {} } }
        let rDeclare = Amqp10Reader::new(fDeclare.body);
        rDeclare.readValue(); // skip the transfer performative (already decoded)
        let declareSection = rDeclare.readValue();
        var sawDeclare: Bool = false;
        match declareSection {
            DescribedVal(sd) => {
                if (sd.descriptor == 0x77) {
                    match sd.value {
                        DescribedVal(dd) => { if (dd.descriptor == 0x31) { sawDeclare = true; } }
                        _ => {}
                    }
                }
            }
            _ => {}
        }
        println("broker-saw-declare:" + sawDeclare.toString());

        // --- Reply with declared(txn-id) as a disposition ---
        let txnId: List<Int64> = [1, 2, 3, 4];
        let declaredDesc = Amqp10Described { descriptor: 0x33, value: Amqp10Value::ListVal([Amqp10Value::BinaryVal(txnId)]) };
        var declaredDispFields: List<Amqp10Value> = [
            Amqp10Value::BoolVal(true), Amqp10Value::UIntVal(declareDeliveryId), Amqp10Value::NullVal,
            Amqp10Value::BoolVal(true), Amqp10Value::DescribedVal(declaredDesc)
        ];
        Amqp10::writeFrame(sconn, 0, fBegin.chanId, Amqp10::encodePerformative(0x15, declaredDispFields));

        // --- Send flow for pubLink now (not earlier, see above) ---
        var flowFields: List<Amqp10Value> = [
            Amqp10Value::NullVal, Amqp10Value::UIntVal(2147483647), Amqp10Value::UIntVal(0),
            Amqp10Value::UIntVal(2147483647), Amqp10Value::UIntVal(pubHandle), Amqp10Value::UIntVal(0),
            Amqp10Value::UIntVal(10)
        ];
        Amqp10::writeFrame(sconn, 0, fBegin.chanId, Amqp10::encodePerformative(0x13, flowFields));

        // --- Receive the transactional transfer (real message), check the state field ---
        let fTxnXfer = Amqp10::readFrame(sconn);
        let pTxnXfer = Amqp10::decodePerformative(fTxnXfer.body);
        var sawTxnTransfer: Bool = false;
        if (pTxnXfer.fields.len() > 7) {
            match pTxnXfer.fields[7] {
                DescribedVal(sd) => {
                    if (sd.descriptor == 0x34) {
                        match sd.value {
                            ListVal(sf) => {
                                if (sf.len() > 0) {
                                    match sf[0] {
                                        BinaryVal(tid) => {
                                            if (tid.len() == txnId.len()) {
                                                var same: Bool = true;
                                                for i in 0..tid.len() { if (tid[i] != txnId[i]) { same = false; } }
                                                sawTxnTransfer = same;
                                            }
                                        }
                                        _ => {}
                                    }
                                }
                            }
                            _ => {}
                        }
                    }
                }
                _ => {}
            }
        }
        println("broker-saw-txn-transfer:" + sawTxnTransfer.toString());

        // --- Receive discharge (commit, fail=false) ---
        let fDischarge1 = Amqp10::readFrame(sconn);
        let pDischarge1Xfer = Amqp10::decodePerformative(fDischarge1.body);
        var discharge1DeliveryId: Int64 = -1;
        if (pDischarge1Xfer.fields.len() > 1) { match pDischarge1Xfer.fields[1] { UIntVal(n) => { discharge1DeliveryId = n; } _ => {} } }
        let rDischarge1 = Amqp10Reader::new(fDischarge1.body);
        rDischarge1.readValue();
        let discharge1Section = rDischarge1.readValue();
        var sawCommit: Bool = false;
        match discharge1Section {
            DescribedVal(sd) => {
                if (sd.descriptor == 0x77) {
                    match sd.value {
                        DescribedVal(dd) => {
                            if (dd.descriptor == 0x32) {
                                match dd.value {
                                    ListVal(df) => {
                                        if (df.len() > 1) {
                                            match df[1] { BoolVal(fail) => { sawCommit = !fail; } _ => {} }
                                        }
                                    }
                                    _ => {}
                                }
                            }
                        }
                        _ => {}
                    }
                }
            }
            _ => {}
        }
        println("broker-saw-commit-discharge:" + sawCommit.toString());
        let acceptedDesc1 = Amqp10Described { descriptor: 0x24, value: Amqp10Value::ListVal([]) };
        var discharge1DispFields: List<Amqp10Value> = [
            Amqp10Value::BoolVal(true), Amqp10Value::UIntVal(discharge1DeliveryId), Amqp10Value::NullVal,
            Amqp10Value::BoolVal(true), Amqp10Value::DescribedVal(acceptedDesc1)
        ];
        Amqp10::writeFrame(sconn, 0, fBegin.chanId, Amqp10::encodePerformative(0x15, discharge1DispFields));

        // --- Second round: declare -> discharge(fail=true, rollback) ---
        let fDeclare2 = Amqp10::readFrame(sconn);
        let pDeclare2Xfer = Amqp10::decodePerformative(fDeclare2.body);
        var declare2DeliveryId: Int64 = -1;
        if (pDeclare2Xfer.fields.len() > 1) { match pDeclare2Xfer.fields[1] { UIntVal(n) => { declare2DeliveryId = n; } _ => {} } }
        let txnId2: List<Int64> = [9, 9, 9, 9];
        let declared2Desc = Amqp10Described { descriptor: 0x33, value: Amqp10Value::ListVal([Amqp10Value::BinaryVal(txnId2)]) };
        var declared2DispFields: List<Amqp10Value> = [
            Amqp10Value::BoolVal(true), Amqp10Value::UIntVal(declare2DeliveryId), Amqp10Value::NullVal,
            Amqp10Value::BoolVal(true), Amqp10Value::DescribedVal(declared2Desc)
        ];
        Amqp10::writeFrame(sconn, 0, fBegin.chanId, Amqp10::encodePerformative(0x15, declared2DispFields));

        let fDischarge2 = Amqp10::readFrame(sconn);
        let pDischarge2Xfer = Amqp10::decodePerformative(fDischarge2.body);
        var discharge2DeliveryId: Int64 = -1;
        if (pDischarge2Xfer.fields.len() > 1) { match pDischarge2Xfer.fields[1] { UIntVal(n) => { discharge2DeliveryId = n; } _ => {} } }
        let rDischarge2 = Amqp10Reader::new(fDischarge2.body);
        rDischarge2.readValue();
        let discharge2Section = rDischarge2.readValue();
        var sawRollback: Bool = false;
        match discharge2Section {
            DescribedVal(sd) => {
                if (sd.descriptor == 0x77) {
                    match sd.value {
                        DescribedVal(dd) => {
                            if (dd.descriptor == 0x32) {
                                match dd.value {
                                    ListVal(df) => {
                                        if (df.len() > 1) {
                                            match df[1] { BoolVal(fail) => { sawRollback = fail; } _ => {} }
                                        }
                                    }
                                    _ => {}
                                }
                            }
                        }
                        _ => {}
                    }
                }
            }
            _ => {}
        }
        println("broker-saw-rollback-discharge:" + sawRollback.toString());
        let acceptedDesc2 = Amqp10Described { descriptor: 0x24, value: Amqp10Value::ListVal([]) };
        var discharge2DispFields: List<Amqp10Value> = [
            Amqp10Value::BoolVal(true), Amqp10Value::UIntVal(discharge2DeliveryId), Amqp10Value::NullVal,
            Amqp10Value::BoolVal(true), Amqp10Value::DescribedVal(acceptedDesc2)
        ];
        Amqp10::writeFrame(sconn, 0, fBegin.chanId, Amqp10::encodePerformative(0x15, discharge2DispFields));

        // --- Receiver link for ackTransactional() ---
        let fAttachSub = Amqp10::readFrame(sconn);
        let pAttachSub = Amqp10::decodePerformative(fAttachSub.body);
        var subHandle: Int64 = -1;
        if (pAttachSub.fields.len() > 1) { match pAttachSub.fields[1] { UIntVal(n) => { subHandle = n; } _ => {} } }
        Amqp10::writeFrame(sconn, 0, fBegin.chanId, Amqp10::encodePerformative(0x12, pAttachSub.fields));
        Amqp10::readFrame(sconn); // flow from the client (credit)

        let msgBody = Amqp10::encodeMessageBody([88], "text/plain");
        var subTransferFields: List<Amqp10Value> = [
            Amqp10Value::UIntVal(subHandle), Amqp10Value::UIntVal(0),
            Amqp10Value::BinaryVal([0, 0, 0, 1]), Amqp10Value::UIntVal(0),
            Amqp10Value::BoolVal(true), Amqp10Value::BoolVal(false)
        ];
        let subTransferBody = Amqp10::encodePerformative(0x14, subTransferFields);
        var subFullFrame: List<Int64> = [];
        for i in 0..subTransferBody.len() { subFullFrame.push(subTransferBody[i]); }
        for i in 0..msgBody.len() { subFullFrame.push(msgBody[i]); }
        Amqp10::writeFrame(sconn, 0, fBegin.chanId, subFullFrame);

        let fTxnDisp = Amqp10::readFrame(sconn);
        let pTxnDisp = Amqp10::decodePerformative(fTxnDisp.body);
        var sawTxnDisposition: Bool = false;
        if (pTxnDisp.fields.len() > 4) {
            match pTxnDisp.fields[4] {
                DescribedVal(sd) => {
                    if (sd.descriptor == 0x34) {
                        match sd.value {
                            ListVal(sf) => {
                                if (sf.len() > 1) {
                                    var tidOk: Bool = false;
                                    match sf[0] {
                                        BinaryVal(tid) => {
                                            if (tid.len() == txnId.len()) {
                                                var same2: Bool = true;
                                                for i in 0..tid.len() { if (tid[i] != txnId[i]) { same2 = false; } }
                                                tidOk = same2;
                                            }
                                        }
                                        _ => {}
                                    }
                                    var outcomeOk: Bool = false;
                                    match sf[1] {
                                        DescribedVal(od) => { if (od.descriptor == 0x24) { outcomeOk = true; } }
                                        _ => {}
                                    }
                                    sawTxnDisposition = tidOk && outcomeOk;
                                }
                            }
                            _ => {}
                        }
                    }
                }
                _ => {}
            }
        }
        println("broker-saw-txn-disposition:" + sawTxnDisposition.toString());

        httpConnClose(sconn);

        var result: Int64 = 0;
        if (sawDeclare) { if (sawTxnTransfer) { if (sawCommit) { if (sawRollback) { if (sawTxnDisposition) {
            result = 1;
        } } } } }
        return result;
    }


    fnc main() -> Int32 {
        let srv = httpServerCreate(0);
        let port = httpServerBoundPort(srv);
        if (srv < 0) {
            println("bind failed");
            return 1;
        }
        let handle = spawn txnBroker(srv);

        let conn = Amqp10Connection::connect("127.0.0.1", port, "guest", "guest");
        if (conn.conn <= 0) {
            println("connect failed: " + conn.errorMessage);
            return 1;
        }
        println("ok-connect");

        let session = Amqp10Session::begin(conn);
        let coordinator = Amqp10Link::attachCoordinator(session, "txn-coordinator");
        let pubLink = Amqp10Link::attach(session, "txn-pub-link", false, "txn-target");

        // --- Round 1: declare -> transactional publish -> commit ---
        let txn1 = coordinator.declare();
        if (txn1.ok) {
            println("ok-declared");
        } else {
            println("declare failed: " + txn1.errorMessage);
        }
        pubLink.publishTransactional([42], "text/plain", txn1.txnId);
        let commitOk = coordinator.discharge(txn1.txnId, false);
        if (commitOk) {
            println("ok-commit-discharge");
        }

        // --- Round 2: declare -> discharge(fail=true), rollback ---
        let txn2 = coordinator.declare();
        let rollbackOk = coordinator.discharge(txn2.txnId, true);
        if (rollbackOk) {
            println("ok-rollback-discharge");
        }

        // --- ackTransactional() on a receiver link ---
        let subLink = Amqp10Link::attach(session, "txn-sub-link", true, "txn-source");
        subLink.grantCredit(5);
        let msg = subLink.nextMessage();
        if (msg.ok) {
            subLink.ackTransactional(msg.deliveryId, txn1.txnId);
        }

        let brokerOk = await handle;
        if (brokerOk == 1) {
            println("ok-broker-saw-all");
        }

        conn.close();
        httpServerClose(srv);
        return 0;
    }
}

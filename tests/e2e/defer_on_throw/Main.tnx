// defer runs during throw unwinding (Bug 41): resource cleanup also happens
// on error paths, not just on a normal return. Covers: uncaught throw,
// throw from a nested loop (runs ALL active defer scopes, including the
// function scope), LIFO order, and that the normal return path stays
// unchanged.
// expect: before throw
// expect: cleanup risky
// expect: caught: error
// expect: i=0
// expect: i=1
// expect: close resource
// expect: caught: loop
// expect: defer B
// expect: defer A
// expect: catch
// expect: normal cleanup
// expect: 42

class Main
{
    fnc risky() -> Nothing {
        defer { println("cleanup risky"); }
        println("before throw");
        throw "error";
    }


    fnc worker() -> Nothing {
        defer { println("close resource"); }   // function scope
        var i: Int64 = 0;
        while i < 5 {
            if (i == 2) { throw "loop"; }         // throw from loop scope
            println("i=" + i.toString());
            i = i + 1;
        }
    }


    fnc multi() -> Nothing {
        defer { println("defer A"); }   // registered first -> runs last
        defer { println("defer B"); }   // registered last -> runs first
        throw "x";
    }


    fnc ok() -> Int64 {
        defer { println("normal cleanup"); }
        return 42;
    }


    fnc main() -> Int32 {
        try { risky(); } catch e: String { println("caught: " + e); }
        try { worker(); } catch e: String { println("caught: " + e); }
        try { multi(); } catch e: String { println("catch"); }
        println(ok().toString());
        return 0;
    }
}

// Bug 63: integer division/modulo by zero was only checked in the binary-op
// path for i64 (Bug 56). Small int widths (i32/i16/i8) and ALL CompoundAssign
// paths (`/=`, `%=`, also for i64) still used raw sdiv/srem → LLVM UB (garbage).
// A shared helper emit_checked_idiv now covers every combination: i64 checked
// directly, small ints via widen→check→narrow. Here are the valid paths (the
// division-by-zero aborts are verified via fuzzing — an e2e test cannot
// express an expected abort).
// expect: 14
// expect: 2
// expect: 12,2
// expect: 5

class Main
{
    fnc main() -> Int32 {
        // Binary op, i32
        const a: Int32 = 100;
        println((a / 7).toString());        // 14
        println((a % 7).toString());        // 2

        // Binary op, i64
        println((100 / 8).toString() + "," + (100 % 7).toString());  // 12,2

        // CompoundAssign, i64 + i32
        var x: Int64 = 17;
        x /= 3;                              // 5
        println(x.toString());               // 5
        return 0;
    }
}

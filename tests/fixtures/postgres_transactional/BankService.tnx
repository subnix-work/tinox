import tinox.core.db;
import Account;

@ApplicationComponent
@Synchronized
class BankService
{
    // @Transactional (issue #191): both saves below must land atomically --
    // either the whole transfer commits, or (if the sender ends up
    // overdrawn) neither balance change survives. Verified end-to-end
    // against a real Postgres, independently of this program's own stdout,
    // by crates/tinox/tests/postgres_transactional.rs.
    @Transactional
    fn transfer(fromId: Int64, toId: Int64, amount: Int64) -> Nothing
    {
        const from: Account = DB::of(Account).filter(a => a.id == fromId).first();
        const to: Account = DB::of(Account).filter(a => a.id == toId).first();
        from.balance = from.balance - amount;
        to.balance = to.balance + amount;
        DB::of(Account).save(from);
        DB::of(Account).save(to);
        if (from.balance < 0) {
            throw "insufficient funds";
        }
    }

    // A real, previously-undiscovered bug: `return` statements emit their
    // `ret` directly with no awareness of gen_transactional_wrapper's own
    // try/catch-style structure around them (the exact same way a plain
    // `try { return x; } finally { ... } ` already skips its finally
    // today) -- so a method ending in an explicit `return` never actually
    // committed, even on success. `transfer` above didn't catch this
    // because Nothing-returning methods with no explicit `return` don't
    // exercise the bug at all. Fixed via GenCtx.transactional_commit,
    // consulted directly by StmtKind::Return's own codegen. This method
    // exists specifically to keep that fix covered by a real test.
    @Transactional
    fn getBalanceAndTouch(accountId: Int64) -> Int64
    {
        const acct: Account = DB::of(Account).filter(a => a.id == accountId).first();
        acct.balance = acct.balance + 1;
        DB::of(Account).save(acct);
        return acct.balance;
    }
    // Cancellation must roll back before the owning scope finishes joining.
    @Transactional
    fn cancelledChange(accountId: Int64, ready: Int64) -> Nothing
    {
        const acct: Account = DB::of(Account).filter(a => a.id == accountId).first();
        acct.balance = acct.balance + 10000;
        DB::of(Account).save(acct);
        send ready -> 1;
        sleep(10000);
    }
    @Transactional
    fn readBalance(accountId: Int64) -> Int64 {
        const account: Account = DB::of(Account).filter(a => a.id == accountId).first();
        return account.balance;
    }

}

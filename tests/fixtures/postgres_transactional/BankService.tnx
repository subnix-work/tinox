import tinox.core.db;
import Account;

class BankService
{
    // @Transactional (issue #191): both saves below must land atomically --
    // either the whole transfer commits, or (if the sender ends up
    // overdrawn) neither balance change survives. Verified end-to-end
    // against a real Postgres, independently of this program's own stdout,
    // by crates/tinox/tests/postgres_transactional.rs.
    @Transactional
    fn transfer(fromId: Int64, toId: Int64, amount: Int64) -> Nothing
    {
        let from: Account = DB.of(Account).filter(a => a.id == fromId).first();
        let to: Account = DB.of(Account).filter(a => a.id == toId).first();
        from.balance = from.balance - amount;
        to.balance = to.balance + amount;
        DB.of(Account).save(from);
        DB.of(Account).save(to);
        if (from.balance < 0) {
            throw "insufficient funds";
        }
    }
}

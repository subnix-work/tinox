import tinox.core.db

@ApplicationComponent
class Service {
    @Transactional
    fn empty() -> Nothing {}
    @Transactional
    fn change() -> Nothing {
        DB::raw("UPDATE items SET amount = 100 WHERE id = 1", [])
        DB::raw("SELECT $1::jsonb", ["{bad"])
        println("unreachable transaction")
    }

    @Transactional
    fn swallowed() -> Nothing {
        DB::raw("UPDATE items SET amount = 200 WHERE id = 1", [])
        try { DB::raw("SELECT $1::jsonb", ["{bad"]) }
        catch (e: String) { println("caught inside transaction") }
    }

    @Transactional("NESTED")
    fn nestedDisconnect() -> Nothing {
        DB::raw("SELECT pg_terminate_backend(pg_backend_pid())", [])
    }

    @Transactional
    fn disconnect() -> Nothing { this.nestedDisconnect() }
}

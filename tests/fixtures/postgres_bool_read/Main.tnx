import tinox.core.db
import Flag

class Main
{
    fnc main() -> Int32
    {
        const rows: List<Flag> = DB::of(Flag).list()
        for f in rows {
            println(f.name + "=" + f.enabled.toString())
        }
        // Round trip: a Bool written by the ORM must read back unchanged.
        const saved: Flag = new Flag()
        saved.name = "saved"
        saved.enabled = true
        DB::of(Flag).save(saved)
        const back: Flag = DB::of(Flag).filter(x => x.name == "saved").first()
        println("roundtrip=" + back.enabled.toString())
        // A runtime Bool (i1) filter parameter must be widened before the i64 conversion (#672).
        println("filtered_on=" + Main::countWith(true).toString())
        println("filtered_off=" + Main::countWith(false).toString())
        return 0
    }

    fnc countWith(wanted: Bool) -> Int64
    {
        const rows: List<Flag> = DB::of(Flag).filter(x => x.enabled == wanted).list()
        return rows.len()
    }
}

/**
 * Tinox Standard Library - String Module
 * String manipulation and utility functions
 */
module tinox.core.string;

namespace tinox.core.string
{
    /**
     * String utility class providing common string operations
     * including inspection, transformation, splitting, and formatting
     */
    class Strings
    {
        /**
         * Returns the length of the string
         *
         * @param s the input string
         * @return the number of characters in the string
         */
        fn length(s: String) -> Int64
        {
            return s.len();
        }

        /**
         * Checks if the string is empty
         *
         * @param s the input string
         * @return true if the string has zero length
         */
        fn isEmpty(s: String) -> Bool
        {
            return s.len() == 0;
        }

        /**
         * Converts all characters to uppercase
         *
         * @param s the input string
         * @return a new string with all uppercase characters
         */
        fn toUpperCase(s: String) -> String
        {
            return s.toUpper();
        }

        /**
         * Converts all characters to lowercase
         *
         * @param s the input string
         * @return a new string with all lowercase characters
         */
        fn toLowerCase(s: String) -> String
        {
            return s.toLower();
        }

        /**
         * Removes leading and trailing whitespace
         *
         * @param s the input string
         * @return a new string with whitespace removed from both ends
         */
        fn trim(s: String) -> String
        {
            return s.trim();
        }

        /**
         * Checks if the haystack contains the needle
         *
         * @param haystack the string to search in
         * @param needle the substring to search for
         * @return true if needle is found in haystack
         */
        fn contains(haystack: String, needle: String) -> Bool
        {
            return haystack.contains(needle);
        }

        /**
         * Checks if the string starts with the given prefix
         *
         * @param s the input string
         * @param prefix the prefix to check for
         * @return true if s starts with prefix
         */
        fn startsWith(s: String, prefix: String) -> Bool
        {
            return s.startsWith(prefix);
        }

        /**
         * Checks if the string ends with the given suffix
         *
         * @param s the input string
         * @param suffix the suffix to check for
         * @return true if s ends with suffix
         */
        fn endsWith(s: String, suffix: String) -> Bool
        {
            return s.endsWith(suffix);
        }

        /**
         * Extracts a substring from start to end (exclusive)
         *
         * @param s the input string
         * @param start the starting index (inclusive)
         * @param end the ending index (exclusive)
         * @return the extracted substring
         */
        fn substring(s: String, start: Int64, end: Int64) -> String
        {
            return s.substring(start, end);
        }

        /**
         * Repeats the string count times
         *
         * @param s the string to repeat
         * @param count the number of repetitions (must be non-negative)
         * @return a new string with s repeated count times
         */
        fn repeat(s: String, count: Int64) -> String
        {
            var result: String = "";
            var i: Int64 = 0;
            while i < count
            {
                result = result + s;
                i = i + 1;
            }
            return result;
        }

        /**
         * Replaces all occurrences of old with new
         *
         * @param s the input string
         * @param old the substring to replace
         * @param new the replacement substring
         * @return a new string with all occurrences replaced
         */
        fn replace(s: String, old: String, repl: String) -> String
        {
            return s.replace(old, repl);
        }

        /**
         * Reverses the characters in the string
         *
         * @param s the input string
         * @return a new string with characters in reverse order
         */
        fn reverse(s: String) -> String
        {
            return s.reverse();
        }

        /**
         * Splits the string by the given delimiter
         *
         * @param s the input string
         * @param delimiter the delimiter to split on
         * @return a list of substrings
         */
        fn split(s: String, delimiter: String) -> List<String>
        {
            return s.split(delimiter);
        }

        /**
         * Joins a list of strings with a separator
         *
         * @param parts the list of strings to join
         * @param separator the string to insert between parts
         * @return the joined string
         */
        fn join(parts: List<String>, separator: String) -> String
        {
            var result: String = "";
            var i: Int64 = 0;
            while i < parts.len()
            {
                if i > 0
                {
                    result = result + separator;
                }
                result = result + parts[i];
                i = i + 1;
            }
            return result;
        }

        /**
         * Converts an integer to its string representation
         *
         * @param n the integer to convert
         * @return the string representation of n
         */
        fn intToString(n: Int64) -> String
        {
            return n.toString();
        }

        /**
         * Converts a float to its string representation
         *
         * @param f the float to convert
         * @return the string representation of f
         */
        fn floatToString(f: Float64) -> String
        {
            return f.toString();
        }
    }
}

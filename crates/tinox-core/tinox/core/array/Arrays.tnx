module tinox.core.array;

namespace tinox.core.array
{
        /**
     * Arrays utility class providing operations on List<Int64>
     * including searching, transforming, sorting, and generating ranges
     */
    class Arrays
    {
        /**
         * Checks if the array contains the given value
         * @param arr the array to search
         * @param value the value to look for
         * @return true if value is found in arr
         */
        fn containsInt(arr: List<Int64>, value: Int64) -> Bool
        {
            var i: Int64 = 0;
            while i < arr.len()
            {
                if arr[i] == value
                {
                    return true;
                }
                i = i + 1;
            }
            return false;
        }

        /**
         * Finds the index of the first occurrence of value
         * @param arr the array to search
         * @param value the value to look for
         * @return the index of value, or -1 if not found
         */
        fn indexOfInt(arr: List<Int64>, value: Int64) -> Int64
        {
            var i: Int64 = 0;
            while i < arr.len()
            {
                if arr[i] == value
                {
                    return i;
                }
                i = i + 1;
            }
            return -1;
        }

        /**
         * Finds the minimum value in the array
         * @param arr the array to search (must not be empty)
         * @return the smallest element in arr
         */
        fn findMin(arr: List<Int64>) -> Int64
        {
            var min: Int64 = arr[0];
            var i: Int64 = 1;
            while i < arr.len()
            {
                if arr[i] < min
                {
                    min = arr[i];
                }
                i = i + 1;
            }
            return min;
        }

        /**
         * Finds the maximum value in the array
         * @param arr the array to search (must not be empty)
         * @return the largest element in arr
         */
        fn findMax(arr: List<Int64>) -> Int64
        {
            var max: Int64 = arr[0];
            var i: Int64 = 1;
            while i < arr.len()
            {
                if arr[i] > max
                {
                    max = arr[i];
                }
                i = i + 1;
            }
            return max;
        }

        /**
         * Calculates the sum of all elements
         * @param arr the array of integers
         * @return the sum of all elements
         */
        fn sum(arr: List<Int64>) -> Int64
        {
            var total: Int64 = 0;
            var i: Int64 = 0;
            while i < arr.len()
            {
                total = total + arr[i];
                i = i + 1;
            }
            return total;
        }

        /**
         * Calculates the integer average of all elements
         * @param arr the array of integers (must not be empty)
         * @return the average (sum / length), truncated to integer
         */
        fn average(arr: List<Int64>) -> Int64
        {
            var total: Int64 = 0;
            var i: Int64 = 0;
            while i < arr.len()
            {
                total = total + arr[i];
                i = i + 1;
            }
            return total / arr.len();
        }

        /**
         * Returns a new array with elements in reverse order
         * @param arr the input array
         * @return a new array with elements reversed
         */
        fn reverseInt(arr: List<Int64>) -> List<Int64>
        {
            var result: List<Int64> = [];
            var i: Int64 = arr.len() - 1;
            while i >= 0
            {
                result.push(arr[i]);
                i = i - 1;
            }
            return result;
        }

        /**
         * Returns a new array containing only positive values
         * @param arr the input array
         * @return a new array with only elements > 0
         */
        fn filterPositive(arr: List<Int64>) -> List<Int64>
        {
            var result: List<Int64> = [];
            var i: Int64 = 0;
            while i < arr.len()
            {
                if arr[i] > 0
                {
                    result.push(arr[i]);
                }
                i = i + 1;
            }
            return result;
        }

        /**
         * Sorts the array using bubble sort algorithm
         * @param arr the array to sort
         * @return a new sorted array in ascending order
         */
        fn bubbleSort(arr: List<Int64>) -> List<Int64>
        {
            var result: List<Int64> = arr;
            var n: Int64 = result.len();
            var i: Int64 = 0;
            while i < n - 1
            {
                var j: Int64 = 0;
                while j < n - i - 1
                {
                    if result[j] > result[j + 1]
                    {
                        var temp: Int64 = result[j];
                        result[j] = result[j + 1];
                        result[j + 1] = temp;
                    }
                    j = j + 1;
                }
                i = i + 1;
            }
            return result;
        }

        /**
         * Checks if the array is sorted in ascending order
         * @param arr the array to check
         * @return true if elements are in non-decreasing order
         */
        fn isSorted(arr: List<Int64>) -> Bool
        {
            var i: Int64 = 1;
            while i < arr.len()
            {
                if arr[i] < arr[i - 1]
                {
                    return false;
                }
                i = i + 1;
            }
            return true;
        }

        /**
         * Generates a range of integers from start to end (exclusive)
         * @param start the starting value (inclusive)
         * @param end the ending value (exclusive)
         * @return a list containing start, start+1, ..., end-1
         */
        fn range(start: Int64, end: Int64) -> List<Int64>
        {
            var result: List<Int64> = [];
            var i: Int64 = start;
            while i < end
            {
                result.push(i);
                i = i + 1;
            }
            return result;
        }

        /**
         * Creates an array filled with the same value
         * @param value the value to fill with
         * @param count the number of elements (must be non-negative)
         * @return a list containing count copies of value
         */
        fn fill(value: Int64, count: Int64) -> List<Int64>
        {
            var result: List<Int64> = [];
            var i: Int64 = 0;
            while i < count
            {
                result.push(value);
                i = i + 1;
            }
            return result;
        }
    }
}

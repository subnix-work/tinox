module tinox.core.cron
import tinox.core.time

namespace tinox.core.cron
{
    class CronScheduler
    {
        var jobs: List<CronJob>
        var running: Bool

        fn new() -> CronScheduler
        {
            return CronScheduler { jobs: [], running: false }
        }

        fn addJob(scheduler: CronScheduler, expr: String, callback: fnc() -> Nothing) -> Nothing
        {
            const cronExpr: CronExpr = Cron::parse(expr)
            scheduler.jobs.push(CronJob { expr: cronExpr, callback: callback, lastRun: -1 })
        }

        fn start(scheduler: CronScheduler) -> Nothing
        {
            scheduler.running = true
        }

        fn stop(scheduler: CronScheduler) -> Nothing
        {
            scheduler.running = false
        }

        fn tick(scheduler: CronScheduler) -> Nothing
        {
            CronScheduler::tickAt(scheduler, Time::now())
        }

        /** Caller-driven, single-threaded tick; missed minutes are not replayed.
         * Repeated or backward ticks never re-run an already executed minute. */
        fn tickAt(scheduler: CronScheduler, now: Int64) -> Nothing
        {
            Cron::validateTimestamp(now)
            if (scheduler.running == false)
            {
                return
            }
            const scheduledMinute: Int64 = (now / 60000) * 60000
            var i: Int64 = 0
            while i < scheduler.jobs.len()
            {
                const job: CronJob = scheduler.jobs[i]
                if (scheduledMinute > job.lastRun && Cron::matches(job.expr, now))
                {
                    // Claim before invoking: callbacks may throw or re-enter tick.
                    job.lastRun = scheduledMinute
                    job.callback()
                }
                i = i + 1
            }
        }
    }
}

module tinox.core.cron
import tinox.core.time

namespace tinox.core.cron
{
    /**
     * Five numeric fields: minute hour day-of-month month day-of-week.
     * Fields accept *, comma lists, inclusive ranges, and /positive-step
     * on * or a range (for example a wildcard step of 15, or 1-10/2).
     * Weekdays are 0-7,
     * Sunday is 0 or 7. Names, macros, seconds, L, W and # are rejected.
     * A bare * day field is unrestricted; otherwise day-of-month and
     * day-of-week use traditional cron OR semantics when both are restricted.
     * All timestamps are Unix milliseconds in UTC, 1970 through 9999;
     * matches() ignores seconds/milliseconds within the scheduled minute.
     */
    class Cron
    {
        fn parse(expr: String) -> CronExpr
        {
            var parts: List<String> = []
            const words: List<String> = expr.replace("\t", " ").split(" ")
            var i: Int64 = 0
            while i < words.len()
            {
                if (words[i] != "")
                {
                    parts.push(words[i])
                }
                i = i + 1
            }
            if (parts.len() != 5)
            {
                throw "Cron: expected five numeric fields"
            }
            const result: CronExpr = CronExpr {
                minute: parts[0], hour: parts[1], dayOfMonth: parts[2],
                month: parts[3], dayOfWeek: parts[4]
            }
            Cron::values(result.minute, 0, 59)
            Cron::values(result.hour, 0, 23)
            Cron::values(result.dayOfMonth, 1, 31)
            Cron::values(result.month, 1, 12)
            Cron::values(result.dayOfWeek, 0, 7)
            return result
        }

        // Parse digits explicitly: numeric casts alone accept malformed text.
        fn number(text: String) -> Int64
        {
            if (text.len() == 0)
            {
                throw "Cron: missing number"
            }
            var n: Int64 = 0
            var i: Int64 = 0
            while i < text.len()
            {
                const digit: Int64 = text.charCodeAt(i) - 48
                if (digit < 0 || digit > 9)
                {
                    throw "Cron: unsupported field syntax"
                }
                n = n * 10 + digit
                if (n > 9999)
                {
                    throw "Cron: number out of range"
                }
                i = i + 1
            }
            return n
        }

        fn values(field: String, minimum: Int64, maximum: Int64) -> List<Int64>
        {
            var mask: List<Int64> = []
            var i: Int64 = 0
            while i <= maximum
            {
                mask.push(0)
                i = i + 1
            }
            const items: List<String> = field.split(",")
            var item: Int64 = 0
            while item < items.len()
            {
                const steps: List<String> = items[item].split("/")
                if (steps.len() > 2)
                {
                    throw "Cron: invalid step"
                }
                var step: Int64 = 1
                if (steps.len() == 2)
                {
                    step = Cron::number(steps[1])
                }
                if (step == 0)
                {
                    throw "Cron: step must be positive"
                }
                var first: Int64 = minimum
                var last: Int64 = maximum
                if (steps[0] != "*")
                {
                    const bounds: List<String> = steps[0].split("-")
                    if (bounds.len() > 2)
                    {
                        throw "Cron: invalid range"
                    }
                    first = Cron::number(bounds[0])
                    last = first
                    if (bounds.len() == 2)
                    {
                        last = Cron::number(bounds[1])
                    }
                    if (bounds.len() == 1 && steps.len() == 2)
                    {
                        throw "Cron: steps require * or a range"
                    }
                }
                if (first < minimum || last > maximum || first > last)
                {
                    throw "Cron: field out of range"
                }
                i = first
                while i <= last
                {
                    mask[i] = 1
                    i = i + step
                }
                item = item + 1
            }
            return mask
        }

        fn validateTimestamp(timestamp: Int64) -> Nothing
        {
            if (timestamp < 0 || timestamp > 253402300799999)
            {
                throw "Cron: timestamp must be in UTC years 1970 through 9999"
            }
        }

        fn leap(year: Int64) -> Bool
        {
            return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
        }

        fn monthDays(year: Int64, month: Int64) -> Int64
        {
            if (month == 2)
            {
                if (Cron::leap(year))
                {
                    return 29
                }
                return 28
            }
            if (month == 4 || month == 6 || month == 9 || month == 11)
            {
                return 30
            }
            return 31
        }

        // Return year, month and day for a nonnegative Unix day number.
        fn date(days: Int64) -> List<Int64>
        {
            var remaining: Int64 = days
            var year: Int64 = 1970
            var length: Int64 = 365
            while true
            {
                length = 365
                if (Cron::leap(year))
                {
                    length = 366
                }
                if (remaining < length)
                {
                    break
                }
                remaining = remaining - length
                year = year + 1
            }
            var month: Int64 = 1
            while remaining >= Cron::monthDays(year, month)
            {
                remaining = remaining - Cron::monthDays(year, month)
                month = month + 1
            }
            return [year, month, remaining + 1]
        }

        fn dayMatches(expr: CronExpr, dom: List<Int64>, dow: List<Int64>, day: Int64, weekday: Int64) -> Bool
        {
            const monthDay: Bool = dom[day] == 1
            const weekDay: Bool = dow[weekday] == 1 || (weekday == 0 && dow[7] == 1)
            if (expr.dayOfMonth == "*")
            {
                return weekDay
            }
            if (expr.dayOfWeek == "*")
            {
                return monthDay
            }
            return monthDay || weekDay
        }

        fn matches(expr: CronExpr, timestamp: Int64) -> Bool
        {
            Cron::validateTimestamp(timestamp)
            const minute: List<Int64> = Cron::values(expr.minute, 0, 59)
            const hour: List<Int64> = Cron::values(expr.hour, 0, 23)
            const dom: List<Int64> = Cron::values(expr.dayOfMonth, 1, 31)
            const month: List<Int64> = Cron::values(expr.month, 1, 12)
            const dow: List<Int64> = Cron::values(expr.dayOfWeek, 0, 7)
            const days: Int64 = timestamp / 86400000
            const date: List<Int64> = Cron::date(days)
            return minute[(timestamp / 60000) % 60] == 1 && hour[(timestamp / 3600000) % 24] == 1 && month[date[1]] == 1 && Cron::dayMatches(expr, dom, dow, date[2], (days + 4) % 7)
        }

        /** Return the first matching minute boundary strictly after now. */
        fn nextRun(expr: CronExpr) -> Int64
        {
            return Cron::nextRunAfter(expr, Time::now())
        }

        /**
         * Deterministic nextRun variant. Search at most one Gregorian
         * 400-year cycle; impossible dates and exhausted years throw.
         */
        fn nextRunAfter(expr: CronExpr, timestamp: Int64) -> Int64
        {
            Cron::validateTimestamp(timestamp)
            const minute: List<Int64> = Cron::values(expr.minute, 0, 59)
            const hour: List<Int64> = Cron::values(expr.hour, 0, 23)
            const dom: List<Int64> = Cron::values(expr.dayOfMonth, 1, 31)
            const month: List<Int64> = Cron::values(expr.month, 1, 12)
            const dow: List<Int64> = Cron::values(expr.dayOfWeek, 0, 7)
            var days: Int64 = timestamp / 86400000
            var date: List<Int64> = Cron::date(days)
            var searched: Int64 = 0
            while searched <= 146097 && date[0] <= 9999
            {
                if (month[date[1]] == 1 && Cron::dayMatches(expr, dom, dow, date[2], (days + 4) % 7))
                {
                    var h: Int64 = 0
                    while h < 24
                    {
                        if (hour[h] == 1)
                        {
                            var m: Int64 = 0
                            while m < 60
                            {
                                const candidate: Int64 = days * 86400000 + h * 3600000 + m * 60000
                                if (minute[m] == 1 && candidate > timestamp)
                                {
                                    return candidate
                                }
                                m = m + 1
                            }
                        }
                        h = h + 1
                    }
                }
                days = days + 1
                searched = searched + 1
                date[2] = date[2] + 1
                if (date[2] > Cron::monthDays(date[0], date[1]))
                {
                    date[2] = 1
                    date[1] = date[1] + 1
                    if (date[1] > 12)
                    {
                        date[1] = 1
                        date[0] = date[0] + 1
                    }
                }
            }
            throw "Cron: no future matching date in supported timestamp range"
        }

        // Legacy helper: wildcard keeps current; explicit fields advance strictly.
        fn nextMinute(current: Int64, field: String) -> Int64
        {
            const mask: List<Int64> = Cron::values(field, 0, 59)
            if (current < 0 || current > 59)
            {
                throw "Cron: minute out of range"
            }
            var candidate: Int64 = current + 1
            if (field == "*")
            {
                return current
            }
            while candidate <= current + 60
            {
                if (mask[candidate % 60] == 1)
                {
                    return candidate
                }
                candidate = candidate + 1
            }
            throw "Cron: no matching minute"
        }

        fn getCurrentMinute(sec: Int64) -> Int64
        {
            if (sec < 0)
            {
                throw "Cron: negative timestamp"
            }
            return (sec / 60) % 60
        }
    }
}

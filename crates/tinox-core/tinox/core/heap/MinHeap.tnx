module tinox.core.heap

namespace tinox.core.heap
{
    class MinHeap<T>
    {
        var heap: Heap<T>

        fn new() -> MinHeap<T>
        {
            return MinHeap<T> { heap: Heap::new() }
        }

        fn push(h: MinHeap<T>, item: T) -> Nothing
        {
            Heap::push(h.heap, item)
        }

        @Throws(EmptyHeapError)
        fn pop(h: MinHeap<T>) -> T
        {
            return Heap::pop(h.heap)
        }

        @Throws(EmptyHeapError)
        fn peek(h: MinHeap<T>) -> T
        {
            return Heap::peek(h.heap)
        }
    }
}

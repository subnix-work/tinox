module tinox.core.set;

namespace tinox.core.set
{
    class Set<T>
    {
        var items: List<T>;

        fn new() -> Set<T>
        {
            return Set<T> { items: [] };
        }

        fn add(set: Set<T>, item: T) -> Nothing
        {
            if Set::contains(set, item) == false
            {
                set.items.push(item);
            }
        }

        fn remove(set: Set<T>, item: T) -> Bool
        {
            var i: Int64 = 0;
            while i < set.items.len()
            {
                if set.items[i] == item
                {
                    set.items.removeAt(i);
                    return true;
                }
                i = i + 1;
            }
            return false;
        }

        fn contains(set: Set<T>, item: T) -> Bool
        {
            var i: Int64 = 0;
            while i < set.items.len()
            {
                if set.items[i] == item
                {
                    return true;
                }
                i = i + 1;
            }
            return false;
        }

        fn size(set: Set<T>) -> Int64
        {
            return set.items.len();
        }

        fn isEmpty(set: Set<T>) -> Bool
        {
            return set.items.len() == 0;
        }

        fn union(a: Set<T>, b: Set<T>) -> Set<T>
        {
            let result: Set<T> = Set::new();
            var i: Int64 = 0;
            while i < a.items.len()
            {
                Set::add(result, a.items[i]);
                i = i + 1;
            }
            i = 0;
            while i < b.items.len()
            {
                Set::add(result, b.items[i]);
                i = i + 1;
            }
            return result;
        }

        fn intersection(a: Set<T>, b: Set<T>) -> Set<T>
        {
            let result: Set<T> = Set::new();
            var i: Int64 = 0;
            while i < a.items.len()
            {
                if Set::contains(b, a.items[i])
                {
                    Set::add(result, a.items[i]);
                }
                i = i + 1;
            }
            return result;
        }

        fn difference(a: Set<T>, b: Set<T>) -> Set<T>
        {
            let result: Set<T> = Set::new();
            var i: Int64 = 0;
            while i < a.items.len()
            {
                if Set::contains(b, a.items[i]) == false
                {
                    Set::add(result, a.items[i]);
                }
                i = i + 1;
            }
            return result;
        }

        fn isSubsetOf(a: Set<T>, b: Set<T>) -> Bool
        {
            var i: Int64 = 0;
            while i < a.items.len()
            {
                if Set::contains(b, a.items[i]) == false
                {
                    return false;
                }
                i = i + 1;
            }
            return true;
        }
    }
}
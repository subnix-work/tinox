module tinox.core.process;

namespace tinox.core.process
{
    class Process
    {
        fn exit(code: Int64) -> Nothing
        {
            processExit(code);
        }

        fn sleep(ms: Int64) -> Nothing
        {
            sleep_ms(ms);
        }

        fn pid() -> Int64
        {
            return processId();
        }

        fn args() -> List<String>
        {
            return processArgs();
        }

        fn env(name: String) -> String
        {
            return envGet(name);
        }

        fn setEnv(name: String, value: String) -> Nothing
        {
            envSet(name, value);
        }
    }
}
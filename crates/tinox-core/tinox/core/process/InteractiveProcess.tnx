namespace tinox.core.process
{
    extern fn processSignal(handle: Int64, sig: Int64) -> Int64
    extern fn processWaitReadable(handle: Int64, timeoutMs: Int64) -> Int64

    /**
     * A long-lived, incrementally-driven subprocess -- unlike
     * Process::run() (blocks until exit, returns the full captured
     * output), this spawns and returns immediately; the caller drives it
     * for the duration of an interactive session (e.g. `kubectl exec -i`
     * bridged to a terminal) via writeStdin/readOutput. start() uses a PTY
     * with merged stdout/stderr; startPiped() uses separate pipes for tools
     * speaking line protocols such as JSON over stdio.
     */
    class InteractiveProcess
    {
        var handle: Int64

        /** argv[0] is the program (resolved via PATH like execvp), argv[1..] its arguments -- same argv-based, no-shell contract as Process::run(). Named start(), not spawn(): `spawn` is a reserved keyword (the language's own thread-spawn construct). */
        fn start(argv: List<String>) -> InteractiveProcess
        {
            return InteractiveProcess { handle: processSpawnInteractive(argv) }
        }

        /**
         * Starts a child with pipes: stdin is not a TTY, input is not echoed,
         * and stderr is separate. cwd/env follow Process::runWithOptions.
         * Call kill() to release resources, including after normal exit.
         * Serialize reads and lifecycle operations on each handle. Writes
         * block; use a concurrent reader when sending large input payloads.
         */
        fn startPiped(argv: List<String>, cwd: String, env: List<String>) -> InteractiveProcess
        {
            return InteractiveProcess { handle: processSpawnPiped(argv, cwd, env) }
        }

        /** Closes pipe stdin to deliver EOF. Idempotent; no effect on PTYs. */
        fn closeStdin(proc: InteractiveProcess) -> Nothing
        {
            processCloseStdin(proc.handle)
        }

        /**
         * Reads a stdout line, including its newline, or the final unterminated
         * line at EOF. Returns "" on timeout/EOF. Partial lines are retained
         * across timeouts. timeoutMs < 0 waits indefinitely; 0 polls.
         * Pipe mode only. Reads also buffer stderr to avoid pipe deadlocks;
         * drain both streams regularly to bound memory use.
         */
        fn readLine(proc: InteractiveProcess, timeoutMs: Int64) -> String
        {
            return processReadLine(proc.handle, timeoutMs)
        }

        /** Reads available pipe stderr; timeout/EOF returns "". */
        fn readStderr(proc: InteractiveProcess, timeoutMs: Int64) -> String
        {
            return processReadStderr(proc.handle, timeoutMs)
        }

        /** Exit status, -signal if killed, or -9223372036854775808 while running. */
        fn exitCode(proc: InteractiveProcess) -> Int64
        {
            return processExitCode(proc.handle)
        }

        /** Writes to the process's stdin. Best-effort: silently stops writing if the process has already exited -- check isAlive() to detect that. */
        fn writeStdin(proc: InteractiveProcess, data: String) -> Nothing
        {
            processWriteStdin(proc.handle, data)
        }

        /**
         * Reads available output (possibly a partial line). Pipe mode reads
         * stdout only and also buffers stderr. Output remains readable after
         * child exit. Returns "" on timeout/EOF; timeoutMs < 0 waits
         * indefinitely and 0 polls.
         */
        fn readOutput(proc: InteractiveProcess, timeoutMs: Int64) -> String
        {
            return processReadOutput(proc.handle, timeoutMs)
        }

        fn isAlive(proc: InteractiveProcess) -> Bool
        {
            return processIsAlive(proc.handle) != 0
        }

        /**
         * Waits up to timeoutMs (< 0 forever, 0 polls) until a pipe-mode child
         * has output on stdout and/or stderr, or both streams ended, and
         * returns a bit mask: 1 = stdout data is ready, 2 = stderr data is
         * ready, 4 = both streams are at EOF and drained, 0 = timeout. The
         * data is buffered, so the following readOutput/readLine/readStderr
         * call with timeout 0 returns it immediately. This lets ONE reader
         * task follow stdout and stderr together without polling either.
         */
        fn waitReadable(proc: InteractiveProcess, timeoutMs: Int64) -> Int64
        {
            return processWaitReadable(proc.handle, timeoutMs)
        }

        /**
         * Sends signal number sig (e.g. 2 = SIGINT, 15 = SIGTERM) to a running
         * child. A pipe-mode child leads its own process group and the signal
         * goes to the whole group, so tools it started receive it too. Returns
         * false when there was nothing to signal (the child already exited).
         */
        fn signal(proc: InteractiveProcess, sig: Int64) -> Bool
        {
            return processSignal(proc.handle, sig) != 0
        }

        /** Asks the process (and, in pipe mode, its process group) to stop with SIGTERM; follow up with kill() if it does not exit. */
        fn terminate(proc: InteractiveProcess) -> Bool
        {
            return processSignal(proc.handle, 15) != 0
        }

        /** Kills the process (if still running; in pipe mode its whole process group) and closes its pipes. Safe to call even if it already exited. */
        fn kill(proc: InteractiveProcess) -> Nothing
        {
            processKillInteractive(proc.handle)
        }
    }
}

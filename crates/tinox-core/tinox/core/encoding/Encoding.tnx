module tinox.core.encoding;

namespace tinox.core.encoding
{
    extern fn tinoxBytesToString(bytes: List<Int64>) -> String;

    class Encoding
    {
        fn toCharCode(s: String) -> Int64
        {
            if s.len() == 0
            {
                return 0;
            }
            return s.charCodeAt(0);
        }

        fn fromCharCode(code: Int64) -> String
        {
            return fromCharCode(code);
        }

        fn toUtf8(s: String) -> List<Int64>
        {
            var result: List<Int64> = [];
            var i: Int64 = 0;
            while i < s.len()
            {
                result.push(s.charCodeAt(i));
                i = i + 1;
            }
            return result;
        }

        fn fromUtf8(codes: List<Int64>) -> String
        {
            // tinoxBytesToString does the byte->char conversion in one
            // pass instead of `result = result + fromCharCode(...)` in a
            // loop, which is O(n^2) over the string length (issue #167).
            return tinoxBytesToString(codes);
        }

        fn htmlEncode(s: String) -> String
        {
            var result: String = s;
            result = result.replace("&", "&amp;");
            result = result.replace("<", "&lt;");
            result = result.replace(">", "&gt;");
            result = result.replace("\"", "&quot;");
            result = result.replace("'", "&#39;");
            return result;
        }

        fn htmlDecode(s: String) -> String
        {
            var result: String = s;
            result = result.replace("&amp;", "&");
            result = result.replace("&lt;", "<");
            result = result.replace("&gt;", ">");
            result = result.replace("&quot;", "\"");
            result = result.replace("&#39;", "'");
            return result;
        }
    }
}
module tinox.core.io;

namespace tinox.core.io
{
    /**
     * Path manipulation utilities for working with file paths
     */
    class Paths
    {
        /**
         * Extracts the file extension from a filename
         *
         * @param filename the filename (e.g., "file.txt")
         * @return the extension without the dot (e.g., "txt"), or empty string
         */
        fn getExtension(filename: String) -> String
        {
            var dotIndex: Int64 = filename.lastIndexOf(".");
            if dotIndex == -1
            {
                return "";
            }
            return filename.substring(dotIndex + 1, filename.len());
        }

        /**
         * Extracts the filename from a full path
         *
         * @param filePath the full path (e.g., "/path/to/file.txt")
         * @return the filename portion (e.g., "file.txt")
         */
        fn getFileName(filePath: String) -> String
        {
            var lastSlash: Int64 = filePath.lastIndexOf("/");
            if lastSlash == -1
            {
                return filePath;
            }
            return filePath.substring(lastSlash + 1, filePath.len());
        }

        /**
         * Extracts the directory portion from a full path
         *
         * @param filePath the full path (e.g., "/path/to/file.txt")
         * @return the directory portion (e.g., "/path/to"), or empty string
         */
        fn getDirectory(filePath: String) -> String
        {
            var lastSlash: Int64 = filePath.lastIndexOf("/");
            if lastSlash == -1
            {
                return "";
            }
            return filePath.substring(0, lastSlash);
        }

        /**
         * Joins a directory and filename with a path separator
         *
         * @param dir the directory path
         * @param file the filename
         * @return the combined path (e.g., "dir/file")
         */
        fn join(dir: String, file: String) -> String
        {
            return dir + "/" + file;
        }
    }
}

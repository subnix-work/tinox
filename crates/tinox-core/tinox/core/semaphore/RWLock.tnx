module tinox.core.semaphore;

namespace tinox.core.semaphore
{
    class RWLock
    {
        var readers: Int64;
        var writers: Int64;

        fn new() -> RWLock
        {
            return RWLock { readers: 0, writers: 0 };
        }

        fn readLock(lock: RWLock) -> Nothing
        {
            if lock.writers > 0
            {
                throw "Write lock held";
            }
            lock.readers = lock.readers + 1;
        }

        fn readUnlock(lock: RWLock) -> Nothing
        {
            lock.readers = lock.readers - 1;
        }

        fn writeLock(lock: RWLock) -> Nothing
        {
            lock.writers = lock.writers + 1;
        }

        fn writeUnlock(lock: RWLock) -> Nothing
        {
            lock.writers = lock.writers - 1;
        }
    }
}

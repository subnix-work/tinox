module tinox.core.semaphore;

namespace tinox.core.semaphore
{
    class Mutex
    {
        var locked: Bool;
        var queue: List<Int64>;

        fn new() -> Mutex
        {
            return Mutex { locked: false, queue: [] };
        }

        fn lock(mutex: Mutex) -> Nothing
        {
            if mutex.locked == false
            {
                mutex.locked = true;
                return;
            }
            throw "Mutex already locked";
        }

        fn unlock(mutex: Mutex) -> Nothing
        {
            mutex.locked = false;
        }

        fn tryLock(mutex: Mutex) -> Bool
        {
            if mutex.locked == false
            {
                mutex.locked = true;
                return true;
            }
            return false;
        }
    }
}

module tinox.core.semaphore;

namespace tinox.core.semaphore
{
    class Semaphore
    {
        var count: Int64;
        var waiting: List<Int64>;

        fn new(count: Int64) -> Semaphore
        {
            return Semaphore { count: count, waiting: [] };
        }

        fn acquire(sem: Semaphore) -> Nothing
        {
            if sem.count > 0
            {
                sem.count = sem.count - 1;
                return;
            }
            throw "Semaphore locked";
        }

        fn release(sem: Semaphore) -> Nothing
        {
            sem.count = sem.count + 1;
        }

        fn tryAcquire(sem: Semaphore) -> Bool
        {
            if sem.count > 0
            {
                sem.count = sem.count - 1;
                return true;
            }
            return false;
        }
    }
}

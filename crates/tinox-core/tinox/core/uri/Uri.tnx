module tinox.core.uri

namespace tinox.core.uri
{
    extern fn tinoxBytesToString(bytes: List<Int64>) -> String

    class Uri
    {
        fn isUnreserved(code: Int64) -> Bool
        {
            if (code >= 65 && code <= 90) { return true }  // A-Z
            if (code >= 97 && code <= 122) { return true } // a-z
            if (code >= 48 && code <= 57) { return true }  // 0-9
            if (code == 45 || code == 95 || code == 46 || code == 126) { return true } // - _ . ~
            return false
        }

        // Reserved/sub-delim characters left untouched by encode() (but not
        // encodeComponent()): ; , / ? : @ & = + $ #
        fn isReserved(code: Int64) -> Bool
        {
            if (code == 59 || code == 44 || code == 47 || code == 63 || code == 58
                || code == 64 || code == 38 || code == 61 || code == 43 || code == 36
                || code == 35)
            {
                return true
            }
            return false
        }

        fn hexDigit(n: Int64) -> String
        {
            if (n < 10)
            {
                return fromCharCode(n + 48)
            }
            return fromCharCode(n + 55)
        }

        fn percentEncodeByte(code: Int64) -> String
        {
            const hi: Int64 = (code >> 4) & 15
            const lo: Int64 = code & 15
            return "%" + Uri::hexDigit(hi) + Uri::hexDigit(lo)
        }

        @Throws(UriError)
        fn hexValue(c: String) -> Int64
        {
            const code: Int64 = c.charCodeAt(0)
            if (code >= 48 && code <= 57) { return code - 48 }
            if (code >= 65 && code <= 70) { return code - 55 }
            if (code >= 97 && code <= 102) { return code - 87 }
            throw UriError { message: "Uri: invalid hex digit '" + c + "' in percent-escape" }
        }

        fn encodeComponent(s: String) -> String
        {
            var result: String = ""
            var i: Int64 = 0
            const len: Int64 = s.len()
            while i < len
            {
                const code: Int64 = s.charCodeAt(i)
                if (Uri::isUnreserved(code))
                {
                    result = result + s.substring(i, i + 1)
                }
                else
                {
                    result = result + Uri::percentEncodeByte(code)
                }
                i = i + 1
            }
            return result
        }

        fn encode(s: String) -> String
        {
            var result: String = ""
            var i: Int64 = 0
            const len: Int64 = s.len()
            while i < len
            {
                const code: Int64 = s.charCodeAt(i)
                if (Uri::isUnreserved(code) || Uri::isReserved(code))
                {
                    result = result + s.substring(i, i + 1)
                }
                else
                {
                    result = result + Uri::percentEncodeByte(code)
                }
                i = i + 1
            }
            return result
        }

        @Throws(UriError)
        fn decodeComponent(s: String) -> String
        {
            // Collects bytes into a List<Int64> and converts in one pass
            // (tinoxBytesToString) instead of `result = result + ...` in
            // the loop, which is O(n^2) over the decoded length (issue #167).
            var bytes: List<Int64> = []
            var i: Int64 = 0
            const len: Int64 = s.len()
            while i < len
            {
                const c: String = s.substring(i, i + 1)
                if (c == "%")
                {
                    if (i + 2 >= len)
                    {
                        throw UriError { message: "Uri: truncated percent-escape" }
                    }
                    const hi: Int64 = Uri::hexValue(s.substring(i + 1, i + 2))
                    const lo: Int64 = Uri::hexValue(s.substring(i + 2, i + 3))
                    bytes.push((hi << 4) | lo)
                    i = i + 3
                }
                else
                {
                    bytes.push(c.charCodeAt(0))
                    i = i + 1
                }
            }
            return tinoxBytesToString(bytes)
        }

        @Throws(UriError)
        fn decode(s: String) -> String
        {
            // Collects bytes into a List<Int64> and converts in one pass
            // (tinoxBytesToString) instead of `result = result + ...` in
            // the loop, which is O(n^2) over the decoded length (issue #167).
            var bytes: List<Int64> = []
            var i: Int64 = 0
            const len: Int64 = s.len()
            while i < len
            {
                const c: String = s.substring(i, i + 1)
                if (c == "%")
                {
                    if (i + 2 >= len)
                    {
                        throw UriError { message: "Uri: truncated percent-escape" }
                    }
                    const hi: Int64 = Uri::hexValue(s.substring(i + 1, i + 2))
                    const lo: Int64 = Uri::hexValue(s.substring(i + 2, i + 3))
                    bytes.push((hi << 4) | lo)
                    i = i + 3
                }
                else
                {
                    bytes.push(c.charCodeAt(0))
                    i = i + 1
                }
            }
            return tinoxBytesToString(bytes)
        }

        fn parse(url: String) -> UriParts
        {
            const schemeEnd: Int64 = url.indexOf("://")
            if (schemeEnd == -1)
            {
                return UriParts { scheme: "", host: "", path: "", query: "", fragment: "" }
            }
            const remaining: String = url.substring(schemeEnd + 3, url.len())
            const pathStart: Int64 = remaining.indexOf("/")
            const queryStart: Int64 = remaining.indexOf("?")
            const fragmentStart: Int64 = remaining.indexOf("#")
            const parts: UriParts = UriParts { scheme: url.substring(0, schemeEnd), host: "", path: "", query: "", fragment: "" }
            if (pathStart == -1 && queryStart == -1 && fragmentStart == -1)
            {
                parts.host = remaining
            }
            else if (pathStart != -1 && (queryStart == -1 || pathStart < queryStart) && (fragmentStart == -1 || pathStart < fragmentStart))
            {
                Uri::splitAtPath(parts, remaining, pathStart, queryStart, fragmentStart)
            }
            else if (queryStart != -1 && (fragmentStart == -1 || queryStart < fragmentStart))
            {
                Uri::splitAtQuery(parts, remaining, queryStart, fragmentStart)
            }
            else if (fragmentStart != -1)
            {
                parts.host = remaining.substring(0, fragmentStart)
                parts.fragment = remaining.substring(fragmentStart + 1, remaining.len())
            }
            return parts
        }

        // Authority followed by a path: `host/path[?query][#fragment]`.
        fnc splitAtPath(parts: UriParts, remaining: String, pathStart: Int64, queryStart: Int64, fragmentStart: Int64)
        {
            parts.host = remaining.substring(0, pathStart)
            const remainingPath: String = remaining.substring(pathStart, remaining.len())
            if (fragmentStart != -1 && queryStart != -1 && fragmentStart < queryStart)
            {
                parts.path = remainingPath.substring(0, fragmentStart - pathStart)
                parts.fragment = remainingPath.substring(fragmentStart - pathStart + 1, remainingPath.len())
            }
            else if (queryStart != -1)
            {
                parts.path = remainingPath.substring(0, queryStart - pathStart)
                parts.query = remainingPath.substring(queryStart - pathStart + 1, remainingPath.len())
            }
            else
            {
                parts.path = remainingPath
            }
        }

        // Authority followed directly by a query: `host?query[#fragment]`.
        fnc splitAtQuery(parts: UriParts, remaining: String, queryStart: Int64, fragmentStart: Int64)
        {
            parts.host = remaining.substring(0, queryStart)
            parts.query = remaining.substring(queryStart + 1, fragmentStart)
            if (fragmentStart != -1)
            {
                parts.fragment = remaining.substring(fragmentStart + 1, remaining.len())
            }
        }
    }
}

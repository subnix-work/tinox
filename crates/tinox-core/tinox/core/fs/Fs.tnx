module tinox.core.fs

namespace tinox.core.fs
{
    extern fn fsMetadataChecked(path: String, listing: Int64) -> List<String>
    extern fn fsRenameChecked(from: String, to: String) -> String
    extern fn fsRemoveDirectoryChecked(path: String, recursive: Int64) -> String
    extern fn fsRealPathChecked(path: String) -> List<String>
    extern fn fsHomeDirectoryChecked() -> List<String>

    class Fs
    {
        fn readFile(path: String) -> String
        {
            return fileReadAllText(path)
        }

        fn writeFile(path: String, content: String) -> Nothing
        {
            let err: String = fileWriteAllTextChecked(path, content)
            if (err != "")
            {
                throw err
            }
        }

        fn appendFile(path: String, content: String) -> Nothing
        {
            fileAppendText(path, content)
        }

        fn deleteFile(path: String) -> Nothing
        {
            deleteFile(path)
        }

        fn copyFile(src: String, dest: String) -> Nothing
        {
            const content: String = Fs::readFile(src)
            Fs::writeFile(dest, content)
        }

        fn moveFile(src: String, dest: String) -> Nothing
        {
            Fs::copyFile(src, dest)
            Fs::deleteFile(src)
        }

        fn listDirectory(path: String) -> List<String>
        {
            return dirList(path)
        }

        fn createDirectory(path: String) -> Nothing
        {
            let err: String = dirCreateChecked(path)
            if (err != "")
            {
                throw err
            }
        }

        // Recursive, like `mkdir -p`; succeeds if the directory already exists.
        fn createDirectories(path: String) -> Nothing
        {
            let err: String = dirCreateAllChecked(path)
            if (err != "")
            {
                throw err
            }
        }

        fn deleteDirectory(path: String) -> Nothing
        {
            const err: String = fsRemoveDirectoryChecked(path, 0)
            if (err != "") { throw err }
        }
        // Metadata describes the entry itself, never the target of a symlink.
        // Only ENOENT/ENOTDIR are absence; all other failures throw.
        fn stat(path: String) -> FileInfo?
        {
            const data: List<String> = fsMetadataChecked(path, 0)
            if (data[0] != "") { throw data[0] }
            if (data.len() == 1) { return null }
            return Fs::decodeInfo(data, 1)
        }

        fn decodeInfo(data: List<String>, offset: Int64) -> FileInfo
        {
            return FileInfo { name: data[offset], kind: data[offset + 1],
                size: data[offset + 2].toInt(), modifiedNanoseconds: data[offset + 3].toInt(),
                permissions: data[offset + 4].toInt() }
        }

        fn isDirectory(path: String) -> Bool
        {
            const info: FileInfo? = Fs::stat(path)
            if (info == null) { return false }
            return (info as FileInfo).kind == "directory"
        }

        fn isFile(path: String) -> Bool
        {
            const info: FileInfo? = Fs::stat(path)
            if (info == null) { return false }
            return (info as FileInfo).kind == "file"
        }

        fn isSymlink(path: String) -> Bool
        {
            const info: FileInfo? = Fs::stat(path)
            if (info == null) { return false }
            return (info as FileInfo).kind == "symlink"
        }

        // One native batch; filesystem order, excluding dot and dot-dot.
        fn listEntries(path: String) -> List<FileInfo>
        {
            const data: List<String> = fsMetadataChecked(path, 1)
            if (data[0] != "") { throw data[0] }
            var entries: List<FileInfo> = []
            var i: Int64 = 1
            while (i < data.len())
            {
                entries.push(Fs::decodeInfo(data, i))
                i = i + 5
            }
            return entries
        }

        fn rename(from: String, to: String) -> Nothing
        {
            const err: String = fsRenameChecked(from, to)
            if (err != "") { throw err }
        }

        // Removes a directory tree or a symlink itself, never its target.
        fn deleteDirectoryRecursive(path: String) -> Nothing
        {
            const err: String = fsRemoveDirectoryChecked(path, 1)
            if (err != "") { throw err }
        }

        fn realPath(path: String) -> String
        {
            const result: List<String> = fsRealPathChecked(path)
            if (result[0] != "") { throw result[0] }
            return result[1]
        }

        fn homeDirectory() -> String
        {
            const result: List<String> = fsHomeDirectoryChecked()
            if (result[0] != "") { throw result[0] }
            return result[1]
        }
    }
}
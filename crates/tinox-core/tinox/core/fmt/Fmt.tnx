module tinox.core.fmt;

import tinox.core.format;

namespace tinox.core.fmt
{
    class Fmt
    {
        fn sprintf(format: String, args: List<String>) -> String
        {
            var result: String = "";
            var argIndex: Int64 = 0;
            var i: Int64 = 0;
            while i < format.len()
            {
                if format.substring(i, i + 1) == "%"
                {
                    if i + 1 >= format.len()
                    {
                        result = result + "%";
                        i = i + 1;
                        continue;
                    }
                    let spec: String = format.substring(i + 1, i + 2);
                    if spec == "%"
                    {
                        result = result + "%";
                    }
                    else if spec == "s"
                    {
                        if argIndex < args.len()
                        {
                            result = result + args[argIndex];
                            argIndex = argIndex + 1;
                        }
                    }
                    else if spec == "d"
                    {
                        if argIndex < args.len()
                        {
                            result = result + args[argIndex];
                            argIndex = argIndex + 1;
                        }
                    }
                    else if spec == "f"
                    {
                        if argIndex < args.len()
                        {
                            result = result + args[argIndex];
                            argIndex = argIndex + 1;
                        }
                    }
                    else if spec == "x"
                    {
                        if argIndex < args.len()
                        {
                            result = result + Format::intToHex((Int64)args[argIndex]);
                            argIndex = argIndex + 1;
                        }
                    }
                    else if spec == "b"
                    {
                        if argIndex < args.len()
                        {
                            result = result + Format::intToBinary((Int64)args[argIndex]);
                            argIndex = argIndex + 1;
                        }
                    }
                    else
                    {
                        result = result + spec;
                    }
                    i = i + 2;
                }
                else
                {
                    result = result + format.substring(i, i + 1);
                    i = i + 1;
                }
            }
            return result;
        }

        fn printf(format: String, args: List<String>) -> Nothing
        {
            print(Fmt::sprintf(format, args));
        }

        fn printlnf(format: String, args: List<String>) -> Nothing
        {
            println(Fmt::sprintf(format, args));
        }
    }
}
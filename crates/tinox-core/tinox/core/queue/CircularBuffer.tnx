module tinox.core.queue;

namespace tinox.core.queue
{
    class CircularBuffer<T>
    {
        var data: List<T>;
        var size: Int64;
        var head: Int64;
        var tail: Int64;
        var count: Int64;

        fn new(size: Int64) -> CircularBuffer<T>
        {
            return CircularBuffer<T> { data: [], size: size, head: 0, tail: 0, count: 0 };
        }

        fn push(buf: CircularBuffer<T>, item: T) -> Bool
        {
            if buf.count >= buf.size
            {
                return false;
            }
            buf.data.push(item);
            buf.count = buf.count + 1;
            return true;
        }

        fn pop(buf: CircularBuffer<T>) -> T
        {
            if buf.count == 0
            {
                throw "Buffer is empty";
            }
            let item: T = buf.data[0];
            buf.data.removeAt(0);
            buf.count = buf.count - 1;
            return item;
        }

        fn isFull(buf: CircularBuffer<T>) -> Bool
        {
            return buf.count >= buf.size;
        }

        fn isEmpty(buf: CircularBuffer<T>) -> Bool
        {
            return buf.count == 0;
        }
    }
}

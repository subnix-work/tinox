module tinox.core.random;

namespace tinox.core.random
{
    class Random
    {
        fn nextInt(max: Int64) -> Int64
        {
            return randomInt(0, max);
        }

        fn nextFloat() -> Float64
        {
            return randomFloat();
        }

        fn nextBool() -> Bool
        {
            return randomInt(0, 2) == 1;
        }

        fn pickOne<T>(list: List<T>) -> T
        {
            let index: Int64 = Random::nextInt(list.len());
            return list[index];
        }

        fn shuffle<T>(list: List<T>) -> List<T>
        {
            var result: List<T> = list;
            var i: Int64 = result.len() - 1;
            while i > 0
            {
                let j: Int64 = Random::nextInt(i + 1);
                let temp: T = result[i];
                result[i] = result[j];
                result[j] = temp;
                i = i - 1;
            }
            return result;
        }

        fn sample<T>(list: List<T>, count: Int64) -> List<T>
        {
            var result: List<T> = [];
            let shuffled: List<T> = Random::shuffle(list);
            var i: Int64 = 0;
            while i < count && i < shuffled.len()
            {
                result.push(shuffled[i]);
                i = i + 1;
            }
            return result;
        }

        fn generateString(length: Int64) -> String
        {
            let chars: String = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
            var result: String = "";
            var i: Int64 = 0;
            while i < length
            {
                let index: Int64 = Random::nextInt(chars.len());
                result = result + chars.substring(index, index + 1);
                i = i + 1;
            }
            return result;
        }
    }
}
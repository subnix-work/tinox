module tinox.core.cache;

import tinox.core.option;

namespace tinox.core.cache
{
    class Cache<K, V>
    {
        var data: Map<K, V>;
        var maxSize: Int64;
        var accessOrder: List<K>;

        fn new(maxSize: Int64) -> Cache<K, V>
        {
            return Cache<K, V> { data: Map::new(), maxSize: maxSize, accessOrder: [] };
        }

        fn get(cache: Cache<K, V>, key: K) -> Option<V>
        {
            if cache.data.contains(key)
            {
                let value: V = cache.data[key];
                Cache::touch(cache, key);
                return Option::some(value);
            }
            return Option::none();
        }

        fn set(cache: Cache<K, V>, key: K, value: V) -> Nothing
        {
            if cache.data.contains(key)
            {
                cache.data[key] = value;
                Cache::touch(cache, key);
                return;
            }
            if cache.data.len() >= cache.maxSize
            {
                let oldestKey: K = cache.accessOrder[0];
                cache.data.remove(oldestKey);
                cache.accessOrder.removeAt(0);
            }
            cache.data[key] = value;
            cache.accessOrder.push(key);
        }

        fn remove(cache: Cache<K, V>, key: K) -> Bool
        {
            if cache.data.contains(key) == false
            {
                return false;
            }
            cache.data.remove(key);
            var i: Int64 = 0;
            while i < cache.accessOrder.len()
            {
                if cache.accessOrder[i] == key
                {
                    cache.accessOrder.removeAt(i);
                    break;
                }
                i = i + 1;
            }
            return true;
        }

        fn clear(cache: Cache<K, V>) -> Nothing
        {
            cache.data = Map::new();
            cache.accessOrder = [];
        }

        fn touch(cache: Cache<K, V>, key: K) -> Nothing
        {
            var i: Int64 = 0;
            while i < cache.accessOrder.len()
            {
                if cache.accessOrder[i] == key
                {
                    cache.accessOrder.removeAt(i);
                    break;
                }
                i = i + 1;
            }
            cache.accessOrder.push(key);
        }
    }
}

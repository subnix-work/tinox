module tinox.core.bytes;

namespace tinox.core.bytes
{
    extern fn tinoxBufNew(len: Int64) -> Int64;
    extern fn tinoxBufLen(h: Int64) -> Int64;
    extern fn tinoxBufGet(h: Int64, i: Int64) -> Int64;
    extern fn tinoxBufSet(h: Int64, i: Int64, v: Int64);
    extern fn tinoxBufSlice(h: Int64, start: Int64, end: Int64) -> Int64;
    extern fn tinoxBufConcat(a: Int64, b: Int64) -> Int64;
    extern fn tinoxBufEquals(a: Int64, b: Int64) -> Bool;
    extern fn tinoxBufFromString(s: String) -> Int64;
    extern fn tinoxBufToString(h: Int64) -> String;
    extern fn tinoxBufFromList(l: List<Int64>) -> Int64;
    extern fn tinoxBufToList(h: Int64) -> List<Int64>;
    extern fn tinoxBufReadFile(path: String) -> Int64;
    extern fn tinoxBufWriteFile(path: String, h: Int64);
    extern fn tinoxBufStdinReadAll() -> Int64;
    extern fn tinoxBufFromRequestBody(body: String) -> Int64;
    extern fn tinoxBufAsResponseBody(h: Int64) -> String;
    extern fn httpConnReadBuf(conn: Int64, n: Int64) -> Int64;
    extern fn httpConnWriteBuf(conn: Int64, h: Int64) -> Int64;

    /**
     * A compact, fixed-length byte buffer: one heap byte per logical byte
     * (List<Int64> needs eight). Any byte value 0..255 -- including 0x00 --
     * is ordinary payload.
     *
     * Ownership/mutability: a Bytes owns its payload; set() mutates in
     * place and aliases (copies of the reference) see the change. The
     * length never changes. slice()/concat() always return a NEW buffer
     * (copy, no shared views). Every out-of-range index, slice, or byte
     * value is a hard runtime error, never a clamp or a silent wrap.
     */
    class Bytes
    {
        /** Opaque runtime handle to the pointer-free payload block */
        var handle: Int64;

        /** Creates a zero-filled buffer of the given length */
        fn new(len: Int64) -> Bytes
        {
            return Bytes { handle: tinoxBufNew(len) };
        }

        /** Copies the characters of a String (UTF-8) into a buffer */
        fn fromText(s: String) -> Bytes
        {
            return Bytes { handle: tinoxBufFromString(s) };
        }

        /** Adapter from the legacy List<Int64> (each element must be 0..255) */
        fn fromList(l: List<Int64>) -> Bytes
        {
            return Bytes { handle: tinoxBufFromList(l) };
        }

        /** Reads a whole file byte-exactly, straight into the compact payload */
        fn readFile(path: String) -> Bytes
        {
            return Bytes { handle: tinoxBufReadFile(path) };
        }

        /** Reads all of stdin byte-exactly */
        fn readStdin() -> Bytes
        {
            return Bytes { handle: tinoxBufStdinReadAll() };
        }

        /**
         * Reads exactly n bytes from a connection. A result shorter than n
         * means EOF/error midway: callers MUST check len().
         */
        fn readFromConn(conn: Int64, n: Int64) -> Bytes
        {
            return Bytes { handle: httpConnReadBuf(conn, n) };
        }

        /**
         * Copies the exact payload of the HTTP request currently being handled
         * (pass ctx.request.body). Embedded NUL bytes survive. Hard error when
         * the argument is not the live request body or outside a handler.
         */
        fn fromRequestBody(body: String) -> Bytes
        {
            return Bytes { handle: tinoxBufFromRequestBody(body) };
        }

        /**
         * A response body (assign to ctx.response.body) carrying exactly this
         * buffer, embedded NUL bytes included. Supported by the plain HTTP/1.1
         * server; the buffer must stay unmodified until the handler returns.
         */
        fn asResponseBody() -> String
        {
            return tinoxBufAsResponseBody(this.handle);
        }

        /** Number of bytes */
        fn len() -> Int64
        {
            return tinoxBufLen(this.handle);
        }

        /** Byte at index i as 0..255 (hard error when out of bounds) */
        fn get(i: Int64) -> Int64
        {
            return tinoxBufGet(this.handle, i);
        }

        /** Stores v (0..255) at index i (hard error when out of range) */
        fn set(i: Int64, v: Int64) -> Nothing
        {
            tinoxBufSet(this.handle, i, v);
        }

        /** Copy of the bytes in [start, end) */
        fn slice(start: Int64, end: Int64) -> Bytes
        {
            return Bytes { handle: tinoxBufSlice(this.handle, start, end) };
        }

        /** New buffer holding this buffer's bytes followed by other's */
        fn concat(other: Bytes) -> Bytes
        {
            return Bytes { handle: tinoxBufConcat(this.handle, other.handle) };
        }

        /** True when both buffers have identical length and content */
        fn equals(other: Bytes) -> Bool
        {
            return tinoxBufEquals(this.handle, other.handle);
        }

        /**
         * Converts to a String. A String cannot hold an embedded NUL, so a
         * buffer containing 0x00 is a hard error, never a truncation.
         */
        fn toText() -> String
        {
            return tinoxBufToString(this.handle);
        }

        /** Adapter to the legacy List<Int64> (8x the memory) */
        fn toList() -> List<Int64>
        {
            return tinoxBufToList(this.handle);
        }

        /** Writes the buffer to a file byte-exactly */
        fn writeFile(path: String) -> Nothing
        {
            tinoxBufWriteFile(path, this.handle);
        }

        /** Writes the whole buffer to a connection; returns bytes written (-1 = invalid conn) */
        fn writeToConn(conn: Int64) -> Int64
        {
            return httpConnWriteBuf(conn, this.handle);
        }
    }
}

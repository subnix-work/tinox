module tinox.core.iter;

import tinox.core.collections;

namespace tinox.core.iter
{
    class Iter
    {
        fn range(start: Int64, end: Int64) -> Iterator
        {
            return Iterator { current: start, end: end, step: 1, data: [], cycled: false };
        }

        fn rangeStep(start: Int64, end: Int64, step: Int64) -> Iterator
        {
            return Iterator { current: start, end: end, step: step, data: [], cycled: false };
        }

        fn repeat<T>(value: T, count: Int64) -> List<T>
        {
            var result: List<T> = [];
            var i: Int64 = 0;
            while i < count
            {
                result.push(value);
                i = i + 1;
            }
            return result;
        }

        fn cycle<T>(list: List<T>) -> Iterator
        {
            return Iterator { current: 0, end: list.len(), step: 1, data: list, cycled: true };
        }

        fn enumerate<T>(list: List<T>) -> List<Pair<Int64, T>>
        {
            var result: List<Pair<Int64, T>> = [];
            var i: Int64 = 0;
            while i < list.len()
            {
                result.push(Pair::new(i, list[i]));
                i = i + 1;
            }
            return result;
        }

        fn zip<T, U>(a: List<T>, b: List<U>) -> List<Pair<T, U>>
        {
            let len: Int64 = (a.len() < b.len()) ? a.len() : b.len();
            var result: List<Pair<T, U>> = [];
            var i: Int64 = 0;
            while i < len
            {
                result.push(Pair::new(a[i], b[i]));
                i = i + 1;
            }
            return result;
        }

        fn map<T, U>(list: List<T>, transform: fnc(T) -> U) -> List<U>
        {
            var result: List<U> = [];
            var i: Int64 = 0;
            while i < list.len()
            {
                result.push(transform(list[i]));
                i = i + 1;
            }
            return result;
        }

        fn filter<T>(list: List<T>, predicate: fnc(T) -> Bool) -> List<T>
        {
            var result: List<T> = [];
            var i: Int64 = 0;
            while i < list.len()
            {
                if predicate(list[i])
                {
                    result.push(list[i]);
                }
                i = i + 1;
            }
            return result;
        }

        fn reduce<T, U>(list: List<T>, initial: U, combiner: fnc(U, T) -> U) -> U
        {
            var result: U = initial;
            var i: Int64 = 0;
            while i < list.len()
            {
                result = combiner(result, list[i]);
                i = i + 1;
            }
            return result;
        }
    }
}

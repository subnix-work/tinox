module tinox.core.iter;

namespace tinox.core.iter
{
    class Iterator
    {
        current: Int64;
        end: Int64;
        step: Int64;
        data: List<Int64>;
        cycled: Bool;

        fn hasNext() -> Bool
        {
            if this.cycled
            {
                return true;
            }
            return this.current < this.end;
        }

        fn next() -> Int64
        {
            if this.cycled
            {
                let idx: Int64 = this.current % this.end;
                this.current = this.current + 1;
                return this.data[idx];
            }
            let result: Int64 = this.current;
            this.current = this.current + this.step;
            return result;
        }
    }
}

module tinox.core.base64;

namespace tinox.core.base64
{
    extern fn tinoxBytesToString(bytes: List<Int64>) -> String;

    class Base64
    {
        fn encode(data: String) -> String
        {
            let alphabet: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
            var result: String = "";
            var i: Int64 = 0;
            let len: Int64 = data.len();
            while i < len
            {
                let b0: Int64 = data.charCodeAt(i);
                let hasB1: Bool = i + 1 < len;
                let b1: Int64 = hasB1 ? data.charCodeAt(i + 1) : 0;
                let hasB2: Bool = i + 2 < len;
                let b2: Int64 = hasB2 ? data.charCodeAt(i + 2) : 0;

                let c0: Int64 = (b0 >> 2) & 63;
                let c1: Int64 = ((b0 << 4) | (b1 >> 4)) & 63;
                let c2: Int64 = ((b1 << 2) | (b2 >> 6)) & 63;
                let c3: Int64 = b2 & 63;

                result = result + alphabet.substring(c0, c0 + 1) + alphabet.substring(c1, c1 + 1);
                if hasB1
                {
                    result = result + alphabet.substring(c2, c2 + 1);
                }
                else
                {
                    result = result + "=";
                }
                if hasB2
                {
                    result = result + alphabet.substring(c3, c3 + 1);
                }
                else
                {
                    result = result + "=";
                }

                i = i + 3;
            }
            return result;
        }

        fn decode(encoded: String) -> String
        {
            // Delegates to decodeBytes() + tinoxBytesToString (one-pass
            // byte->char conversion) instead of building the result via
            // `result = result + fromCharCode(...)` in the loop, which is
            // O(n^2) over the decoded length (issue #167). decodeBytes()
            // already avoided this pattern.
            return tinoxBytesToString(Base64::decodeBytes(encoded));
        }

        fn charToValue(c: String) -> Int64
        {
            if c == "="
            {
                return 0;
            }
            let code: Int64 = c.charCodeAt(0);
            if code >= 65 && code <= 90
            {
                return code - 65;
            }
            if code >= 97 && code <= 122
            {
                return code - 97 + 26;
            }
            if code >= 48 && code <= 57
            {
                return code - 48 + 52;
            }
            if code == 43
            {
                return 62;
            }
            if code == 47
            {
                return 63;
            }
            return 0;
        }

        // A standalone byte-array variant of encode() instead of an
        // encode(rawString) delegate: the earlier implementation first
        // built a Tinox string from the bytes (raw + fromCharCode(b))
        // and then called encode(raw) — a Tinox string is internally a
        // C string, so any 0 byte in the input data would wrongly
        // shorten raw.len() (strlen-based) and SILENTLY truncate the
        // rest of the bytes. For real random bytes (e.g. a 32-byte HMAC
        // digest, issue 77 SCRAM), this isn't a theoretical edge case:
        // ~11.6% probability per call that at least one 0 byte occurs —
        // found via a 1-in-20 flake in a SCRAM e2e test, not by
        // inspection.
        fn encodeBytes(data: List<Int64>) -> String
        {
            let alphabet: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
            var result: String = "";
            var i: Int64 = 0;
            let len: Int64 = data.len();
            while i < len
            {
                let b0: Int64 = data[i];
                let hasB1: Bool = i + 1 < len;
                let b1: Int64 = hasB1 ? data[i + 1] : 0;
                let hasB2: Bool = i + 2 < len;
                let b2: Int64 = hasB2 ? data[i + 2] : 0;

                let c0: Int64 = (b0 >> 2) & 63;
                let c1: Int64 = ((b0 << 4) | (b1 >> 4)) & 63;
                let c2: Int64 = ((b1 << 2) | (b2 >> 6)) & 63;
                let c3: Int64 = b2 & 63;

                result = result + alphabet.substring(c0, c0 + 1) + alphabet.substring(c1, c1 + 1);
                if hasB1
                {
                    result = result + alphabet.substring(c2, c2 + 1);
                }
                else
                {
                    result = result + "=";
                }
                if hasB2
                {
                    result = result + alphabet.substring(c3, c3 + 1);
                }
                else
                {
                    result = result + "=";
                }

                i = i + 3;
            }
            return result;
        }

        // base64url (RFC 4648 §5, PADDING STRIPPED) instead of the
        // standard alphabet — issue #131 (OAuth2 PKCE `code_challenge`,
        // RFC 7636 §4.2 explicitly requires "Base64 URL Encoding without
        // padding"). `+`/`/` aren't safe in a URL query (would otherwise
        // need percent-encoding), `-`/`_` are; the `=` padding is
        // redundant anyway for a fixed input length (here: a SHA-256
        // digest, always 32 bytes) and per spec is to be removed, not
        // just optional.
        fn encodeUrlBytes(data: List<Int64>) -> String
        {
            let alphabet: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
            var result: String = "";
            var i: Int64 = 0;
            let len: Int64 = data.len();
            while i < len
            {
                let b0: Int64 = data[i];
                let hasB1: Bool = i + 1 < len;
                let b1: Int64 = hasB1 ? data[i + 1] : 0;
                let hasB2: Bool = i + 2 < len;
                let b2: Int64 = hasB2 ? data[i + 2] : 0;

                let c0: Int64 = (b0 >> 2) & 63;
                let c1: Int64 = ((b0 << 4) | (b1 >> 4)) & 63;
                let c2: Int64 = ((b1 << 2) | (b2 >> 6)) & 63;
                let c3: Int64 = b2 & 63;

                result = result + alphabet.substring(c0, c0 + 1) + alphabet.substring(c1, c1 + 1);
                if hasB1
                {
                    result = result + alphabet.substring(c2, c2 + 1);
                }
                if hasB2
                {
                    result = result + alphabet.substring(c3, c3 + 1);
                }

                i = i + 3;
            }
            return result;
        }

        // Like decode(), but returns the raw bytes as List<Int64> instead
        // of materializing them into a Tinox string — decode() appends
        // decoded 0 bytes internally via fromCharCode(), which would
        // silently truncate a C-string-based Tinox string at the first
        // 0 byte. For real binary data (e.g. SCRAM salts/digests, issue
        // 77), this variant is therefore the only safe one.
        fn decodeBytes(encoded: String) -> List<Int64>
        {
            var result: List<Int64> = [];
            var i: Int64 = 0;
            let len: Int64 = encoded.len();
            while i + 4 <= len
            {
                let c0: String = encoded.substring(i, i + 1);
                let c1: String = encoded.substring(i + 1, i + 2);
                let c2: String = encoded.substring(i + 2, i + 3);
                let c3: String = encoded.substring(i + 3, i + 4);

                let v0: Int64 = Base64::charToValue(c0);
                let v1: Int64 = Base64::charToValue(c1);
                let v2: Int64 = Base64::charToValue(c2);
                let v3: Int64 = Base64::charToValue(c3);

                let b0: Int64 = ((v0 << 2) | (v1 >> 4)) & 255;
                result.push(b0);

                if c2 != "="
                {
                    let b1: Int64 = ((v1 << 4) | (v2 >> 2)) & 255;
                    result.push(b1);
                }
                if c3 != "="
                {
                    let b2: Int64 = ((v2 << 6) | v3) & 255;
                    result.push(b2);
                }

                i = i + 4;
            }
            return result;
        }

        fn urlCharToValue(c: String) -> Int64
        {
            let code: Int64 = c.charCodeAt(0);
            if code >= 65 && code <= 90
            {
                return code - 65;
            }
            if code >= 97 && code <= 122
            {
                return code - 97 + 26;
            }
            if code >= 48 && code <= 57
            {
                return code - 48 + 52;
            }
            if code == 45
            {
                return 62;
            }
            if code == 95
            {
                return 63;
            }
            return 0;
        }

        // base64url decode (RFC 4648 §5, NO padding expected) — issue #138
        // (JWT header/payload/signature segments per RFC 7515 §3, and JWKS
        // "n"/"e" RSA key fields per RFC 7517 §9.3, are all unpadded
        // base64url). Unlike decodeBytes()'s standard-alphabet '='-driven
        // truncation, an unpadded input's last group's length (0, 2 or 3
        // extra characters beyond full 4-char quads) IS the only signal for
        // how many trailing bytes that group holds.
        fn decodeUrlBytes(encoded: String) -> List<Int64>
        {
            var result: List<Int64> = [];
            var i: Int64 = 0;
            let len: Int64 = encoded.len();
            while i + 4 <= len
            {
                let v0: Int64 = Base64::urlCharToValue(encoded.substring(i, i + 1));
                let v1: Int64 = Base64::urlCharToValue(encoded.substring(i + 1, i + 2));
                let v2: Int64 = Base64::urlCharToValue(encoded.substring(i + 2, i + 3));
                let v3: Int64 = Base64::urlCharToValue(encoded.substring(i + 3, i + 4));

                result.push(((v0 << 2) | (v1 >> 4)) & 255);
                result.push(((v1 << 4) | (v2 >> 2)) & 255);
                result.push(((v2 << 6) | v3) & 255);

                i = i + 4;
            }
            let remaining: Int64 = len - i;
            if remaining == 2
            {
                let v0: Int64 = Base64::urlCharToValue(encoded.substring(i, i + 1));
                let v1: Int64 = Base64::urlCharToValue(encoded.substring(i + 1, i + 2));
                result.push(((v0 << 2) | (v1 >> 4)) & 255);
            }
            else if remaining == 3
            {
                let v0: Int64 = Base64::urlCharToValue(encoded.substring(i, i + 1));
                let v1: Int64 = Base64::urlCharToValue(encoded.substring(i + 1, i + 2));
                let v2: Int64 = Base64::urlCharToValue(encoded.substring(i + 2, i + 3));
                result.push(((v0 << 2) | (v1 >> 4)) & 255);
                result.push(((v1 << 4) | (v2 >> 2)) & 255);
            }
            return result;
        }
    }
}

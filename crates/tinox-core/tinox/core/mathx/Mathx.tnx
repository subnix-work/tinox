module tinox.core.mathx;

namespace tinox.core.mathx
{
    class Mathx
    {
        fn gcd(a: Int64, b: Int64) -> Int64
        {
            var x: Int64 = a;
            var y: Int64 = b;
            while y != 0
            {
                let t: Int64 = y;
                y = x % y;
                x = t;
            }
            return x;
        }

        fn lcm(a: Int64, b: Int64) -> Int64
        {
            return (a * b) / Mathx::gcd(a, b);
        }

        fn isPrime(n: Int64) -> Bool
        {
            if n < 2
            {
                return false;
            }
            if n == 2
            {
                return true;
            }
            if n % 2 == 0
            {
                return false;
            }
            var i: Int64 = 3;
            while i * i <= n
            {
                if n % i == 0
                {
                    return false;
                }
                i = i + 2;
            }
            return true;
        }

        fn nextPrime(n: Int64) -> Int64
        {
            var candidate: Int64 = n;
            if candidate < 2
            {
                candidate = 2;
            }
            while Mathx::isPrime(candidate) == false
            {
                candidate = candidate + 1;
            }
            return candidate;
        }

        fn fibonacci(n: Int64) -> Int64
        {
            if n <= 1
            {
                return n;
            }
            var a: Int64 = 0;
            var b: Int64 = 1;
            var i: Int64 = 2;
            while i <= n
            {
                let temp: Int64 = b;
                b = a + b;
                a = temp;
                i = i + 1;
            }
            return b;
        }

        fn combinations(n: Int64, k: Int64) -> Int64
        {
            if k > n
            {
                return 0;
            }
            if k == 0 || k == n
            {
                return 1;
            }
            return Mathx::factorial(n) / (Mathx::factorial(k) * Mathx::factorial(n - k));
        }

        fn permutations(n: Int64, k: Int64) -> Int64
        {
            if k > n
            {
                return 0;
            }
            return Mathx::factorial(n) / Mathx::factorial(n - k);
        }

        fn factorial(n: Int64) -> Int64
        {
            if n <= 1
            {
                return 1;
            }
            var result: Int64 = 1;
            var i: Int64 = 2;
            while i <= n
            {
                result = result * i;
                i = i + 1;
            }
            return result;
        }

        fn modPow(base: Int64, exp: Int64, mod: Int64) -> Int64
        {
            var result: Int64 = 1;
            var b: Int64 = base;
            var e: Int64 = exp;
            while e > 0
            {
                if e % 2 == 1
                {
                    result = (result * b) % mod;
                }
                b = (b * b) % mod;
                e = e >> 1;
            }
            return result;
        }

        fn digitSum(n: Int64) -> Int64
        {
            var sum: Int64 = 0;
            var value: Int64 = n;
            if value < 0
            {
                value = -value;
            }
            while value > 0
            {
                sum = sum + (value % 10);
                value = value / 10;
            }
            return sum;
        }

        fn digitCount(n: Int64) -> Int64
        {
            if n == 0
            {
                return 1;
            }
            var count: Int64 = 0;
            var value: Int64 = n;
            if value < 0
            {
                value = -value;
            }
            while value > 0
            {
                count = count + 1;
                value = value / 10;
            }
            return count;
        }
    }
}
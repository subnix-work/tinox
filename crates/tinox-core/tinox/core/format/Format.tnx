module tinox.core.format;

namespace tinox.core.format
{
    class Format
    {
        fn padLeft(s: String, width: Int64, char: String) -> String
        {
            let len: Int64 = s.len();
            if width <= len
            {
                return s;
            }
            let padLen: Int64 = width - len;
            var padding: String = "";
            var i: Int64 = 0;
            while i < padLen
            {
                padding = padding + char;
                i = i + 1;
            }
            return padding + s;
        }

        fn padRight(s: String, width: Int64, char: String) -> String
        {
            let len: Int64 = s.len();
            if width <= len
            {
                return s;
            }
            let padLen: Int64 = width - len;
            var padding: String = "";
            var i: Int64 = 0;
            while i < padLen
            {
                padding = padding + char;
                i = i + 1;
            }
            return s + padding;
        }

        fn intToBinary(n: Int64) -> String
        {
            if n == 0
            {
                return "0";
            }
            var result: String = "";
            var value: Int64 = n;
            while value > 0
            {
                if (value & 1) == 1
                {
                    result = "1" + result;
                }
                else
                {
                    result = "0" + result;
                }
                value = value >> 1;
            }
            return result;
        }

        fn intToHex(n: Int64) -> String
        {
            if n == 0
            {
                return "0";
            }
            var result: String = "";
            var value: Int64 = n;
            let digits: String = "0123456789abcdef";
            while value > 0
            {
                let digit: Int64 = value & 15;
                result = digits.substring(digit, digit + 1) + result;
                value = value >> 4;
            }
            return result;
        }

        fn formatInt(n: Int64, width: Int64) -> String
        {
            return Format::padLeft(n.toString(), width, " ");
        }
    }
}
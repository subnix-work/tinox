module tinox.core.math;

namespace tinox.core.math
{
        /**
     * Math helper class with common mathematical operations
     * including constants, arithmetic, power functions, and random number generation
     */
    class Math
    {
        /**
         * Returns the value of pi (3.14159...)
         * @return the mathematical constant pi
         */
        fn pi() -> Float64
        {
            return 3.14159265358979;
        }

        /**
         * Returns Euler's number (2.71828...)
         * @return the mathematical constant e
         */
        fn e() -> Float64
        {
            return 2.71828182845904;
        }

        /**
         * Returns tau (2 * pi = 6.28318...)
         * @return the mathematical constant tau
         */
        fn tau() -> Float64
        {
            return 6.28318530717958;
        }

        /**
         * Returns the absolute value of x
         * @param x the input value
         * @return the absolute value (always non-negative)
         */
        fn abs(x: Int64) -> Int64
        {
            if x < 0
            {
                return -x;
            }
            return x;
        }

        /**
         * Returns the smaller of two values
         * @param a the first value
         * @param b the second value
         * @return a if a < b, otherwise b
         */
        fn min(a: Int64, b: Int64) -> Int64
        {
            if a < b
            {
                return a;
            }
            return b;
        }

        /**
         * Returns the larger of two values
         * @param a the first value
         * @param b the second value
         * @return a if a > b, otherwise b
         */
        fn max(a: Int64, b: Int64) -> Int64
        {
            if a > b
            {
                return a;
            }
            return b;
        }

        /**
         * Returns x squared (x * x)
         * @param x the input value
         * @return x multiplied by itself
         */
        fn square(x: Int64) -> Int64
        {
            return x * x;
        }

        /**
         * Returns base raised to the power of exp
         * @param base the base value
         * @param exp the exponent (must be non-negative)
         * @return base raised to the power of exp
         */
        fn pow(base: Int64, exp: Int64) -> Int64
        {
            var result: Int64 = 1;
            var i: Int64 = 0;
            while i < exp
            {
                result = result * base;
                i = i + 1;
            }
            return result;
        }

        /**
         * Returns the factorial of n (n!)
         * Computes n * (n-1) * ... * 2 * 1 recursively.
         * For n <= 1, returns 1.
         * @param n the input value (must be non-negative)
         * @return n factorial
         */
        fn factorial(n: Int64) -> Int64
        {
            if n <= 1
            {
                return 1;
            }
            var result: Int64 = 1;
            for i in 2..(n+1)
            {
                result = result * i;
            }
            return result;
        }

        /**
         * Generates a pseudo-random number from a seed
         * Uses a linear congruential generator (LCG) algorithm.
         * The same seed always produces the same result.
         * @param seed the seed value
         * @return a pseudo-random integer
         */
        fn randomSeed(seed: Int64) -> Int64
        {
            return (seed * 1103515245 + 12345) & 2147483647;
        }
    }
}

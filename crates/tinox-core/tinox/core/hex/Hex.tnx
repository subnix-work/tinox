module tinox.core.hex;

namespace tinox.core.hex
{
    extern fn tinoxBytesToString(bytes: List<Int64>) -> String;

    class Hex
    {
        fn encode(data: String) -> String
        {
            var result: String = "";
            var i: Int64 = 0;
            while i < data.len()
            {
                let byte: Int64 = data.charCodeAt(i);
                let high: Int64 = (byte >> 4) & 15;
                let low: Int64 = byte & 15;
                result = result + Hex::nibbleToChar(high) + Hex::nibbleToChar(low);
                i = i + 1;
            }
            return result;
        }

        fn decode(hex: String) -> String
        {
            // Delegates to decodeBytes() + tinoxBytesToString (one-pass
            // byte->char conversion) instead of `result = result +
            // fromCharCode(...)` in the loop, which is O(n^2) over the
            // decoded length (issue #167).
            return tinoxBytesToString(Hex::decodeBytes(hex));
        }

        // Like decode(), but returns the raw bytes as List<Int64> instead
        // of materializing them into a Tinox string (issue #131: OAuth2
        // PKCE needs the raw 32 bytes of a SHA-256 digest for base64url,
        // not their hex text). Same reason as Base64::decodeBytes: a
        // Tinox string is internally a C string (strlen-based) — a
        // digest with an embedded 0 byte (not uncommon among 32 random
        // bytes, see Base64::encodeBytes' comment about the exact same
        // finding) would be silently truncated at the first 0 byte via
        // decode()+fromCharCode.
        fn decodeBytes(hex: String) -> List<Int64>
        {
            var result: List<Int64> = [];
            var i: Int64 = 0;
            while i < hex.len()
            {
                let high: Int64 = Hex::charToNibble(hex.substring(i, i + 1));
                let low: Int64 = Hex::charToNibble(hex.substring(i + 1, i + 2));
                result.push((high << 4) | low);
                i = i + 2;
            }
            return result;
        }

        fn nibbleToChar(n: Int64) -> String
        {
            if n < 10
            {
                return fromCharCode(n + 48);
            }
            return fromCharCode(n + 87);
        }

        fn charToNibble(c: String) -> Int64
        {
            let code: Int64 = c.charCodeAt(0);
            if code >= 48 && code <= 57
            {
                return code - 48;
            }
            if code >= 97 && code <= 102
            {
                return code - 87;
            }
            if code >= 65 && code <= 70
            {
                return code - 55;
            }
            return 0;
        }

        fn dump(data: String) -> String
        {
            var result: String = "";
            var i: Int64 = 0;
            while i < data.len()
            {
                if i > 0
                {
                    result = result + " ";
                }
                let byte: Int64 = data.charCodeAt(i);
                result = result + Hex::encode(data.substring(i, i + 1));
                i = i + 1;
            }
            return result;
        }
    }
}
module tinox.core.trie;

namespace tinox.core.trie
{
    class Trie
    {
        var root: TrieNode;

        fn new() -> Trie
        {
            return Trie { root: TrieNode::new() };
        }

        fn insert(trie: Trie, word: String) -> Nothing
        {
            var current: TrieNode = trie.root;
            var i: Int64 = 0;
            while i < word.len()
            {
                let c: String = word.substring(i, i + 1);
                if current.children.contains(c) == false
                {
                    current.children[c] = TrieNode::new();
                }
                current = current.children[c];
                i = i + 1;
            }
            current.isEnd = true;
        }

        fn search(trie: Trie, word: String) -> Bool
        {
            var current: TrieNode = trie.root;
            var i: Int64 = 0;
            while i < word.len()
            {
                let c: String = word.substring(i, i + 1);
                if current.children.contains(c) == false
                {
                    return false;
                }
                current = current.children[c];
                i = i + 1;
            }
            return current.isEnd;
        }

        fn startsWith(trie: Trie, prefix: String) -> Bool
        {
            var current: TrieNode = trie.root;
            var i: Int64 = 0;
            while i < prefix.len()
            {
                let c: String = prefix.substring(i, i + 1);
                if current.children.contains(c) == false
                {
                    return false;
                }
                current = current.children[c];
                i = i + 1;
            }
            return true;
        }

        fn autocomplete(trie: Trie, prefix: String) -> List<String>
        {
            var current: TrieNode = trie.root;
            var i: Int64 = 0;
            while i < prefix.len()
            {
                let c: String = prefix.substring(i, i + 1);
                if current.children.contains(c) == false
                {
                    return [];
                }
                current = current.children[c];
                i = i + 1;
            }
            return Trie::collectWords(current, prefix);
        }

        fn collectWords(node: TrieNode, prefix: String) -> List<String>
        {
            var results: List<String> = [];
            if node.isEnd
            {
                results.push(prefix);
            }
            let keys: List<String> = node.children.keys();
            var j: Int64 = 0;
            while j < keys.len()
            {
                let childWords: List<String> = Trie::collectWords(node.children[keys[j]], prefix + keys[j]);
                var k: Int64 = 0;
                while k < childWords.len()
                {
                    results.push(childWords[k]);
                    k = k + 1;
                }
                j = j + 1;
            }
            return results;
        }
    }
}

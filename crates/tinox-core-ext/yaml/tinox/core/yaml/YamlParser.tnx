module tinox.core.yaml;

namespace tinox.core.yaml
{
    class YamlParser
    {
        fn parse(content: String) -> YamlValue
        {
            return YamlValue { kind: "map", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: false, listValue: [], mapValue: Map::new() };
        }
    }
}

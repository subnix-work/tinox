module tinox.core.yaml;

namespace tinox.core.yaml
{
    // A real block-style YAML subset parser (mappings, sequences -- both
    // "- item" indented deeper than its key AND the equally common
    // kubectl-style "- item" at the SAME indent as its key --, flow
    // collections [a, b]/{k: v}, quoted/plain scalars, comments). Multi-line
    // block scalars (| and >) and YAML anchors/aliases/tags are NOT
    // supported -- out of scope for this module's actual use (parsing
    // kubeconfig-shaped config files), and neither construct appears in any
    // kubectl-generated file.
    //
    // Previously a stub that always returned an empty map regardless of
    // input -- fixed as a real dependency of tinox.core.kubernetes (needs
    // to load ~/.kube/config), not a standalone cleanup.
    class YamlParser
    {
        fn parse(content: String) -> YamlValue
        {
            let lines: List<YamlLine> = YamlParser::tokenize(content);
            if lines.len() == 0
            {
                return YamlValue::ofMap(Map::new());
            }
            let idxRef: List<Int64> = [0];
            return YamlParser::parseBlock(lines, idxRef, 0);
        }

        // ---- line tokenizer: strips comments/blank lines/doc markers,
        // keeps only (indent, content) pairs ----

        fn tokenize(content: String) -> List<YamlLine>
        {
            let rawLines: List<String> = content.split("\n");
            var lines: List<YamlLine> = [];
            var i: Int64 = 0;
            while i < rawLines.len()
            {
                var raw: String = rawLines[i];
                if raw.endsWith("\r")
                {
                    raw = raw.substring(0, raw.len() - 1);
                }
                let indent: Int64 = YamlParser::countIndent(raw);
                var rest: String = raw.substring(indent, raw.len());
                rest = YamlParser::stripComment(rest).trim();
                if rest.len() > 0 && rest != "---" && rest != "..."
                {
                    lines.push(YamlLine { indent: indent, content: rest });
                }
                i = i + 1;
            }
            return lines;
        }

        fn countIndent(raw: String) -> Int64
        {
            var i: Int64 = 0;
            while i < raw.len() && raw.substring(i, i + 1) == " "
            {
                i = i + 1;
            }
            return i;
        }

        // rest has no leading whitespace already. Strips a trailing " #..."
        // comment, ignoring '#' inside a quoted string.
        fn stripComment(rest: String) -> String
        {
            if rest.len() == 0
            {
                return rest;
            }
            if rest.substring(0, 1) == "#"
            {
                return "";
            }
            var inSingle: Bool = false;
            var inDouble: Bool = false;
            var i: Int64 = 0;
            let n: Int64 = rest.len();
            while i < n
            {
                let ch: String = rest.substring(i, i + 1);
                if !inDouble && ch == "'"
                {
                    inSingle = !inSingle;
                }
                else if !inSingle && ch == "\""
                {
                    inDouble = !inDouble;
                }
                else if !inSingle && !inDouble && ch == "#" && i > 0 && rest.substring(i - 1, i) == " "
                {
                    return rest.substring(0, i).trim();
                }
                i = i + 1;
            }
            return rest;
        }

        // ---- recursive-descent block parser ----

        fn parseBlock(lines: List<YamlLine>, idxRef: List<Int64>, minIndent: Int64) -> YamlValue
        {
            let idx: Int64 = idxRef[0];
            if idx >= lines.len()
            {
                return YamlValue::ofNull();
            }
            let indent: Int64 = lines[idx].indent;
            if indent < minIndent
            {
                return YamlValue::ofNull();
            }
            let content: String = lines[idx].content;
            if content == "-" || content.startsWith("- ")
            {
                return YamlParser::parseSequence(lines, idxRef, indent);
            }
            return YamlParser::parseMapping(lines, idxRef, indent);
        }

        // Looks at the line right after a "key:"/"- " with nothing after
        // the colon/dash and decides whether it starts a nested value:
        // a block sequence at the SAME OR a greater indent than the parent
        // (kubectl's own convention: "clusters:\n- cluster:\n  name: x"
        // keeps the "-" at the parent key's own column), or a nested
        // mapping/scalar strictly indented further. Returns null (no
        // nested value; caller has already advanced past the key line)
        // if neither applies.
        fn parseNestedValue(lines: List<YamlLine>, idxRef: List<Int64>, parentIndent: Int64) -> YamlValue
        {
            let nextIdx: Int64 = idxRef[0];
            if nextIdx >= lines.len()
            {
                return YamlValue::ofNull();
            }
            let nextIndent: Int64 = lines[nextIdx].indent;
            let nextContent: String = lines[nextIdx].content;
            let isDash: Bool = nextContent == "-" || nextContent.startsWith("- ");
            if isDash && nextIndent >= parentIndent
            {
                return YamlParser::parseSequence(lines, idxRef, nextIndent);
            }
            if !isDash && nextIndent > parentIndent
            {
                return YamlParser::parseBlock(lines, idxRef, parentIndent + 1);
            }
            return YamlValue::ofNull();
        }

        fn parseMapping(lines: List<YamlLine>, idxRef: List<Int64>, mapIndent: Int64) -> YamlValue
        {
            let result: Map<String, YamlValue> = Map::new();
            while idxRef[0] < lines.len() && lines[idxRef[0]].indent == mapIndent
            {
                let idx: Int64 = idxRef[0];
                let line: YamlLine = lines[idx];
                let split: Int64 = YamlParser::findColon(line.content);
                if split == -1
                {
                    throw "Yaml::parse: expected 'key: value' at indent " + mapIndent.toString() + ": " + line.content;
                }
                var key: String = line.content.substring(0, split).trim();
                key = YamlParser::stripQuotes(key);
                let valueStr: String = line.content.substring(split + 1, line.content.len()).trim();
                var value: YamlValue = YamlValue::ofNull();
                if valueStr.len() == 0
                {
                    idxRef[0] = idx + 1;
                    value = YamlParser::parseNestedValue(lines, idxRef, mapIndent);
                }
                else
                {
                    value = YamlParser::parseScalarOrFlow(valueStr);
                    idxRef[0] = idx + 1;
                }
                result.insert(key, value);
            }
            return YamlValue::ofMap(result);
        }

        fn parseSequence(lines: List<YamlLine>, idxRef: List<Int64>, indent: Int64) -> YamlValue
        {
            let items: List<YamlValue> = [];
            while idxRef[0] < lines.len() && lines[idxRef[0]].indent == indent && (lines[idxRef[0]].content == "-" || lines[idxRef[0]].content.startsWith("- "))
            {
                let idx: Int64 = idxRef[0];
                let raw: String = lines[idx].content;
                let rest: String = raw == "-" ? "" : raw.substring(2, raw.len());
                var value: YamlValue = YamlValue::ofNull();
                if rest.len() == 0
                {
                    idxRef[0] = idx + 1;
                    value = YamlParser::parseNestedValue(lines, idxRef, indent);
                }
                else
                {
                    // De-dash in place: "- cluster:" at `indent` becomes a
                    // plain "cluster:" line at `indent + 2` (the column
                    // right after "- "), so the mapping/sequence parsers
                    // can treat it exactly like a real line at that indent
                    // -- no separate synthetic-line list needed.
                    lines[idx] = YamlLine { indent: indent + 2, content: rest };
                    if rest == "-" || rest.startsWith("- ")
                    {
                        value = YamlParser::parseSequence(lines, idxRef, indent + 2);
                    }
                    else if YamlParser::findColon(rest) != -1
                    {
                        value = YamlParser::parseMapping(lines, idxRef, indent + 2);
                    }
                    else
                    {
                        value = YamlParser::parseScalarOrFlow(rest);
                        idxRef[0] = idx + 1;
                    }
                }
                items.push(value);
            }
            return YamlValue::ofList(items);
        }

        // Index of the ':' that separates a mapping key from its value
        // (a colon followed by a space, or at end of line), ignoring
        // colons inside quotes -- so "server: https://host:8443" splits
        // after "server", not at the URL's own colons.
        fn findColon(content: String) -> Int64
        {
            var inSingle: Bool = false;
            var inDouble: Bool = false;
            var i: Int64 = 0;
            let n: Int64 = content.len();
            while i < n
            {
                let ch: String = content.substring(i, i + 1);
                if !inDouble && ch == "'"
                {
                    inSingle = !inSingle;
                }
                else if !inSingle && ch == "\""
                {
                    inDouble = !inDouble;
                }
                else if !inSingle && !inDouble && ch == ":"
                {
                    if i + 1 == n || content.substring(i + 1, i + 2) == " "
                    {
                        return i;
                    }
                }
                i = i + 1;
            }
            return -1;
        }

        fn stripQuotes(s: String) -> String
        {
            if s.len() >= 2 && s.substring(0, 1) == "\"" && s.substring(s.len() - 1, s.len()) == "\""
            {
                return s.substring(1, s.len() - 1);
            }
            if s.len() >= 2 && s.substring(0, 1) == "'" && s.substring(s.len() - 1, s.len()) == "'"
            {
                return s.substring(1, s.len() - 1);
            }
            return s;
        }

        // ---- flow collections: [a, b] / {k: v} ----

        fn parseScalarOrFlow(s: String) -> YamlValue
        {
            let t: String = s.trim();
            if t.startsWith("{") || t.startsWith("[")
            {
                return YamlParser::parseFlow(t);
            }
            return YamlParser::parseScalar(t);
        }

        fn parseFlow(s: String) -> YamlValue
        {
            if s == "{}"
            {
                return YamlValue::ofMap(Map::new());
            }
            if s == "[]"
            {
                return YamlValue::ofList([]);
            }
            if s.startsWith("{") && s.endsWith("}")
            {
                let inner: String = s.substring(1, s.len() - 1);
                let parts: List<String> = YamlParser::splitTopLevel(inner, ",");
                let m: Map<String, YamlValue> = Map::new();
                var i: Int64 = 0;
                while i < parts.len()
                {
                    let p: String = parts[i].trim();
                    if p.len() > 0
                    {
                        let split: Int64 = YamlParser::findColon(p);
                        if split == -1
                        {
                            throw "Yaml::parse: expected 'key: value' inside flow mapping: " + p;
                        }
                        let key: String = YamlParser::stripQuotes(p.substring(0, split).trim());
                        let valueStr: String = p.substring(split + 1, p.len()).trim();
                        m.insert(key, YamlParser::parseScalarOrFlow(valueStr));
                    }
                    i = i + 1;
                }
                return YamlValue::ofMap(m);
            }
            if s.startsWith("[") && s.endsWith("]")
            {
                let inner: String = s.substring(1, s.len() - 1);
                let parts: List<String> = YamlParser::splitTopLevel(inner, ",");
                var list: List<YamlValue> = [];
                var i: Int64 = 0;
                while i < parts.len()
                {
                    let p: String = parts[i].trim();
                    if p.len() > 0
                    {
                        list.push(YamlParser::parseScalarOrFlow(p));
                    }
                    i = i + 1;
                }
                return YamlValue::ofList(list);
            }
            return YamlParser::parseScalar(s);
        }

        // Splits `s` on top-level occurrences of a single-character `sep`,
        // ignoring separators inside quotes or nested []/{}.
        fn splitTopLevel(s: String, sep: String) -> List<String>
        {
            var result: List<String> = [];
            var depth: Int64 = 0;
            var inSingle: Bool = false;
            var inDouble: Bool = false;
            var cur: String = "";
            var i: Int64 = 0;
            let n: Int64 = s.len();
            while i < n
            {
                let ch: String = s.substring(i, i + 1);
                if !inDouble && ch == "'"
                {
                    inSingle = !inSingle;
                }
                else if !inSingle && ch == "\""
                {
                    inDouble = !inDouble;
                }
                else if !inSingle && !inDouble && (ch == "[" || ch == "{")
                {
                    depth = depth + 1;
                }
                else if !inSingle && !inDouble && (ch == "]" || ch == "}")
                {
                    depth = depth - 1;
                }
                if !inSingle && !inDouble && depth == 0 && ch == sep
                {
                    result.push(cur);
                    cur = "";
                }
                else
                {
                    cur = cur + ch;
                }
                i = i + 1;
            }
            result.push(cur);
            return result;
        }

        // ---- scalars ----

        fn parseScalar(raw: String) -> YamlValue
        {
            let s: String = raw.trim();
            if s.len() == 0
            {
                return YamlValue::ofNull();
            }
            if s.len() >= 2 && s.substring(0, 1) == "\"" && s.substring(s.len() - 1, s.len()) == "\""
            {
                return YamlValue::ofString(YamlParser::unescapeDouble(s.substring(1, s.len() - 1)));
            }
            if s.len() >= 2 && s.substring(0, 1) == "'" && s.substring(s.len() - 1, s.len()) == "'"
            {
                return YamlValue::ofString(s.substring(1, s.len() - 1).replace("''", "'"));
            }
            if s == "~" || s == "null" || s == "Null" || s == "NULL"
            {
                return YamlValue::ofNull();
            }
            if s == "true" || s == "True" || s == "TRUE"
            {
                return YamlValue::ofBool(true);
            }
            if s == "false" || s == "False" || s == "FALSE"
            {
                return YamlValue::ofBool(false);
            }
            if YamlParser::isIntLiteral(s)
            {
                return YamlValue::ofInt(s.toInt());
            }
            if YamlParser::isFloatLiteral(s)
            {
                return YamlValue::ofFloat(s.toFloat());
            }
            return YamlValue::ofString(s);
        }

        fn unescapeDouble(s: String) -> String
        {
            var result: String = "";
            var i: Int64 = 0;
            let n: Int64 = s.len();
            while i < n
            {
                let ch: String = s.substring(i, i + 1);
                if ch == "\\" && i + 1 < n
                {
                    let nxt: String = s.substring(i + 1, i + 2);
                    if nxt == "n"
                    {
                        result = result + "\n";
                    }
                    else if nxt == "t"
                    {
                        result = result + "\t";
                    }
                    else
                    {
                        result = result + nxt;
                    }
                    i = i + 2;
                }
                else
                {
                    result = result + ch;
                    i = i + 1;
                }
            }
            return result;
        }

        fn isIntLiteral(s: String) -> Bool
        {
            if s.len() == 0
            {
                return false;
            }
            var i: Int64 = 0;
            if s.substring(0, 1) == "-"
            {
                i = 1;
            }
            if i >= s.len()
            {
                return false;
            }
            while i < s.len()
            {
                let code: Int64 = s.charCodeAt(i);
                if code < 48 || code > 57
                {
                    return false;
                }
                i = i + 1;
            }
            return true;
        }

        fn isFloatLiteral(s: String) -> Bool
        {
            if s.len() == 0
            {
                return false;
            }
            var i: Int64 = 0;
            if s.substring(0, 1) == "-" || s.substring(0, 1) == "+"
            {
                i = 1;
            }
            var sawDigit: Bool = false;
            var sawDot: Bool = false;
            var sawExp: Bool = false;
            while i < s.len()
            {
                let ch: String = s.substring(i, i + 1);
                let code: Int64 = s.charCodeAt(i);
                if code >= 48 && code <= 57
                {
                    sawDigit = true;
                    i = i + 1;
                }
                else if ch == "." && !sawDot && !sawExp
                {
                    sawDot = true;
                    i = i + 1;
                }
                else if (ch == "e" || ch == "E") && !sawExp && sawDigit
                {
                    sawExp = true;
                    i = i + 1;
                    if i < s.len() && (s.substring(i, i + 1) == "+" || s.substring(i, i + 1) == "-")
                    {
                        i = i + 1;
                    }
                }
                else
                {
                    return false;
                }
            }
            return sawDigit && (sawDot || sawExp);
        }
    }
}

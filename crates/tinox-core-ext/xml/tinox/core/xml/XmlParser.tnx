module tinox.core.xml;

import tinox.core.string;

namespace tinox.core.xml
{
    class XmlParser
    {
        fn parse(text: String) -> XmlNode
        {
            const trimmed: String = Strings::trim(text);
            return XmlParser::parseNode(trimmed);
        }

        fn parseNode(text: String) -> XmlNode
        {
            const tagStart: Int64 = text.indexOf("<");
            const tagEnd: Int64 = text.indexOf(">");
            if (tagStart == -1 || tagEnd == -1)
            {
                return XmlNode { tagName: "", text: text, attrs: Map::new(), children: [] };
            }
            const tagContent: String = text.substring(tagStart + 1, tagEnd);
            const tagName: String = XmlParser::extractTagName(tagContent);
            const attrs: Map<String, String> = XmlParser::parseAttrs(tagContent);
            const selfClosing: Bool = tagContent.endsWith("/");
            const children: List<XmlNode> = [];
            var content: String = "";
            if (selfClosing == false)
            {
                const endTag: String = "</" + tagName + ">";
                const endPos: Int64 = text.indexOf(endTag);
                if (endPos != -1)
                {
                    content = text.substring(tagEnd + 1, endPos);
                }
            }
            return XmlNode { tagName: tagName, text: content, attrs: attrs, children: children };
        }

        fn extractTagName(tagContent: String) -> String
        {
            var i: Int64 = 0;
            while i < tagContent.len()
            {
                const c: String = tagContent.substring(i, i + 1);
                if (c == " " || c == "/" || c == ">")
                {
                    return tagContent.substring(0, i);
                }
                i = i + 1;
            }
            return tagContent;
        }

        fn parseAttrs(tagContent: String) -> Map<String, String>
        {
            const attrs: Map<String, String> = Map::new();
            const parts: List<String> = tagContent.split(" ");
            var i: Int64 = 1;
            while i < parts.len()
            {
                const attr: String = Strings::trim(parts[i]);
                if (attr.len() > 0 && attr != "/")
                {
                    const eqPos: Int64 = attr.indexOf("=");
                    if (eqPos != -1)
                    {
                        const name: String = attr.substring(0, eqPos);
                        const value: String = attr.substring(eqPos + 1, attr.len());
                        attrs[name] = value.replace("\"", "");
                    }
                }
                i = i + 1;
            }
            return attrs;
        }
    }
}

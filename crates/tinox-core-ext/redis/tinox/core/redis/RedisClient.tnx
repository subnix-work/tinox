/**
 * Tinox Standard Library - Redis Client Module
 * Client for an external cache/session store (RESP2, single-node,
 * request/response commands) -- tinox.core.cache's Cache/LruCache are
 * in-process only, so they can't share state across HTTP worker
 * processes/instances or store sessions outside a single process's
 * memory. Wire-compatible with both Redis and Valkey (the two speak the
 * same RESP2 protocol for everything this client uses).
 *
 *   const client: RedisClient = RedisClient::connect("localhost", 6379);
 *   if client.conn <= 0 { throw client.errorMessage; }
 *   client.setEx("session:abc", "user-42", 3600);
 *   const value: String = client.get("session:abc");
 *   if !client.lastGetFound() { throw "cache miss"; }
 *   client.close();
 *
 * A client is NOT safe for concurrent use: one request/reply exchange
 * at a time on one connection. Share connections through RedisPool
 * (exclusive borrow), not by handing one client to several threads.
 *
 * command()/getReply() report absent, present-empty, Redis error and
 * transport failure as distinct RedisReply kinds without any shared
 * status flag. Any transport/protocol failure marks the client
 * unhealthy (healthy == false) so a pool discards it instead of handing
 * out a connection with unread bytes.
 *
 * v1 scope, deliberately not covered (see issue #135):
 *   - Pooling lives in RedisPool (#544), Pub/Sub in RedisSubscriber
 *     (#546, its own connection); no Redis Cluster/Sentinel --
 *     single-node, request/response commands only here.
 *   - No Memcached client in this pass -- different wire protocol, no
 *     shared code with RESP2 beyond the raw socket layer, an explicit
 *     separately-scoped follow-up if needed.
 */
module tinox.core.redis

import tinox.core.socket

namespace tinox.core.redis
{
    extern fn httpConnReadLine(conn: Int64) -> String
    extern fn tinoxBytesToString(bytes: List<Int64>) -> String

    class RedisClient
    {
        var conn: Int64
        var errorMessage: String
        var getFound: Bool
        var incrOk: Bool
        // false after any transport/protocol failure: the stream position
        // is unknown, so the connection must be discarded, never reused.
        var healthy: Bool
        // true while a RedisPool has lent this client out.
        var pooled: Bool

        /*
         * Dials and sends PING to fail fast on a bad host/port (RESP2
         * has no connect-time greeting to read the way SMTP's 220
         * banner works, so this is the only way to confirm the peer
         * actually speaks the protocol before the caller's first real
         * command). `conn` is -1 on any failure (caller MUST check,
         * kein Silent-Garbage) -- `errorMessage` describes the cause.
         */
        fn connect(host: String, port: Int64) -> RedisClient
        {
            const fd = socketCreateTcp()
            if (!socketConnect(fd, host, port)) {
                socketClose(fd)
                return RedisClient { conn: -1, errorMessage: "connect failed", getFound: false, incrOk: false, healthy: true, pooled: false }
            }
            var client: RedisClient = RedisClient { conn: httpConnFromFd(fd), errorMessage: "", getFound: false, incrOk: false, healthy: true, pooled: false }
            if (!client.ping()) {
                httpConnClose(client.conn)
                client.conn = -1
                client.healthy = false
                client.errorMessage = "PING failed"
            }
            return client
        }

        fn ping() -> Bool
        {
            this.sendCommand(["PING"])
            return this.readLine() == "+PONG"
        }

        /*
         * GET. Returns "" both on a real cache miss (RESP2 nil bulk
         * string, "$-1") and on a protocol error -- lastGetFound()
         * distinguishes "no value" from "there was one and this is it",
         * since an empty string IS a valid stored value in Redis and
         * the caller needs to tell the two apart (kein Silent-Garbage).
         */
        fn get(key: String) -> String
        {
            this.sendCommand(["GET", key])
            const header = this.readLine()
            if (!header.startsWith("$") || header == "$-1") {
                this.getFound = false
                return ""
            }
            const len = header.substring(1, header.len()).toInt()
            const bytes = httpConnReadN(this.conn, len + 2) // value + trailing \r\n
            // tinoxBytesToString does the byte->char conversion in one
            // pass instead of `result = result + fromCharCode(...)` in a
            // loop, which is O(n^2) over the value length (issue #167).
            // bytes includes the trailing \r\n (2 extra bytes past `len`),
            // so slice it down to just the value first.
            var value: List<Int64> = []
            var i: Int64 = 0
            while i < len {
                value.push(bytes[i])
                i = i + 1
            }
            this.getFound = true
            return tinoxBytesToString(value)
        }

        fn lastGetFound() -> Bool
        {
            return this.getFound
        }

        fn set(key: String, value: String) -> Bool
        {
            this.sendCommand(["SET", key, value])
            return this.readLine() == "+OK"
        }

        fn setEx(key: String, value: String, ttlSeconds: Int64) -> Bool
        {
            this.sendCommand(["SETEX", key, ttlSeconds.toString(), value])
            return this.readLine() == "+OK"
        }

        // Returns whether a key was actually removed (RESP2 integer
        // reply: number of keys deleted, 0 or 1 for a single-key DEL).
        fn del(key: String) -> Bool
        {
            this.sendCommand(["DEL", key])
            const line = this.readLine()
            if (!line.startsWith(":")) {
                return false
            }
            return line.substring(1, line.len()).toInt() > 0
        }

        fn expire(key: String, ttlSeconds: Int64) -> Bool
        {
            this.sendCommand(["EXPIRE", key, ttlSeconds.toString()])
            const line = this.readLine()
            if (!line.startsWith(":")) {
                return false
            }
            return line.substring(1, line.len()).toInt() == 1
        }

        /*
         * INCR. lastIncrOk() distinguishes a real result of 0 from a
         * protocol/value error (e.g. RESP2 "-ERR value is not an
         * integer" if the key holds a non-numeric string) -- same
         * kein-Silent-Garbage rationale as lastGetFound().
         */
        fn incr(key: String) -> Int64
        {
            this.sendCommand(["INCR", key])
            const line = this.readLine()
            if (!line.startsWith(":")) {
                this.incrOk = false
                return 0
            }
            this.incrOk = true
            return line.substring(1, line.len()).toInt()
        }

        fn lastIncrOk() -> Bool
        {
            return this.incrOk
        }

        fn close() -> Nothing
        {
            httpConnClose(this.conn)
            this.healthy = false
        }

        // One line of a reply. An empty result means the connection closed or
        // timed out: the client becomes unhealthy.
        fn readLine() -> String
        {
            const line = httpConnReadLine(this.conn)
            if (line == "") {
                this.healthy = false
            }
            return line
        }

        /*
         * Sends any command and returns its reply with an explicit kind
         * (see RedisReply): value (including the empty string), nil, Redis
         * error, or transport/protocol failure. Array replies are not
         * supported by this client; receiving one marks the client
         * unhealthy because its elements would remain unread.
         */
        fn command(args: List<String>) -> RedisReply
        {
            if (this.conn <= 0 || !this.healthy) {
                return RedisReply { kind: 3, text: "connection is not usable" }
            }
            this.sendCommand(args)
            const line = this.readLine()
            if (line == "") {
                return RedisReply { kind: 3, text: "connection closed or timed out" }
            }
            if (line.startsWith("+") || line.startsWith(":")) {
                return RedisReply { kind: 1, text: line.substring(1, line.len()) }
            }
            if (line.startsWith("-")) {
                return RedisReply { kind: 2, text: line.substring(1, line.len()) }
            }
            if (line.startsWith("$")) {
                if (line == "$-1") {
                    return RedisReply { kind: 0, text: "" }
                }
                const len = line.substring(1, line.len()).toInt()
                if (len < 0) {
                    this.healthy = false
                    return RedisReply { kind: 3, text: "invalid bulk length" }
                }
                const bytes = httpConnReadN(this.conn, len + 2)
                if (bytes.len() < len + 2) {
                    this.healthy = false
                    return RedisReply { kind: 3, text: "truncated bulk reply" }
                }
                var value: List<Int64> = []
                var i: Int64 = 0
                while i < len {
                    value.push(bytes[i])
                    i = i + 1
                }
                return RedisReply { kind: 1, text: tinoxBytesToString(value) }
            }
            this.healthy = false
            return RedisReply { kind: 3, text: "unsupported or malformed reply" }
        }

        // GET without a shared status flag: nil, empty value, value and error are distinct.
        fn getReply(key: String) -> RedisReply
        {
            return this.command(["GET", key])
        }

        // RESP2 request encoding (a "multi bulk" array of bulk strings):
        // *<argc>\r\n($<len>\r\n<arg>\r\n)*
        fn sendCommand(args: List<String>) -> Nothing
        {
            var out: String = "*" + args.len().toString() + "\r\n"
            var i: Int64 = 0
            while i < args.len() {
                out = out + "$" + args[i].len().toString() + "\r\n" + args[i] + "\r\n"
                i = i + 1
            }
            httpConnSendRaw(this.conn, out)
        }
    }
}

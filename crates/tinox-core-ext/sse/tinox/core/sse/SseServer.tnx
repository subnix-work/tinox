module tinox.core.sse;

namespace tinox.core.sse
{
    /*
     * Minimal server entry point, mirroring tinox.core.websocket's
     * WsServer: listen + accept-with-handshake, handing back a raw conn
     * handle for the caller to drive directly (see module comment on
     * Sse for why -- SSE's "handshake" is just a normal HTTP response
     * with the right headers and no Connection: close, so accept() only
     * needs to read the request and send that response before returning
     * the conn).
     */
    class SseServer
    {
        fn listen(port: Int64) -> Int64
        {
            return httpServerCreate(port);
        }

        /*
         * Accepts the next connection and sends the SSE handshake
         * response (200, Content-Type: text/event-stream, no framing).
         * Returns the conn handle (>0) or -1 (request unreadable/empty,
         * connection is already closed in that case).
         */
        fn accept(srv: Int64) -> Int64
        {
            let conn = httpServerAcceptConnHandle(srv);
            if conn <= 0 {
                return -1;
            }
            if !Sse::handshake(conn) {
                httpConnClose(conn);
                return -1;
            }
            return conn;
        }

        // https:// variant of listen() — mirrors WsServer::listenTls.
        fn listenTls(port: Int64, certPath: String, keyPath: String) -> Int64
        {
            return httpServerCreateTls(port, certPath, keyPath);
        }

        // TLS variant of accept() — mirrors WsServer::acceptTls.
        fn acceptTls(srv: Int64) -> Int64
        {
            let conn = httpServerAcceptTls(srv);
            if conn <= 0 {
                return -1;
            }
            if !Sse::handshake(conn) {
                httpConnClose(conn);
                return -1;
            }
            return conn;
        }
    }
}

module tinox.core.kubernetes;

import tinox.core.json;

namespace tinox.core.kubernetes
{
    @JsonSerializable
    class ClusterRoleBinding
    {
        var apiVersion: String;
        var kind: String;
        var metadata: ObjectMeta;
        var subjects: List<Subject>;
        var roleRef: RoleRef;

        fnc create(name: String, subjects: List<Subject>, roleRef: RoleRef) -> ClusterRoleBinding
        {
            return ClusterRoleBinding {
                apiVersion: "rbac.authorization.k8s.io/v1", kind: "ClusterRoleBinding",
                metadata: ObjectMeta::withName(name),
                subjects: subjects, roleRef: roleRef
            };
        }
    }
}

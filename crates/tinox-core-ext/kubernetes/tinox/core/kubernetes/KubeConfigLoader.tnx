module tinox.core.kubernetes;

import tinox.core.yaml;
import tinox.core.base64;
import tinox.core.env;
import tinox.core.fs;
import tinox.core.time;

namespace tinox.core.kubernetes
{
    // Loads a kubeconfig (the same file/format `kubectl` reads) or the
    // in-cluster service-account files into a resolved ClusterAuth.
    // Supports both the file-path and the base64 "-data" form of every
    // cert/key field, `token`/`tokenFile` bearer auth, and
    // insecure-skip-tls-verify -- NOT supported: exec-based/OIDC plugin
    // auth (`user.exec`/`user.auth-provider`), which would need shelling
    // out to an arbitrary configured command; a kubeconfig relying on
    // that fails loudly (empty bearerToken/cert fields -> the API server
    // rejects the request with 401, not a silent wrong-auth attempt).
    class KubeConfigLoader
    {
        fnc fromDefaultLocation() -> ClusterAuth
        {
            return KubeConfigLoader::fromFile(KubeConfigLoader::defaultConfigPath());
        }

        // Like fromDefaultLocation, but for an explicit context name
        // instead of the kubeconfig's own current-context -- see
        // fromFileWithContext's own doc comment.
        fnc fromDefaultLocationWithContext(contextName: String) -> ClusterAuth
        {
            return KubeConfigLoader::fromFileWithContext(KubeConfigLoader::defaultConfigPath(), contextName);
        }

        // KUBECONFIG env var if set, else ~/.kube/config -- the same
        // resolution `kubectl` itself uses, and shared by every
        // "default location" entry point here (and by a context-picker
        // UI that needs to resolve the path once before calling
        // listContextNames/currentContextName on it).
        fnc defaultConfigPath() -> String
        {
            const envPath: String = Env::getVar("KUBECONFIG");
            if (envPath.len() > 0)
            {
                return envPath;
            }
            const home: String = Env::getVar("HOME");
            return home + "/.kube/config";
        }

        fnc fromFile(path: String) -> ClusterAuth
        {
            return KubeConfigLoader::fromFileWithContext(path, "");
        }

        // Like fromFile, but resolves an EXPLICIT context name instead of
        // always using the kubeconfig's own `current-context` -- needed
        // for multi-context support (switching clusters from a running
        // app without mutating the shared kubeconfig file's own
        // `current-context`, which would race across concurrent
        // sessions/users). `contextName` "" means "use current-context",
        // same as plain fromFile.
        fnc fromFileWithContext(path: String, contextName: String) -> ClusterAuth
        {
            if (!fileExists(path))
            {
                throw "KubeConfigLoader: kubeconfig file not found: " + path;
            }
            const content: String = Fs::readFile(path);
            const doc: YamlValue = Yaml::parse(content);

            var targetContext: String = contextName;
            if (targetContext.len() == 0)
            {
                targetContext = doc.get("current-context").asString("");
                if (targetContext.len() == 0)
                {
                    throw "KubeConfigLoader: kubeconfig has no current-context: " + path;
                }
            }

            const contextEntry: YamlValue = KubeConfigLoader::findByName(doc.get("contexts"), targetContext);
            if (contextEntry.isNull())
            {
                throw "KubeConfigLoader: context '" + targetContext + "' not found in contexts: " + path;
            }
            const context: YamlValue = contextEntry.get("context");
            const clusterName: String = context.get("cluster").asString("");
            const userName: String = context.get("user").asString("");
            const namespace: String = context.get("namespace").asString("default");

            const clusterEntry: YamlValue = KubeConfigLoader::findByName(doc.get("clusters"), clusterName);
            if (clusterEntry.isNull())
            {
                throw "KubeConfigLoader: cluster '" + clusterName + "' not found: " + path;
            }
            const cluster: YamlValue = clusterEntry.get("cluster");

            const userEntry: YamlValue = KubeConfigLoader::findByName(doc.get("users"), userName);
            const user: YamlValue = userEntry.isNull() ? YamlValue::ofMap(Map::new()) : userEntry.get("user");

            const server: String = cluster.get("server").asString("");
            if (server.len() == 0)
            {
                throw "KubeConfigLoader: cluster '" + clusterName + "' has no server: " + path;
            }

            const caCertPath: String = KubeConfigLoader::resolveCertOrKeyFile(
                cluster.get("certificate-authority").asString(""),
                cluster.get("certificate-authority-data").asString(""),
                "ca");
            const clientCertPath: String = KubeConfigLoader::resolveCertOrKeyFile(
                user.get("client-certificate").asString(""),
                user.get("client-certificate-data").asString(""),
                "client-cert");
            const clientKeyPath: String = KubeConfigLoader::resolveCertOrKeyFile(
                user.get("client-key").asString(""),
                user.get("client-key-data").asString(""),
                "client-key");

            const token: String = user.get("token").asString("");
            const tokenFile: String = user.get("tokenFile").asString("");
            var bearerToken: String = token;
            if (bearerToken.len() == 0 && tokenFile.len() > 0 && fileExists(tokenFile))
            {
                bearerToken = Fs::readFile(tokenFile).trim();
            }

            const insecure: YamlValue = cluster.get("insecure-skip-tls-verify");
            const insecureSkip: Bool = insecure.isBool() && insecure.boolValue;

            return ClusterAuth {
                serverUrl: server,
                caCertPath: caCertPath,
                clientCertPath: clientCertPath,
                clientKeyPath: clientKeyPath,
                bearerToken: bearerToken,
                namespace: namespace,
                insecureSkipTlsVerify: insecureSkip
            };
        }

        // The standard way a program running INSIDE a Kubernetes pod
        // authenticates against its own cluster's API server -- reads the
        // token/CA/namespace Kubernetes auto-mounts into every pod at
        // /var/run/secrets/kubernetes.io/serviceaccount/, and the
        // apiserver's own in-cluster address from the always-set
        // KUBERNETES_SERVICE_HOST/PORT env vars.
        fnc inCluster() -> ClusterAuth
        {
            const base: String = "/var/run/secrets/kubernetes.io/serviceaccount";
            const tokenPath: String = base + "/token";
            const caPath: String = base + "/ca.crt";
            const nsPath: String = base + "/namespace";
            if (!fileExists(tokenPath))
            {
                throw "KubeConfigLoader::inCluster: not running inside a Kubernetes pod (no service account token found at " + tokenPath + ")";
            }
            const host: String = Env::getVar("KUBERNETES_SERVICE_HOST");
            const port: String = Env::getVar("KUBERNETES_SERVICE_PORT");
            if (host.len() == 0 || port.len() == 0)
            {
                throw "KubeConfigLoader::inCluster: KUBERNETES_SERVICE_HOST/KUBERNETES_SERVICE_PORT not set";
            }
            const token: String = Fs::readFile(tokenPath).trim();
            const namespace: String = fileExists(nsPath) ? Fs::readFile(nsPath).trim() : "default";
            return ClusterAuth {
                serverUrl: "https://" + host + ":" + port,
                caCertPath: fileExists(caPath) ? caPath : "",
                clientCertPath: "",
                clientKeyPath: "",
                bearerToken: token,
                namespace: namespace,
                insecureSkipTlsVerify: false
            };
        }

        // Every context name declared in the kubeconfig -- for a context
        // picker UI. No cluster round trip (reads only the local
        // kubeconfig file), matching how a namespace/context selector
        // should populate instantly, not block on a live API call.
        fnc listContextNames(path: String) -> List<String>
        {
            var names: List<String> = [];
            if (!fileExists(path))
            {
                return names;
            }
            const content: String = Fs::readFile(path);
            const doc: YamlValue = Yaml::parse(content);
            const contexts: YamlValue = doc.get("contexts");
            if (!contexts.isList())
            {
                return names;
            }
            var i: Int64 = 0;
            while i < contexts.len()
            {
                const name: String = contexts.at(i).get("name").asString("");
                if (name.len() > 0)
                {
                    names.push(name);
                }
                i = i + 1;
            }
            return names;
        }

        fnc currentContextName(path: String) -> String
        {
            if (!fileExists(path))
            {
                return "";
            }
            const content: String = Fs::readFile(path);
            const doc: YamlValue = Yaml::parse(content);
            return doc.get("current-context").asString("");
        }

        fnc findByName(list: YamlValue, name: String) -> YamlValue
        {
            if (!list.isList())
            {
                return YamlValue::ofNull();
            }
            var i: Int64 = 0;
            while i < list.len()
            {
                const entry: YamlValue = list.at(i);
                if (entry.get("name").asString("") == name)
                {
                    return entry;
                }
                i = i + 1;
            }
            return YamlValue::ofNull();
        }

        // Returns a usable FILE PATH for a cert/key: the kubeconfig's own
        // file-path form as-is, or its base64 "-data" form decoded into a
        // fresh private temp file. "" if neither is set (e.g. a user with
        // no client cert, only a bearer token).
        fnc resolveCertOrKeyFile(filePath: String, base64Data: String, tag: String) -> String
        {
            if (filePath.len() > 0)
            {
                return filePath;
            }
            if (base64Data.len() > 0)
            {
                const pem: String = Base64::decode(base64Data);
                const tmpPath: String = "/tmp/.tinox_kube_" + tag + "_" + Time::now().toString() + ".pem";
                Fs::writeFile(tmpPath, pem);
                return tmpPath;
            }
            return "";
        }
    }
}

module tinox.core.kubernetes;

import tinox.core.json;

namespace tinox.core.kubernetes
{
    // Generic CRUD over ANY Kubernetes resource kind -- built-in or a
    // CRD-defined custom resource -- addressed purely by its
    // group/version/plural (exactly what `kubectl api-resources` lists),
    // with no compiled-in knowledge of the kind's shape. This is what
    // makes "every resource kind" true structurally: KubernetesClient's
    // typed convenience methods (pods()/deployments()/...) are thin
    // wrappers over this same class for the common built-in kinds, but
    // any kind -- including one this client has no dedicated method or
    // model class for -- is reachable the same way via
    // `client.resource(group, version, plural, namespaced)`.
    class GenericResourceOperations
    {
        var client: KubernetesClient;
        var group: String;
        var version: String;
        var plural: String;
        var namespaced: Bool;
        var namespace: String;

        // Named `of`, not `create` -- this class also has an instance
        // `create(bodyJson)` (the REST POST operation) and this compiler
        // does not support two methods sharing a name in one class, even
        // when one is static (`fnc`) and the other an instance method
        // (`fn`): a `Class::create(...)` call resolved to whichever one
        // regardless of arity, silently mistypechecking the other call
        // site instead of rejecting the duplicate name outright.
        fnc of(client: KubernetesClient, group: String, version: String, plural: String, namespaced: Bool, namespace: String) -> GenericResourceOperations
        {
            return GenericResourceOperations {
                client: client, group: group, version: version, plural: plural,
                namespaced: namespaced, namespace: namespace
            };
        }

        fn inNamespace(namespace: String) -> GenericResourceOperations
        {
            return GenericResourceOperations {
                client: this.client, group: this.group, version: this.version, plural: this.plural,
                namespaced: this.namespaced, namespace: namespace
            };
        }

        fn basePath() -> String
        {
            var apiRoot: String = "";
            if this.group.len() == 0
            {
                apiRoot = "/api/" + this.version;
            }
            else
            {
                apiRoot = "/apis/" + this.group + "/" + this.version;
            }
            if this.namespaced
            {
                return apiRoot + "/namespaces/" + this.namespace + "/" + this.plural;
            }
            return apiRoot + "/" + this.plural;
        }

        // Full raw JSON response ({kind: "...List", items: [...], ...}) --
        // use `.getField("items").asList()` to iterate, then a typed
        // class's own `::fromJson(item)` for the common kinds.
        fn list() -> JsonValue
        {
            let resp: KubeResponse = this.client.request("GET", this.basePath(), "");
            resp.throwIfError("list " + this.plural);
            return resp.json();
        }

        fn get(name: String) -> JsonValue
        {
            let resp: KubeResponse = this.client.request("GET", this.basePath() + "/" + name, "");
            resp.throwIfError("get " + this.plural + "/" + name);
            return resp.json();
        }

        fn exists(name: String) -> Bool
        {
            let resp: KubeResponse = this.client.request("GET", this.basePath() + "/" + name, "");
            return resp.isSuccess();
        }

        fn create(bodyJson: String) -> JsonValue
        {
            let resp: KubeResponse = this.client.request("POST", this.basePath(), bodyJson);
            resp.throwIfError("create " + this.plural);
            return resp.json();
        }

        // Full-object replace (HTTP PUT) -- bodyJson must carry the
        // current resourceVersion for an update to an existing object
        // (the standard optimistic-concurrency check every Kubernetes
        // API write goes through).
        fn update(name: String, bodyJson: String) -> JsonValue
        {
            let resp: KubeResponse = this.client.request("PUT", this.basePath() + "/" + name, bodyJson);
            resp.throwIfError("update " + this.plural + "/" + name);
            return resp.json();
        }

        // JSON Merge Patch (RFC 7386) -- patchJson only needs the fields
        // being changed, not the whole object (unlike update()).
        fn patchMerge(name: String, patchJson: String) -> JsonValue
        {
            let resp: KubeResponse = this.client.request("PATCH", this.basePath() + "/" + name, patchJson);
            resp.throwIfError("patch " + this.plural + "/" + name);
            return resp.json();
        }

        // Server-Side Apply (PATCH + `application/apply-patch+json`,
        // `?fieldManager=...&force=true`) -- unlike patchMerge (RFC 7386,
        // caller supplies only the fields being changed) or update (full
        // PUT replace, needs the current resourceVersion), SSA takes the
        // FULL desired object state and lets the API server compute the
        // diff itself against what this fieldManager previously applied,
        // the standard way a "load YAML, edit it, apply" workflow is
        // meant to work (no manual resourceVersion bookkeeping, no
        // hand-built partial patch body). `force: true` resolves a field
        // conflict with a DIFFERENT field manager in this manager's own
        // favor (kubectl's own `--force-conflicts`) -- the expected
        // behavior for an interactive YAML editor overwriting whatever
        // was there, not a background controller that should defer.
        fn applyServerSide(name: String, bodyJson: String, fieldManager: String) -> JsonValue
        {
            let path: String = this.basePath() + "/" + name + "?fieldManager=" + fieldManager + "&force=true";
            // `application/apply-patch+yaml`, NOT `+json` -- verified live
            // against a real cluster (minikube, kube-apiserver v1.35.1):
            // `+json` is rejected outright with HTTP 415 Unsupported
            // Media Type, matching `kubectl apply --server-side`'s own
            // observed request (`kubectl -v=8`) which ALSO always sends
            // `+yaml`, even for a body that's valid JSON -- apparently
            // this API server build only registers the YAML apply-patch
            // media type, not the JSON one both are supposed to support
            // per the API conventions. A plain JSON body is valid YAML,
            // so sending JSON under `+yaml` works fine; only the
            // Content-Type header needed to match what kubectl itself
            // actually uses.
            let resp: KubeResponse = this.client.requestWithContentType("PATCH", path, bodyJson, "application/apply-patch+yaml");
            resp.throwIfError("applyServerSide " + this.plural + "/" + name);
            return resp.json();
        }

        fn delete(name: String) -> Nothing
        {
            let resp: KubeResponse = this.client.request("DELETE", this.basePath() + "/" + name, "");
            resp.throwIfError("delete " + this.plural + "/" + name);
        }

        // Opens a live watch on this resource collection (or, combined
        // with `.inNamespace(ns)`, this namespace's collection of it).
        // See Watch's own doc comment for what it streams and its
        // known simplifications (no resourceVersion resume support).
        fn watch() -> Watch
        {
            return Watch::open(this.client, this.basePath());
        }
    }
}

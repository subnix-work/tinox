module tinox.core.kubernetes;

import tinox.core.json;

namespace tinox.core.kubernetes
{
    @JsonSerializable
    class Deployment
    {
        var apiVersion: String;
        var kind: String;
        var metadata: ObjectMeta;
        var spec: DeploymentSpec;
        var status: DeploymentStatus;

        // `labels` is used both as the Deployment's own metadata labels
        // AND as the pod template's labels/selector.matchLabels -- the
        // conventional "app: name" shape every real Deployment needs
        // (the ReplicaSet controller requires the template's labels to be
        // a superset of the selector, so reusing the same map for both
        // is the common-case-safe default, not just a shortcut).
        fnc create(name: String, namespace: String, replicas: Int64, labels: Map<String, String>, containers: List<Container>) -> Deployment
        {
            var meta: ObjectMeta = ObjectMeta::withNameAndNamespace(name, namespace);
            meta.labels = labels;
            return Deployment {
                apiVersion: "apps/v1", kind: "Deployment",
                metadata: meta,
                spec: DeploymentSpec {
                    replicas: replicas,
                    selector: LabelSelector { matchLabels: labels },
                    template: PodTemplateSpec::create(labels, containers)
                },
                status: DeploymentStatus { replicas: 0, readyReplicas: 0, availableReplicas: 0, updatedReplicas: 0 }
            };
        }
    }
}

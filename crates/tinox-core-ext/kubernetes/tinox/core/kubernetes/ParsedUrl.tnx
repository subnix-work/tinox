module tinox.core.kubernetes;

namespace tinox.core.kubernetes
{
    // Minimal internal helper for Watch::open -- ClusterAuth.serverUrl is
    // always a plain "https://host:port" (or "http://host:port"), never a
    // path/query, so a hand-rolled split covers this without pulling in a
    // general-purpose URL parser.
    class ParsedUrl
    {
        var host: String;
        var port: Int64;
        var isHttps: Bool;

        fnc parse(url: String) -> ParsedUrl
        {
            var isHttps: Bool = true;
            var rest: String = url;
            if rest.startsWith("https://")
            {
                isHttps = true;
                rest = rest.substring(8, rest.len());
            }
            else if rest.startsWith("http://")
            {
                isHttps = false;
                rest = rest.substring(7, rest.len());
            }
            let slashIdx: Int64 = rest.indexOf("/");
            if slashIdx >= 0
            {
                rest = rest.substring(0, slashIdx);
            }
            var host: String = rest;
            var port: Int64 = isHttps ? 443 : 80;
            let colonIdx: Int64 = rest.indexOf(":");
            if colonIdx >= 0
            {
                host = rest.substring(0, colonIdx);
                port = rest.substring(colonIdx + 1, rest.len()).toInt();
            }
            return ParsedUrl { host: host, port: port, isHttps: isHttps };
        }
    }
}

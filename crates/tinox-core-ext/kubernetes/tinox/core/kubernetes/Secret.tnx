module tinox.core.kubernetes;

import tinox.core.json;

namespace tinox.core.kubernetes
{
    // `data` (base64-encoded values, as returned by GET) and `stringData`
    // (plain-text, write-only -- the API server base64-encodes it into
    // `data` on write) both exist, matching the real upstream shape --
    // create a Secret via `stringData` so callers never have to
    // base64-encode by hand.
    @JsonSerializable
    class Secret
    {
        var apiVersion: String;
        var kind: String;
        var metadata: ObjectMeta;
        var type: String;
        var data: Map<String, String>;
        var stringData: Map<String, String>;

        fnc create(name: String, namespace: String, stringData: Map<String, String>) -> Secret
        {
            return Secret {
                apiVersion: "v1", kind: "Secret",
                metadata: ObjectMeta::withNameAndNamespace(name, namespace),
                type: "Opaque", data: Map::new(), stringData: stringData
            };
        }
    }
}

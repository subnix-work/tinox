/**
 * Tinox Standard Library - SMTP Client Module
 * Sends email over plain SMTP (RFC 5321), STARTTLS (RFC 3207, port 587)
 * or implicit TLS (port 465) — the common "send a password reset email /
 * signup confirmation" need that previously required shelling out or
 * hand-rolling raw SMTP over tinox.core.socket.
 *
 *   let client: SmtpClient = SmtpClient::connect("smtp.example.org", 587);
 *   if client.conn <= 0 { throw client.errorMessage; }
 *   if !client.startTls() { throw "STARTTLS failed"; }
 *   if !client.authPlain("user", "pass") { throw "auth failed"; }
 *   client.send("me@example.org", ["you@example.org"], "Hi", "Hello!");
 *   client.close();
 *
 * v1 scope, deliberately not covered (see issue #134):
 *   - Plain-text body only — no multipart/HTML/attachments.
 *   - No DKIM signing (the sending mail server's job when routing
 *     through a real relay like SES/SendGrid, not this client library's).
 */
module tinox.core.smtp;

import tinox.core.socket;
import tinox.core.base64;

namespace tinox.core.smtp
{
    extern fn httpConnReadLine(conn: Int64) -> String;
    extern fn httpConnTakeFd(conn: Int64) -> Int64;

    class SmtpClient
    {
        var conn: Int64;
        var host: String;
        var errorMessage: String;

        /*
         * Plain-text connect (port 25/587 before STARTTLS): dials, reads
         * the 220 greeting, then sends EHLO (client identifies itself as
         * "localhost" -- most servers don't validate this argument, and
         * RFC 5321 only requires it to be a syntactically valid
         * domain/address literal, not the caller's *actual* hostname).
         * `conn` is -1 on any failure (caller MUST check, kein Silent-
         * Garbage) -- `errorMessage` describes the cause.
         */
        fn connect(host: String, port: Int64) -> SmtpClient
        {
            let fd = socketCreateTcp();
            if !socketConnect(fd, host, port) {
                socketClose(fd);
                return SmtpClient { conn: -1, host: host, errorMessage: "connect failed" };
            }
            return SmtpClient::finishConnect(httpConnFromFd(fd), host);
        }

        /*
         * smtps:// — implicit-TLS variant of connect() (port 465).
         * verify=true (recommended for real relays like SES/SendGrid/
         * Gmail, all of which have publicly-trusted certs) checks the
         * certificate chain + hostname against the system CA store;
         * verify=false is a deliberate opt-out for self-signed test
         * certificates.
         */
        fn connectTls(host: String, port: Int64, verify: Bool) -> SmtpClient
        {
            let fd = socketCreateTcp();
            if !socketConnect(fd, host, port) {
                socketClose(fd);
                return SmtpClient { conn: -1, host: host, errorMessage: "connect failed (TLS)" };
            }
            let conn = httpConnFromFdTls(fd, host, verify);
            if conn <= 0 {
                return SmtpClient { conn: -1, host: host, errorMessage: "TLS handshake failed" };
            }
            return SmtpClient::finishConnect(conn, host);
        }

        // Shared tail of connect()/connectTls(): greeting + EHLO.
        fn finishConnect(conn: Int64, host: String) -> SmtpClient
        {
            if conn <= 0 {
                return SmtpClient { conn: -1, host: host, errorMessage: "connect failed" };
            }
            let greeting = SmtpClient::readReply(conn);
            if !greeting.startsWith("2") {
                httpConnClose(conn);
                return SmtpClient { conn: -1, host: host, errorMessage: "unexpected greeting: " + greeting };
            }
            var client: SmtpClient = SmtpClient { conn: conn, host: host, errorMessage: "" };
            if !client.ehlo() {
                httpConnClose(conn);
                client.conn = -1;
                client.errorMessage = "EHLO failed";
            }
            return client;
        }

        fn ehlo() -> Bool
        {
            httpConnSendRaw(this.conn, "EHLO localhost\r\n");
            return SmtpClient::readReply(this.conn).startsWith("2");
        }

        /*
         * RFC 3207: upgrades an already-connected plaintext session (port
         * 587 flow) to TLS in place. Sends STARTTLS, expects 220, hands
         * the underlying fd to httpConnFromFdTls (verify=true -- see
         * connectTls()'s doc for why v1 doesn't expose a toggle here),
         * then re-issues EHLO as RFC 3207 requires (the pre-TLS session
         * state, including any capabilities the server advertised, is
         * discarded on upgrade).
         */
        fn startTls() -> Bool
        {
            httpConnSendRaw(this.conn, "STARTTLS\r\n");
            if SmtpClient::readReply(this.conn) != "220" {
                return false;
            }
            let fd = httpConnTakeFd(this.conn);
            if fd < 0 {
                return false;
            }
            let tlsConn = httpConnFromFdTls(fd, this.host, true);
            if tlsConn <= 0 {
                return false;
            }
            this.conn = tlsConn;
            return this.ehlo();
        }

        /*
         * SASL PLAIN (RFC 4954 AUTH command + RFC 4616 mechanism),
         * single-step form (initial response inline with AUTH PLAIN,
         * which every real server supports per RFC 4954 §3). The raw
         * "\0user\0pass" payload is built as a List<Int64> byte array,
         * NOT a Tinox String -- a Tinox string is internally a C string,
         * so the embedded 0-bytes would silently truncate it at the
         * first one before it ever reached an encoder (the exact bug
         * Base64::encodeBytes's own doc comment describes finding via a
         * SCRAM e2e flake, issue 77). Base64::encodeBytes operates on
         * the byte array directly, so this never touches that path.
         */
        fn authPlain(user: String, pass: String) -> Bool
        {
            var bytes: List<Int64> = [];
            bytes.push(0);
            var i: Int64 = 0;
            while i < user.len() {
                bytes.push(user.charCodeAt(i));
                i = i + 1;
            }
            bytes.push(0);
            var j: Int64 = 0;
            while j < pass.len() {
                bytes.push(pass.charCodeAt(j));
                j = j + 1;
            }
            let encoded = Base64::encodeBytes(bytes);
            httpConnSendRaw(this.conn, "AUTH PLAIN " + encoded + "\r\n");
            return SmtpClient::readReply(this.conn) == "235";
        }

        /*
         * Sends a plain-text email: MAIL FROM -> RCPT TO (one per
         * recipient) -> DATA -> headers + body, dot-stuffed (RFC 5321
         * §4.5.2: any body line starting with '.' gets an extra leading
         * '.', or the server would misparse it as the end-of-data
         * marker) -> the "." terminator line.
         */
        fn send(from: String, to: List<String>, subject: String, body: String) -> Bool
        {
            httpConnSendRaw(this.conn, "MAIL FROM:<" + from + ">\r\n");
            if !SmtpClient::readReply(this.conn).startsWith("2") {
                return false;
            }

            var i: Int64 = 0;
            while i < to.len() {
                httpConnSendRaw(this.conn, "RCPT TO:<" + to[i] + ">\r\n");
                if !SmtpClient::readReply(this.conn).startsWith("2") {
                    return false;
                }
                i = i + 1;
            }

            httpConnSendRaw(this.conn, "DATA\r\n");
            if SmtpClient::readReply(this.conn) != "354" {
                return false;
            }

            var toHeader: String = "";
            var k: Int64 = 0;
            while k < to.len() {
                if k > 0 {
                    toHeader = toHeader + ", ";
                }
                toHeader = toHeader + to[k];
                k = k + 1;
            }

            let message = "From: " + from + "\r\nTo: " + toHeader + "\r\nSubject: " + subject + "\r\n\r\n" + body;
            let lines = message.split("\n");
            var m: Int64 = 0;
            while m < lines.len() {
                var line = lines[m];
                if line.endsWith("\r") {
                    line = line.substring(0, line.len() - 1);
                }
                if line.startsWith(".") {
                    line = "." + line;
                }
                httpConnSendRaw(this.conn, line + "\r\n");
                m = m + 1;
            }
            httpConnSendRaw(this.conn, ".\r\n");

            return SmtpClient::readReply(this.conn).startsWith("2");
        }

        fn close() -> Nothing
        {
            httpConnClose(this.conn);
        }

        /*
         * Reads one full SMTP reply, looping over continuation lines
         * (RFC 5321 §4.2.1: "<code>-<text>" for every line but the last,
         * "<code> <text>" for the final one) -- needed for e.g. EHLO's
         * multi-line capability list. Returns just the 3-digit code (the
         * only thing v1 needs); a too-short/malformed/EOF line returns
         * "" so every caller's startsWith("2")/=="235"/etc. check below
         * naturally fails closed instead of misreading garbage as success.
         */
        fn readReply(conn: Int64) -> String
        {
            var code: String = "";
            var done: Bool = false;
            while !done {
                let line = httpConnReadLine(conn);
                if line.len() < 4 {
                    return "";
                }
                code = line.substring(0, 3);
                if line.substring(3, 4) == " " {
                    done = true;
                }
            }
            return code;
        }
    }
}

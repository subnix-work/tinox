module tinox.core.oidc;

import tinox.core.oauth2;
import tinox.core.jwt;
import tinox.core.json;

namespace tinox.core.oidc
{
    /*
     * OIDC login on top of OAuth2Client's Authorization Code + PKCE flow
     * (issue #138, follow-up to #131/#137) -- runs the same flow, then
     * verifies the returned `id_token` (RS256 signature via the issuer's
     * JWKS, plus `iss`/`aud`/`exp`/`nbf`) instead of trusting it
     * unverified, and returns the token's claims (`sub`, `email`, ...).
     *
     * Flow (same shape as OAuth2Client, see its doc comment):
     *   1. buildAuthorizeUrl(scope) -- scope MUST include "openid" (RFC
     *      OIDC Core §3.1.2.1), checked eagerly here rather than surfacing
     *      as a confusing "no id_token" failure later at exchangeCode().
     *   2. Callback handler: check state (same as OAuth2Client), then
     *      exchangeCode(code, codeVerifier).
     *   3. refresh(refreshToken) later as needed.
     *
     * v1 gaps (see issue #138): no JWKS caching (fetches fresh every
     * verification), no client_credentials/implicit/device_code grants,
     * no token storage/session integration -- same stance as #131.
     */
    class OidcClient
    {
        var issuer: String;
        var jwksUri: String;
        var clientId: String;
        var oauth: OAuth2Client;

        fn new(issuer: String, authorizeUrl: String, tokenUrl: String, jwksUri: String, clientId: String, clientSecret: String, redirectUri: String) -> OidcClient
        {
            let oauth: OAuth2Client = OAuth2Client::new(authorizeUrl, tokenUrl, clientId, clientSecret, redirectUri);
            return OidcClient { issuer: issuer, jwksUri: jwksUri, clientId: clientId, oauth: oauth };
        }

        fn buildAuthorizeUrl(scope: String) -> OAuth2AuthorizeRequest
        {
            let parts: List<String> = scope.split(" ");
            var hasOpenid: Bool = false;
            var i: Int64 = 0;
            while i < parts.len()
            {
                if parts[i] == "openid"
                {
                    hasOpenid = true;
                }
                i = i + 1;
            }
            if !hasOpenid
            {
                throw "OidcClient::buildAuthorizeUrl: scope must include \"openid\" (no id_token will be issued otherwise)";
            }
            return this.oauth.buildAuthorizeUrl(scope);
        }

        fn exchangeCode(code: String, codeVerifier: String) -> OidcTokenResponse
        {
            let tr: OAuth2TokenResponse = this.oauth.exchangeCode(code, codeVerifier);
            if !tr.ok
            {
                return OidcTokenResponse { accessToken: "", refreshToken: "", tokenType: "", expiresIn: 0, idToken: "", claims: Map::new(), ok: false, errorMessage: tr.errorMessage };
            }
            if tr.idToken == ""
            {
                return OidcTokenResponse { accessToken: "", refreshToken: "", tokenType: "", expiresIn: 0, idToken: "", claims: Map::new(), ok: false, errorMessage: "token endpoint response has no id_token field (was \"openid\" included in the requested scope?)" };
            }
            return this.verifyAndWrap(tr);
        }

        /*
         * Providers are not required to reissue an id_token on a refresh
         * grant (unlike exchangeCode(), an empty idToken here is not an
         * error) -- if one comes back anyway, it is verified the same way.
         */
        fn refresh(refreshToken: String) -> OidcTokenResponse
        {
            let tr: OAuth2TokenResponse = this.oauth.refresh(refreshToken);
            if !tr.ok
            {
                return OidcTokenResponse { accessToken: "", refreshToken: "", tokenType: "", expiresIn: 0, idToken: "", claims: Map::new(), ok: false, errorMessage: tr.errorMessage };
            }
            if tr.idToken == ""
            {
                return OidcTokenResponse { accessToken: tr.accessToken, refreshToken: tr.refreshToken, tokenType: tr.tokenType, expiresIn: tr.expiresIn, idToken: "", claims: Map::new(), ok: true, errorMessage: "" };
            }
            return this.verifyAndWrap(tr);
        }

        fn verifyAndWrap(tr: OAuth2TokenResponse) -> OidcTokenResponse
        {
            var claims: Map<String, JsonValue> = Map::new();
            var verifyError: String = "";
            try
            {
                claims = this.verifyIdToken(tr.idToken);
            }
            catch e: String
            {
                verifyError = e;
            }

            if verifyError != ""
            {
                return OidcTokenResponse { accessToken: "", refreshToken: "", tokenType: "", expiresIn: 0, idToken: "", claims: Map::new(), ok: false, errorMessage: "id_token verification failed: " + verifyError };
            }

            return OidcTokenResponse { accessToken: tr.accessToken, refreshToken: tr.refreshToken, tokenType: tr.tokenType, expiresIn: tr.expiresIn, idToken: tr.idToken, claims: claims, ok: true, errorMessage: "" };
        }

        /*
         * Signature (RS256 via the issuer's JWKS) + iss/aud verification
         * (OIDC Core §3.1.3.7 steps 2/3; exp/nbf are already enforced by
         * Jwt::decodeRs256's checkTemporalClaims). Throws (String) on any
         * failure -- verifyAndWrap() turns that into `ok: false`.
         */
        fn verifyIdToken(idToken: String) -> Map<String, JsonValue>
        {
            let header: Map<String, JsonValue> = Jwt::extractHeader(idToken);
            if !header.contains("alg") || header["alg"].getString() != "RS256"
            {
                throw "unsupported id_token alg (expected RS256)";
            }
            var kid: String = "";
            if header.contains("kid")
            {
                kid = header["kid"].getString();
            }

            let key: Map<String, String> = Jwks::fetchRsaKey(this.jwksUri, kid);
            let claims: Map<String, JsonValue> = Jwt::decodeRs256(idToken, key["n"], key["e"]);

            if !claims.contains("iss") || claims["iss"].getString() != this.issuer
            {
                throw "id_token iss claim does not match expected issuer \"" + this.issuer + "\"";
            }

            if !claims.contains("aud")
            {
                throw "id_token missing aud claim";
            }
            var audMatches: Bool = false;
            if claims["aud"].isString()
            {
                audMatches = claims["aud"].getString() == this.clientId;
            }
            else if claims["aud"].isArray()
            {
                let auds: List<JsonValue> = claims["aud"].asList();
                var i: Int64 = 0;
                while i < auds.len()
                {
                    if auds[i].getString() == this.clientId
                    {
                        audMatches = true;
                    }
                    i = i + 1;
                }
            }
            if !audMatches
            {
                throw "id_token aud claim does not include this client_id";
            }

            return claims;
        }
    }
}

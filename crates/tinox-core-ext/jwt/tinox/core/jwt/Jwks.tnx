module tinox.core.jwt;

import tinox.core.http;
import tinox.core.json;

namespace tinox.core.jwt
{
    /*
     * Fetches a JWKS (JSON Web Key Set, RFC 7517 §5) document over HTTPS
     * and finds the RSA public key a token's signature should be verified
     * against (issue #138, OIDC ID-token verification). No caching in v1
     * -- every verification does a fresh fetch, acceptable for now, a
     * caching layer is separate follow-up work if this becomes a real
     * per-request cost.
     */
    class Jwks
    {
        /*
         * `kid` is the token header's "kid" claim, or "" if the token
         * omitted it (legal per RFC 7515 -- in that case the JWKS MUST
         * contain exactly one RSA key, otherwise which key to use is
         * genuinely ambiguous and picking the first one silently would
         * let a second/rotated key in the set substitute for the real
         * one). Returns {"n": ..., "e": ...} (still base64url-encoded
         * exactly as the JWKS serves them -- Jwt::decodeRs256/verifyRs256
         * decode them to raw bytes). Throws (never returns a partial/
         * empty result) on any network/HTTP error or on no-match/
         * ambiguous-match.
         */
        fn fetchRsaKey(jwksUri: String, kid: String) -> Map<String, String>
        {
            let resp = Http::get(jwksUri);
            if resp.statusCode() == 0
            {
                throw "network error fetching JWKS from " + jwksUri + " (connection failed or TLS/certificate error)";
            }
            if resp.statusCode() < 200 || resp.statusCode() >= 300
            {
                throw "JWKS endpoint " + jwksUri + " returned HTTP " + resp.statusCode().toString();
            }

            let doc: Map<String, JsonValue> = Json::parse(resp.body()).asTable();
            if !doc.contains("keys")
            {
                throw "JWKS document from " + jwksUri + " has no 'keys' field";
            }
            let keys: List<JsonValue> = doc["keys"].asList();

            var foundN: String = "";
            var foundE: String = "";
            var matches: Int64 = 0;
            var i: Int64 = 0;
            while i < keys.len()
            {
                let entry: Map<String, JsonValue> = keys[i].asTable();
                if entry.contains("kty") && entry["kty"].getString() == "RSA" && entry.contains("n") && entry.contains("e")
                {
                    var entryKid: String = "";
                    if entry.contains("kid")
                    {
                        entryKid = entry["kid"].getString();
                    }
                    if kid == "" || entryKid == kid
                    {
                        foundN = entry["n"].getString();
                        foundE = entry["e"].getString();
                        matches = matches + 1;
                    }
                }
                i = i + 1;
            }

            if matches == 0
            {
                throw "no matching RSA key found in JWKS (" + jwksUri + ") for kid \"" + kid + "\"";
            }
            if matches > 1
            {
                throw "ambiguous JWKS (" + jwksUri + "): multiple RSA keys match kid \"" + kid + "\"";
            }

            var result: Map<String, String> = Map::new();
            result.insert("n", foundN);
            result.insert("e", foundE);
            return result;
        }
    }
}

module tinox.core.jwt;

import tinox.core.base64;
import tinox.core.json;
import tinox.core.time;

namespace tinox.core.jwt
{
    // RS256 (RSASSA-PKCS1-v1_5 using SHA-256) signature verification against
    // an RSA public key's raw modulus/exponent bytes (JWK "n"/"e" fields,
    // base64url-decoded by the caller) -- issue #138 (OIDC ID-token
    // verification). Backed by OpenSSL's EVP_PKEY_fromdata (OSSL3 API, no
    // deprecated legacy RSA_* calls) in runtime.c, gated behind TINOX_TLS
    // like the rest of the OpenSSL-backed crypto in this codebase.
    extern fn rsaVerifySha256(message: List<Int64>, signature: List<Int64>, modulus: List<Int64>, exponent: List<Int64>) -> Bool;
    extern fn tinoxBytesToString(bytes: List<Int64>) -> String;

    class Jwt
    {
        /*
         * Issue #137: encode/decode/verify used to append/compare the HMAC
         * signature as raw hex text and base64-encode (not base64url) the
         * header/payload -- self-consistent (Tinox's own encode paired
         * correctly with its own decode/verify) but not a valid JWS Compact
         * Serialization (RFC 7519/7515): no real-world JWT library could
         * verify a Tinox-issued token, and Jwt::decode/verify couldn't
         * verify a token issued by any standard library or OIDC provider,
         * which blocked #131/#138 entirely. Fixed by using base64url (no
         * padding) for all three segments and the raw HMAC-SHA256 bytes
         * (via the bytes-safe `hmacSha256Bytes` builtin, no hex round-trip)
         * for the signature. This is a wire-format break for any
         * previously Tinox-issued token -- intentional, since the old
         * format was never spec-compliant to begin with.
         */
        fn encode(payload: Map<String, JsonValue>, secret: String) -> String
        {
            let headerB64: String = Base64::encodeUrlBytes(Jwt::stringToBytes("{\"alg\":\"HS256\",\"typ\":\"JWT\"}"));
            let payloadJson: String = Json::stringify(Json::fromMap(payload));
            let payloadB64: String = Base64::encodeUrlBytes(Jwt::stringToBytes(payloadJson));
            let message: String = headerB64 + "." + payloadB64;
            let sigBytes: List<Int64> = hmacSha256Bytes(Jwt::stringToBytes(message), Jwt::stringToBytes(secret));
            let signature: String = Base64::encodeUrlBytes(sigBytes);
            return message + "." + signature;
        }

        fn decode(token: String, secret: String) -> Map<String, JsonValue>
        {
            let parts: List<String> = token.split(".");
            if parts.len() != 3
            {
                throw "Invalid JWT format";
            }
            // Alg-confusion hardening: now that Jwt also supports RS256
            // (issue #138), decode() must reject anything but the alg it
            // was actually asked to verify -- otherwise a token signed
            // with a different/weaker scheme (or "none") could slip past
            // a signature check whose secret happens to still validate it.
            let header: Map<String, JsonValue> = Jwt::decodeSegment(parts[0]);
            if !header.contains("alg") || header["alg"].getString() != "HS256"
            {
                throw "Unexpected alg header (expected HS256)";
            }
            let message: String = parts[0] + "." + parts[1];
            let expectedSigBytes: List<Int64> = hmacSha256Bytes(Jwt::stringToBytes(message), Jwt::stringToBytes(secret));
            let expectedSig: String = Base64::encodeUrlBytes(expectedSigBytes);
            if expectedSig != parts[2]
            {
                throw "Invalid signature";
            }
            let payload: Map<String, JsonValue> = Jwt::decodeSegment(parts[1]);
            // Bug 105: a correctly-signed token was accepted regardless of
            // its exp/nbf claims -- isExpired() existed but neither verify()
            // nor decode() (the two actual authentication gates) called it.
            Jwt::checkTemporalClaims(payload);
            return payload;
        }

        fn verify(token: String, secret: String) -> Bool
        {
            let parts: List<String> = token.split(".");
            if parts.len() != 3
            {
                return false;
            }
            let header: Map<String, JsonValue> = Jwt::decodeSegment(parts[0]);
            if !header.contains("alg") || header["alg"].getString() != "HS256"
            {
                return false;
            }
            let message: String = parts[0] + "." + parts[1];
            let expectedSigBytes: List<Int64> = hmacSha256Bytes(Jwt::stringToBytes(message), Jwt::stringToBytes(secret));
            let expectedSig: String = Base64::encodeUrlBytes(expectedSigBytes);
            if expectedSig != parts[2]
            {
                return false;
            }
            let payload: Map<String, JsonValue> = Jwt::decodeSegment(parts[1]);
            let now: Int64 = Time::now() / 1000;
            if payload.contains("exp") && now > payload["exp"].asInt()
            {
                return false;
            }
            if payload.contains("nbf") && now < payload["nbf"].asInt()
            {
                return false;
            }
            return true;
        }

        /*
         * RS256 counterpart of decode()/verify() (issue #138, OIDC ID-token
         * verification) -- `n`/`e` are a JWK's RSA modulus/exponent fields,
         * still base64url-encoded exactly as JWKS serves them (decoded to
         * raw bytes here, right before rsaVerifySha256). Same alg-header
         * strictness as decode(): rejects anything but "RS256", so an
         * attacker can't substitute a cheaper-to-forge scheme.
         */
        fn decodeRs256(token: String, n: String, e: String) -> Map<String, JsonValue>
        {
            let parts: List<String> = token.split(".");
            if parts.len() != 3
            {
                throw "Invalid JWT format";
            }
            let header: Map<String, JsonValue> = Jwt::decodeSegment(parts[0]);
            if !header.contains("alg") || header["alg"].getString() != "RS256"
            {
                throw "Unexpected alg header (expected RS256)";
            }
            let message: String = parts[0] + "." + parts[1];
            let sigBytes: List<Int64> = Base64::decodeUrlBytes(parts[2]);
            let nBytes: List<Int64> = Base64::decodeUrlBytes(n);
            let eBytes: List<Int64> = Base64::decodeUrlBytes(e);
            if !rsaVerifySha256(Jwt::stringToBytes(message), sigBytes, nBytes, eBytes)
            {
                throw "Invalid signature";
            }
            let payload: Map<String, JsonValue> = Jwt::decodeSegment(parts[1]);
            Jwt::checkTemporalClaims(payload);
            return payload;
        }

        fn verifyRs256(token: String, n: String, e: String) -> Bool
        {
            let parts: List<String> = token.split(".");
            if parts.len() != 3
            {
                return false;
            }
            let header: Map<String, JsonValue> = Jwt::decodeSegment(parts[0]);
            if !header.contains("alg") || header["alg"].getString() != "RS256"
            {
                return false;
            }
            let message: String = parts[0] + "." + parts[1];
            let sigBytes: List<Int64> = Base64::decodeUrlBytes(parts[2]);
            let nBytes: List<Int64> = Base64::decodeUrlBytes(n);
            let eBytes: List<Int64> = Base64::decodeUrlBytes(e);
            if !rsaVerifySha256(Jwt::stringToBytes(message), sigBytes, nBytes, eBytes)
            {
                return false;
            }
            let payload: Map<String, JsonValue> = Jwt::decodeSegment(parts[1]);
            let now: Int64 = Time::now() / 1000;
            if payload.contains("exp") && now > payload["exp"].asInt()
            {
                return false;
            }
            if payload.contains("nbf") && now < payload["nbf"].asInt()
            {
                return false;
            }
            return true;
        }

        /*
         * Bug 105: shared exp/nbf check for decode() (throws, since decode()
         * already throws on format/signature errors). verify() inlines the
         * same two checks since it returns Bool instead.
         */
        fn checkTemporalClaims(payload: Map<String, JsonValue>) -> Nothing
        {
            let now: Int64 = Time::now() / 1000;
            if payload.contains("exp") && now > payload["exp"].asInt()
            {
                throw "Token expired";
            }
            if payload.contains("nbf") && now < payload["nbf"].asInt()
            {
                throw "Token not yet valid (nbf)";
            }
        }

        // Shared base64url-segment-to-JSON-object decode for header/payload
        // (both are JSON objects per RFC 7515 §3).
        fn decodeSegment(part: String) -> Map<String, JsonValue>
        {
            let json: String = Jwt::bytesToString(Base64::decodeUrlBytes(part));
            return Json::parse(json).asTable();
        }

        // Issue #138: OidcClient needs the header (for "alg"/"kid") before
        // it knows which key to verify the signature with, so this must be
        // exposed independently of extractPayload()/decode() and MUST NOT
        // itself verify the signature (there is nothing to verify against
        // yet at this point in the OIDC flow).
        fn extractHeader(token: String) -> Map<String, JsonValue>
        {
            let parts: List<String> = token.split(".");
            if parts.len() != 3
            {
                throw "Invalid JWT format";
            }
            return Jwt::decodeSegment(parts[0]);
        }

        fn extractPayload(token: String) -> Map<String, JsonValue>
        {
            let parts: List<String> = token.split(".");
            if parts.len() != 3
            {
                throw "Invalid JWT format";
            }
            return Jwt::decodeSegment(parts[1]);
        }

        fn isExpired(token: String) -> Bool
        {
            let payload: Map<String, JsonValue> = Jwt::extractPayload(token);
            if payload.contains("exp")
            {
                let exp: Int64 = payload["exp"].asInt();
                let now: Int64 = Time::now() / 1000;
                return now > exp;
            }
            return false;
        }

        // ASCII/UTF-8 bytes of a string -- JWS header/payload JSON never
        // contains a raw NUL byte (JSON escapes control characters), so
        // the round-trip through a Tinox String (C-string, strlen-based)
        // is safe here, unlike raw binary data (see Base64::decodeBytes'
        // comment for the general hazard).
        fn stringToBytes(s: String) -> List<Int64>
        {
            var bytes: List<Int64> = [];
            var i: Int64 = 0;
            while i < s.len()
            {
                bytes.push(s.charCodeAt(i) & 0xFF);
                i = i + 1;
            }
            return bytes;
        }

        fn bytesToString(b: List<Int64>) -> String
        {
            // tinoxBytesToString does the byte->char conversion in one
            // pass instead of `s = s + fromCharCode(...)` in a loop, which
            // is O(n^2) over the string length (issue #167).
            return tinoxBytesToString(b);
        }
    }
}

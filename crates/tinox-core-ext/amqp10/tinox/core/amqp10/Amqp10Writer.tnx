module tinox.core.amqp10;

import tinox.core.socket;
import tinox.core.base64;

namespace tinox.core.amqp10
{
    /*
     * Byte builder for the AMQP-1.0 type-system encoding (big-endian).
     * ALWAYS writes the full width (no smalluint/uint0/etc. picking —
     * that's only an optional size optimization, not a correctness
     * requirement) AND for variable width (binary/string/symbol/list/map)
     * ALWAYS the 32-bit form — unlike 0-9-1's shortstr/longstr two-method
     * distinction, there's no size cutover branch here and no artificial
     * 255-byte error boundary: the 32-bit form is spec-compliant for ANY
     * length, it just costs a few more bytes for small values. The reader
     * still MUST be able to read all short forms, because the broker is
     * allowed to use them (asymmetric, same as with 0-9-1).
     */
    class Amqp10Writer
    {
        var bytes: List<Int64>;

        fn new() -> Amqp10Writer
        {
            return Amqp10Writer { bytes: [] };
        }

        fn pushU8(v: Int64) -> Nothing
        {
            this.bytes.push(v & 0xFF);
        }

        fn pushU16(v: Int64) -> Nothing
        {
            this.bytes.push((v >> 8) & 0xFF);
            this.bytes.push(v & 0xFF);
        }

        fn pushU32(v: Int64) -> Nothing
        {
            this.bytes.push((v >> 24) & 0xFF);
            this.bytes.push((v >> 16) & 0xFF);
            this.bytes.push((v >> 8) & 0xFF);
            this.bytes.push(v & 0xFF);
        }

        fn pushU64(v: Int64) -> Nothing
        {
            var shift: Int64 = 56;
            while shift >= 0 {
                this.bytes.push((v >> shift) & 0xFF);
                shift = shift - 8;
            }
        }

        fn pushRawStr(s: String) -> Nothing
        {
            for i in 0..s.len() {
                this.bytes.push(s.charCodeAt(i) & 0xFF);
            }
        }

        fn pushRawBytes(data: List<Int64>) -> Nothing
        {
            for i in 0..data.len() {
                this.bytes.push(data[i] & 0xFF);
            }
        }

        fn writeNull() -> Nothing
        {
            this.pushU8(0x40);
        }

        fn writeBoolean(v: Bool) -> Nothing
        {
            this.pushU8(0x56);
            if v {
                this.pushU8(1);
            } else {
                this.pushU8(0);
            }
        }

        fn writeUbyte(v: Int64) -> Nothing
        {
            this.pushU8(0x50);
            this.pushU8(v);
        }

        fn writeUshort(v: Int64) -> Nothing
        {
            this.pushU8(0x60);
            this.pushU16(v);
        }

        fn writeUint(v: Int64) -> Nothing
        {
            this.pushU8(0x70);
            this.pushU32(v);
        }

        fn writeUlong(v: Int64) -> Nothing
        {
            this.pushU8(0x80);
            this.pushU64(v);
        }

        fn writeByte(v: Int64) -> Nothing
        {
            this.pushU8(0x51);
            this.pushU8(v);
        }

        fn writeShort(v: Int64) -> Nothing
        {
            this.pushU8(0x61);
            this.pushU16(v);
        }

        fn writeInt(v: Int64) -> Nothing
        {
            this.pushU8(0x71);
            this.pushU32(v);
        }

        fn writeLong(v: Int64) -> Nothing
        {
            this.pushU8(0x81);
            this.pushU64(v);
        }

        fn writeChar(v: Int64) -> Nothing
        {
            this.pushU8(0x73);
            this.pushU32(v);
        }

        fn writeTimestamp(v: Int64) -> Nothing
        {
            this.pushU8(0x83);
            this.pushU64(v);
        }

        /* `bytes` must have exactly 16 elements (caller's responsibility,
         * analogous to 0-9-1's unchecked bounds assumptions for frame
         * payloads). */
        fn writeUuid(uuidBytes: List<Int64>) -> Nothing
        {
            this.pushU8(0x98);
            this.pushRawBytes(uuidBytes);
        }

        fn writeBinary(data: List<Int64>) -> Nothing
        {
            this.pushU8(0xb0);
            this.pushU32(data.len());
            this.pushRawBytes(data);
        }

        fn writeString(s: String) -> Nothing
        {
            this.pushU8(0xb1);
            this.pushU32(s.len());
            this.pushRawStr(s);
        }

        fn writeSymbol(s: String) -> Nothing
        {
            this.pushU8(0xb3);
            this.pushU32(s.len());
            this.pushRawStr(s);
        }

        fn writeList(items: List<Amqp10Value>) -> Nothing
        {
            let inner = Amqp10Writer::new();
            for i in 0..items.len() {
                inner.writeValue(items[i]);
            }
            this.pushU8(0xd0);
            this.pushU32(4 + inner.bytes.len());
            this.pushU32(items.len());
            this.pushRawBytes(inner.bytes);
        }

        /* `pairs` is flat (key0, val0, key1, val1, ...) — MUST have an
         * even number of elements (caller's responsibility). */
        fn writeMap(pairs: List<Amqp10Value>) -> Nothing
        {
            let inner = Amqp10Writer::new();
            for i in 0..pairs.len() {
                inner.writeValue(pairs[i]);
            }
            this.pushU8(0xd1);
            this.pushU32(4 + inner.bytes.len());
            this.pushU32(pairs.len());
            this.pushRawBytes(inner.bytes);
        }

        /* Descriptor always as smallulong (0x53 + 1 byte) — every
         * descriptor code used in v1 is < 256 (performatives 0x10-0x18,
         * SASL 0x40-0x44, sections 0x70-0x78), see Amqp10Described. */
        fn writeDescribed(d: Amqp10Described) -> Nothing
        {
            this.pushU8(0x00);
            this.pushU8(0x53);
            this.pushU8(d.descriptor);
            this.writeValue(d.value);
        }

        fn writeValue(v: Amqp10Value) -> Nothing
        {
            match v
            {
                NullVal => { this.writeNull(); }
                BoolVal(b) => { this.writeBoolean(b); }
                UByteVal(n) => { this.writeUbyte(n); }
                UShortVal(n) => { this.writeUshort(n); }
                UIntVal(n) => { this.writeUint(n); }
                ULongVal(n) => { this.writeUlong(n); }
                ByteVal(n) => { this.writeByte(n); }
                ShortVal(n) => { this.writeShort(n); }
                IntVal(n) => { this.writeInt(n); }
                LongVal(n) => { this.writeLong(n); }
                CharVal(n) => { this.writeChar(n); }
                TimestampVal(n) => { this.writeTimestamp(n); }
                UuidVal(b) => { this.writeUuid(b); }
                BinaryVal(b) => { this.writeBinary(b); }
                StrVal(s) => { this.writeString(s); }
                SymbolVal(s) => { this.writeSymbol(s); }
                ListVal(items) => { this.writeList(items); }
                MapVal(pairs) => { this.writeMap(pairs); }
                DescribedVal(d) => { this.writeDescribed(d); }
                ErrorVal(_msg) => {
                    // An ErrorVal is never sent (decode result only) — no
                    // silent garbage: a hard null marker instead of
                    // staying quiet if it's ever accidentally re-encoded
                    // (analogous to 0-9-1's AmqpFieldValue091::ErrorVal
                    // handling).
                    this.writeNull();
                }
            }
        }
    }
}

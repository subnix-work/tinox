module tinox.core.amqp10;

import tinox.core.socket;
import tinox.core.base64;

namespace tinox.core.amqp10
{
    /*
     * An AMQP-1.0 frame that was read (§2.3.1). frameType: 0 = AMQP
     * frame, 1 = SASL frame (the broker may send both on the same
     * connection, depending on the negotiation phase); additionally as
     * a read result: -1 = connection closed/EOF, -2 = protocol error
     * (implausible size/doff, see Amqp10::readFrame).
     */
    class Amqp10Frame
    {
        var frameType: Int64;
        var chanId: Int64;
        var body: List<Int64>;
    }
}

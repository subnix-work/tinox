module tinox.core.amqp10;

import tinox.core.socket;
import tinox.core.base64;

namespace tinox.core.amqp10
{
    extern fn tinoxBytesToString(bytes: List<Int64>) -> String;

    /*
     * Counterpart to Amqp10Writer: reads big-endian from `bytes` starting
     * at an internal cursor position `pos`. Format-code driven — unlike
     * 0-9-1's AmqpReader091 (where the caller says WHICH type it expects
     * at this position), here the next format-code byte ALWAYS
     * determines the type itself (readValue()). No array-level bounds
     * check (caller MUST know the frame size beforehand, same as 0-9-1).
     */
    class Amqp10Reader
    {
        var bytes: List<Int64>;
        var pos: Int64;
        // Bug 86: sticky flag set once a read runs past the end of `bytes`.
        // A malicious/compromised broker frame (or a genuine but truncated
        // one) can be shorter than what the format codes inside it claim —
        // readU8() used to index straight into `bytes` and hard-crash the
        // whole client process. Now it returns a dummy 0 and sets this
        // instead, and readValueOfCode() short-circuits to ErrorVal once
        // it's set, so decoding a truncated body fails gracefully (like
        // the existing "unknown format code" error path) instead of
        // crashing or recursing forever on the dummy 0x00 bytes.
        var truncated: Bool;

        fn new(bytes: List<Int64>) -> Amqp10Reader
        {
            return Amqp10Reader { bytes: bytes, pos: 0, truncated: false };
        }

        fn remaining() -> Int64
        {
            return this.bytes.len() - this.pos;
        }

        fn readU8() -> Int64
        {
            if this.pos >= this.bytes.len() {
                this.truncated = true;
                return 0;
            }
            let v = this.bytes[this.pos];
            this.pos = this.pos + 1;
            return v;
        }

        fn readU16() -> Int64
        {
            let hi = this.readU8();
            let lo = this.readU8();
            return (hi << 8) | lo;
        }

        fn readU32() -> Int64
        {
            var v: Int64 = 0;
            for i in 0..4 {
                v = (v << 8) | this.readU8();
            }
            return v;
        }

        fn readU64() -> Int64
        {
            var v: Int64 = 0;
            for i in 0..8 {
                v = (v << 8) | this.readU8();
            }
            return v;
        }

        fn toSigned8(v: Int64) -> Int64
        {
            if v >= 128 {
                return v - 256;
            }
            return v;
        }

        fn toSigned16(v: Int64) -> Int64
        {
            if v >= 32768 {
                return v - 65536;
            }
            return v;
        }

        fn toSigned32(v: Int64) -> Int64
        {
            if v >= 2147483648 {
                return v - 4294967296;
            }
            return v;
        }

        fn readRawStr(n: Int64) -> String
        {
            // Collects bytes into a List<Int64> and converts in one pass
            // (tinoxBytesToString) instead of `s = s + fromCharCode(...)`
            // in the loop, which is O(n^2) over the string length (issue #167).
            var bytes: List<Int64> = [];
            for i in 0..n {
                // Bug 86: a broker-controlled length prefix (n) can vastly
                // exceed the actual remaining bytes — stop as soon as we
                // run out instead of looping n times over dummy 0 bytes.
                if this.truncated { break; }
                let b = this.readU8();
                bytes.push(b);
            }
            return tinoxBytesToString(bytes);
        }

        fn readRawBytes(n: Int64) -> List<Int64>
        {
            var out: List<Int64> = [];
            for i in 0..n {
                if this.truncated { break; }
                out.push(this.readU8());
            }
            return out;
        }

        /* Reads ONE value of the given format code (without reading the
         * code byte itself — for array elements it's present only ONCE
         * before all elements, see readArray). readValue() is the normal
         * entry point (reads the code byte itself); this here is the
         * shared core for both cases. */
        fn readValueOfCode(code: Int64) -> Amqp10Value
        {
            // Bug 86: once truncated, `code` is a dummy 0x00 — dispatching
            // it to the 0x00 branch below (readDescribed(), which itself
            // calls readValue() twice) would recurse forever, since every
            // further readU8() also returns dummy 0x00. Bail out here
            // instead, same error-marker convention as the other fatal
            // parse-error branches at the bottom of this function.
            if this.truncated {
                return Amqp10Value::ErrorVal("truncated: unexpected end of input");
            }
            if code == 0x40 { return Amqp10Value::NullVal; }
            if code == 0x41 { return Amqp10Value::BoolVal(true); }
            if code == 0x42 { return Amqp10Value::BoolVal(false); }
            if code == 0x56 { return Amqp10Value::BoolVal(this.readU8() != 0); }
            if code == 0x50 { return Amqp10Value::UByteVal(this.readU8()); }
            if code == 0x60 { return Amqp10Value::UShortVal(this.readU16()); }
            if code == 0x70 { return Amqp10Value::UIntVal(this.readU32()); }
            if code == 0x52 { return Amqp10Value::UIntVal(this.readU8()); }
            if code == 0x43 { return Amqp10Value::UIntVal(0); }
            if code == 0x80 { return Amqp10Value::ULongVal(this.readU64()); }
            if code == 0x53 { return Amqp10Value::ULongVal(this.readU8()); }
            if code == 0x44 { return Amqp10Value::ULongVal(0); }
            if code == 0x51 { return Amqp10Value::ByteVal(this.toSigned8(this.readU8())); }
            if code == 0x61 { return Amqp10Value::ShortVal(this.toSigned16(this.readU16())); }
            if code == 0x71 { return Amqp10Value::IntVal(this.toSigned32(this.readU32())); }
            if code == 0x54 { return Amqp10Value::IntVal(this.toSigned8(this.readU8())); }
            if code == 0x81 { return Amqp10Value::LongVal(this.readU64()); }
            if code == 0x55 { return Amqp10Value::LongVal(this.toSigned8(this.readU8())); }
            if code == 0x73 { return Amqp10Value::CharVal(this.readU32()); }
            if code == 0x83 { return Amqp10Value::TimestampVal(this.readU64()); }
            if code == 0x98 { return Amqp10Value::UuidVal(this.readRawBytes(16)); }
            if code == 0xa0 { return Amqp10Value::BinaryVal(this.readRawBytes(this.readU8())); }
            if code == 0xb0 { return Amqp10Value::BinaryVal(this.readRawBytes(this.readU32())); }
            if code == 0xa1 { return Amqp10Value::StrVal(this.readRawStr(this.readU8())); }
            if code == 0xb1 { return Amqp10Value::StrVal(this.readRawStr(this.readU32())); }
            if code == 0xa3 { return Amqp10Value::SymbolVal(this.readRawStr(this.readU8())); }
            if code == 0xb3 { return Amqp10Value::SymbolVal(this.readRawStr(this.readU32())); }
            if code == 0x45 { return Amqp10Value::ListVal([]); }
            if code == 0xc0 { return this.readList(this.readU8(), this.readU8()); }
            if code == 0xd0 { return this.readList(this.readU32(), this.readU32()); }
            if code == 0xc1 { return this.readMap(this.readU8(), this.readU8()); }
            if code == 0xd1 { return this.readMap(this.readU32(), this.readU32()); }
            if code == 0xe0 { return this.readArray(this.readU8(), this.readU8()); }
            if code == 0xf0 { return this.readArray(this.readU32(), this.readU32()); }
            if code == 0x00 { return this.readDescribed(); }
            // float/double/decimal32/64/128: not supported (see the
            // Amqp10Value comment) — the cursor still advances correctly
            // (no resync loss for subsequent fields), but the value
            // itself is a hard error marker instead of silent garbage.
            if code == 0x72 { this.readU32(); return Amqp10Value::ErrorVal("float not supported in v1"); }
            if code == 0x82 { this.readU64(); return Amqp10Value::ErrorVal("double not supported in v1"); }
            if code == 0x74 { this.readU32(); return Amqp10Value::ErrorVal("decimal32 not supported in v1"); }
            if code == 0x84 { this.readU64(); return Amqp10Value::ErrorVal("decimal64 not supported in v1"); }
            if code == 0x94 { this.readRawBytes(16); return Amqp10Value::ErrorVal("decimal128 not supported in v1"); }
            // Unknown format code: width unknown, the cursor CANNOT be
            // safely resynchronized — a fatal error, caller MUST abort
            // the whole decode (analogous to 0-9-1's frameType -2).
            return Amqp10Value::ErrorVal("unknown format code: " + code.toString());
        }

        fn readValue() -> Amqp10Value
        {
            return this.readValueOfCode(this.readU8());
        }

        fn readList(size: Int64, count: Int64) -> Amqp10Value
        {
            var items: List<Amqp10Value> = [];
            for i in 0..count {
                // Bug 86: count is broker-controlled (up to 2^32-1 for a
                // list32) and unrelated to the actual remaining bytes —
                // stop once truncated instead of looping count times.
                if this.truncated { break; }
                items.push(this.readValue());
            }
            return Amqp10Value::ListVal(items);
        }

        fn readMap(size: Int64, count: Int64) -> Amqp10Value
        {
            var pairs: List<Amqp10Value> = [];
            for i in 0..count {
                if this.truncated { break; }
                pairs.push(this.readValue());
            }
            return Amqp10Value::MapVal(pairs);
        }

        /* Array elements share ONE format code (after size+count), each
         * element itself no longer has its own code byte — hence
         * readValueOfCode(elementCode) instead of readValue() in the
         * loop. */
        fn readArray(size: Int64, count: Int64) -> Amqp10Value
        {
            let elementCode = this.readU8();
            var items: List<Amqp10Value> = [];
            for i in 0..count {
                if this.truncated { break; }
                items.push(this.readValueOfCode(elementCode));
            }
            return Amqp10Value::ListVal(items);
        }

        /* The descriptor is read generically as an Amqp10Value (the spec
         * allows any value as a descriptor), but v1 accepts ONLY numeric
         * descriptors (see Amqp10Described) — anything else is a hard
         * error instead of a silently ignored descriptor. */
        fn readDescribed() -> Amqp10Value
        {
            let descVal = this.readValue();
            var descriptor: Int64 = -1;
            var descOk: Bool = false;
            match descVal
            {
                UByteVal(n) => { descriptor = n; descOk = true; }
                UShortVal(n) => { descriptor = n; descOk = true; }
                UIntVal(n) => { descriptor = n; descOk = true; }
                ULongVal(n) => { descriptor = n; descOk = true; }
                _ => {}
            }
            let inner = this.readValue();
            if !descOk {
                return Amqp10Value::ErrorVal("described type with a non-numeric descriptor (not supported in v1)");
            }
            return Amqp10Value::DescribedVal(Amqp10Described { descriptor: descriptor, value: inner });
        }
    }
}

module tinox.core.amqp10;

import tinox.core.socket;
import tinox.core.base64;

namespace tinox.core.amqp10
{
    /*
     * A decoded performative wrapper (§2.3.1: each of the 9
     * performatives is a described list — ONE generic encoding for all
     * of them, unlike 0-9-1's classId+methodId+method-specific field
     * schema). descriptor: -1 = decode error (unexpected structure —
     * see Amqp10::decodePerformative). fields are POSITIONAL, field
     * meaning comes from the respective performative spec, not from
     * this generic building block.
     */
    class Amqp10Performative
    {
        var descriptor: Int64;
        var fields: List<Amqp10Value>;
    }
}

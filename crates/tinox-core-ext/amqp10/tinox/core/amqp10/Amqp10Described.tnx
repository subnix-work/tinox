module tinox.core.amqp10;

import tinox.core.socket;
import tinox.core.base64;

namespace tinox.core.amqp10
{
    /*
     * A described-type value (type system §1.2): format code 0x00 +
     * descriptor + value. v1 restricts the descriptor to Int64
     * (numeric, encoded as smallulong) — covers all 9 performatives, the
     * 5 SASL frame types, and the 9 message section types (all use
     * numeric ulong descriptors per spec); symbol descriptors (the other
     * form the spec allows) don't occur in the AMQP core protocol.
     */
    class Amqp10Described
    {
        var descriptor: Int64;
        var value: Amqp10Value;
    }
}

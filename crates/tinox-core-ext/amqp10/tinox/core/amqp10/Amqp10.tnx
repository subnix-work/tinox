module tinox.core.amqp10;

import tinox.core.socket;
import tinox.core.base64;

namespace tinox.core.amqp10
{
    extern fn tinoxBytesToString(bytes: List<Int64>) -> String;

    class Amqp10
    {
        /*
         * Connects to the broker (raw TCP), still WITHOUT the protocol
         * handshake. Returns: conn handle (>0) or -1 on connection error.
         */
        fn dial(host: String, port: Int64) -> Int64
        {
            let fd = socketCreateTcp();
            if !socketConnect(fd, host, port) {
                // Bug 90 (same leak found in the sibling amqp091 module):
                // a reconnect loop against an unreachable/refusing broker
                // used to leak `fd` on every attempt.
                socketClose(fd);
                return -1;
            }
            return httpConnFromFd(fd);
        }

        /*
         * amqps:// — TLS variant of dial(). OpenSSL is linked by default
         * (see HttpServer::listenTls); built with TINOX_TLS=0,
         * httpConnFromFdTls returns -1. verify=true checks the
         * certificate chain + hostname against the system CA stores;
         * verify=false is a deliberate opt-out for self-signed test
         * certificates.
         */
        fn dialTls(host: String, port: Int64, verify: Bool) -> Int64
        {
            let fd = socketCreateTcp();
            if !socketConnect(fd, host, port) {
                // Bug 90: same fd leak as dial() above.
                socketClose(fd);
                return -1;
            }
            return httpConnFromFdTls(fd, host, verify);
        }

        /*
         * Sends the 8-byte AMQP protocol header (protocol-id 0):
         * "AMQP" 0x00 0x01 0x00 0x00.
         */
        fn sendAmqpProtocolHeader(conn: Int64) -> Nothing
        {
            httpConnWriteBytes(conn, [65, 77, 81, 80, 0, 1, 0, 0]);
        }

        /*
         * Sends the 8-byte SASL protocol header (protocol-id 3):
         * "AMQP" 0x03 0x01 0x00 0x00. Runs BEFORE the AMQP header on the
         * same connection when SASL auth is used (v1 always does, same
         * as 0-9-1's SASL PLAIN path).
         */
        fn sendSaslProtocolHeader(conn: Int64) -> Nothing
        {
            httpConnWriteBytes(conn, [65, 77, 81, 80, 3, 1, 0, 0]);
        }

        /*
         * Reads 8 bytes and compares them exactly against the previously
         * sent header (§2.2: the receiver confirms a supported version
         * by sending back the SAME header — unlike 0-9-1, where success
         * is recognized by the first byte of a real frame instead of an
         * echoed header). An unequal header (broker proposes a different
         * version) OR EOF/short read both count as a hard failure; the
         * caller then closes the connection.
         */
        fn checkProtocolHeaderEcho(conn: Int64, sent: List<Int64>) -> Bool
        {
            let resp = httpConnReadN(conn, 8);
            if resp.len() != 8 {
                return false;
            }
            for i in 0..8 {
                if resp[i] != sent[i] {
                    return false;
                }
            }
            return true;
        }

        /*
         * Reads ONE frame (§2.3.1): size(4B) | doff(1B) | type(1B) |
         * chanId(2B) | [extended header, (doff-2)*4 bytes] | body. `size`
         * is the TOTAL size including the 8 fixed header bytes (unlike
         * 0-9-1's `long`, which only counts the payload length). The
         * extended header is read and discarded (v1 doesn't use it, but
         * brokers are allowed to set it — skip instead of crashing).
         * Malformed size/doff (smaller than the fixed header, or header
         * > size) are a hard protocol error (-2) instead of silent
         * garbage, exactly like 0-9-1's frame-terminator check.
         */
        fn readFrame(conn: Int64) -> Amqp10Frame
        {
            let bad = Amqp10Frame { frameType: -1, chanId: 0, body: [] };
            let hdr = httpConnReadN(conn, 8);
            if hdr.len() < 8 {
                return bad;
            }
            let size = (hdr[0] << 24) | (hdr[1] << 16) | (hdr[2] << 8) | hdr[3];
            let doff = hdr[4];
            let frameType = hdr[5];
            let chanId = (hdr[6] << 8) | hdr[7];
            if size < 8 || doff < 2 {
                return Amqp10Frame { frameType: -2, chanId: chanId, body: [] };
            }
            let headerBytes = doff * 4;
            if headerBytes > size {
                return Amqp10Frame { frameType: -2, chanId: chanId, body: [] };
            }
            let extendedBytes = headerBytes - 8;
            if extendedBytes > 0 {
                let ext = httpConnReadN(conn, extendedBytes);
                if ext.len() < extendedBytes {
                    return bad;
                }
            }
            let bodyBytes = size - headerBytes;
            if bodyBytes > 16777216 {
                return Amqp10Frame { frameType: -2, chanId: chanId, body: [] };
            }
            var body: List<Int64> = [];
            if bodyBytes > 0 {
                let raw = httpConnReadN(conn, bodyBytes);
                if raw.len() < bodyBytes {
                    return bad;
                }
                body = raw;
            }
            return Amqp10Frame { frameType: frameType, chanId: chanId, body: body };
        }

        /*
         * Like readFrame(), but absorbs incoming heartbeat frames (§2.4.5:
         * an "empty frame", i.e. a frame with no body at all) instead of
         * passing them through to the caller (issue 82). The broker may
         * send a heartbeat at any time once `open`/`open-ok` have
         * negotiated the idle-time-out — every call site that waits for
         * a REAL performative (currently: nextMessage(), which blocks
         * for a long time waiting for the next transfer, see
         * Amqp10Link), MUST transparently skip heartbeats instead of
         * wrongly treating them as a protocol error. Other call sites
         * (begin/attach/detach/end/close) stay on readFrame() — there,
         * never enough time passes between send and expected response
         * for a heartbeat to land in between (a v1 assumption, analogous
         * to awaitFlow()'s comment about the missing real frame
         * dispatcher).
         */
        fn readFrameSkipHeartbeats(conn: Int64) -> Amqp10Frame
        {
            while true {
                let f = Amqp10::readFrame(conn);
                if f.frameType < 0 {
                    return f; // EOF/protocol error, passed through unchanged
                }
                if f.body.len() > 0 {
                    return f; // a real frame
                }
                // Empty body = heartbeat: absorb, keep waiting.
            }
            return Amqp10Frame { frameType: -1, chanId: 0, body: [] };
        }

        /*
         * Writes a frame (§2.3.1). v1: `doff` is always 2 (no extended
         * header) — the caller decides the 0/1 frame-type distinction
         * (AMQP/SASL) depending on the handshake phase.
         */
        fn writeFrame(conn: Int64, frameType: Int64, chanId: Int64, body: List<Int64>) -> Nothing
        {
            let w = Amqp10Writer::new();
            w.pushU32(8 + body.len());
            w.pushU8(2);
            w.pushU8(frameType);
            w.pushU16(chanId);
            w.pushRawBytes(body);
            httpConnWriteBytes(conn, w.bytes);
        }

        /*
         * Builds the frame body of a performative (§2.3.1): a described
         * type with `descriptorCode` (as smallulong) + a ListVal of the
         * positional fields — ONE generic building block for all 9
         * performatives, unlike 0-9-1's method-specific
         * encodeMethodPayload (classId+methodId+its own argument schema
         * per method).
         */
        fn encodePerformative(descriptorCode: Int64, fields: List<Amqp10Value>) -> List<Int64>
        {
            let w = Amqp10Writer::new();
            let d = Amqp10Described { descriptor: descriptorCode, value: Amqp10Value::ListVal(fields) };
            w.writeDescribed(d);
            return w.bytes;
        }

        /*
         * Splits a frame body into a descriptor code + positional
         * fields. Expects EXACTLY the structure encodePerformative
         * produces (a described type over a ListVal) — any deviation
         * (not a described type, the value isn't a list, a non-numeric
         * descriptor) is a hard error: descriptor -1, empty fields, no
         * best-effort parsing.
         */
        fn decodePerformative(body: List<Int64>) -> Amqp10Performative
        {
            let r = Amqp10Reader::new(body);
            let v = r.readValue();
            var descriptor: Int64 = -1;
            var fields: List<Amqp10Value> = [];
            match v
            {
                DescribedVal(d) => {
                    match d.value
                    {
                        ListVal(innerFields) => {
                            descriptor = d.descriptor;
                            fields = innerFields;
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
            return Amqp10Performative { descriptor: descriptor, fields: fields };
        }

        /*
         * Builds the frame body of a message (§3.2): a `properties`
         * section (0x73, only `content-type` set, all preceding fields
         * as placeholders — list fields may only be omitted at the END)
         * followed by a `data` section (0x75, raw-bytes body). v1
         * deliberately uses ONLY these two sections (no `header`, no
         * `application-properties`) — analogous to 0-9-1's
         * content-type/body concept, but as its own described-type
         * sections instead of a separate content-header frame.
         */
        fn encodeMessageBody(body: List<Int64>, contentType: String) -> List<Int64>
        {
            let w = Amqp10Writer::new();
            var propFields: List<Amqp10Value> = [
                Amqp10Value::NullVal, // message-id
                Amqp10Value::NullVal, // user-id
                Amqp10Value::NullVal, // to
                Amqp10Value::NullVal, // subject
                Amqp10Value::NullVal, // reply-to
                Amqp10Value::NullVal, // correlation-id
                Amqp10Value::SymbolVal(contentType)
            ];
            let propDesc = Amqp10Described { descriptor: 0x73, value: Amqp10Value::ListVal(propFields) };
            w.writeDescribed(propDesc);
            let dataDesc = Amqp10Described { descriptor: 0x75, value: Amqp10Value::BinaryVal(body) };
            w.writeDescribed(dataDesc);
            return w.bytes;
        }

        /* 4-byte big-endian encoding of a counter as a delivery tag
         * (binary, an arbitrary byte sequence per spec — only needs to
         * be unique among unsettled deliveries on the same link). */
        fn deliveryTagBytes(n: Int64) -> List<Int64>
        {
            return [(n >> 24) & 0xFF, (n >> 16) & 0xFF, (n >> 8) & 0xFF, n & 0xFF];
        }

        /*
         * SASL PLAIN response: "\0user\0pass" as raw bytes — identical
         * byte structure to 0-9-1's Amqp091::saslPlainResponse, but
         * reimplemented in the new module (no cross-import between the
         * two AMQP modules).
         */
        fn saslPlainResponse(user: String, pass: String) -> List<Int64>
        {
            var bytes: List<Int64> = [];
            bytes.push(0);
            for i in 0..user.len() {
                bytes.push(user.charCodeAt(i) & 0xFF);
            }
            bytes.push(0);
            for i in 0..pass.len() {
                bytes.push(pass.charCodeAt(i) & 0xFF);
            }
            return bytes;
        }

        /*
         * SASL negotiation: receive sasl-mechanisms (0x40) -> pick the
         * strongest shared mechanism -> run the handshake for THAT
         * mechanism. Runs AFTER the SASL protocol header
         * (sendSaslProtocolHeader + checkProtocolHeaderEcho) on the SAME
         * connection on which the AMQP header + `open` follow afterward.
         *
         * Issue 77: SCRAM-SHA-256 is preferred (real challenge-response
         * authentication with mutual verification) over PLAIN (the
         * password goes over the connection in plaintext — protected
         * only by TLS if amqps:// is used). Falling back to PLAIN still
         * works if the broker doesn't offer SCRAM-SHA-256 — no API
         * break for existing PLAIN-only brokers/tests.
         */
        fn negotiateSasl(conn: Int64, user: String, pass: String) -> Amqp10SaslResult
        {
            // --- receive sasl-mechanisms ---
            let f1 = Amqp10::readFrame(conn);
            if f1.frameType != 1 {
                return Amqp10SaslResult { ok: false, errorMessage: "expected SASL frame (type=1), got frameType=" + f1.frameType.toString() };
            }
            let p1 = Amqp10::decodePerformative(f1.body);
            if p1.descriptor != 0x40 {
                return Amqp10SaslResult { ok: false, errorMessage: "expected sasl-mechanisms (0x40), got descriptor=" + p1.descriptor.toString() };
            }
            if p1.fields.len() < 1 {
                return Amqp10SaslResult { ok: false, errorMessage: "sasl-mechanisms with no mechanisms field" };
            }
            var hasPlain: Bool = false;
            var hasScram: Bool = false;
            match p1.fields[0]
            {
                // sasl-server-mechanisms is always a symbol array per
                // spec (even with exactly one mechanism) — ListVal is
                // the generic return type of Amqp10Reader::readArray.
                // The SymbolVal branch is pure defense against
                // non-conforming brokers, not spec-required.
                ListVal(mechs) => {
                    for i in 0..mechs.len() {
                        match mechs[i] {
                            SymbolVal(s) => {
                                if s == "PLAIN" { hasPlain = true; }
                                if s == "SCRAM-SHA-256" { hasScram = true; }
                            }
                            _ => {}
                        }
                    }
                }
                SymbolVal(s) => {
                    if s == "PLAIN" { hasPlain = true; }
                    if s == "SCRAM-SHA-256" { hasScram = true; }
                }
                _ => {}
            }
            if hasScram {
                return Amqp10::negotiateSaslScram(conn, user, pass);
            }
            if !hasPlain {
                return Amqp10SaslResult { ok: false, errorMessage: "broker offers neither SCRAM-SHA-256 nor PLAIN" };
            }

            // --- send sasl-init: mechanism, initial-response, hostname(null) ---
            var initFields: List<Amqp10Value> = [
                Amqp10Value::SymbolVal("PLAIN"),
                Amqp10Value::BinaryVal(Amqp10::saslPlainResponse(user, pass)),
                Amqp10Value::NullVal
            ];
            let initBody = Amqp10::encodePerformative(0x41, initFields);
            Amqp10::writeFrame(conn, 1, 0, initBody);

            // --- receive sasl-outcome ---
            let f2 = Amqp10::readFrame(conn);
            if f2.frameType != 1 {
                return Amqp10SaslResult { ok: false, errorMessage: "expected SASL frame (type=1), got frameType=" + f2.frameType.toString() };
            }
            let p2 = Amqp10::decodePerformative(f2.body);
            if p2.descriptor != 0x44 {
                return Amqp10SaslResult { ok: false, errorMessage: "expected sasl-outcome (0x44), got descriptor=" + p2.descriptor.toString() };
            }
            if p2.fields.len() < 1 {
                return Amqp10SaslResult { ok: false, errorMessage: "sasl-outcome with no code field" };
            }
            var code: Int64 = -1;
            match p2.fields[0]
            {
                UByteVal(n) => { code = n; }
                _ => {}
            }
            if code != 0 {
                return Amqp10SaslResult { ok: false, errorMessage: "SASL auth failed, sasl-outcome-code=" + code.toString() };
            }
            return Amqp10SaslResult { ok: true, errorMessage: "" };
        }

        /*
         * ASCII/UTF-8 bytes of a string — for the printable SCRAM
         * message parts (issue 77), which are transmitted as
         * initial-response/response BINARY (AMQP-1.0 SASL has no plain
         * string field for that).
         */
        fn stringToBytes(s: String) -> List<Int64>
        {
            var bytes: List<Int64> = [];
            for i in 0..s.len() {
                bytes.push(s.charCodeAt(i) & 0xFF);
            }
            return bytes;
        }

        /*
         * Reverse direction of stringToBytes — SAFE only for bytes that
         * really are printable ASCII/UTF-8 text (the SCRAM message
         * envelope "r=...,s=...,i=..." always is; the base64-encoded
         * salt/proof/signature values embedded in it stay printable
         * base64 text regardless). NOT for raw binary data (0 bytes
         * would silently truncate a Tinox string, see the
         * Base64::decodeBytes comment).
         */
        fn bytesToString(b: List<Int64>) -> String
        {
            // tinoxBytesToString does the byte->char conversion in one
            // pass instead of `s = s + fromCharCode(...)` in a loop, which
            // is O(n^2) over the string length (issue #167).
            return tinoxBytesToString(b);
        }

        fn xorBytes(a: List<Int64>, b: List<Int64>) -> List<Int64>
        {
            var out: List<Int64> = [];
            for i in 0..a.len() {
                out.push((a[i] ^ b[i]) & 0xFF);
            }
            return out;
        }

        /*
         * PBKDF2-HMAC-SHA256 (RFC 8018) with dkLen = 32 = SHA-256 output
         * size — so ONE block suffices (block index 1 in the RFC), no
         * T1||T2||... concatenation needed. `iterations` comes from the
         * broker (server-first-message, typically 4096+) — O(iterations)
         * HMAC calls, once at connection setup, not a hot path.
         */
        fn pbkdf2HmacSha256(password: List<Int64>, salt: List<Int64>, iterations: Int64) -> List<Int64>
        {
            var saltBlock: List<Int64> = [];
            for i in 0..salt.len() { saltBlock.push(salt[i]); }
            saltBlock.push(0);
            saltBlock.push(0);
            saltBlock.push(0);
            saltBlock.push(1); // INT(1), 4-byte big-endian block index
            var u: List<Int64> = hmacSha256Bytes(saltBlock, password);
            var t: List<Int64> = u;
            var iter: Int64 = 2;
            while iter <= iterations {
                u = hmacSha256Bytes(u, password);
                t = Amqp10::xorBytes(t, u);
                iter = iter + 1;
            }
            return t;
        }

        /*
         * Random SCRAM client nonce: 16 random bytes, base64-encoded
         * (printable, free of commas/equals signs — safe for the "r="
         * text message). Per spec the nonce only needs to be UNIQUE, no
         * cryptographic key derivation depends directly on its
         * unpredictability (unlike, say, an AES nonce) — so the simple
         * PRNG behind randomInt is sufficient here.
         */
        fn generateScramNonce() -> String
        {
            var bytes: List<Int64> = [];
            for i in 0..16 {
                bytes.push(randomInt(0, 256));
            }
            return Base64::encodeBytes(bytes);
        }

        /*
         * SCRAM-SHA-256 (RFC 5802/7677) as an AMQP-1.0 SASL mechanism
         * (issue 77). Flow: sasl-init (client-first-message) ->
         * sasl-challenge (server-first-message: r=<nonce>,s=<salt>,
         * i=<iterations>) -> sasl-response (client-final-message:
         * c=<gs2-header>,r=<nonce>,p=<proof>) -> sasl-outcome (code=0,
         * additional-data = server-final-message "v=<signature>").
         * Spec-compliant brokers deliver the server-signature
         * verification AS additional-data on sasl-outcome instead of
         * another challenge round — v1 only supports this (common) case,
         * no multiple sasl-challenge/-response rounds.
         *
         * gs2 header "n,," = no channel binding (a v1 limitation, same
         * as PLAIN over amqps:// also not checking any channel binding
         * to the TLS certificate). The username is passed through
         * UNESCAPED (the RFC requires "="/","-escaping as "=3D"/"=2C")
         * — a v1 assumption: usernames don't contain those characters.
         */
        fn negotiateSaslScram(conn: Int64, user: String, pass: String) -> Amqp10SaslResult
        {
            let clientNonce = Amqp10::generateScramNonce();
            let gs2Header = "n,,";
            let clientFirstMessageBare = "n=" + user + ",r=" + clientNonce;
            let clientFirstMessage = gs2Header + clientFirstMessageBare;

            var initFields: List<Amqp10Value> = [
                Amqp10Value::SymbolVal("SCRAM-SHA-256"),
                Amqp10Value::BinaryVal(Amqp10::stringToBytes(clientFirstMessage)),
                Amqp10Value::NullVal
            ];
            let initBody = Amqp10::encodePerformative(0x41, initFields);
            Amqp10::writeFrame(conn, 1, 0, initBody);

            // --- receive sasl-challenge (server-first-message) ---
            let f2 = Amqp10::readFrame(conn);
            if f2.frameType != 1 {
                return Amqp10SaslResult { ok: false, errorMessage: "expected SASL frame (type=1) for SCRAM challenge, got frameType=" + f2.frameType.toString() };
            }
            let p2 = Amqp10::decodePerformative(f2.body);
            if p2.descriptor != 0x42 {
                return Amqp10SaslResult { ok: false, errorMessage: "expected sasl-challenge (0x42), got descriptor=" + p2.descriptor.toString() };
            }
            if p2.fields.len() < 1 {
                return Amqp10SaslResult { ok: false, errorMessage: "sasl-challenge with no challenge field" };
            }
            var serverFirstMessage: String = "";
            match p2.fields[0] {
                BinaryVal(b) => { serverFirstMessage = Amqp10::bytesToString(b); }
                _ => {}
            }
            if serverFirstMessage.len() == 0 {
                return Amqp10SaslResult { ok: false, errorMessage: "sasl-challenge with an empty/invalid challenge field" };
            }

            // --- parse the server-first-message ---
            let parts = serverFirstMessage.split(",");
            var combinedNonce: String = "";
            var saltB64: String = "";
            var iterations: Int64 = 0;
            for i in 0..parts.len() {
                let part = parts[i];
                if part.startsWith("r=") {
                    combinedNonce = part.substring(2, part.len());
                }
                if part.startsWith("s=") {
                    saltB64 = part.substring(2, part.len());
                }
                if part.startsWith("i=") {
                    iterations = part.substring(2, part.len()).toInt();
                }
            }
            if !combinedNonce.startsWith(clientNonce) {
                return Amqp10SaslResult { ok: false, errorMessage: "SCRAM: broker nonce doesn't start with the client nonce (possible downgrade attack)" };
            }
            if saltB64.len() == 0 || iterations <= 0 {
                return Amqp10SaslResult { ok: false, errorMessage: "SCRAM: server-first-message with no valid salt/iterations field" };
            }
            // Bug 87: `iterations` is broker-controlled and fed straight into
            // an O(iterations) PBKDF2-HMAC loop below. A malicious/compromised
            // broker (or a plaintext MITM before amqps:// TLS is negotiated)
            // could otherwise force unbounded CPU consumption during connect()
            // with an absurd `i=` value. 200000 is well above real-world
            // broker defaults (typically 4096-100000) but caps the worst case.
            if iterations > 200000 {
                return Amqp10SaslResult { ok: false, errorMessage: "SCRAM: iteration count " + iterations.toString() + " exceeds safety cap (200000)" };
            }

            // --- SaltedPassword / ClientKey / StoredKey ---
            let saltBytes = Base64::decodeBytes(saltB64);
            let passwordBytes = Amqp10::stringToBytes(pass);
            let saltedPassword = Amqp10::pbkdf2HmacSha256(passwordBytes, saltBytes, iterations);
            let clientKey = hmacSha256Bytes(Amqp10::stringToBytes("Client Key"), saltedPassword);
            let storedKey = sha256Bytes(clientKey);

            // --- client-final-message-without-proof + AuthMessage + ClientProof ---
            let clientFinalMessageWithoutProof = "c=" + Base64::encode(gs2Header) + ",r=" + combinedNonce;
            let authMessage = clientFirstMessageBare + "," + serverFirstMessage + "," + clientFinalMessageWithoutProof;
            let clientSignature = hmacSha256Bytes(Amqp10::stringToBytes(authMessage), storedKey);
            let clientProof = Amqp10::xorBytes(clientKey, clientSignature);
            let clientFinalMessage = clientFinalMessageWithoutProof + ",p=" + Base64::encodeBytes(clientProof);

            // --- send sasl-response ---
            var respFields: List<Amqp10Value> = [Amqp10Value::BinaryVal(Amqp10::stringToBytes(clientFinalMessage))];
            let respBody = Amqp10::encodePerformative(0x43, respFields);
            Amqp10::writeFrame(conn, 1, 0, respBody);

            // --- receive sasl-outcome (additional-data = server-final-message) ---
            let f3 = Amqp10::readFrame(conn);
            if f3.frameType != 1 {
                return Amqp10SaslResult { ok: false, errorMessage: "expected SASL frame (type=1) for SCRAM outcome, got frameType=" + f3.frameType.toString() };
            }
            let p3 = Amqp10::decodePerformative(f3.body);
            if p3.descriptor != 0x44 {
                return Amqp10SaslResult { ok: false, errorMessage: "expected sasl-outcome (0x44), got descriptor=" + p3.descriptor.toString() };
            }
            if p3.fields.len() < 1 {
                return Amqp10SaslResult { ok: false, errorMessage: "sasl-outcome with no code field" };
            }
            var code: Int64 = -1;
            match p3.fields[0] { UByteVal(n) => { code = n; } _ => {} }
            if code != 0 {
                return Amqp10SaslResult { ok: false, errorMessage: "SCRAM auth failed, sasl-outcome-code=" + code.toString() };
            }

            // --- verify the server signature (mutual authentication,
            // not just client -> server) — no silent trust ---
            var serverFinalMessage: String = "";
            if p3.fields.len() > 1 {
                match p3.fields[1] {
                    BinaryVal(b) => { serverFinalMessage = Amqp10::bytesToString(b); }
                    _ => {}
                }
            }
            if serverFinalMessage.len() == 0 {
                return Amqp10SaslResult { ok: false, errorMessage: "SCRAM: sasl-outcome with no additional-data (server-final-message) — server identity not verifiable" };
            }
            if !serverFinalMessage.startsWith("v=") {
                return Amqp10SaslResult { ok: false, errorMessage: "SCRAM: server-final-message with no 'v=' field" };
            }
            let serverSignatureB64 = serverFinalMessage.substring(2, serverFinalMessage.len());
            let receivedServerSignature = Base64::decodeBytes(serverSignatureB64);
            let serverKey = hmacSha256Bytes(Amqp10::stringToBytes("Server Key"), saltedPassword);
            let expectedServerSignature = hmacSha256Bytes(Amqp10::stringToBytes(authMessage), serverKey);
            var sigMatch: Bool = receivedServerSignature.len() == expectedServerSignature.len();
            if sigMatch {
                for i in 0..expectedServerSignature.len() {
                    if receivedServerSignature[i] != expectedServerSignature[i] { sigMatch = false; }
                }
            }
            if !sigMatch {
                return Amqp10SaslResult { ok: false, errorMessage: "SCRAM: server signature mismatch — server identity NOT verified (possible MITM)" };
            }

            return Amqp10SaslResult { ok: true, errorMessage: "" };
        }
    }
}

module tinox.core.amqp10;

import tinox.core.socket;
import tinox.core.base64;

namespace tinox.core.amqp10
{
    /*
     * A session on an Amqp10Connection (§2.7.3, corresponds to 0-9-1's
     * channel, but with window-based flow control instead of a plain
     * "open" status). `incoming-window`/`outgoing-window` are generously
     * fixed (no real window tracking in v1 — a later `flow` addition
     * would add that for the actual message flow, `begin` itself only
     * needs plausible starting values).
     *
     * Issue 76: multiple sessions per connection are now structurally
     * possible (every begin() gets its own, guaranteed-unique channel
     * from Amqp10Connection.nextChannelId instead of the previously
     * hardcoded channel 1) — a v1 limitation remains, though: there is
     * NO real frame dispatcher at the connection level (see
     * Amqp10Link::awaitFlow()'s comment about the same gap in the
     * single-link case). readFrame()/readFrameSkipHeartbeats() ALWAYS
     * read the next frame on the connection, regardless of which
     * channel carries it — multiple sessions therefore work correctly
     * ONLY as long as the application calls its blocking operations
     * (begin/attach/nextMessage/...) SEQUENTIALLY across all
     * sessions/links (no simultaneous waiting on two sessions from two
     * application threads). nextMessage() at least checks the received
     * `handle` field against this.handle (see there) — a transfer
     * mistakenly read for a different link is thereby made visible as a
     * hard error instead of silent garbage (misattributed message
     * content).
     */
    class Amqp10Session
    {
        var conn: Int64;
        var chanId: Int64;
        var maxFrameSize: Int64;
        var errorMessage: String;
        // Issue 76: the next link-handle number to assign within this
        // session (analogous to Amqp10Connection.nextChannelId).
        var nextLinkHandle: Int64;

        fn begin(connection: Amqp10Connection) -> Amqp10Session
        {
            let chanId = connection.nextChannelId;
            connection.nextChannelId = connection.nextChannelId + 1;

            var beginFields: List<Amqp10Value> = [
                Amqp10Value::NullVal,             // remote-channel (only set in responses)
                Amqp10Value::UIntVal(0),           // next-outgoing-id
                Amqp10Value::UIntVal(2147483647),  // incoming-window
                Amqp10Value::UIntVal(2147483647)   // outgoing-window
            ];
            let beginBody = Amqp10::encodePerformative(0x11, beginFields);
            Amqp10::writeFrame(connection.conn, 0, chanId, beginBody);

            let f = Amqp10::readFrame(connection.conn);
            if f.frameType != 0 {
                return Amqp10Session { conn: connection.conn, chanId: -1, maxFrameSize: connection.maxFrameSize, errorMessage: "expected AMQP frame (type=0), got frameType=" + f.frameType.toString(), nextLinkHandle: 0 };
            }
            let p = Amqp10::decodePerformative(f.body);
            if p.descriptor != 0x11 {
                return Amqp10Session { conn: connection.conn, chanId: -1, maxFrameSize: connection.maxFrameSize, errorMessage: "expected begin (0x11), got descriptor=" + p.descriptor.toString(), nextLinkHandle: 0 };
            }
            return Amqp10Session { conn: connection.conn, chanId: chanId, maxFrameSize: connection.maxFrameSize, errorMessage: "", nextLinkHandle: 0 };
        }

        /*
         * Ends the session: send `end` and wait for `end` from the
         * broker (unchecked in v1, analogous to Amqp10Connection::close).
         */
        fn end() -> Nothing
        {
            let endBody = Amqp10::encodePerformative(0x17, []);
            Amqp10::writeFrame(this.conn, 0, this.chanId, endBody);
            Amqp10::readFrame(this.conn);
        }
    }
}

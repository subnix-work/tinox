module tinox.core.amqp10;

import tinox.core.socket;
import tinox.core.base64;

namespace tinox.core.amqp10
{
    /*
     * A message received via Amqp10Link::nextMessage(). ok == false on
     * any error (wrong frame/performative type) — errorMessage then
     * describes the cause, analogous to 0-9-1's AmqpMessage091.
     * `deliveryId` is needed for Amqp10Link::ack().
     */
    class Amqp10Message
    {
        var body: List<Int64>;
        var contentType: String;
        var deliveryId: Int64;
        var ok: Bool;
        var errorMessage: String;
    }
}

module tinox.core.amqp10;

import tinox.core.socket;
import tinox.core.base64;

/*
 * AMQP-1.0 client (no broker): transport dial + protocol-header
 * handshake. No shared code with amqp091.tnx beyond the same basic
 * pattern (conn-handle dial via socketCreateTcp/socketConnect/
 * httpConnFromFd, binary-safe read/write via httpConnReadN/
 * httpConnWriteBytes) — AMQP 1.0 is a different beast protocol- and
 * data-model-wise (generic type system instead of fixed field tags,
 * connection→session→link instead of connection→channel). Verified
 * against the OASIS spec, not derived from memory.
 */

namespace tinox.core.amqp10
{
    /*
     * A generic AMQP-1.0 value. Unlike 0-9-1's AmqpFieldValue091 (only
     * for field-table entries), this type is used for EVERYTHING:
     * performative fields, message sections, even the performative
     * wrapper itself — AMQP 1.0 has ONE type system for the entire
     * frame body instead of separate method-argument and field-table
     * encodings.
     *
     * Deliberate v1 gaps (format codes are recognized by the reader and
     * processed with the correct byte skip, but the value itself comes
     * back as ErrorVal instead of being genuinely decoded — no silent
     * garbage, the cursor still stays in sync for subsequent fields):
     * `float`/`double` (IEEE-754 bit conversion would need a bitcast
     * primitive the runtime doesn't have, and per spec the core
     * performatives never use float/double — only message bodies could
     * theoretically do so), `decimal32/64/128` (practically never used,
     * even more exotic than float/double).
     *
     * MapVal is a FLAT list (key0, val0, key1, val1, ...) instead of a
     * Tinox Map<K,V> — AMQP-1.0 map keys are arbitrary values, not a
     * uniform K type like 0-9-1's always-String keys.
     */
    enum Amqp10Value
    {
        NullVal;
        BoolVal(Bool);
        UByteVal(Int64);
        UShortVal(Int64);
        UIntVal(Int64);
        ULongVal(Int64);
        ByteVal(Int64);
        ShortVal(Int64);
        IntVal(Int64);
        LongVal(Int64);
        CharVal(Int64);       // UTF-32 codepoint, raw (not a Tinox string)
        TimestampVal(Int64);  // ms since the Unix epoch
        UuidVal(List<Int64>); // exactly 16 raw bytes
        BinaryVal(List<Int64>);
        StrVal(String);
        SymbolVal(String);
        ListVal(List<Amqp10Value>);
        MapVal(List<Amqp10Value>);      // flat: key,val,key,val,...
        DescribedVal(Amqp10Described);  // performatives/SASL frames/sections
        ErrorVal(String);
    }
}

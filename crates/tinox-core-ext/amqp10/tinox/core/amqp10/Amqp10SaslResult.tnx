module tinox.core.amqp10;

import tinox.core.socket;
import tinox.core.base64;

namespace tinox.core.amqp10
{
    /*
     * Result of Amqp10::negotiateSasl. ok == false on any failure (wrong
     * frame type, unexpected performative, PLAIN not offered,
     * sasl-outcome-code != 0) — errorMessage then describes the cause,
     * analogous to 0-9-1's errorMessage field convention.
     */
    class Amqp10SaslResult
    {
        var ok: Bool;
        var errorMessage: String;
    }
}

module tinox.core.amqp10;

import tinox.core.socket;
import tinox.core.base64;

namespace tinox.core.amqp10
{
    /*
     * Result of Amqp10Link::declare() (issue 79). ok == false on any
     * failure (broker doesn't respond with `declared`, etc.) — txnId is
     * then empty. On success, txnId is passed to
     * publishTransactional()/ackTransactional()/discharge(), following
     * the same errorMessage conventions as the rest of this module.
     */
    class Amqp10Transaction
    {
        var txnId: List<Int64>;
        var ok: Bool;
        var errorMessage: String;
    }
}

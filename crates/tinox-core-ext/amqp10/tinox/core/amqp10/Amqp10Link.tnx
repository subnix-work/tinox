module tinox.core.amqp10;

import tinox.core.socket;
import tinox.core.base64;

namespace tinox.core.amqp10
{
    /*
     * A link on an Amqp10Session (§2.7.4) — an explicit, directional
     * sender OR receiver role with `source`/`target` addresses, no
     * equivalent in 0-9-1 (there, `basic.publish`/`basic.consume` run
     * implicitly on the channel).
     *
     * Issue 76: multiple links per session are now structurally possible
     * (every attach() gets its own, guaranteed-unique handle from
     * Amqp10Session.nextLinkHandle instead of the previously hardcoded
     * handle 0) — the same v1 limitation as with Amqp10Session applies
     * here too: no real frame dispatcher, multiple links work correctly
     * with sequential use, not with truly simultaneous blocking waits on
     * two links. nextMessage() checks the received `handle` field
     * against this.handle, so a misattributed transfer shows up as a
     * hard error instead of silently delivering the wrong message body.
     */
    class Amqp10Link
    {
        var conn: Int64;
        var chanId: Int64;
        var handle: Int64;
        var maxFrameSize: Int64;
        var linkCredit: Int64;
        var deliveryCount: Int64;
        var errorMessage: String;
        // Issue 80: delivery tags the BROKER reports back in its own
        // unsettled field on attach-ok as (from ITS perspective) still
        // unsettled — only populated by attachWithRecovery() (see
        // there), otherwise always empty.
        var recoveredUnsettledTags: List<List<Int64>>;

        /*
         * role: false = sender (target carries the destination address,
         * e.g. a queue to publish to), true = receiver (source carries
         * the source address, e.g. a queue to consume from) — spec
         * convention. The other side gets an empty, addressless
         * source/target (a described type with an empty field list, not
         * `NullVal` — most brokers expect the wrapper even without an
         * address).
         */
        fn attach(session: Amqp10Session, name: String, role: Bool, address: String) -> Amqp10Link
        {
            return Amqp10Link::attachCore(session, name, role, address, []);
        }

        /*
         * Link recovery/resumption (issue 80, §2.6.12/3.5.x of the
         * spec): like attach(), but reports a list of delivery tags in
         * the `unsettled` field that THIS client still remembers as
         * unsettled from an earlier session (before a detach/reconnect)
         * — the broker compares that against its own view and returns
         * its own unsettled field in the attach RESPONSE (into
         * this.recoveredUnsettledTags), so the caller can tell which
         * deliveries are actually still open.
         *
         * v1 limitation (deliberate, analogous to
         * Amqp10Connection::reconnect()'s limitation — a building block
         * instead of automatic magic): this client does NOT yet track
         * unsettled deliveries itself (publish() always sends
         * settled=true, ack()/reject()/... settle immediately) — WHICH
         * tags get reported as "prior unsettled" is up to the caller
         * (e.g. its own bookkeeping of recently sent/received,
         * not-yet-confirmed delivery tags). The reported state per tag
         * is always NullVal ("unknown, please report the broker's
         * view") instead of a concrete delivery state — full
         * exactly-once recovery with a per-tag redelivery decision is a
         * separate, larger feature.
         */
        fn attachWithRecovery(session: Amqp10Session, name: String, role: Bool, address: String, priorUnsettledTags: List<List<Int64>>) -> Amqp10Link
        {
            return Amqp10Link::attachCore(session, name, role, address, priorUnsettledTags);
        }

        fn attachCore(session: Amqp10Session, name: String, role: Bool, address: String, priorUnsettledTags: List<List<Int64>>) -> Amqp10Link
        {
            let handle = session.nextLinkHandle;
            session.nextLinkHandle = session.nextLinkHandle + 1;

            var sourceVal: Amqp10Value = Amqp10Value::DescribedVal(Amqp10Described { descriptor: 0x28, value: Amqp10Value::ListVal([]) });
            var targetVal: Amqp10Value = Amqp10Value::DescribedVal(Amqp10Described { descriptor: 0x29, value: Amqp10Value::ListVal([]) });
            if role {
                sourceVal = Amqp10Value::DescribedVal(Amqp10Described { descriptor: 0x28, value: Amqp10Value::ListVal([Amqp10Value::StrVal(address)]) });
            } else {
                targetVal = Amqp10Value::DescribedVal(Amqp10Described { descriptor: 0x29, value: Amqp10Value::ListVal([Amqp10Value::StrVal(address)]) });
            }

            // unsettled (field 7): a flat map delivery-tag(binary) ->
            // state. v1 always reports each tag's state as NullVal (see
            // the attachWithRecovery() comment) — an empty
            // priorUnsettledTags still yields NullVal instead of an
            // empty map (identical to the previous attach() behavior,
            // no behavior change).
            var unsettledVal: Amqp10Value = Amqp10Value::NullVal;
            if priorUnsettledTags.len() > 0 {
                var pairs: List<Amqp10Value> = [];
                for i in 0..priorUnsettledTags.len() {
                    pairs.push(Amqp10Value::BinaryVal(priorUnsettledTags[i]));
                    pairs.push(Amqp10Value::NullVal);
                }
                unsettledVal = Amqp10Value::MapVal(pairs);
            }

            // initial-delivery-count (field 10) is REQUIRED per spec when
            // role=sender ("MUST be set if the role is sender") —
            // RabbitMQ 4.x's rabbit_amqp_session:handle_attach
            // pattern-matches the field hard against a real uint value
            // and crashes with function_clause if it's missing (found
            // live against a real broker).
            var attachFields: List<Amqp10Value> = [
                Amqp10Value::StrVal(name),
                Amqp10Value::UIntVal(handle),
                Amqp10Value::BoolVal(role),
                Amqp10Value::UByteVal(2),  // snd-settle-mode: mixed (spec default, set explicitly)
                Amqp10Value::UByteVal(0),  // rcv-settle-mode: first (spec default, set explicitly)
                sourceVal,
                targetVal,
                unsettledVal,
                Amqp10Value::BoolVal(false), // incomplete-unsettled: false (spec default, set explicitly)
                Amqp10Value::UIntVal(0)    // initial-delivery-count (only relevant for role=sender, ignored otherwise)
            ];
            let attachBody = Amqp10::encodePerformative(0x12, attachFields);
            Amqp10::writeFrame(session.conn, 0, session.chanId, attachBody);

            let f = Amqp10::readFrame(session.conn);
            if f.frameType != 0 {
                return Amqp10Link { conn: session.conn, chanId: session.chanId, handle: -1, maxFrameSize: session.maxFrameSize, linkCredit: 0, deliveryCount: 0, errorMessage: "expected AMQP frame (type=0), got frameType=" + f.frameType.toString(), recoveredUnsettledTags: [] };
            }
            let p = Amqp10::decodePerformative(f.body);
            if p.descriptor != 0x12 {
                return Amqp10Link { conn: session.conn, chanId: session.chanId, handle: -1, maxFrameSize: session.maxFrameSize, linkCredit: 0, deliveryCount: 0, errorMessage: "expected attach (0x12), got descriptor=" + p.descriptor.toString(), recoveredUnsettledTags: [] };
            }
            // Evaluate the broker's own unsettled field (position 7) —
            // only the tags themselves (not their state details, see the
            // class comment), which is enough in practice to know WHICH
            // deliveries the broker still considers open.
            var recoveredTags: List<List<Int64>> = [];
            if p.fields.len() > 7 {
                match p.fields[7] {
                    MapVal(pairs) => {
                        var i: Int64 = 0;
                        while i + 1 < pairs.len() {
                            match pairs[i] {
                                BinaryVal(tag) => { recoveredTags.push(tag); }
                                _ => {}
                            }
                            i = i + 2;
                        }
                    }
                    _ => {}
                }
            }
            return Amqp10Link { conn: session.conn, chanId: session.chanId, handle: handle, maxFrameSize: session.maxFrameSize, linkCredit: 0, deliveryCount: 0, errorMessage: "", recoveredUnsettledTags: recoveredTags };
        }

        /*
         * Detaches the link: send `detach` and wait for `detach` from
         * the broker (unchecked in v1). The `closed` field is omitted
         * (default false — a normal detach, not a permanent deletion of
         * the link).
         */
        fn detach() -> Nothing
        {
            var detachFields: List<Amqp10Value> = [Amqp10Value::UIntVal(this.handle)];
            let detachBody = Amqp10::encodePerformative(0x16, detachFields);
            Amqp10::writeFrame(this.conn, 0, this.chanId, detachBody);
            Amqp10::readFrame(this.conn);
        }

        /*
         * Reads ONE frame and expects a `flow` (0x13) — RabbitMQ sends
         * it unsolicited, for example, right after a sender attach
         * (found live against a real broker). Updates `this.linkCredit`
         * from the `link-credit` field (position 6). v1 doesn't have a
         * real frame dispatcher yet — whoever waits for `flow` MUST
         * therefore be sure that only `flow` can really come next (here:
         * right after attach, or when credit is exhausted).
         */
        fn awaitFlow() -> Nothing
        {
            let f = Amqp10::readFrame(this.conn);
            if f.frameType != 0 {
                this.errorMessage = "expected AMQP frame (type=0) while waiting for flow, got frameType=" + f.frameType.toString();
                return;
            }
            // Issue 76: a channel check like in nextMessage() — prevents
            // a flow from a DIFFERENT session from wrongly being applied
            // as credit for this link (no real frame dispatcher in v1,
            // see the class comment).
            if f.chanId != this.chanId {
                this.errorMessage = "flow received on the wrong channel " + f.chanId.toString() + " (expected: " + this.chanId.toString() + ") — no frame dispatcher in v1, see issue 76";
                return;
            }
            let p = Amqp10::decodePerformative(f.body);
            if p.descriptor != 0x13 {
                this.errorMessage = "expected flow (0x13), got descriptor=" + p.descriptor.toString();
                return;
            }
            // Field positions: next-incoming-id(0), incoming-window(1),
            // next-outgoing-id(2), outgoing-window(3), handle(4),
            // delivery-count(5), link-credit(6).
            if p.fields.len() > 6 {
                match p.fields[6] { UIntVal(n) => { this.linkCredit = n; } _ => {} }
            }
        }

        /*
         * Sends `flow` and grants `amount` link credit to the broker
         * (receiver role — the broker may then send us up to `amount`
         * `transfer`s). No equivalent in 0-9-1, where `basic.consume`
         * immediately delivers without bound; here it's mandatory,
         * otherwise the broker sends nothing at all.
         */
        fn grantCredit(amount: Int64) -> Nothing
        {
            var flowFields: List<Amqp10Value> = [
                Amqp10Value::NullVal,               // next-incoming-id (not tracked in v1)
                Amqp10Value::UIntVal(2147483647),   // incoming-window
                Amqp10Value::UIntVal(0),            // next-outgoing-id
                Amqp10Value::UIntVal(2147483647),   // outgoing-window
                Amqp10Value::UIntVal(this.handle),
                Amqp10Value::UIntVal(this.deliveryCount),
                Amqp10Value::UIntVal(amount)
            ];
            let flowBody = Amqp10::encodePerformative(0x13, flowFields);
            Amqp10::writeFrame(this.conn, 0, this.chanId, flowBody);
            this.linkCredit = amount;
        }

        /*
         * Publishes a message (sender role). Waits for `flow` if no
         * credit is available (credit-based flow control is mandatory
         * for EVERY transfer in AMQP 1.0 — unlike 0-9-1, where publish
         * always goes through immediately). v1: `settled=true`
         * (fire-and-forget, like 0-9-1's v1 publish without publisher
         * confirms, no disposition round trip per message). The body is
         * split across multiple `transfer` frames with `more=true` when
         * it exceeds `max-frame-size` (a functional equivalent to
         * 0-9-1's multi-frame body splitting, a different mechanism: a
         * `more` flag instead of implicit continuation).
         */
        fn publish(body: List<Int64>, contentType: String) -> Nothing
        {
            this.publishCore(body, contentType, Amqp10Value::NullVal);
        }

        /*
         * Like publish(), but marks EVERY transfer frame as part of
         * transaction `txnId` (issue 79) — `state` (transfer field 7)
         * carries a TransactionalState (descriptor 0x34: txn-id +
         * optional outcome, always NullVal in v1 — the sender doesn't
         * decide the outcome, discharge() does that). The broker only
         * actually delivers the message after a committing discharge()
         * (or discards it on fail=true) — settled stays true just like
         * publish() (v1 style, fire-and-forget regarding the individual
         * delivery; the real guarantee comes from the transaction
         * itself, not from the transfer's settled flag).
         */
        fn publishTransactional(body: List<Int64>, contentType: String, txnId: List<Int64>) -> Nothing
        {
            let txnState = Amqp10Described { descriptor: 0x34, value: Amqp10Value::ListVal([
                Amqp10Value::BinaryVal(txnId),
                Amqp10Value::NullVal
            ]) };
            this.publishCore(body, contentType, Amqp10Value::DescribedVal(txnState));
        }

        fn publishCore(body: List<Int64>, contentType: String, txnState: Amqp10Value) -> Nothing
        {
            if this.linkCredit <= 0 {
                this.awaitFlow();
                if this.errorMessage.len() > 0 {
                    return;
                }
                if this.linkCredit <= 0 {
                    this.errorMessage = "no link credit received despite a flow frame";
                    return;
                }
            }

            let msgBytes = Amqp10::encodeMessageBody(body, contentType);
            let deliveryTag = Amqp10::deliveryTagBytes(this.deliveryCount);

            // A rough but safe overhead buffer for the transfer
            // performative wrapper itself (handle/delivery-id/tag/flags)
            // — v1 deliberately estimates generously instead of
            // computing exactly.
            var maxBodyPerFrame: Int64 = this.maxFrameSize - 64;
            if maxBodyPerFrame < 1 {
                maxBodyPerFrame = 1;
            }

            var offset: Int64 = 0;
            var isFirst: Bool = true;
            while offset < msgBytes.len() || isFirst {
                var remaining: Int64 = msgBytes.len() - offset;
                var chunkSize: Int64 = remaining;
                if chunkSize > maxBodyPerFrame {
                    chunkSize = maxBodyPerFrame;
                }
                var more: Bool = false;
                if (offset + chunkSize) < msgBytes.len() {
                    more = true;
                }
                var chunk: List<Int64> = [];
                for i in 0..chunkSize {
                    chunk.push(msgBytes[offset + i]);
                }

                // rcv-settle-mode (6) is a placeholder (spec default
                // 0=first) — needed to reach state (7), because list
                // fields may only be omitted at the END (see attach()'s
                // initial-delivery-count comment for the same pattern).
                var transferFields: List<Amqp10Value> = [
                    Amqp10Value::UIntVal(this.handle),
                    Amqp10Value::UIntVal(this.deliveryCount),
                    Amqp10Value::BinaryVal(deliveryTag),
                    Amqp10Value::UIntVal(0),      // message-format
                    Amqp10Value::BoolVal(true),   // settled
                    Amqp10Value::BoolVal(more),
                    Amqp10Value::UByteVal(0),     // rcv-settle-mode: first
                    txnState                      // state (issue 79: TransactionalState or NullVal)
                ];
                let transferBody = Amqp10::encodePerformative(0x14, transferFields);
                var fullFrame: List<Int64> = [];
                for i in 0..transferBody.len() {
                    fullFrame.push(transferBody[i]);
                }
                for i in 0..chunk.len() {
                    fullFrame.push(chunk[i]);
                }
                Amqp10::writeFrame(this.conn, 0, this.chanId, fullFrame);

                offset = offset + chunkSize;
                isFirst = false;
            }

            this.linkCredit = this.linkCredit - 1;
            this.deliveryCount = this.deliveryCount + 1;
        }

        /*
         * Blocking pull of the next message (receiver role, assumes
         * grantCredit() was called). v1 does NOT implement multi-frame
         * reassembly for received transfers (the counterpart to
         * sender-side splitting) — a deliberate v1 gap, because the
         * test/live broker round trip used here, with the message sizes
         * v1 uses, never produces more than one transfer frame per
         * delivery; `more=true` is detected and reported as an error
         * instead of silently returning just the first part.
         */
        fn nextMessage() -> Amqp10Message
        {
            let f = Amqp10::readFrameSkipHeartbeats(this.conn);
            if f.frameType != 0 {
                return Amqp10Message { body: [], contentType: "", deliveryId: -1, ok: false, errorMessage: "expected AMQP frame (type=0), got frameType=" + f.frameType.toString() };
            }
            // Issue 76: there is no real frame dispatcher — with
            // multiple sessions/links on the same connection, this MUST
            // check that the frame read really belongs to THIS link,
            // instead of silently delivering someone else's transfer as
            // its own message (a wrong message body would be a classic
            // case of silent garbage). Channel first (cheap, from the
            // frame header, no performative decoding needed).
            if f.chanId != this.chanId {
                return Amqp10Message { body: [], contentType: "", deliveryId: -1, ok: false, errorMessage: "frame received on the wrong channel " + f.chanId.toString() + " (expected: " + this.chanId.toString() + ") — no frame dispatcher in v1, see issue 76" };
            }
            let r = Amqp10Reader::new(f.body);
            let v = r.readValue();
            var descriptor: Int64 = -1;
            var fields: List<Amqp10Value> = [];
            match v
            {
                DescribedVal(d) => {
                    match d.value { ListVal(fl) => { descriptor = d.descriptor; fields = fl; } _ => {} }
                }
                _ => {}
            }
            if descriptor != 0x14 {
                return Amqp10Message { body: [], contentType: "", deliveryId: -1, ok: false, errorMessage: "expected transfer (0x14), got descriptor=" + descriptor.toString() };
            }
            if fields.len() > 0 {
                match fields[0] {
                    UIntVal(fh) => {
                        if fh != this.handle {
                            return Amqp10Message { body: [], contentType: "", deliveryId: -1, ok: false, errorMessage: "transfer received for the wrong link handle " + fh.toString() + " (expected: " + this.handle.toString() + ") — no frame dispatcher in v1, see issue 76" };
                        }
                    }
                    _ => {}
                }
            }
            var deliveryId: Int64 = -1;
            if fields.len() > 1 {
                match fields[1] { UIntVal(n) => { deliveryId = n; } _ => {} }
            }
            if fields.len() > 5 {
                match fields[5] {
                    BoolVal(more) => {
                        if more {
                            return Amqp10Message { body: [], contentType: "", deliveryId: deliveryId, ok: false, errorMessage: "multi-frame transfer (more=true) is not reassembled in v1" };
                        }
                    }
                    _ => {}
                }
            }

            // The rest of the frame body after the performative are the
            // message sections (properties/data OR amqp-value), read
            // them raw.
            //
            // Live cross-check finding (python-qpid-proton): other
            // implementations do NOT necessarily encode a plain string
            // body as a `data` section (0x75, raw bytes) — Proton uses
            // an `amqp-value` section (0x77) with a `StrVal` inside for
            // `Message(body="...")`. Without handling this case, an
            // empty body would come back here EVEN THOUGH `ok=true`
            // would be reported — exactly the silent-garbage pattern
            // this project wants to avoid. v1 therefore handles BOTH
            // forms AND fails hard (ok=false) if no recognized body
            // section was found at all, instead of silently returning
            // an empty body.
            let restBytes = r.readRawBytes(r.remaining());
            var body: List<Int64> = [];
            var contentType: String = "";
            var bodyFound: Bool = false;
            let mr = Amqp10Reader::new(restBytes);
            while mr.remaining() > 0 {
                let sv = mr.readValue();
                match sv
                {
                    DescribedVal(sd) => {
                        if sd.descriptor == 0x75 {
                            match sd.value { BinaryVal(b) => { body = b; bodyFound = true; } _ => {} }
                        }
                        if sd.descriptor == 0x77 {
                            match sd.value {
                                BinaryVal(b) => { body = b; bodyFound = true; }
                                StrVal(s) => {
                                    for i in 0..s.len() {
                                        body.push(s.charCodeAt(i) & 0xFF);
                                    }
                                    bodyFound = true;
                                }
                                _ => {}
                            }
                        }
                        if sd.descriptor == 0x73 {
                            match sd.value {
                                ListVal(propFields) => {
                                    if propFields.len() > 6 {
                                        match propFields[6] { SymbolVal(s) => { contentType = s; } _ => {} }
                                    }
                                }
                                _ => {}
                            }
                        }
                    }
                    _ => {}
                }
            }
            if !bodyFound {
                return Amqp10Message { body: [], contentType: contentType, deliveryId: deliveryId, ok: false, errorMessage: "no recognized body section (data/amqp-value) found in the transfer" };
            }

            this.deliveryCount = this.deliveryCount + 1;
            this.linkCredit = this.linkCredit - 1;
            return Amqp10Message { body: body, contentType: contentType, deliveryId: deliveryId, ok: true, errorMessage: "" };
        }

        /*
         * Shared core for ack()/reject()/release()/modify() (issue 78):
         * sends `disposition` (0x15) for EXACTLY one delivery with the
         * given state. role/first/last/settled are identical for all
         * four outcomes, only the `state` field itself differs
         * (accepted/rejected/released/modified, §3.4).
         */
        fn sendDisposition(deliveryId: Int64, state: Amqp10Value) -> Nothing
        {
            var dispFields: List<Amqp10Value> = [
                Amqp10Value::BoolVal(true),   // role: true=receiver
                Amqp10Value::UIntVal(deliveryId), // first
                Amqp10Value::NullVal,         // last (this one delivery only)
                Amqp10Value::BoolVal(true),   // settled
                state
            ];
            let dispBody = Amqp10::encodePerformative(0x15, dispFields);
            Amqp10::writeFrame(this.conn, 0, this.chanId, dispBody);
        }

        /*
         * Acknowledges a message received via nextMessage() (receiver
         * role) — sends `disposition` with `state=accepted`. The
         * AMQP-1.0 equivalent of 0-9-1's `basic.ack`.
         */
        fn ack(deliveryId: Int64) -> Nothing
        {
            let acceptedDesc = Amqp10Described { descriptor: 0x24, value: Amqp10Value::ListVal([]) };
            this.sendDisposition(deliveryId, Amqp10Value::DescribedVal(acceptedDesc));
        }

        /*
         * Rejects a message permanently (§3.4.3 `rejected`, issue 78) —
         * the sender must NOT redeliver it (unlike release()).
         * `condition`/`description` are optional (an empty string = no
         * error field, a list field may be omitted at the end);
         * condition is an AMQP error-condition symbol, e.g.
         * "amqp:decode-error" — v1 doesn't validate the string against
         * the spec table, it's just passed through (analogous to
         * 0-9-1's unvalidated reply-text fields).
         */
        fn reject(deliveryId: Int64, condition: String, description: String) -> Nothing
        {
            var rejectedFields: List<Amqp10Value> = [];
            if condition.len() > 0 {
                let errorDesc = Amqp10Described { descriptor: 0x1d, value: Amqp10Value::ListVal([
                    Amqp10Value::SymbolVal(condition),
                    Amqp10Value::StrVal(description)
                ]) };
                rejectedFields = [Amqp10Value::DescribedVal(errorDesc)];
            }
            let rejectedDesc = Amqp10Described { descriptor: 0x25, value: Amqp10Value::ListVal(rejectedFields) };
            this.sendDisposition(deliveryId, Amqp10Value::DescribedVal(rejectedDesc));
        }

        /*
         * Returns a message unprocessed (§3.4.4 `released`, issue 78) —
         * unlike reject(), NOT a permanent rejection, the broker
         * may/should redeliver it (e.g. to a different consumer). No
         * fields (an empty list, spec-compliant).
         */
        fn release(deliveryId: Int64) -> Nothing
        {
            let releasedDesc = Amqp10Described { descriptor: 0x26, value: Amqp10Value::ListVal([]) };
            this.sendDisposition(deliveryId, Amqp10Value::DescribedVal(releasedDesc));
        }

        /*
         * Signals that delivery failed AND/OR was not deliverable at
         * this point (§3.4.5 `modified`, issue 78) — more fine-grained
         * than release(): deliveryFailed increases the delivery count
         * (if tracked by the sender), undeliverableHere tells the
         * sender not to offer it to this receiver/link again.
         * message-annotations (the third, optional list field) is
         * deliberately not supported in v1 (analogous to other v1
         * omissions in this module, e.g. amqp-value/data-only body
         * sections).
         */
        fn modify(deliveryId: Int64, deliveryFailed: Bool, undeliverableHere: Bool) -> Nothing
        {
            let modifiedDesc = Amqp10Described { descriptor: 0x27, value: Amqp10Value::ListVal([
                Amqp10Value::BoolVal(deliveryFailed),
                Amqp10Value::BoolVal(undeliverableHere)
            ]) };
            this.sendDisposition(deliveryId, Amqp10Value::DescribedVal(modifiedDesc));
        }

        /*
         * Like ack(), but confirms the delivery AS PART OF transaction
         * `txnId` (issue 79) — the broker only actually applies the
         * `accepted` outcome on a committing discharge() (on
         * fail=true/rollback, the delivery stays unsettled/discardable).
         * `state` (disposition field 4) is a TransactionalState
         * (descriptor 0x34: txn-id + the ACTUAL outcome `accepted` as an
         * inner DescribedVal — unlike publishTransactional(), where the
         * sender doesn't set an outcome).
         */
        fn ackTransactional(deliveryId: Int64, txnId: List<Int64>) -> Nothing
        {
            let acceptedDesc = Amqp10Described { descriptor: 0x24, value: Amqp10Value::ListVal([]) };
            let txnState = Amqp10Described { descriptor: 0x34, value: Amqp10Value::ListVal([
                Amqp10Value::BinaryVal(txnId),
                Amqp10Value::DescribedVal(acceptedDesc)
            ]) };
            this.sendDisposition(deliveryId, Amqp10Value::DescribedVal(txnState));
        }

        /*
         * Attaches a TRANSACTION-CONTROL link (issue 79, §4.2/4.3 of the
         * transactions extension) — structurally a normal sender link
         * (role=false), but with `target` = `Coordinator` (descriptor
         * 0x30, one field: txn-capabilities as a symbol array — v1
         * writes it, like all lists/arrays in this module, always as a
         * `list` instead of the spec's `array` short form; not a
         * correctness issue, just no size optimization) instead of a
         * normal address. `source` stays the empty, addressless wrapper
         * like on any sender link. ONLY declare()/discharge() run over
         * THIS link — no publish()/nextMessage() on a coordinator link.
         */
        fn attachCoordinator(session: Amqp10Session, name: String) -> Amqp10Link
        {
            let coordinatorDesc = Amqp10Described { descriptor: 0x30, value: Amqp10Value::ListVal([
                Amqp10Value::ListVal([Amqp10Value::SymbolVal("amqp:local-transactions")])
            ]) };
            let handle = session.nextLinkHandle;
            session.nextLinkHandle = session.nextLinkHandle + 1;

            let sourceVal = Amqp10Value::DescribedVal(Amqp10Described { descriptor: 0x28, value: Amqp10Value::ListVal([]) });
            var attachFields: List<Amqp10Value> = [
                Amqp10Value::StrVal(name),
                Amqp10Value::UIntVal(handle),
                Amqp10Value::BoolVal(false), // role: sender (the client sends declare/discharge to the coordinator)
                Amqp10Value::UByteVal(2),    // snd-settle-mode: mixed
                Amqp10Value::UByteVal(0),    // rcv-settle-mode: first
                sourceVal,
                Amqp10Value::DescribedVal(coordinatorDesc), // target: Coordinator instead of a normal address
                Amqp10Value::NullVal,        // unsettled
                Amqp10Value::BoolVal(false), // incomplete-unsettled
                Amqp10Value::UIntVal(0)      // initial-delivery-count (role=sender)
            ];
            let attachBody = Amqp10::encodePerformative(0x12, attachFields);
            Amqp10::writeFrame(session.conn, 0, session.chanId, attachBody);

            let f = Amqp10::readFrame(session.conn);
            if f.frameType != 0 {
                return Amqp10Link { conn: session.conn, chanId: session.chanId, handle: -1, maxFrameSize: session.maxFrameSize, linkCredit: 0, deliveryCount: 0, errorMessage: "expected AMQP frame (type=0), got frameType=" + f.frameType.toString(), recoveredUnsettledTags: [] };
            }
            let p = Amqp10::decodePerformative(f.body);
            if p.descriptor != 0x12 {
                return Amqp10Link { conn: session.conn, chanId: session.chanId, handle: -1, maxFrameSize: session.maxFrameSize, linkCredit: 0, deliveryCount: 0, errorMessage: "expected attach (0x12), got descriptor=" + p.descriptor.toString(), recoveredUnsettledTags: [] };
            }
            // Coordinator links never receive flow -- the broker accepts
            // declare/discharge transfers unconditionally regardless of
            // link credit (a control channel, not a message flow). v1
            // therefore generously grants itself credit instead of
            // waiting for a flow that never comes.
            return Amqp10Link { conn: session.conn, chanId: session.chanId, handle: handle, maxFrameSize: session.maxFrameSize, linkCredit: 2147483647, deliveryCount: 0, errorMessage: "", recoveredUnsettledTags: [] };
        }

        /*
         * Sends a coordinator link's control transfer (declare OR
         * discharge, depending on `controlValue`) and reads the matching
         * `disposition` (settled=false, the broker MUST respond) —
         * shared core for declare()/discharge(), analogous to
         * publishCore().
         */
        fn sendCoordinatorControl(controlValue: Amqp10Value) -> Amqp10Value
        {
            let w = Amqp10Writer::new();
            let sectionDesc = Amqp10Described { descriptor: 0x77, value: controlValue }; // amqp-value section
            w.writeDescribed(sectionDesc);

            let deliveryTag = Amqp10::deliveryTagBytes(this.deliveryCount);
            var transferFields: List<Amqp10Value> = [
                Amqp10Value::UIntVal(this.handle),
                Amqp10Value::UIntVal(this.deliveryCount),
                Amqp10Value::BinaryVal(deliveryTag),
                Amqp10Value::UIntVal(0),       // message-format
                Amqp10Value::BoolVal(false)    // settled: false -- the broker MUST respond with a disposition
            ];
            let transferBody = Amqp10::encodePerformative(0x14, transferFields);
            var fullFrame: List<Int64> = [];
            for i in 0..transferBody.len() { fullFrame.push(transferBody[i]); }
            for i in 0..w.bytes.len() { fullFrame.push(w.bytes[i]); }
            Amqp10::writeFrame(this.conn, 0, this.chanId, fullFrame);
            this.deliveryCount = this.deliveryCount + 1;

            let f = Amqp10::readFrame(this.conn);
            if f.frameType != 0 {
                return Amqp10Value::ErrorVal("expected AMQP frame (type=0), got frameType=" + f.frameType.toString());
            }
            let p = Amqp10::decodePerformative(f.body);
            if p.descriptor != 0x15 {
                return Amqp10Value::ErrorVal("expected disposition (0x15), got descriptor=" + p.descriptor.toString());
            }
            if p.fields.len() < 5 {
                return Amqp10Value::ErrorVal("disposition with no state field");
            }
            return p.fields[4];
        }

        /*
         * Starts a new transaction (issue 79, §4.4): sends `declare`
         * (descriptor 0x31, its only field global-id = NullVal — v1 only
         * supports local transactions, no distributed global-id) over
         * THIS link (attached via attachCoordinator()), expects a
         * `declared` (descriptor 0x33, field: txn-id as binary) as the
         * disposition state. `Amqp10Transaction.txnId` gets passed to
         * publishTransactional()/ackTransactional()/discharge().
         */
        fn declare() -> Amqp10Transaction
        {
            let declareDesc = Amqp10Described { descriptor: 0x31, value: Amqp10Value::ListVal([Amqp10Value::NullVal]) };
            let state = this.sendCoordinatorControl(Amqp10Value::DescribedVal(declareDesc));
            match state {
                DescribedVal(d) => {
                    if d.descriptor == 0x33 {
                        match d.value {
                            ListVal(fields) => {
                                if fields.len() > 0 {
                                    match fields[0] {
                                        BinaryVal(txnId) => { return Amqp10Transaction { txnId: txnId, ok: true, errorMessage: "" }; }
                                        _ => {}
                                    }
                                }
                            }
                            _ => {}
                        }
                    }
                }
                ErrorVal(msg) => { return Amqp10Transaction { txnId: [], ok: false, errorMessage: msg }; }
                _ => {}
            }
            return Amqp10Transaction { txnId: [], ok: false, errorMessage: "declare: unexpected disposition state (not declared/0x33)" };
        }

        /*
         * Ends a transaction (issue 79, §4.5): sends `discharge`
         * (descriptor 0x32, fields txn-id + fail) over THIS coordinator
         * link. fail=false commits (every delivery marked via
         * publishTransactional()/ackTransactional() becomes binding for
         * the broker), fail=true discards (rollback). Expects an
         * `accepted` as the disposition state — any other state (or a
         * `rejected` with a txn-error) is a hard error instead of a
         * discharge that's silently treated as "successful".
         */
        fn discharge(txnId: List<Int64>, fail: Bool) -> Bool
        {
            let dischargeDesc = Amqp10Described { descriptor: 0x32, value: Amqp10Value::ListVal([
                Amqp10Value::BinaryVal(txnId),
                Amqp10Value::BoolVal(fail)
            ]) };
            let state = this.sendCoordinatorControl(Amqp10Value::DescribedVal(dischargeDesc));
            match state {
                DescribedVal(d) => { if d.descriptor == 0x24 { return true; } } // accepted
                _ => {}
            }
            this.errorMessage = "discharge: did not receive an accepted disposition state";
            return false;
        }
    }
}

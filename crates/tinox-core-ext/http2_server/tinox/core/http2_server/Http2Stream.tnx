module tinox.core.http2_server

import tinox.core.hpack

namespace tinox.core.http2_server
{
    /**
     * Per-stream state for an HTTP/2 connection.
     *
     * Accumulates the HPACK-encoded header block across one or more
     * HEADERS/CONTINUATION frames, and body bytes from DATA frames.
     */
    class Http2Stream
    {
        var id: Int64
        /** "open" | "half_closed_remote" | "closed" */
        var state: String
        var headerBlock: List<Int64>
        var body: List<Int64>
        var endStream: Bool
        var expectingContinuation: Bool
        /** Decoded request header fields (decoded when END_HEADERS arrives, in wire order). */
        var headers: List<HpackHeader>
        /** True once the initial header block is complete; a later HEADERS is a trailer block. */
        var headersDone: Bool
        var trailerBlock: Bool
        var sendWindow: Int64
        /** Over the concurrent-stream limit: decoded for HPACK state, then answered with RST_STREAM. */
        var refused: Bool
        /** Response body still to be sent (flow-controlled), with the bytes already written. */
        var outBody: String
        /** Byte copy of a body that could not be sent at once (the length-aware bridge is only valid right after the handler ran). */
        var outBytes: List<Int64>
        var bodyLength: Int64
        var sendOffset: Int64

        fn new(id: Int64, window: Int64) -> Http2Stream
        {
            return Http2Stream {
                id: id,
                state: "open",
                headerBlock: [],
                body: [],
                endStream: false,
                expectingContinuation: false,
                headers: [],
                headersDone: false,
                trailerBlock: false,
                sendWindow: window,
                refused: false,
                outBody: "",
                outBytes: [],
                bodyLength: 0,
                sendOffset: 0
            }
        }
    }
}

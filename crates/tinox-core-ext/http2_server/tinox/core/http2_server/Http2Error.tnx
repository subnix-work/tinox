module tinox.core.http2_server;

namespace tinox.core.http2_server
{
    // =========================================================================
    // Error codes (RFC 7540 §7)
    // =========================================================================

    class Http2Error
    {
        fn NO_ERROR()            -> Int64 { return 0x0; }
        fn PROTOCOL_ERROR()      -> Int64 { return 0x1; }
        fn INTERNAL_ERROR()      -> Int64 { return 0x2; }
        fn FLOW_CONTROL_ERROR()  -> Int64 { return 0x3; }
        fn STREAM_CLOSED()       -> Int64 { return 0x5; }
        fn FRAME_SIZE_ERROR()    -> Int64 { return 0x6; }
        fn REFUSED_STREAM()      -> Int64 { return 0x7; }
        fn CANCEL()              -> Int64 { return 0x8; }
        fn COMPRESSION_ERROR()   -> Int64 { return 0x9; }
    }
}

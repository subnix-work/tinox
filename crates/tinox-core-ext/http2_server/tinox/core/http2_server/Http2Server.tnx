module tinox.core.http2_server

import tinox.core.bytes
import tinox.core.hpack
import tinox.core.http_server

namespace tinox.core.http2_server
{
    // Roh-Bytes von einem Socket-fd lesen (HTTP/2-Framing).
    extern fn tinoxBytesToString(bytes: List<Int64>) -> String
    // @Cors/@Csrf policy (#529): 1 = the guard already filled the response.
    extern fn tinoxSecurityGuard(ctx: HttpContext, routeExists: Int64) -> Int64
    extern fn tinoxHttpRequestBodyFromBytes(bytes: List<Int64>) -> String
    extern fn tinoxHttpClearBodyBridge() -> Nothing
    extern fn tinoxHttpBodyLength(body: String) -> Int64
    extern fn tinoxHttpBodySlice(body: String, start: Int64, end: Int64) -> List<Int64>

    /**
     * HTTP/2 server with a fluent route-registration API identical to HttpServer.
     *
     * Handles the full HTTP/2 connection lifecycle per RFC 7540:
     * connection preface validation, SETTINGS exchange, binary frame I/O,
     * HPACK decoding for requests and encoding for responses,
     * multi-stream multiplexing, and graceful GOAWAY shutdown.
     */
    class Http2Server
    {
        var port: Int64
        var routes: List<Route>
        var middleware: List<fnc(HttpContext) -> Bool>
        var socketHandle: Int64
        var running: Bool

        fn new(port: Int64) -> Http2Server
        {
            return Http2Server {
                port: port,
                routes: [],
                middleware: [],
                socketHandle: -1,
                running: false
            }
        }

        fn get(path: String, handler: fnc(HttpContext) -> Nothing) -> Http2Server
        {
            this.routes.push(Route { method: "GET", path: path, handler: handler })
            return this
        }

        fn post(path: String, handler: fnc(HttpContext) -> Nothing) -> Http2Server
        {
            this.routes.push(Route { method: "POST", path: path, handler: handler })
            return this
        }

        fn put(path: String, handler: fnc(HttpContext) -> Nothing) -> Http2Server
        {
            this.routes.push(Route { method: "PUT", path: path, handler: handler })
            return this
        }

        fn patch(path: String, handler: fnc(HttpContext) -> Nothing) -> Http2Server
        {
            this.routes.push(Route { method: "PATCH", path: path, handler: handler })
            return this
        }

        fn delete(path: String, handler: fnc(HttpContext) -> Nothing) -> Http2Server
        {
            this.routes.push(Route { method: "DELETE", path: path, handler: handler })
            return this
        }

        fn use(mware: fnc(HttpContext) -> Bool) -> Http2Server
        {
            this.middleware.push(mware)
            return this
        }

        fn stop() -> Nothing
        {
            this.running = false
        }

        @Throws(Http2ServerError)
        /**
         * Starts listening and enters the connection accept loop.
         * Each accepted connection runs on its own task, so one idle client never blocks the others.
         */
        fn listen() -> Nothing
        {
            this.socketHandle = httpServerCreate(this.port)
            if (this.socketHandle < 0)
            {
                throw Http2ServerError { message: "Failed to create HTTP/2 server on port " + this.port.toString() }
            }
            this.running = true
            while this.running
            {
                const clientFd: Int64 = httpServerAcceptConn(this.socketHandle)
                if (clientFd >= 0)
                {
                    // One task per connection: an idle or slow client must not block every other one.
                    const task = spawn serveConnection(this, clientFd)
                    taskDetach(task)
                }
            }
            httpServerClose(this.socketHandle)
        }

        /**
         * Runs one connection to completion on its own task (a static function, because spawn does not
         * take a this-bound method). Errors are contained here: a failing connection only closes itself.
         */
        async fnc serveConnection(server: Http2Server, fd: Int64) -> Int64
        {
            try { server.handleConnection(fd) }
            catch (error: String)
            {
                tinoxHttpClearBodyBridge()
                httpServerCloseConn(fd)
                println("HTTP/2 connection failed: " + error)
            }
            return 0
        }

        // =====================================================================
        // Low-level byte I/O helpers
        // =====================================================================

        // Binary-safe I/O on a connection handle (httpConnFromFd): frame headers start with
        // NUL bytes, which a C-string based read would silently truncate -- real clients
        // (curl, browsers) always send such frames.
        fn readBytes(wire: Int64, count: Int64) -> List<Int64>
        {
            return httpConnReadN(wire, count)
        }

        fn sendBytes(wire: Int64, bytes: List<Int64>) -> Nothing
        {
            httpConnWriteBytes(wire, bytes)
        }

        fn appendBytes(dest: List<Int64>, src: List<Int64>) -> Nothing
        {
            var i: Int64 = 0
            while i < src.len()
            {
                dest.push(src[i])
                i = i + 1
            }
        }

        // =====================================================================
        // Frame I/O (RFC 7540 §4.1)
        //
        // Frame header layout (9 bytes):
        //   +-----------------------------------------------+
        //   |                 Length (24)                    |
        //   +---------------+---------------+---------------+
        //   |   Type (8)    |   Flags (8)   |
        //   +-+-------------+---------------+---------------+
        //   |R|           Stream Identifier (31)            |
        //   +=+=============================================+
        //   |               Frame Payload ...               |
        //   +-----------------------------------------------+
        // =====================================================================

        fn readFrame(conn: Http2Conn) -> Http2Frame
        {
            const header: List<Int64> = this.readBytes(conn.handle, 9)
            if (header.len() < 9)
            {
                // Connection closed or error — signal with type -1
                return Http2Frame { length: 0, type: -1, flags: 0, streamId: 0, payload: [] }
            }
            const length: Int64 = (header[0] << 16) | (header[1] << 8) | header[2]
            const frameType: Int64 = header[3]
            const flags: Int64 = header[4]
            // R bit (MSB of stream ID) is reserved and must be ignored
            const streamId: Int64 = ((header[5] & 127) << 24) | (header[6] << 16) | (header[7] << 8) | header[8]
            // RFC 9113 §4.2: nothing above SETTINGS_MAX_FRAME_SIZE (the 16384 default we never raise)
            // is read at all; type -2 tells the loop to answer FRAME_SIZE_ERROR.
            if (length > 16384)
            {
                return Http2Frame { length: length, type: -2, flags: 0, streamId: streamId, payload: [] }
            }
            const payload: List<Int64> = this.readBytes(conn.handle, length)
            if (payload.len() < length)
            {
                return Http2Frame { length: 0, type: -1, flags: 0, streamId: 0, payload: [] }
            }
            return Http2Frame {
                length: length,
                type: frameType,
                flags: flags,
                streamId: streamId,
                payload: payload
            }
        }

        fn writeFrame(conn: Http2Conn, frame: Http2Frame) -> Nothing
        {
            const out: List<Int64> = []
            const len: Int64 = frame.payload.len()
            out.push((len >> 16) & 255)
            out.push((len >> 8) & 255)
            out.push(len & 255)
            out.push(frame.type & 255)
            out.push(frame.flags & 255)
            out.push((frame.streamId >> 24) & 127)
            out.push((frame.streamId >> 16) & 255)
            out.push((frame.streamId >> 8) & 255)
            out.push(frame.streamId & 255)
            this.appendBytes(out, frame.payload)
            this.sendBytes(conn.handle, out)
        }

        // =====================================================================
        // Control frame senders
        // =====================================================================

        fn sendServerSettings(conn: Http2Conn) -> Nothing
        {
            const payload: List<Int64> = []
            // Disable server push (we don't use it)
            payload.push(0)
            payload.push(Http2Settings::ENABLE_PUSH())
            payload.push(0)
            payload.push(0)
            payload.push(0)
            payload.push(0)
            // Max concurrent streams = 128
            payload.push(0)
            payload.push(Http2Settings::MAX_CONCURRENT_STREAMS())
            payload.push(0)
            payload.push(0)
            payload.push(0)
            payload.push(128)
            // Initial window size = 65535 (default)
            payload.push(0)
            payload.push(Http2Settings::INITIAL_WINDOW_SIZE())
            payload.push(0)
            payload.push(0)
            payload.push(255)
            payload.push(255)
            this.writeFrame(conn, Http2Frame::new(Http2FrameType::SETTINGS(), 0, 0, payload))
        }

        fn sendSettingsAck(conn: Http2Conn) -> Nothing
        {
            this.writeFrame(conn, Http2Frame::new(Http2FrameType::SETTINGS(), Http2Flags::ACK(), 0, []))
        }

        fn sendPong(conn: Http2Conn, pingPayload: List<Int64>) -> Nothing
        {
            this.writeFrame(conn, Http2Frame::new(Http2FrameType::PING(), Http2Flags::ACK(), 0, pingPayload))
        }

        fn sendGoaway(conn: Http2Conn, errorCode: Int64) -> Nothing
        {
            const payload: List<Int64> = []
            payload.push((conn.lastStreamId >> 24) & 127)
            payload.push((conn.lastStreamId >> 16) & 255)
            payload.push((conn.lastStreamId >> 8) & 255)
            payload.push(conn.lastStreamId & 255)
            payload.push((errorCode >> 24) & 255)
            payload.push((errorCode >> 16) & 255)
            payload.push((errorCode >> 8) & 255)
            payload.push(errorCode & 255)
            this.writeFrame(conn, Http2Frame::new(Http2FrameType::GOAWAY(), 0, 0, payload))
        }

        fn sendRstStream(conn: Http2Conn, streamId: Int64, errorCode: Int64) -> Nothing
        {
            const payload: List<Int64> = []
            payload.push((errorCode >> 24) & 255)
            payload.push((errorCode >> 16) & 255)
            payload.push((errorCode >> 8) & 255)
            payload.push(errorCode & 255)
            this.writeFrame(conn, Http2Frame::new(Http2FrameType::RST_STREAM(), 0, streamId, payload))
        }

        // =====================================================================
        // Error handling helpers (RFC 9113 §5.4)
        // =====================================================================

        /** Connection error: GOAWAY with the error code, then the frame loop ends. */
        fn connError(conn: Http2Conn, errorCode: Int64) -> Nothing
        {
            if (conn.dead == false)
            {
                this.sendGoaway(conn, errorCode)
                conn.dead = true
            }
        }

        /** Marks a stream closed and drops its buffers; the small stub stays so later frames see "closed". */
        fn closeStream(conn: Http2Conn, stream: Http2Stream) -> Nothing
        {
            if (stream.state != "closed")
            {
                stream.state = "closed"
                conn.openStreams = conn.openStreams - 1
                conn.closedCount = conn.closedCount + 1
            }
            stream.headerBlock = []
            stream.body = []
            stream.headers = []
            stream.outBody = ""
            stream.outBytes = []
            if (conn.closedCount > 4096)
            {
                // Bound the per-connection stub table: old closed streams are forgotten.
                const keys: List<String> = conn.streams.keys()
                var k: Int64 = 0
                while k < keys.len()
                {
                    const old: Http2Stream = conn.streams[keys[k]]
                    if (old.state == "closed" && old.id + 8192 < conn.lastStreamId)
                    {
                        conn.streams.remove(keys[k])
                    }
                    k = k + 1
                }
                conn.closedCount = 0
            }
        }

        fn streamError(conn: Http2Conn, stream: Http2Stream, errorCode: Int64) -> Nothing
        {
            this.sendRstStream(conn, stream.id, errorCode)
            this.closeStream(conn, stream)
        }

        // =====================================================================
        // SETTINGS frame processing (RFC 7540 §6.5)
        // =====================================================================

        fn processSettings(conn: Http2Conn, frame: Http2Frame) -> Nothing
        {
            if (frame.streamId != 0)
            {
                this.connError(conn, Http2Error::PROTOCOL_ERROR())
                return
            }
            if ((frame.flags & Http2Flags::ACK()) != 0)
            {
                if (frame.payload.len() != 0)
                {
                    this.connError(conn, Http2Error::FRAME_SIZE_ERROR())
                }
                return
            }
            if (frame.payload.len() % 6 != 0)
            {
                this.connError(conn, Http2Error::FRAME_SIZE_ERROR())
                return
            }
            var i: Int64 = 0
            while i + 5 < frame.payload.len()
            {
                const settingId: Int64 = (frame.payload[i] << 8) | frame.payload[i + 1]
                const settingVal: Int64 = (frame.payload[i + 2] << 24) | (frame.payload[i + 3] << 16) | (frame.payload[i + 4] << 8) | frame.payload[i + 5]
                if (settingId == Http2Settings::ENABLE_PUSH() && settingVal > 1)
                {
                    this.connError(conn, Http2Error::PROTOCOL_ERROR())
                    return
                }
                if (settingId == Http2Settings::INITIAL_WINDOW_SIZE())
                {
                    if (settingVal > 2147483647)
                    {
                        this.connError(conn, Http2Error::FLOW_CONTROL_ERROR())
                        return
                    }
                    // §6.9.2: the change applies to every open stream's window.
                    const delta: Int64 = settingVal - conn.peerInitWindowSize
                    const keys: List<String> = conn.streams.keys()
                    var k: Int64 = 0
                    while k < keys.len()
                    {
                        const st: Http2Stream = conn.streams[keys[k]]
                        st.sendWindow = st.sendWindow + delta
                        if (st.sendWindow > 2147483647)
                        {
                            this.connError(conn, Http2Error::FLOW_CONTROL_ERROR())
                            return
                        }
                        k = k + 1
                    }
                    conn.peerInitWindowSize = settingVal
                }
                if (settingId == Http2Settings::MAX_FRAME_SIZE())
                {
                    if (settingVal < 16384 || settingVal > 16777215)
                    {
                        this.connError(conn, Http2Error::PROTOCOL_ERROR())
                        return
                    }
                    conn.peerMaxFrameSize = settingVal
                }
                // HEADER_TABLE_SIZE limits our ENCODER table; the decoder table (recvDynTable)
                // is bounded by the size this server advertised, so it is not touched here.
                i = i + 6
            }
            this.sendSettingsAck(conn)
            // A larger initial window (or a bigger frame size) may unblock queued responses.
            this.flushSendQueue(conn)
        }

        // =====================================================================
        // Header block completion: HPACK decoding in wire order + request validation
        // (RFC 9113 §8.2, §8.3). Decoding must happen when END_HEADERS arrives, not later,
        // because the dynamic table is shared state across streams.
        // =====================================================================

        fn hasUpper(name: String) -> Bool
        {
            var i: Int64 = 0
            while i < name.len()
            {
                const c: Int64 = name.charCodeAt(i)
                if (c >= 65 && c <= 90)
                {
                    return true
                }
                i = i + 1
            }
            return false
        }

        /** Returns true if the decoded request (or trailer) header list is well-formed. */
        fn validHeaderList(headers: List<HpackHeader>, trailer: Bool) -> Bool
        {
            var seenRegular: Bool = false
            var methodCount: Int64 = 0
            var schemeCount: Int64 = 0
            var pathCount: Int64 = 0
            var pathEmpty: Bool = false
            var i: Int64 = 0
            while i < headers.len()
            {
                const h: HpackHeader = headers[i]
                if (this.hasUpper(h.name) || h.name.len() == 0)
                {
                    return false
                }
                if (h.name.startsWith(":"))
                {
                    if (trailer || seenRegular)
                    {
                        return false
                    }
                    if (h.name == ":method") { methodCount = methodCount + 1 }
                    else if (h.name == ":scheme") { schemeCount = schemeCount + 1 }
                    else if (h.name == ":path")
                    {
                        pathCount = pathCount + 1
                        if (h.value.len() == 0) { pathEmpty = true }
                    }
                    else if (h.name != ":authority")
                    {
                        return false
                    }
                }
                else
                {
                    seenRegular = true
                    if (h.name == "connection" || h.name == "keep-alive" || h.name == "proxy-connection" || h.name == "transfer-encoding" || h.name == "upgrade")
                    {
                        return false
                    }
                    if (h.name == "te" && h.value != "trailers")
                    {
                        return false
                    }
                }
                i = i + 1
            }
            if (trailer)
            {
                return true
            }
            return methodCount == 1 && schemeCount == 1 && pathCount == 1 && pathEmpty == false
        }

        /**
         * Called when a header block is complete (END_HEADERS). Decodes it, validates it and,
         * if the request is already complete (END_STREAM), dispatches it.
         */
        fn headerBlockComplete(conn: Http2Conn, stream: Http2Stream) -> Nothing
        {
            conn.continuationStream = 0
            stream.expectingContinuation = false
            var decoded: List<HpackHeader> = []
            try
            {
                decoded = Hpack::decode(stream.headerBlock, conn.recvDynTable)
            }
            catch (error: String)
            {
                this.connError(conn, Http2Error::COMPRESSION_ERROR())
                return
            }
            stream.headerBlock = []
            if (this.validHeaderList(decoded, stream.trailerBlock) == false)
            {
                this.streamError(conn, stream, Http2Error::PROTOCOL_ERROR())
                return
            }
            if (stream.trailerBlock == false)
            {
                stream.headers = decoded
                stream.headersDone = true
            }
            if (stream.endStream)
            {
                stream.state = "half_closed_remote"
                this.dispatchStream(conn, stream)
            }
        }

        // =====================================================================
        // HEADERS frame processing (RFC 7540 §6.2)
        // =====================================================================

        fn processHeaders(conn: Http2Conn, frame: Http2Frame) -> Nothing
        {
            if (frame.streamId == 0 || frame.streamId % 2 == 0)
            {
                this.connError(conn, Http2Error::PROTOCOL_ERROR())
                return
            }
            var payloadOffset: Int64 = 0
            var padLength: Int64 = 0
            if ((frame.flags & Http2Flags::PADDED()) != 0)
            {
                if (frame.payload.len() < 1)
                {
                    this.connError(conn, Http2Error::FRAME_SIZE_ERROR())
                    return
                }
                padLength = frame.payload[0]
                payloadOffset = 1
            }
            if ((frame.flags & Http2Flags::PRIORITY()) != 0)
            {
                if (frame.payload.len() < payloadOffset + 5)
                {
                    this.connError(conn, Http2Error::FRAME_SIZE_ERROR())
                    return
                }
                const dependency: Int64 = ((frame.payload[payloadOffset] & 127) << 24) | (frame.payload[payloadOffset + 1] << 16) | (frame.payload[payloadOffset + 2] << 8) | frame.payload[payloadOffset + 3]
                if (dependency == frame.streamId)
                {
                    this.connError(conn, Http2Error::PROTOCOL_ERROR())
                    return
                }
                payloadOffset = payloadOffset + 5
            }
            if (padLength > frame.payload.len() - payloadOffset)
            {
                this.connError(conn, Http2Error::PROTOCOL_ERROR())
                return
            }

            const sid: String = frame.streamId.toString()
            var stream: Http2Stream
            if (conn.streams.contains(sid))
            {
                stream = conn.streams[sid]
                if (stream.state == "closed" || stream.state == "half_closed_remote")
                {
                    this.connError(conn, Http2Error::STREAM_CLOSED())
                    return
                }
                // A second HEADERS on an open stream is the trailer block and must end the stream.
                if (stream.headersDone == false || (frame.flags & Http2Flags::END_STREAM()) == 0)
                {
                    this.connError(conn, Http2Error::PROTOCOL_ERROR())
                    return
                }
                stream.trailerBlock = true
            }
            else
            {
                if (frame.streamId <= conn.lastStreamId)
                {
                    this.connError(conn, Http2Error::PROTOCOL_ERROR())
                    return
                }
                conn.lastStreamId = frame.streamId
                stream = Http2Stream::new(frame.streamId, conn.peerInitWindowSize)
                conn.streams[sid] = stream
                conn.openStreams = conn.openStreams + 1
                if (conn.openStreams > 128)
                {
                    // Over the advertised SETTINGS_MAX_CONCURRENT_STREAMS. The header block still has
                    // to be decoded to keep the HPACK table in sync, so only refuse after that.
                    stream.refused = true
                }
            }

            const headerEnd: Int64 = frame.payload.len() - padLength
            var i: Int64 = payloadOffset
            while i < headerEnd
            {
                stream.headerBlock.push(frame.payload[i])
                i = i + 1
            }

            // Bug 94: cap the cumulative header block (CONTINUATION flood).
            if (stream.headerBlock.len() > 1048576)
            {
                this.connError(conn, Http2Error::ENHANCE_YOUR_CALM())
                return
            }

            if ((frame.flags & Http2Flags::END_STREAM()) != 0)
            {
                stream.endStream = true
            }
            if ((frame.flags & Http2Flags::END_HEADERS()) != 0)
            {
                this.headerBlockComplete(conn, stream)
            }
            else
            {
                stream.expectingContinuation = true
                conn.continuationStream = frame.streamId
            }
        }

        // =====================================================================
        // CONTINUATION frame processing (RFC 7540 §6.10)
        // =====================================================================

        fn processContinuation(conn: Http2Conn, frame: Http2Frame) -> Nothing
        {
            // The loop already guarantees continuationStream == frame.streamId here.
            const stream: Http2Stream = conn.streams[frame.streamId.toString()]
            this.appendBytes(stream.headerBlock, frame.payload)

            // Bug 94: same cumulative cap as processHeaders() — the actual CONTINUATION-flood path.
            if (stream.headerBlock.len() > 1048576)
            {
                this.connError(conn, Http2Error::ENHANCE_YOUR_CALM())
                return
            }

            if ((frame.flags & Http2Flags::END_HEADERS()) != 0)
            {
                this.headerBlockComplete(conn, stream)
            }
        }

        // =====================================================================
        // DATA frame processing (RFC 7540 §6.1)
        // =====================================================================

        fn processData(conn: Http2Conn, frame: Http2Frame) -> Nothing
        {
            if (frame.streamId == 0)
            {
                this.connError(conn, Http2Error::PROTOCOL_ERROR())
                return
            }
            const sid: String = frame.streamId.toString()
            if (conn.streams.contains(sid) == false)
            {
                if (frame.streamId > conn.lastStreamId)
                {
                    // idle stream
                    this.connError(conn, Http2Error::PROTOCOL_ERROR())
                }
                else
                {
                    this.sendRstStream(conn, frame.streamId, Http2Error::STREAM_CLOSED())
                }
                return
            }
            const stream: Http2Stream = conn.streams[sid]
            if (stream.state == "closed" || stream.state == "half_closed_remote")
            {
                this.sendRstStream(conn, frame.streamId, Http2Error::STREAM_CLOSED())
                return
            }
            if (stream.headersDone == false)
            {
                this.connError(conn, Http2Error::PROTOCOL_ERROR())
                return
            }

            var payloadOffset: Int64 = 0
            var padLength: Int64 = 0
            if ((frame.flags & Http2Flags::PADDED()) != 0)
            {
                if (frame.payload.len() < 1)
                {
                    this.connError(conn, Http2Error::FRAME_SIZE_ERROR())
                    return
                }
                padLength = frame.payload[0]
                payloadOffset = 1
            }
            if (padLength > frame.payload.len() - payloadOffset)
            {
                this.connError(conn, Http2Error::PROTOCOL_ERROR())
                return
            }
            const dataEnd: Int64 = frame.payload.len() - padLength
            var i: Int64 = payloadOffset
            while i < dataEnd
            {
                stream.body.push(frame.payload[i])
                i = i + 1
            }

            // Bug 94: cap the accumulated request body.
            if (stream.body.len() > 16777216)
            {
                this.streamError(conn, stream, Http2Error::FRAME_SIZE_ERROR())
                return
            }

            // Receive-side flow control: return the credit for every consumed byte, otherwise a client
            // upload larger than the initial 65535-byte window stalls forever.
            if (frame.length > 0)
            {
                this.sendWindowUpdate(conn, 0, frame.length)
                if ((frame.flags & Http2Flags::END_STREAM()) == 0)
                {
                    this.sendWindowUpdate(conn, frame.streamId, frame.length)
                }
            }

            if ((frame.flags & Http2Flags::END_STREAM()) != 0)
            {
                stream.endStream = true
                stream.state = "half_closed_remote"
                this.dispatchStream(conn, stream)
            }
        }

        fn sendWindowUpdate(conn: Http2Conn, streamId: Int64, increment: Int64) -> Nothing
        {
            const payload: List<Int64> = []
            payload.push((increment >> 24) & 127)
            payload.push((increment >> 16) & 255)
            payload.push((increment >> 8) & 255)
            payload.push(increment & 255)
            this.writeFrame(conn, Http2Frame::new(Http2FrameType::WINDOW_UPDATE(), 0, streamId, payload))
        }

        // =====================================================================
        // Control frames: PING, PRIORITY, RST_STREAM, WINDOW_UPDATE, PUSH_PROMISE
        // =====================================================================

        fn processPing(conn: Http2Conn, frame: Http2Frame) -> Nothing
        {
            if (frame.streamId != 0)
            {
                this.connError(conn, Http2Error::PROTOCOL_ERROR())
                return
            }
            if (frame.payload.len() != 8)
            {
                this.connError(conn, Http2Error::FRAME_SIZE_ERROR())
                return
            }
            // A PING with ACK is the answer to ours; echoing it would ping-pong forever.
            if ((frame.flags & Http2Flags::ACK()) == 0)
            {
                this.sendPong(conn, frame.payload)
            }
        }

        fn processPriority(conn: Http2Conn, frame: Http2Frame) -> Nothing
        {
            if (frame.streamId == 0)
            {
                this.connError(conn, Http2Error::PROTOCOL_ERROR())
                return
            }
            if (frame.payload.len() != 5)
            {
                this.connError(conn, Http2Error::FRAME_SIZE_ERROR())
                return
            }
            const dependency: Int64 = ((frame.payload[0] & 127) << 24) | (frame.payload[1] << 16) | (frame.payload[2] << 8) | frame.payload[3]
            if (dependency == frame.streamId)
            {
                this.connError(conn, Http2Error::PROTOCOL_ERROR())
            }
        }

        fn processRstStream(conn: Http2Conn, frame: Http2Frame) -> Nothing
        {
            if (frame.streamId == 0)
            {
                this.connError(conn, Http2Error::PROTOCOL_ERROR())
                return
            }
            if (frame.payload.len() != 4)
            {
                this.connError(conn, Http2Error::FRAME_SIZE_ERROR())
                return
            }
            const sid: String = frame.streamId.toString()
            if (conn.streams.contains(sid))
            {
                this.closeStream(conn, conn.streams[sid])
            }
            else if (frame.streamId > conn.lastStreamId)
            {
                this.connError(conn, Http2Error::PROTOCOL_ERROR())
            }
        }

        fn processWindowUpdate(conn: Http2Conn, frame: Http2Frame) -> Nothing
        {
            if (frame.payload.len() != 4)
            {
                this.connError(conn, Http2Error::FRAME_SIZE_ERROR())
                return
            }
            const increment: Int64 = ((frame.payload[0] & 127) << 24) | (frame.payload[1] << 16) | (frame.payload[2] << 8) | frame.payload[3]
            if (frame.streamId == 0)
            {
                if (increment == 0)
                {
                    this.connError(conn, Http2Error::PROTOCOL_ERROR())
                    return
                }
                conn.sendWindow = conn.sendWindow + increment
                if (conn.sendWindow > 2147483647)
                {
                    this.connError(conn, Http2Error::FLOW_CONTROL_ERROR())
                    return
                }
                this.flushSendQueue(conn)
                return
            }
            const sid: String = frame.streamId.toString()
            if (conn.streams.contains(sid) == false)
            {
                if (frame.streamId > conn.lastStreamId)
                {
                    this.connError(conn, Http2Error::PROTOCOL_ERROR())
                }
                return
            }
            const stream: Http2Stream = conn.streams[sid]
            if (increment == 0)
            {
                this.streamError(conn, stream, Http2Error::PROTOCOL_ERROR())
                return
            }
            stream.sendWindow = stream.sendWindow + increment
            if (stream.sendWindow > 2147483647)
            {
                this.streamError(conn, stream, Http2Error::FLOW_CONTROL_ERROR())
                return
            }
            this.flushSendQueue(conn)
        }

        // =====================================================================
        // Request dispatch and response sending
        // =====================================================================

        /**
         * Decodes a completed stream into an HttpContext, runs middleware and
         * route matching, then sends the HEADERS + DATA response frames.
         */
        fn dispatchStream(conn: Http2Conn, stream: Http2Stream) -> Nothing
        {
            if (stream.refused)
            {
                this.streamError(conn, stream, Http2Error::REFUSED_STREAM())
                return
            }
            const rawHeaders: List<HpackHeader> = stream.headers
            // RFC 9113 §8.1.1: a content-length that disagrees with the DATA actually received is malformed.
            var ci: Int64 = 0
            while ci < rawHeaders.len()
            {
                if (rawHeaders[ci].name == "content-length")
                {
                    if (rawHeaders[ci].value != stream.body.len().toString())
                    {
                        this.streamError(conn, stream, Http2Error::PROTOCOL_ERROR())
                        return
                    }
                }
                ci = ci + 1
            }

            const request: HttpRequest = HttpRequest::new("", "", "", Map::new(), "")
            var i: Int64 = 0
            while i < rawHeaders.len()
            {
                const h: HpackHeader = rawHeaders[i]
                if (h.name == ":method")
                {
                    request.method = h.value
                }
                else if (h.name == ":path")
                {
                    const qIdx: Int64 = h.value.indexOf("?")
                    if (qIdx >= 0)
                    {
                        request.path = h.value.substring(0, qIdx)
                        request.queryString = h.value.substring(qIdx + 1, h.value.len())
                    }
                    else
                    {
                        request.path = h.value
                    }
                }
                else if (h.name == ":authority")
                {
                    // HTTP/2 carries the host here; expose it as Host like HTTP/1 (same-origin checks need it).
                    request.headers["host"] = h.value
                }
                else if (h.name.startsWith(":") == false)
                {
                    request.headers[h.name] = h.value
                }
                i = i + 1
            }

            // tinoxBytesToString does the byte->char conversion in one
            // pass instead of `bodyStr = bodyStr + fromCharCode(...)` in a
            // loop, which is O(n^2) over the body length (issue #167).
            request.body = tinoxHttpRequestBodyFromBytes(stream.body)

            const response: HttpResponse = HttpResponse::new()
            const ctx: HttpContext = HttpContext::new(request, response)

            const guarded: Int64 = tinoxSecurityGuard(ctx, this.routeExistsFor(ctx))
            const middlewareContinue: Bool = guarded != 0 || this.runMiddleware(ctx)
            if (guarded != 0)
            {
                // answered by the browser-security guard (preflight, rejection)
            }
            else if (middlewareContinue == false)
            {
                ctx.response.statusCode = 403
                ctx.response.text("Forbidden")
            }
            else
            {
                const matched: Bool = this.matchRoute(ctx)
                if (matched == false)
                {
                    ctx.response.statusCode = 404
                    ctx.response.text("Not Found")
                }
            }

            this.sendResponse(conn, stream, ctx.response)
        }

        /**
         * Encodes an HttpResponse as HTTP/2 HEADERS + DATA frames and sends them.
         * HEADERS carries the :status pseudo-header plus all response headers.
         * DATA carries the body (omitted for empty bodies; END_STREAM on HEADERS instead).
         */
        fn sendResponse(conn: Http2Conn, stream: Http2Stream, response: HttpResponse) -> Nothing
        {
            // A peer-controlled zero/invalid maximum must never stall the
            // bounded DATA-frame loop. Reject on the wire, without guessing.
            if (conn.peerMaxFrameSize < 16384 || conn.peerMaxFrameSize > 16777215)
            {
                this.sendGoaway(conn, Http2Error::PROTOCOL_ERROR())
                conn.dead = true
                tinoxHttpClearBodyBridge()
                return
            }
            const bodyLength: Int64 = tinoxHttpBodyLength(response.body)
            const responseHeaders: List<HpackHeader> = []
            responseHeaders.push(HpackHeader::new(":status", response.statusCode.toString()))

            const headerKeys: List<String> = response.headers.keys()
            var i: Int64 = 0
            while i < headerKeys.len()
            {
                // Repeated fields are stored as "<Name> <n>" (HttpResponse.addHeader, #528);
                // the wire name is the part before the first space.
                var wireName: String = headerKeys[i]
                const space = wireName.indexOf(" ")
                if (space > 0) {
                    wireName = wireName.substring(0, space)
                }
                responseHeaders.push(HpackHeader::new(wireName.toLowerCase(), response.headers[headerKeys[i]]))
                i = i + 1
            }
            if (bodyLength > 0)
            {
                responseHeaders.push(HpackHeader::new("content-length", bodyLength.toString()))
            }

            const encodedHeaders: List<Int64> = Hpack::encode(responseHeaders, conn.sendDynTable)

            var headersFlags: Int64 = Http2Flags::END_HEADERS()
            if (bodyLength == 0)
            {
                headersFlags = headersFlags | Http2Flags::END_STREAM()
            }
            this.writeFrame(conn, Http2Frame::new(Http2FrameType::HEADERS(), headersFlags, stream.id, encodedHeaders))

            if (bodyLength == 0)
            {
                tinoxHttpClearBodyBridge()
                this.closeStream(conn, stream)
                return
            }
            // The body is flow-controlled (RFC 9113 §6.9): send what the windows allow now and keep
            // the rest queued; WINDOW_UPDATE / SETTINGS frames continue it via flushSendQueue.
            stream.outBody = response.body
            stream.bodyLength = bodyLength
            stream.sendOffset = 0
            var firstWindow: Int64 = conn.sendWindow
            if (stream.sendWindow < firstWindow) { firstWindow = stream.sendWindow }
            if (bodyLength > firstWindow)
            {
                // Will be continued later, after the bridge is gone: keep an exact byte copy now.
                stream.outBytes = tinoxHttpBodySlice(response.body, 0, bodyLength)
            }
            this.flushStream(conn, stream)
            if (stream.state != "closed")
            {
                conn.sendQueue.push(stream.id)
            }
        }

        /** Sends as much of the stream's pending body as the connection and stream windows allow. */
        fn flushStream(conn: Http2Conn, stream: Http2Stream) -> Nothing
        {
            while (stream.sendOffset < stream.bodyLength && conn.dead == false)
            {
                var allowed: Int64 = conn.sendWindow
                if (stream.sendWindow < allowed) { allowed = stream.sendWindow }
                if (allowed <= 0)
                {
                    return
                }
                var size: Int64 = conn.peerMaxFrameSize
                if (allowed < size) { size = allowed }
                var end: Int64 = stream.sendOffset + size
                if (end > stream.bodyLength) { end = stream.bodyLength }
                var bodyBytes: List<Int64> = []
                if (stream.outBytes.len() > 0)
                {
                    var b: Int64 = stream.sendOffset
                    while b < end
                    {
                        bodyBytes.push(stream.outBytes[b])
                        b = b + 1
                    }
                }
                else
                {
                    bodyBytes = tinoxHttpBodySlice(stream.outBody, stream.sendOffset, end)
                }
                var flags: Int64 = 0
                if (end == stream.bodyLength) { flags = Http2Flags::END_STREAM() }
                this.writeFrame(conn, Http2Frame::new(Http2FrameType::DATA(), flags, stream.id, bodyBytes))
                conn.sendWindow = conn.sendWindow - (end - stream.sendOffset)
                stream.sendWindow = stream.sendWindow - (end - stream.sendOffset)
                stream.sendOffset = end
            }
            tinoxHttpClearBodyBridge()
            if (stream.sendOffset >= stream.bodyLength)
            {
                stream.outBody = ""
                stream.outBytes = []
                this.closeStream(conn, stream)
            }
        }

        /** Continues every queued response after a window grew (WINDOW_UPDATE, SETTINGS). */
        fn flushSendQueue(conn: Http2Conn) -> Nothing
        {
            const waiting: List<Int64> = conn.sendQueue
            conn.sendQueue = []
            var i: Int64 = 0
            while i < waiting.len()
            {
                const key: String = waiting[i].toString()
                if (conn.streams.contains(key))
                {
                    const stream: Http2Stream = conn.streams[key]
                    if (stream.state != "closed" && stream.sendOffset < stream.bodyLength)
                    {
                        this.flushStream(conn, stream)
                        if (stream.state != "closed")
                        {
                            conn.sendQueue.push(stream.id)
                        }
                    }
                }
                i = i + 1
            }
        }

        // =====================================================================
        // Connection lifecycle (RFC 7540 §3.5, §6)
        // =====================================================================

        /**
         * Manages a single HTTP/2 connection from preface validation through GOAWAY.
         *
         * Steps:
         *  1. Read and validate the 24-byte client connection preface
         *  2. Send server SETTINGS
         *  3. Enter the frame-processing loop:
         *     - SETTINGS → update peer params, send ACK
         *     - HEADERS  → accumulate header block, dispatch when END_HEADERS + END_STREAM
         *     - CONTINUATION → append to header block, dispatch when END_HEADERS
         *     - DATA     → accumulate body, dispatch on END_STREAM
         *     - PING     → echo back with ACK flag
         *     - RST_STREAM → mark stream closed
         *     - GOAWAY   → graceful shutdown
         *     - WINDOW_UPDATE → acknowledged but not tracked (basic flow control)
         *  4. Send GOAWAY and close the connection
         */
        fn handleConnection(fd: Int64) -> Nothing
        {
            // RFC 7540 §3.5: client connection preface = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"
            const wire: Int64 = httpConnFromFd(fd)
            const prefaceBytes: List<Int64> = this.readBytes(wire, 24)
            if (prefaceBytes.len() < 24)
            {
                httpConnClose(wire)
                return
            }
            // tinoxBytesToString does the byte->char conversion in one
            // pass instead of `prefaceStr = prefaceStr + fromCharCode(...)`
            // in a loop (issue #167; bounded to 24 bytes here, but kept
            // consistent with the rest of this module's byte->string sites).
            const prefaceStr: String = tinoxBytesToString(prefaceBytes)
            if (prefaceStr != "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n")
            {
                httpConnClose(wire)
                return
            }

            const conn: Http2Conn = Http2Conn::new(wire)
            this.sendServerSettings(conn)

            var active: Bool = true
            while active && conn.dead == false
            {
                const frame: Http2Frame = this.readFrame(conn)

                if (frame.type == -1)
                {
                    active = false
                }
                else if (frame.type == -2)
                {
                    this.connError(conn, Http2Error::FRAME_SIZE_ERROR())
                }
                else if (conn.continuationStream != 0 && (frame.type != Http2FrameType::CONTINUATION() || frame.streamId != conn.continuationStream))
                {
                    // RFC 9113 §6.10: nothing may interleave a header block.
                    this.connError(conn, Http2Error::PROTOCOL_ERROR())
                }
                else if (frame.type == Http2FrameType::SETTINGS())
                {
                    this.processSettings(conn, frame)
                }
                else if (frame.type == Http2FrameType::HEADERS())
                {
                    this.processHeaders(conn, frame)
                }
                else if (frame.type == Http2FrameType::CONTINUATION())
                {
                    // Valid only inside an open header block (matching stream id checked above).
                    if (conn.continuationStream == 0)
                    {
                        this.connError(conn, Http2Error::PROTOCOL_ERROR())
                    }
                    else
                    {
                        this.processContinuation(conn, frame)
                    }
                }
                else if (frame.type == Http2FrameType::DATA())
                {
                    this.processData(conn, frame)
                }
                else if (frame.type == Http2FrameType::PING())
                {
                    this.processPing(conn, frame)
                }
                else if (frame.type == Http2FrameType::PRIORITY())
                {
                    this.processPriority(conn, frame)
                }
                else if (frame.type == Http2FrameType::RST_STREAM())
                {
                    this.processRstStream(conn, frame)
                }
                else if (frame.type == Http2FrameType::WINDOW_UPDATE())
                {
                    this.processWindowUpdate(conn, frame)
                }
                else if (frame.type == Http2FrameType::PUSH_PROMISE())
                {
                    // Clients must never push (RFC 9113 §8.4).
                    this.connError(conn, Http2Error::PROTOCOL_ERROR())
                }
                else if (frame.type == Http2FrameType::GOAWAY())
                {
                    active = false
                }
                // Unknown frame types are ignored (RFC 9113 §4.1).
            }

            if (conn.dead == false)
            {
                this.sendGoaway(conn, Http2Error::NO_ERROR())
            }
            httpConnClose(wire)
        }

        // =====================================================================
        // Middleware and route matching (mirrors HttpServer)
        // =====================================================================

        fn runMiddleware(ctx: HttpContext) -> Bool
        {
            var i: Int64 = 0
            while i < this.middleware.len()
            {
                const result: Bool = this.middleware[i](ctx)
                if (result == false)
                {
                    return false
                }
                i = i + 1
            }
            return true
        }

        // For a CORS preflight: is a route registered for the method it asks about on this path?
        fn routeExistsFor(ctx: HttpContext) -> Int64
        {
            const wanted: String = ctx.request.getHeader("access-control-request-method")
            if (wanted == "")
            {
                return 1
            }
            var i: Int64 = 0
            while i < this.routes.len()
            {
                const route: Route = this.routes[i]
                if (route.method == wanted && RouteMatcher::matches(route.path, ctx.request.path))
                {
                    return 1
                }
                i = i + 1
            }
            return 0
        }

        fn matchRoute(ctx: HttpContext) -> Bool
        {
            var i: Int64 = 0
            while i < this.routes.len()
            {
                const route: Route = this.routes[i]
                if (route.method == ctx.request.method && RouteMatcher::matches(route.path, ctx.request.path))
                {
                    const params: Map<String, String> = RouteMatcher::extractParams(route.path, ctx.request.path)
                    ctx.request.setParams(params)
                    route.handler(ctx)
                    return true
                }
                i = i + 1
            }
            return false
        }
    }
}

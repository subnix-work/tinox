module tinox.core.tpl;

namespace tinox.core.tpl
{
    class Template
    {
        fn render(template: String, data: Map<String, JsonValue>) -> String
        {
            var result: String = template;
            let keys: List<String> = data.keys();
            var i: Int64 = 0;
            while i < keys.len()
            {
                let key: String = keys[i];
                let placeholder: String = "{{" + key + "}}";
                let value: String = Json::stringify(data[key]);
                result = result.replace(placeholder, value);
                i = i + 1;
            }
            return result;
        }

        fn renderLoop(template: String, items: List<Map<String, JsonValue>>, itemVar: String) -> String
        {
            var result: String = "";
            var i: Int64 = 0;
            while i < items.len()
            {
                result = result + Template::render(template, items[i]);
                i = i + 1;
            }
            return result;
        }

        fn compile(template: String) -> CompiledTemplate
        {
            var sections: List<TemplateSection> = [];
            var current: Int64 = 0;
            while current < template.len()
            {
                let tagStart: Int64 = template.indexOf("{{", current);
                if tagStart == -1
                {
                    if current < template.len()
                    {
                        sections.push(TemplateSection { kind: "text", content: template.substring(current, template.len()) });
                    }
                    break;
                }
                if tagStart > current
                {
                    sections.push(TemplateSection { kind: "text", content: template.substring(current, tagStart) });
                }
                let tagEnd: Int64 = template.indexOf("}}", tagStart);
                if tagEnd == -1
                {
                    break;
                }
                let tagContent: String = template.substring(tagStart + 2, tagEnd);
                if tagContent.startsWith("#")
                {
                    sections.push(TemplateSection { kind: "section", content: tagContent.substring(1, tagContent.len()) });
                }
                else if tagContent.startsWith("/")
                {
                    sections.push(TemplateSection { kind: "end", content: tagContent.substring(1, tagContent.len()) });
                }
                else
                {
                    sections.push(TemplateSection { kind: "var", content: tagContent });
                }
                current = tagEnd + 2;
            }
            return CompiledTemplate { source: template, sections: sections };
        }

        fn execute(tpl: CompiledTemplate, data: Map<String, JsonValue>) -> String
        {
            var result: String = "";
            var i: Int64 = 0;
            while i < tpl.sections.len()
            {
                let section: TemplateSection = tpl.sections[i];
                if section.kind == "text"
                {
                    result = result + section.content;
                }
                else if section.kind == "var"
                {
                    if data.contains(section.content)
                    {
                        result = result + Json::stringify(data[section.content]);
                    }
                }
                i = i + 1;
            }
            return result;
        }
    }
}

module tinox.core.rest.server;

namespace tinox.core.rest.server
{
    /**
     * Specifies the response content type (Content-Type header).
     * @Produces(MediaType::Json)
     */
    @annotation
    class Produces
    {
        var value: MediaType;

        fn new(value: MediaType) -> Produces
        {
            return Produces { value: value };
        }
    }
}

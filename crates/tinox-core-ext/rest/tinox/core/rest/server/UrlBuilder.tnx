module tinox.core.rest.server;

namespace tinox.core.rest.server
{
    // ========================================================================
    // URL Builder (reuses patterns from rest.tnx)
    // ========================================================================

    /**
     * URL path builder for joining base paths and route paths
     */
    class UrlBuilder
    {
        /**
         * Joins a base path and a route path, avoiding duplicate slashes
         *
         * @param base the base path (e.g., "/api/users")
         * @param path the route path (e.g., "/:id")
         * @return the combined path
         */
        fn join(base: String, path: String) -> String
        {
            if base.len() == 0
            {
                return path;
            }
            if path.len() == 0
            {
                return base;
            }
            if base == "/"
            {
                return path;
            }
            if base.endsWith("/") && path.startsWith("/")
            {
                return base.substring(0, base.len() - 1) + path;
            }
            if base.endsWith("/") || path.startsWith("/")
            {
                return base + path;
            }
            return base + "/" + path;
        }
    }
}

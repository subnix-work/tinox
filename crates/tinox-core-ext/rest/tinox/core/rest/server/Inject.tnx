module tinox.core.rest.server;

namespace tinox.core.rest.server
{
    /**
     * Marks a field for compile-time dependency injection.
     * The compiler resolves the dependency from the DI container and
     * wires it up without any runtime lookup.
     *
     * Example:
     *   @ApplicationComponent
     *   class UserController
     *   {
     *       @Inject
     *       var service: UserService;
     *   }
     */
    @annotation
    class Inject {}
}

module tinox.core.rest.server;

namespace tinox.core.rest.server
{
    /**
     * Marks a method or class as requiring authentication.
     * @Auth("bearer")
     * @Auth("basic")
     */
    @annotation
    class Auth
    {
        var value: String;

        fn new(value: String) -> Auth
        {
            return Auth { value: value };
        }
    }
}

module tinox.core.rest.server;

import tinox.core.http_server;

namespace tinox.core.rest.server
{
    /**
     * Main REST framework class for building and starting an HTTP API server.
     *
     * Combines the annotation-driven approach with explicit registration,
     * supporting graceful migration once the compiler processes annotations natively.
     *
     * Example:
     *   let app: RestApi = RestApi::new(8080);
     *
     *   // Register an annotated controller
     *   app.register(userController);
     *
     *   // Or use fluent API directly
     *   app.get("/ping", ctx => {
     *       ctx.response.text("pong");
     *   });
     *
     *   // Add global middleware
     *   app.use(loggingMiddleware);
     *   app.use(corsMiddleware);
     *
     *   app.start();
     */
    class RestApi
    {
        /** The underlying HTTP server */
        var server: HttpServer;

        /** All registered route entries from controllers */
        var routeEntries: List<RouteEntry>;

        /** Global middleware functions */
        var globalMiddleware: List<fnc(HttpContext) -> Bool>;

        /** Whether CORS is enabled */
        var corsEnabled: Bool;

        /** Allowed origins for CORS */
        var corsOrigin: String;

        /**
         * Validates the credential extracted from an @Auth-protected route's
         * Authorization header: called as (authType, credential) where
         * credential is the header value with the "Bearer "/"Basic " scheme
         * prefix already stripped. Defaults to rejecting everything (Bug
         * 104) -- previously @Auth only checked that the header started
         * with the right scheme prefix and never validated the credential
         * itself, so any syntactically-shaped Authorization header passed.
         * Wire up real validation with setAuthValidator(), e.g. checking a
         * bearer token against Jwt::verify() or a basic-auth credential
         * against a user store.
         */
        var authValidator: fnc(String, String) -> Bool;

        fn new(port: Int64) -> RestApi
        {
            return RestApi {
                server: HttpServer::new(port),
                routeEntries: [],
                globalMiddleware: [],
                corsEnabled: false,
                corsOrigin: "",
                authValidator: fnc(authType: String, credential: String) -> Bool { return false; }
            };
        }

        /**
         * Registers the credential validator used by @Auth-protected routes
         * (see authValidator). Must be set explicitly -- without it, every
         * @Auth-protected route rejects all requests.
         *
         * @param validator fn(authType, credential) -> Bool
         * @return this RestApi for chaining
         */
        fn setAuthValidator(validator: fnc(String, String) -> Bool) -> RestApi
        {
            this.authValidator = validator;
            return this;
        }

        /**
         * Registers all routes from a RestController.
         *
         * Routes defined via the controller's .route() calls are added
         * to the framework's routing table and the underlying server.
         *
         * @param controller the controller to register
         * @return this RestApi for chaining
         */
        fn register(controller: RestController) -> RestApi
        {
            var i: Int64 = 0;
            while i < controller.routes.len()
            {
                let entry: RouteEntry = controller.routes[i];
                this.addRouteEntry(entry);
                i = i + 1;
            }
            return this;
        }

        /**
         * Registers a GET route directly (fluent API)
         *
         * @param path the URL path pattern
         * @param handler the handler function
         * @return this RestApi for chaining
         */
        fn get(path: String, handler: fnc(HttpContext) -> Nothing) -> RestApi
        {
            this.addRouteEntry(RouteEntry::new("GET", path, handler));
            return this;
        }

        /**
         * Registers a POST route directly (fluent API)
         *
         * @param path the URL path pattern
         * @param handler the handler function
         * @return this RestApi for chaining
         */
        fn post(path: String, handler: fnc(HttpContext) -> Nothing) -> RestApi
        {
            this.addRouteEntry(RouteEntry::new("POST", path, handler));
            return this;
        }

        /**
         * Registers a PUT route directly (fluent API)
         *
         * @param path the URL path pattern
         * @param handler the handler function
         * @return this RestApi for chaining
         */
        fn put(path: String, handler: fnc(HttpContext) -> Nothing) -> RestApi
        {
            this.addRouteEntry(RouteEntry::new("PUT", path, handler));
            return this;
        }

        /**
         * Registers a PATCH route directly (fluent API)
         *
         * @param path the URL path pattern
         * @param handler the handler function
         * @return this RestApi for chaining
         */
        fn patch(path: String, handler: fnc(HttpContext) -> Nothing) -> RestApi
        {
            this.addRouteEntry(RouteEntry::new("PATCH", path, handler));
            return this;
        }

        /**
         * Registers a DELETE route directly (fluent API)
         *
         * @param path the URL path pattern
         * @param handler the handler function
         * @return this RestApi for chaining
         */
        fn delete(path: String, handler: fnc(HttpContext) -> Nothing) -> RestApi
        {
            this.addRouteEntry(RouteEntry::new("DELETE", path, handler));
            return this;
        }

        /**
         * Adds a global middleware function.
         * Middleware runs before route handlers in registration order.
         * Return false to stop the request chain (sends 403).
         *
         * @param mware the middleware function
         * @return this RestApi for chaining
         */
        fn use(mware: fnc(HttpContext) -> Bool) -> RestApi
        {
            this.globalMiddleware.push(mware);
            this.server.use(mware);
            return this;
        }

        /**
         * Enables CORS for all responses
         *
         * @param origin the allowed origin (default "*")
         * @return this RestApi for chaining
         */
        fn enableCors(origin: String) -> RestApi
        {
            this.corsEnabled = true;
            this.corsOrigin = origin;
            this.server.use(ctx => {
                ctx.response.cors(origin);
                if ctx.request.method == "OPTIONS"
                {
                    ctx.response.status(204);
                    return false;
                }
                return true;
            });
            return this;
        }

        /**
         * Adds default JSON Content-Type to all responses
         *
         * @return this RestApi for chaining
         */
        fn defaultJson() -> RestApi
        {
            this.server.use(ctx => {
                if ctx.response.headers.contains("Content-Type") == false
                {
                    ctx.response.header("Content-Type", "application/json; charset=utf-8");
                }
                return true;
            });
            return this;
        }

        /**
         * Starts the REST API server.
         *
         * Registers all route entries with the underlying HttpServer
         * and begins listening for connections. This is a blocking call.
         */
        fn start() -> Nothing
        {
            this.registerRoutes();
            this.server.listen();
        }

        /**
         * Stops the REST API server.
         */
        fn stop() -> Nothing
        {
            this.server.stop();
        }

        /**
         * Registers all collected route entries with the underlying HttpServer,
         * applying annotation metadata (status code, content types, auth).
         */
        fn registerRoutes() -> Nothing
        {
            var i: Int64 = 0;
            while i < this.routeEntries.len()
            {
                let entry: RouteEntry = this.routeEntries[i];
                let handler: fnc(HttpContext) -> Nothing = this.wrapHandler(entry);
                if entry.method == "GET"
                {
                    this.server.get(entry.path, handler);
                }
                else if entry.method == "POST"
                {
                    this.server.post(entry.path, handler);
                }
                else if entry.method == "PUT"
                {
                    this.server.put(entry.path, handler);
                }
                else if entry.method == "PATCH"
                {
                    this.server.patch(entry.path, handler);
                }
                else if entry.method == "DELETE"
                {
                    this.server.delete(entry.path, handler);
                }
                i = i + 1;
            }
        }

        /**
         * Wraps a route handler to apply annotation metadata:
         * - @StatusCode sets the default response status
         * - @Produces sets Content-Type if not already set
         * - @Consumes validates the request Content-Type
         * - @Auth validates authentication
         *
         * @param entry the route entry with metadata
         * @return a wrapped handler that applies metadata before calling the original
         */
        fn wrapHandler(entry: RouteEntry) -> fnc(HttpContext) -> Nothing
        {
            let statusCode: Int64 = entry.statusCode;
            let produces: MediaType = entry.produces;
            let consumes: MediaType = entry.consumes;
            let authType: String = entry.authType;
            let originalHandler: fnc(HttpContext) -> Nothing = entry.handler;
            let authenticator: fnc(String, String) -> Bool = this.authValidator;

            return fnc(ctx: HttpContext) -> Nothing {
                if consumes != MediaType::None
                {
                    let expected: String = MediaTypeHelper::toString(consumes);
                    let ct: String = ctx.request.getHeader("Content-Type");
                    if ct.startsWith(expected) == false
                    {
                        ctx.response.status(415).text("Unsupported Media Type. Expected: " + expected);
                        return;
                    }
                }

                if authType.len() > 0
                {
                    let authHeader: String = ctx.request.getHeader("Authorization");
                    if authHeader.len() == 0
                    {
                        ctx.response.status(401).header("WWW-Authenticate", authType).text("Unauthorized");
                        return;
                    }
                    if authType == "bearer" && authHeader.startsWith("Bearer ") == false
                    {
                        ctx.response.status(401).text("Unauthorized: Bearer token required");
                        return;
                    }
                    if authType == "basic" && authHeader.startsWith("Basic ") == false
                    {
                        ctx.response.status(401).text("Unauthorized: Basic auth required");
                        return;
                    }
                    // Bug 104: the checks above only ever validated the
                    // Authorization header's scheme prefix -- any syntactically
                    // correct but arbitrary "Bearer ..."/"Basic ..." header
                    // passed. Actually validate the credential now.
                    var credential: String = authHeader;
                    if authType == "bearer" { credential = authHeader.substring(7, authHeader.len()); }
                    if authType == "basic" { credential = authHeader.substring(6, authHeader.len()); }
                    if credential.len() == 0 || authenticator(authType, credential) == false
                    {
                        ctx.response.status(401).text("Unauthorized");
                        return;
                    }
                }

                if statusCode != 200
                {
                    ctx.response.status(statusCode);
                }

                if produces != MediaType::None && ctx.response.headers.contains("Content-Type") == false
                {
                    ctx.response.header("Content-Type", MediaTypeHelper::toString(produces));
                }

                originalHandler(ctx);
            };
        }

        /**
         * Adds a RouteEntry to the internal list
         */
        fn addRouteEntry(entry: RouteEntry) -> Nothing
        {
            this.routeEntries.push(entry);
        }
    }
}

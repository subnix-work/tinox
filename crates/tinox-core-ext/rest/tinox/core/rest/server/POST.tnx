module tinox.core.rest.server;

namespace tinox.core.rest.server
{
    /**
     * Marks a method as a POST endpoint.
     * @POST("/path") or @POST for the class base path
     */
    @annotation
    class POST
    {
        var path: String;

        fn new(path: String) -> POST
        {
            return POST { path: path };
        }

        fn default() -> POST
        {
            return POST { path: "" };
        }
    }
}

module tinox.core.rest.server;

namespace tinox.core.rest.server
{
    /**
     * Specifies the accepted request content type.
     * @Consumes(MediaType::Json)
     */
    @annotation
    class Consumes
    {
        var value: MediaType;

        fn new(value: MediaType) -> Consumes
        {
            return Consumes { value: value };
        }
    }
}

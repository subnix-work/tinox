/**
 * Tinox Standard Library - HTTP Server Module
 * HTTP server implementation for building RESTful APIs
 * with route registration, middleware support, and request/response handling
 */
module tinox.core.http_server;

namespace tinox.core.http_server
{
    /**
     * HTTP server for handling incoming HTTP requests
     *
     * Supports route registration for GET, POST, PUT, PATCH, DELETE,
     * middleware chains, and automatic request parsing.
     *
     * Example usage:
     *   let server: HttpServer = HttpServer::new(8080);
     *   server.get("/hello", ctx => {
     *       ctx.response.text("Hello, World!");
     *   });
     *   server.post("/users", ctx => {
     *       let data: JsonValue = ctx.request.json();
     *       ctx.response.status(201).json("{\"id\": 1}");
     *   });
     *   server.listen();
     */
    class HttpServer
    {
        /** The port to listen on */
        var port: Int64;

        /** Registered routes */
        var routes: List<Route>;

        /** Registered middleware functions */
        var middleware: List<fnc(HttpContext) -> Bool>;

        /** The underlying socket handle */
        var socketHandle: Int64;

        /** Whether the server is running */
        var running: Bool;

        /**
         * Creates a new HttpServer listening on the given port
         *
         * @param port the port number to bind to
         * @return a new HttpServer instance
         */
        fn new(port: Int64) -> HttpServer
        {
            return HttpServer { port: port, routes: [], middleware: [], socketHandle: -1, running: false };
        }

        /**
         * Registers a GET route handler
         *
         * @param path the URL path pattern (e.g., "/users/:id")
         * @param handler the function to handle matching requests
         * @return this server for chaining
         */
        fn get(path: String, handler: fnc(HttpContext) -> Nothing) -> HttpServer
        {
            this.routes.push(Route { method: "GET", path: path, handler: handler });
            return this;
        }

        /**
         * Registers a POST route handler
         *
         * @param path the URL path pattern
         * @param handler the function to handle matching requests
         * @return this server for chaining
         */
        fn post(path: String, handler: fnc(HttpContext) -> Nothing) -> HttpServer
        {
            this.routes.push(Route { method: "POST", path: path, handler: handler });
            return this;
        }

        /**
         * Registers a PUT route handler
         *
         * @param path the URL path pattern
         * @param handler the function to handle matching requests
         * @return this server for chaining
         */
        fn put(path: String, handler: fnc(HttpContext) -> Nothing) -> HttpServer
        {
            this.routes.push(Route { method: "PUT", path: path, handler: handler });
            return this;
        }

        /**
         * Registers a PATCH route handler
         *
         * @param path the URL path pattern
         * @param handler the function to handle matching requests
         * @return this server for chaining
         */
        fn patch(path: String, handler: fnc(HttpContext) -> Nothing) -> HttpServer
        {
            this.routes.push(Route { method: "PATCH", path: path, handler: handler });
            return this;
        }

        /**
         * Registers a DELETE route handler
         *
         * @param path the URL path pattern
         * @param handler the function to handle matching requests
         * @return this server for chaining
         */
        fn delete(path: String, handler: fnc(HttpContext) -> Nothing) -> HttpServer
        {
            this.routes.push(Route { method: "DELETE", path: path, handler: handler });
            return this;
        }

        /**
         * Registers a middleware function
         *
         * Middleware is executed in the order it is registered.
         * If a middleware returns false, the request chain is interrupted.
         *
         * @param mware the middleware function
         * @return this server for chaining
         */
        fn use(mware: fnc(HttpContext) -> Bool) -> HttpServer
        {
            this.middleware.push(mware);
            return this;
        }

        /**
         * Starts the server and begins listening for connections
         *
         * This is a blocking call that enters the server event loop.
         * Use stop() to shut down the server.
         */
        fn listen() -> Nothing
        {
            this.socketHandle = httpServerCreate(this.port);
            if this.socketHandle < 0
            {
                throw "Failed to create HTTP server on port " + this.port.toString();
            }
            this.running = true;
            while this.running
            {
                let conn: Int64 = httpServerAcceptConnHandle(this.socketHandle);
                if conn > 0
                {
                    let raw: String = httpConnReadRequest(conn);
                    if raw.len() > 0
                    {
                        let ctx: HttpContext = this.parseRawRequest(raw);
                        this.handleRequest(ctx, conn);
                    }
                    else
                    {
                        httpConnClose(conn);
                    }
                }
            }
            httpServerClose(this.socketHandle);
        }

        /**
         * Starts the server with TLS/HTTPS enabled.
         *
         * OpenSSL is linked by default (opt-out via TINOX_TLS=0 at build
         * time). Without it, httpServerCreateTls returns -1 and this call
         * throws.
         *
         * Certificate and key must both be PEM files. certPath may contain the
         * full certificate chain (leaf first).
         *
         * Example:
         *   server.listenTls("cert.pem", "key.pem");
         *
         * @param certPath path to the PEM certificate (chain) file
         * @param keyPath path to the PEM private key file
         */
        fn listenTls(certPath: String, keyPath: String) -> Nothing
        {
            this.socketHandle = httpServerCreateTls(this.port, certPath, keyPath);
            if this.socketHandle < 0
            {
                throw "Failed to create HTTPS server on port " + this.port.toString() + " (TLS setup failed — runtime built with TINOX_TLS=0, or cert/key invalid)";
            }
            this.running = true;
            while this.running
            {
                let conn: Int64 = httpServerAcceptTls(this.socketHandle);
                if conn > 0
                {
                    let raw: String = httpConnReadRequest(conn);
                    if raw.len() > 0
                    {
                        let ctx: HttpContext = this.parseRawRequest(raw);
                        this.handleRequest(ctx, conn);
                    }
                    else
                    {
                        httpConnClose(conn);
                    }
                }
            }
            httpServerClose(this.socketHandle);
        }

        /**
         * Parses a raw HTTP/1.1 request string into an HttpContext
         */
        fn parseRawRequest(raw: String) -> HttpContext
        {
            let request: HttpRequest = HttpRequest::new("", "", "", Map::new(), "");
            let response: HttpResponse = HttpResponse::new();
            let lines: List<String> = raw.split("\r\n");
            if lines.len() > 0
            {
                let firstLine: String = lines[0];
                let parts: List<String> = firstLine.split(" ");
                if parts.len() >= 2
                {
                    request.method = parts[0];
                    let fullPath: String = parts[1];
                    let qIdx: Int64 = fullPath.indexOf("?");
                    if qIdx >= 0
                    {
                        request.path = fullPath.substring(0, qIdx);
                        request.queryString = fullPath.substring(qIdx + 1, fullPath.len());
                    }
                    else
                    {
                        request.path = fullPath;
                    }
                }
            }
            var i: Int64 = 1;
            while i < lines.len()
            {
                let line: String = lines[i];
                if line.len() == 0
                {
                    i = i + 1;
                    break;
                }
                let colonIdx: Int64 = line.indexOf(":");
                if colonIdx > 0
                {
                    let key: String = line.substring(0, colonIdx).trim();
                    let hdrVal: String = line.substring(colonIdx + 1, line.len()).trim();
                    request.headers[key] = hdrVal;
                }
                i = i + 1;
            }
            var body: String = "";
            while i < lines.len()
            {
                if body.len() > 0
                {
                    body = body + "\r\n";
                }
                body = body + lines[i];
                i = i + 1;
            }
            request.body = body;
            return HttpContext::new(request, response);
        }

        /**
         * Formats an HttpResponse into a raw HTTP/1.1 response string
         */
        fn formatResponse(response: HttpResponse) -> String
        {
            let statusText: String = HttpServer::statusText(response.statusCode);
            var raw: String = "HTTP/1.1 " + response.statusCode.toString() + " " + statusText + "\r\n";
            let keys: List<String> = response.headers.keys();
            var hi: Int64 = 0;
            while hi < keys.len()
            {
                raw = raw + keys[hi] + ": " + response.headers[keys[hi]] + "\r\n";
                hi = hi + 1;
            }
            raw = raw + "Content-Length: " + response.body.len().toString() + "\r\n";
            raw = raw + "Connection: close\r\n";
            raw = raw + "\r\n";
            raw = raw + response.body;
            return raw;
        }

        /**
         * Returns the HTTP status text for a given status code
         */
        fn statusText(code: Int64) -> String
        {
            if code == 200 { return "OK"; }
            if code == 201 { return "Created"; }
            if code == 204 { return "No Content"; }
            if code == 301 { return "Moved Permanently"; }
            if code == 302 { return "Found"; }
            if code == 400 { return "Bad Request"; }
            if code == 401 { return "Unauthorized"; }
            if code == 403 { return "Forbidden"; }
            if code == 404 { return "Not Found"; }
            if code == 405 { return "Method Not Allowed"; }
            if code == 500 { return "Internal Server Error"; }
            return "Unknown";
        }

        /**
         * Stops the running server
         */
        fn stop() -> Nothing
        {
            this.running = false;
        }

        /**
         * Processes an incoming request through middleware and route matching,
         * then sends the response and closes the connection.
         *
         * @param ctx the request context
         * @param conn the client connection handle (plaintext or TLS)
         */
        fn handleRequest(ctx: HttpContext, conn: Int64) -> Nothing
        {
            let middlewareContinue: Bool = this.runMiddleware(ctx);
            if middlewareContinue == false
            {
                ctx.response.statusCode = 403;
                ctx.response.text("Forbidden");
            }
            else
            {
                let matched: Bool = this.matchRoute(ctx);
                if matched == false
                {
                    ctx.response.statusCode = 404;
                    ctx.response.text("Not Found");
                }
            }
            let raw: String = this.formatResponse(ctx.response);
            httpConnSendRaw(conn, raw);
            httpConnClose(conn);
        }

        /**
         * Runs all registered middleware functions
         *
         * @param ctx the request context
         * @return true if all middleware passed, false if any rejected
         */
        fn runMiddleware(ctx: HttpContext) -> Bool
        {
            var i: Int64 = 0;
            while i < this.middleware.len()
            {
                let result: Bool = this.middleware[i](ctx);
                if result == false
                {
                    return false;
                }
                i = i + 1;
            }
            return true;
        }

        /**
         * Matches an incoming request against registered routes
         *
         * Supports path parameters via :param syntax.
         * For example, "/users/:id" matches "/users/42" with params { id: "42" }
         *
         * @param ctx the request context (modified in place with params)
         * @return true if a matching route was found and executed
         */
        fn matchRoute(ctx: HttpContext) -> Bool
        {
            var i: Int64 = 0;
            while i < this.routes.len()
            {
                let route: Route = this.routes[i];
                if route.method == ctx.request.method && RouteMatcher::matches(route.path, ctx.request.path)
                {
                    let params: Map<String, String> = RouteMatcher::extractParams(route.path, ctx.request.path);
                    ctx.request.setParams(params);
                    route.handler(ctx);
                    return true;
                }
                i = i + 1;
            }
            return false;
        }
    }
}

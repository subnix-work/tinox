module tinox.core.http_server;

import tinox.core.option;

namespace tinox.core.http_server
{
    /**
     * Utility for parsing and working with query strings
     */
    class QueryString
    {
        /**
         * Parses a query string into a map of key-value pairs
         *
         * @param qs the raw query string (e.g., "page=1&limit=10")
         * @return a map of parameter names to values
         */
        fn parse(qs: String) -> Map<String, String>
        {
            const params: Map<String, String> = Map::new();
            if (qs.len() == 0)
            {
                return params;
            }

            var i: Int64 = 0;
            var key: String = "";
            var value: String = "";
            var inKey: Bool = true;

            while i < qs.len()
            {
                const ch: String = qs.substring(i, i + 1);
                if (ch == "&")
                {
                    if (key.len() > 0)
                    {
                        params[key] = value;
                    }
                    key = "";
                    value = "";
                    inKey = true;
                }
                else if (ch == "=" && inKey)
                {
                    inKey = false;
                }
                else if (inKey)
                {
                    key = key + ch;
                }
                else
                {
                    value = value + ch;
                }
                i = i + 1;
            }

            if (key.len() > 0)
            {
                params[key] = value;
            }
            return params;
        }

        /**
         * Gets a single value from a query string by parameter name
         *
         * @param qs the raw query string
         * @param name the parameter name
         * @return the parameter value, or empty string if not found
         */
        fn get(qs: String, name: String) -> String
        {
            return QueryString::find(qs, name).unwrapOr("");
        }

        /**
         * Finds a raw, case-sensitive query parameter. Some("") represents
         * a bare key or key=; None represents absence. Like parse(), the
         * last duplicate wins, empty keys are ignored, and no URL decoding
         * is performed.
         */
        fn find(qs: String, name: String) -> Option<String>
        {
            const params: Map<String, String> = QueryString::parse(qs);
            if (params.contains(name))
            {
                return Option<String>::some(params[name]);
            }
            return Option<String>::none();
        }
    }
}

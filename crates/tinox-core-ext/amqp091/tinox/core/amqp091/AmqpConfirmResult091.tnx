module tinox.core.amqp091;

import tinox.core.socket;

namespace tinox.core.amqp091
{
    /*
     * A publisher confirm received via `waitForConfirm()`
     * (`basic.ack`/`basic.nack` from the broker after `confirmSelect()`).
     * `ok == false` on any error (caller MUST check, no silent garbage)
     * — `errorMessage` then describes the cause. `multiple == true`
     * means: every delivery tag up to and including `deliveryTag` is
     * (n)acked, not just this one.
     */
    class AmqpConfirmResult091
    {
        var deliveryTag: Int64;
        var multiple: Bool;
        var ack: Bool;
        var ok: Bool;
        var errorMessage: String;
    }
}

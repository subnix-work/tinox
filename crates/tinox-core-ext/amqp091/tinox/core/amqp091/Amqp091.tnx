module tinox.core.amqp091;

import tinox.core.socket;

namespace tinox.core.amqp091
{
    class Amqp091
    {
        /*
         * Connects to the broker (raw TCP), still WITHOUT the protocol
         * handshake. Returns: conn handle (>0) or -1 on connection error.
         */
        fn dial(host: String, port: Int64) -> Int64
        {
            let fd = socketCreateTcp();
            if !socketConnect(fd, host, port) {
                // Bug 90: used to leak `fd` on every failed connect — a
                // reconnect loop against an unreachable/refusing broker
                // could exhaust the process fd limit over time.
                socketClose(fd);
                return -1;
            }
            return httpConnFromFd(fd);
        }

        /*
         * amqps:// — TLS variant of dial() (default broker port 5671).
         * OpenSSL is linked by default (see HttpServer::listenTls); built
         * with TINOX_TLS=0, httpConnFromFdTls returns -1. verify=true
         * checks the certificate chain + hostname against the system CA
         * stores (the default case for real broker certificates);
         * verify=false is a deliberate opt-out for self-signed test
         * certificates.
         */
        fn dialTls(host: String, port: Int64, verify: Bool) -> Int64
        {
            let fd = socketCreateTcp();
            if !socketConnect(fd, host, port) {
                // Bug 90: same fd leak as dial() above.
                socketClose(fd);
                return -1;
            }
            return httpConnFromFdTls(fd, host, verify);
        }

        /*
         * Sends the 8-byte protocol header (AMQP 0-9-1 §4.2.2):
         * "AMQP" 0x00 0x00 0x09 0x01.
         */
        fn sendProtocolHeader(conn: Int64) -> Nothing
        {
            let header: List<Int64> = [65, 77, 81, 80, 0, 0, 9, 1];
            httpConnWriteBytes(conn, header);
        }

        /*
         * Checks the response to the protocol header: reads the first
         * byte of the response. If the broker supports 0-9-1, that's the
         * start of a real METHOD frame (type octet 1, the frame is
         * `connection.start` — parsing follows separately). On a version
         * mismatch, the broker echoes the same 8-byte header layout back
         * and closes (first byte 'A' = 65) — that AND any other value
         * != 1, as well as EOF/short read, count as a hard failure.
         */
        fn checkHandshakeResponse(conn: Int64) -> Bool
        {
            let resp = httpConnReadN(conn, 1);
            if resp.len() < 1 {
                return false;
            }
            return resp[0] == 1;
        }

        /*
         * Reads exactly ONE frame (blocking): type octet + channel
         * (short) + size (long) + payload + 0xCE terminator (§4.2.3).
         * EOF/short read -> frameType -1; missing 0xCE OR payload > cap
         * -> frameType -2 (protocol error, caller closes).
         */
        fn readFrame(conn: Int64) -> AmqpFrame091
        {
            let bad = AmqpFrame091 { frameType: -1, chanId: 0, payload: [] };
            let hdr = httpConnReadN(conn, 7);
            if hdr.len() < 7 {
                return bad;
            }
            let frameType = hdr[0];
            let chanId = (hdr[1] << 8) | hdr[2];
            let size = (hdr[3] << 24) | (hdr[4] << 16) | (hdr[5] << 8) | hdr[6];
            if size < 0 || size > 16777216 {
                return AmqpFrame091 { frameType: -2, chanId: chanId, payload: [] };
            }
            var payload: List<Int64> = [];
            if size > 0 {
                let raw = httpConnReadN(conn, size);
                if raw.len() < size {
                    return bad;
                }
                payload = raw;
            }
            let end = httpConnReadN(conn, 1);
            if end.len() < 1 {
                return bad;
            }
            if end[0] != 0xCE {
                return AmqpFrame091 { frameType: -2, chanId: chanId, payload: [] };
            }
            return AmqpFrame091 { frameType: frameType, chanId: chanId, payload: payload };
        }

        /*
         * Writes a client->broker frame (§4.2.3).
         */
        fn writeFrame(conn: Int64, frameType: Int64, chanId: Int64, payload: List<Int64>) -> Nothing
        {
            let w = AmqpWriter091::new();
            w.octet(frameType);
            w.short(chanId);
            w.long(payload.len());
            w.rawBytes(payload);
            w.octet(0xCE);
            httpConnWriteBytes(conn, w.bytes);
        }

        /*
         * Builds the payload of a METHOD frame (§4.2.4): class-id +
         * method-id + already-encoded argument bytes (caller uses its
         * own AmqpWriter091 for the method-specific argument order).
         */
        fn encodeMethodPayload(classId: Int64, methodId: Int64, args: List<Int64>) -> List<Int64>
        {
            let w = AmqpWriter091::new();
            w.short(classId);
            w.short(methodId);
            w.rawBytes(args);
            return w.bytes;
        }

        /*
         * Splits a METHOD frame payload into class-id/method-id +
         * remaining argument bytes (for further processing with a fresh
         * AmqpReader091).
         */
        fn decodeMethodPayload(payload: List<Int64>) -> AmqpMethodFrame091
        {
            let r = AmqpReader091::new(payload);
            let classId = r.short();
            let methodId = r.short();
            var args: List<Int64> = [];
            while r.remaining() > 0 {
                args.push(r.octet());
            }
            return AmqpMethodFrame091 { classId: classId, methodId: methodId, args: args };
        }

        /*
         * Builds the SASL PLAIN response byte string: NUL + username +
         * NUL + password (RFC 4616). As List<Int64> instead of String,
         * because the embedded NUL byte would make Tinox string
         * concatenation risky (see longstrBytes).
         */
        fn saslPlainResponse(user: String, pass: String) -> List<Int64>
        {
            var bytes: List<Int64> = [];
            bytes.push(0);
            for i in 0..user.len() {
                bytes.push(user.charCodeAt(i) & 0xFF);
            }
            bytes.push(0);
            for i in 0..pass.len() {
                bytes.push(pass.charCodeAt(i) & 0xFF);
            }
            return bytes;
        }

        /*
         * Handles an unexpected `connection.close`/`channel.close` (e.g.
         * SASL error, unknown vhost): acknowledges per spec with
         * close-ok (the reply-code/reply-text fields have the same
         * position in both classes: short + shortstr first) and returns
         * an error message to pass along.
         */
        fn describeAndAckClose(conn: Int64, chanId: Int64, mf: AmqpMethodFrame091, closeOkMethodId: Int64) -> String
        {
            let r = AmqpReader091::new(mf.args);
            let replyCode = r.short();
            let replyText = r.shortstr();
            let closeOkPayload = Amqp091::encodeMethodPayload(mf.classId, closeOkMethodId, []);
            Amqp091::writeFrame(conn, 1, chanId, closeOkPayload);
            return "broker closed with code " + replyCode.toString() + ": " + replyText;
        }
    }
}

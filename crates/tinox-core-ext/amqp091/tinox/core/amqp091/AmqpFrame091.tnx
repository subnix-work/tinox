module tinox.core.amqp091;

import tinox.core.socket;

/*
 * AMQP-0-9-1 client on top of the HTTP server's conn-handle architecture
 * (the same foundation as WebSocket). No broker/server — only the
 * client-side connection setup to an existing broker (RabbitMQ etc.).
 *
 * Bytes flow as List<Int64> (one byte 0..255 per slot) over the
 * binary-safe primitives httpConnReadN/httpConnWriteBytes — the same
 * ones already used for WebSocket. Connection setup via
 * socketCreateTcp/socketConnect, then httpConnFromFd to wrap the bare fd
 * binary-safely.
 *
 * Deliberate v1 gaps: no TLS client (amqp:// only, no amqps://), no
 * content-header property codec here (that belongs to basic.publish,
 * not to the generic frame codec).
 */

namespace tinox.core.amqp091
{
    /*
     * A frame that was read (AMQP 0-9-1 §4.2.3). frameType: 1=METHOD,
     * 2=HEADER, 3=BODY, 4=HEARTBEAT; additionally as a read result: -1 =
     * connection closed/EOF, -2 = protocol error (missing 0xCE
     * terminator or payload cap exceeded).
     */
    class AmqpFrame091
    {
        var frameType: Int64;
        var chanId: Int64;
        var payload: List<Int64>;
    }
}

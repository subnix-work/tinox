module tinox.core.amqp091;

import tinox.core.socket;

namespace tinox.core.amqp091
{
    extern fn tinoxBytesToString(bytes: List<Int64>) -> String;

    /*
     * Counterpart to AmqpWriter091: reads big-endian from `bytes` starting
     * at an internal cursor position `pos`. No array-level bounds check
     * (caller MUST know the frame size beforehand, see
     * AmqpFrame091.payload — the length always comes from the outer
     * frame header).
     */
    class AmqpReader091
    {
        var bytes: List<Int64>;
        var pos: Int64;
        // Bug 89: sticky flag set once a read runs past the end of `bytes`,
        // same pattern as Amqp10Reader (Bug 86). A malicious/compromised
        // broker frame — e.g. a METHOD frame shorter than the class-id/
        // method-id header decodeMethodPayload() always reads, or a
        // field-table/array whose declared length exceeds what's actually
        // present — used to index straight into `bytes` and hard-crash the
        // client. Now octet() returns a dummy 0 and sets this instead.
        var truncated: Bool;

        fn new(bytes: List<Int64>) -> AmqpReader091
        {
            return AmqpReader091 { bytes: bytes, pos: 0, truncated: false };
        }

        fn remaining() -> Int64
        {
            return this.bytes.len() - this.pos;
        }

        fn octet() -> Int64
        {
            if this.pos >= this.bytes.len() {
                this.truncated = true;
                return 0;
            }
            let v = this.bytes[this.pos];
            this.pos = this.pos + 1;
            return v;
        }

        fn short() -> Int64
        {
            let hi = this.octet();
            let lo = this.octet();
            return (hi << 8) | lo;
        }

        /* Reads 4 bytes as an UNSIGNED 32-bit value (0..2^32-1) — for
         * size fields (table/array/longstr length). For the signed
         * `long-int` field-value type ('I') see longSigned(). */
        fn long() -> Int64
        {
            var v: Int64 = 0;
            for i in 0..4 {
                v = (v << 8) | this.octet();
            }
            return v;
        }

        /* Reads 4 bytes as a SIGNED 32-bit value (two's complement) — for
         * the field-value type 'I' (long-int). long() builds the value
         * unsigned; without the correction, a set bit 31 (any negative
         * Int32) would be misinterpreted as a huge positive Int64 (e.g.
         * -42 -> 4294967254). */
        fn longSigned() -> Int64
        {
            let v = this.long();
            if v >= 2147483648 {
                return v - 4294967296;
            }
            return v;
        }

        fn longlong() -> Int64
        {
            var v: Int64 = 0;
            for i in 0..8 {
                v = (v << 8) | this.octet();
            }
            return v;
        }

        fn rawStr(n: Int64) -> String
        {
            // Collects bytes into a List<Int64> and converts in one pass
            // (tinoxBytesToString) instead of `s = s + fromCharCode(...)`
            // in the loop, which is O(n^2) over the string length (issue #167).
            var bytes: List<Int64> = [];
            for i in 0..n {
                // Bug 66 (fixed): fromCharCode(this.octet()) directly used
                // to evaluate the side-effecting argument twice. The fix
                // is in codegen.rs, but other builtin arguments are
                // presumably affected the same way — done via a local
                // variable here regardless, just to be safe.
                let b = this.octet();
                bytes.push(b);
            }
            return tinoxBytesToString(bytes);
        }

        fn shortstr() -> String
        {
            let n = this.octet();
            return this.rawStr(n);
        }

        fn longstr() -> String
        {
            let n = this.long();
            return this.rawStr(n);
        }

        /* No silent garbage: an unknown type marker returns
         * ErrorVal(description) instead of guessing or aborting — the
         * caller decides whether that's fatal. */
        fn fieldValue() -> AmqpFieldValue091
        {
            let tag = this.octet();
            if tag == 116 { // 't'
                let b = this.octet();
                return AmqpFieldValue091::BoolVal(b != 0);
            }
            if tag == 73 { // 'I'
                return AmqpFieldValue091::Int32Val(this.longSigned());
            }
            if tag == 76 { // 'L'
                return AmqpFieldValue091::Int64Val(this.longlong());
            }
            if tag == 83 { // 'S'
                return AmqpFieldValue091::StrVal(this.longstr());
            }
            if tag == 84 { // 'T'
                return AmqpFieldValue091::TimestampVal(this.longlong());
            }
            if tag == 70 { // 'F'
                return AmqpFieldValue091::TableVal(this.fieldTable());
            }
            if tag == 65 { // 'A'
                return AmqpFieldValue091::ArrayVal(this.fieldArray());
            }
            if tag == 86 { // 'V'
                return AmqpFieldValue091::VoidVal;
            }
            return AmqpFieldValue091::ErrorVal("unknown field-value type: " + tag.toString());
        }

        fn fieldTable() -> Map<String, AmqpFieldValue091>
        {
            let tableLen = this.long();
            let endPos = this.pos + tableLen;
            var result: Map<String, AmqpFieldValue091> = Map::new();
            while this.pos < endPos {
                // Bug 89: endPos comes from the broker-controlled tableLen
                // and can exceed what's actually in `bytes`. Once octet()
                // hits the end it no longer advances `pos` (see above), so
                // without this check `this.pos < endPos` would stay true
                // forever — an infinite loop instead of a crash.
                if this.truncated { break; }
                let key = this.shortstr();
                let value = this.fieldValue();
                result.insert(key, value);
            }
            return result;
        }

        fn fieldArray() -> List<AmqpFieldValue091>
        {
            let arrLen = this.long();
            let endPos = this.pos + arrLen;
            var result: List<AmqpFieldValue091> = [];
            while this.pos < endPos {
                if this.truncated { break; }
                result.push(this.fieldValue());
            }
            return result;
        }
    }
}

module tinox.core.amqp091;

import tinox.core.socket;

namespace tinox.core.amqp091
{
    /*
     * An open channel on an AmqpConnection091 (§1.4.2.2). Multiple
     * channels per connection with independent traffic are supported
     * (issue #123): each channel gets its own, sequentially assigned
     * channel ID when opened (AmqpConnection091::allocateChanId()) and
     * its own frame inbox, fed by the connection-wide background
     * dispatcher (amqp091DispatchLoop in AmqpConnection091.tnx) based on
     * the chanId — so every read here (`recv this.inbox`) only reads
     * frames for EXACTLY this channel, never another one's.
     */
    class AmqpChannel091
    {
        var conn: Int64;
        var chanId: Int64;
        var frameMax: Int64;
        var errorMessage: String;
        var confirmsEnabled: Bool;
        var lastDeliveryTag: Int64;
        var inbox: Channel<AmqpFrame091>;

        fn open(connection: AmqpConnection091) -> AmqpChannel091
        {
            if connection.conn <= 0 {
                return AmqpChannel091 { conn: -1, chanId: 0, frameMax: 0, errorMessage: "connection not established: " + connection.errorMessage, confirmsEnabled: false, lastDeliveryTag: 0, inbox: channel };
            }
            let chanId = connection.allocateChanId();
            let inbox: Channel<AmqpFrame091> = channel;
            // MUST happen before writeFrame: otherwise channel.open-ok
            // could arrive before the dispatcher knows where to route it
            // (see AmqpConnection091::registerChannelInbox).
            connection.registerChannelInbox(chanId, inbox);

            let w = AmqpWriter091::new();
            w.shortstr(""); // reserved-1 (out-of-band, deprecated)
            let openPayload = Amqp091::encodeMethodPayload(20, 10, w.bytes);
            Amqp091::writeFrame(connection.conn, 1, chanId, openPayload);

            let f = recv inbox;
            if f.frameType != 1 {
                return AmqpChannel091 { conn: -1, chanId: 0, frameMax: 0, errorMessage: "channel.open failed (frameType=" + f.frameType.toString() + ")", confirmsEnabled: false, lastDeliveryTag: 0, inbox: channel };
            }
            let mf = Amqp091::decodeMethodPayload(f.payload);
            if mf.classId == 20 && mf.methodId == 40 {
                let msg = Amqp091::describeAndAckClose(connection.conn, chanId, mf, 41);
                return AmqpChannel091 { conn: -1, chanId: 0, frameMax: 0, errorMessage: "channel.open failed: " + msg, confirmsEnabled: false, lastDeliveryTag: 0, inbox: channel };
            }
            if mf.classId != 20 || mf.methodId != 11 {
                return AmqpChannel091 { conn: -1, chanId: 0, frameMax: 0, errorMessage: "expected channel.open-ok, got class=" + mf.classId.toString() + " method=" + mf.methodId.toString(), confirmsEnabled: false, lastDeliveryTag: 0, inbox: channel };
            }
            return AmqpChannel091 { conn: connection.conn, chanId: chanId, frameMax: connection.frameMax, errorMessage: "", confirmsEnabled: false, lastDeliveryTag: 0, inbox: inbox };
        }

        /*
         * `queue.declare` + `-ok`. Returns the actual queue name
         * (important for server-generated names when `name` is empty) or
         * "" on error (real queue names are never empty — `errorMessage`
         * then describes the cause).
         */
        fn declareQueue(name: String, durable: Bool, exclusive: Bool, autoDelete: Bool) -> String
        {
            let w = AmqpWriter091::new();
            w.short(0); // reserved-1 (ticket, deprecated)
            w.shortstr(name);
            var flags: Int64 = 0; // bit 0 (passive) always 0 in v1
            if durable {
                flags = flags | 2;
            }
            if exclusive {
                flags = flags | 4;
            }
            if autoDelete {
                flags = flags | 8;
            }
            w.octet(flags); // bit 4 (no-wait) always 0 in v1
            var emptyArgs: Map<String, AmqpFieldValue091> = Map::new();
            w.fieldTable(emptyArgs);
            if w.hasError() {
                this.errorMessage = "queue name too long (max 255 bytes, shortstr): " + name.len().toString() + " bytes";
                return "";
            }
            let payload = Amqp091::encodeMethodPayload(50, 10, w.bytes);
            Amqp091::writeFrame(this.conn, 1, this.chanId, payload);

            let f = recv this.inbox;
            if f.frameType != 1 {
                this.errorMessage = "queue.declare failed (frameType=" + f.frameType.toString() + ")";
                return "";
            }
            let mf = Amqp091::decodeMethodPayload(f.payload);
            if mf.classId == 20 && mf.methodId == 40 {
                this.errorMessage = Amqp091::describeAndAckClose(this.conn, this.chanId, mf, 41);
                return "";
            }
            if mf.classId != 50 || mf.methodId != 11 {
                this.errorMessage = "expected queue.declare-ok, got class=" + mf.classId.toString() + " method=" + mf.methodId.toString();
                return "";
            }
            let r = AmqpReader091::new(mf.args);
            return r.shortstr();
        }

        /*
         * `exchange.declare` + `-ok` (issue #124 — previously only the
         * default exchange or a broker-predefined exchange (`amq.direct`
         * etc.) could be used by name, but the client couldn't declare
         * its own exchange). `exchangeType` typically: "direct",
         * "fanout", "topic", "headers" (checked broker-side, v1 doesn't
         * validate the string). Per spec, `exchange.declare-ok` has no
         * arguments — success = frame received correctly.
         */
        fn declareExchange(name: String, exchangeType: String, durable: Bool, autoDelete: Bool) -> Bool
        {
            let w = AmqpWriter091::new();
            w.short(0); // reserved-1 (ticket, deprecated)
            w.shortstr(name);
            w.shortstr(exchangeType);
            var flags: Int64 = 0; // bit 0 (passive) always 0 in v1
            if durable {
                flags = flags | 2;
            }
            if autoDelete {
                flags = flags | 4;
            }
            w.octet(flags); // bit 3 (internal), bit 4 (no-wait) always 0 in v1
            var emptyArgs: Map<String, AmqpFieldValue091> = Map::new();
            w.fieldTable(emptyArgs);
            if w.hasError() {
                this.errorMessage = "exchange name/type too long (max 255 bytes, shortstr): " + name.len().toString() + " bytes";
                return false;
            }
            let payload = Amqp091::encodeMethodPayload(40, 10, w.bytes);
            Amqp091::writeFrame(this.conn, 1, this.chanId, payload);

            let f = recv this.inbox;
            if f.frameType != 1 {
                this.errorMessage = "exchange.declare failed (frameType=" + f.frameType.toString() + ")";
                return false;
            }
            let mf = Amqp091::decodeMethodPayload(f.payload);
            if mf.classId == 20 && mf.methodId == 40 {
                this.errorMessage = Amqp091::describeAndAckClose(this.conn, this.chanId, mf, 41);
                return false;
            }
            if mf.classId != 40 || mf.methodId != 11 {
                this.errorMessage = "expected exchange.declare-ok, got class=" + mf.classId.toString() + " method=" + mf.methodId.toString();
                return false;
            }
            return true;
        }

        /*
         * `queue.bind` + `-ok`. Binds to any exchange (name `""` =
         * default exchange, routing key = queue name; or an exchange
         * declared via `declareExchange()` or broker-predefined).
         */
        fn bindQueue(queue: String, exchange: String, routingKey: String) -> Bool
        {
            let w = AmqpWriter091::new();
            w.short(0); // reserved-1
            w.shortstr(queue);
            w.shortstr(exchange);
            w.shortstr(routingKey);
            w.octet(0); // no-wait
            var emptyArgs: Map<String, AmqpFieldValue091> = Map::new();
            w.fieldTable(emptyArgs);
            if w.hasError() {
                this.errorMessage = "queue/exchange/routing-key name too long (max 255 bytes, shortstr)";
                return false;
            }
            let payload = Amqp091::encodeMethodPayload(50, 20, w.bytes);
            Amqp091::writeFrame(this.conn, 1, this.chanId, payload);

            let f = recv this.inbox;
            if f.frameType != 1 {
                this.errorMessage = "queue.bind failed (frameType=" + f.frameType.toString() + ")";
                return false;
            }
            let mf = Amqp091::decodeMethodPayload(f.payload);
            if mf.classId == 20 && mf.methodId == 40 {
                this.errorMessage = Amqp091::describeAndAckClose(this.conn, this.chanId, mf, 41);
                return false;
            }
            if mf.classId != 50 || mf.methodId != 21 {
                this.errorMessage = "expected queue.bind-ok, got class=" + mf.classId.toString() + " method=" + mf.methodId.toString();
                return false;
            }
            return true;
        }

        /*
         * `basic.qos` + `-ok`: sets the prefetch limit before
         * `consume()` (a sensible default, otherwise the broker sends an
         * unbounded number of unacked messages at once).
         */
        fn qos(prefetchCount: Int64) -> Bool
        {
            let w = AmqpWriter091::new();
            w.long(0); // prefetch-size: 0 = no byte limit
            w.short(prefetchCount);
            w.octet(0); // global = false (this consumer only)
            let payload = Amqp091::encodeMethodPayload(60, 10, w.bytes);
            Amqp091::writeFrame(this.conn, 1, this.chanId, payload);

            let f = recv this.inbox;
            if f.frameType != 1 {
                this.errorMessage = "basic.qos failed (frameType=" + f.frameType.toString() + ")";
                return false;
            }
            let mf = Amqp091::decodeMethodPayload(f.payload);
            if mf.classId == 20 && mf.methodId == 40 {
                this.errorMessage = Amqp091::describeAndAckClose(this.conn, this.chanId, mf, 41);
                return false;
            }
            if mf.classId != 60 || mf.methodId != 11 {
                this.errorMessage = "expected basic.qos-ok, got class=" + mf.classId.toString() + " method=" + mf.methodId.toString();
                return false;
            }
            return true;
        }

        /*
         * `confirm.select` + `-ok` (issue #125 — a RabbitMQ extension,
         * extension class 85). Enables publisher confirms: from now on,
         * every message sent via `publish()` is assigned a sequential
         * delivery-tag number (1, 2, 3, ...) (`publish()`'s return
         * value), and the broker later answers each message
         * asynchronously with `basic.ack`/`basic.nack` — collected via
         * `waitForConfirm()` (a blocking pull, analogous to
         * `nextMessage()`). Must be called before the first `publish()`,
         * otherwise `publish()`'s return value stays 0.
         */
        fn confirmSelect() -> Bool
        {
            let w = AmqpWriter091::new();
            w.octet(0); // nowait = false
            let payload = Amqp091::encodeMethodPayload(85, 10, w.bytes);
            Amqp091::writeFrame(this.conn, 1, this.chanId, payload);

            let f = recv this.inbox;
            if f.frameType != 1 {
                this.errorMessage = "confirm.select failed (frameType=" + f.frameType.toString() + ")";
                return false;
            }
            let mf = Amqp091::decodeMethodPayload(f.payload);
            if mf.classId == 20 && mf.methodId == 40 {
                this.errorMessage = Amqp091::describeAndAckClose(this.conn, this.chanId, mf, 41);
                return false;
            }
            if mf.classId != 85 || mf.methodId != 11 {
                this.errorMessage = "expected confirm.select-ok, got class=" + mf.classId.toString() + " method=" + mf.methodId.toString();
                return false;
            }
            this.confirmsEnabled = true;
            this.lastDeliveryTag = 0;
            return true;
        }

        /*
         * `basic.publish` (no `-ok`, asynchronous per spec) + content
         * header + body frame(s). v1: exactly two properties supported
         * (content-type optional, delivery-mode fixed at 2/persistent).
         * The body is split at `frameMax` (frame overhead: 7-byte header
         * + 1-byte terminator = 8-byte safety margin).
         *
         * Return value (issue #125): the assigned delivery tag if
         * `confirmSelect()` was called beforehand (sequential starting
         * at 1), otherwise 0 — collect the matching confirm via
         * `waitForConfirm()`.
         */
        fn publish(exchange: String, routingKey: String, body: List<Int64>, contentType: String) -> Int64
        {
            let w = AmqpWriter091::new();
            w.short(0); // reserved-1
            w.shortstr(exchange);
            w.shortstr(routingKey);
            w.octet(0); // mandatory=false, immediate=false
            if w.hasError() {
                this.errorMessage = "exchange/routing-key name too long (max 255 bytes, shortstr) -- basic.publish NOT sent";
                return 0;
            }

            var flags: Int64 = 0;
            let pw = AmqpWriter091::new();
            if contentType.len() > 0 {
                flags = flags | 32768; // bit 15: content-type
                pw.shortstr(contentType);
            }
            flags = flags | 4096; // bit 12: delivery-mode
            pw.octet(2); // persistent
            if pw.hasError() {
                this.errorMessage = "content-type too long (max 255 bytes, shortstr) -- basic.publish NOT sent";
                return 0;
            }

            var assignedTag: Int64 = 0;
            if this.confirmsEnabled {
                this.lastDeliveryTag = this.lastDeliveryTag + 1;
                assignedTag = this.lastDeliveryTag;
            }

            let payload = Amqp091::encodeMethodPayload(60, 40, w.bytes);
            Amqp091::writeFrame(this.conn, 1, this.chanId, payload);

            let hw = AmqpWriter091::new();
            hw.short(60); // class-id
            hw.short(0);  // weight (unused)
            hw.longlong(body.len());
            hw.short(flags);
            hw.rawBytes(pw.bytes);
            Amqp091::writeFrame(this.conn, 2, this.chanId, hw.bytes);

            var frameOverhead: Int64 = 8;
            var chunkSize: Int64 = this.frameMax - frameOverhead;
            if chunkSize <= 0 {
                chunkSize = 4096;
            }
            var offset: Int64 = 0;
            let n = body.len();
            while offset < n {
                var end: Int64 = offset + chunkSize;
                if end > n {
                    end = n;
                }
                var chunk: List<Int64> = [];
                for i in offset..end {
                    chunk.push(body[i]);
                }
                Amqp091::writeFrame(this.conn, 3, this.chanId, chunk);
                offset = end;
            }
            return assignedTag;
        }

        /*
         * `basic.consume` + `-ok`: registers the client as a consumer.
         * Returns the (possibly server-generated) consumer tag, or "" on
         * error. After that, the broker pushes messages asynchronously —
         * collect them via `nextMessage()` (a blocking pull, no lambda
         * handler in v1).
         */
        fn consume(queue: String) -> String
        {
            let w = AmqpWriter091::new();
            w.short(0); // reserved-1
            w.shortstr(queue);
            w.shortstr(""); // consumer-tag: server-generated
            w.octet(0); // no-local=false, no-ack=false, exclusive=false, no-wait=false
            var emptyArgs: Map<String, AmqpFieldValue091> = Map::new();
            w.fieldTable(emptyArgs);
            if w.hasError() {
                this.errorMessage = "queue name too long (max 255 bytes, shortstr): " + queue.len().toString() + " bytes";
                return "";
            }
            let payload = Amqp091::encodeMethodPayload(60, 20, w.bytes);
            Amqp091::writeFrame(this.conn, 1, this.chanId, payload);

            let f = recv this.inbox;
            if f.frameType != 1 {
                this.errorMessage = "basic.consume failed (frameType=" + f.frameType.toString() + ")";
                return "";
            }
            let mf = Amqp091::decodeMethodPayload(f.payload);
            if mf.classId == 20 && mf.methodId == 40 {
                this.errorMessage = Amqp091::describeAndAckClose(this.conn, this.chanId, mf, 41);
                return "";
            }
            if mf.classId != 60 || mf.methodId != 21 {
                this.errorMessage = "expected basic.consume-ok, got class=" + mf.classId.toString() + " method=" + mf.methodId.toString();
                return "";
            }
            let r = AmqpReader091::new(mf.args);
            return r.shortstr();
        }

        /*
         * Blocking pull: reads exactly ONE complete message
         * (`basic.deliver` method + content header + body frame(s),
         * until `body-size` bytes have been read — analogous to
         * `Ws::readMessage`). `AmqpMessage091.ok == false` on any error
         * (caller MUST check), `errorMessage` describes the cause.
         *
         * v1 only decodes `content-type` from the content header and
         * correctly skips all other 13 basic properties based on their
         * bit (otherwise the byte cursor would run off track for a
         * message with, say, `headers` or `correlation-id`).
         */
        fn nextMessage() -> AmqpMessage091
        {
            let f1 = recv this.inbox;
            if f1.frameType != 1 {
                return AmqpMessage091 { deliveryTag: -1, exchange: "", routingKey: "", contentType: "", body: [], ok: false, errorMessage: "expected basic.deliver (frameType=" + f1.frameType.toString() + ")" };
            }
            let mf = Amqp091::decodeMethodPayload(f1.payload);
            if mf.classId == 20 && mf.methodId == 40 {
                let msg = Amqp091::describeAndAckClose(this.conn, this.chanId, mf, 41);
                return AmqpMessage091 { deliveryTag: -1, exchange: "", routingKey: "", contentType: "", body: [], ok: false, errorMessage: msg };
            }
            if mf.classId != 60 || mf.methodId != 60 {
                return AmqpMessage091 { deliveryTag: -1, exchange: "", routingKey: "", contentType: "", body: [], ok: false, errorMessage: "expected basic.deliver, got class=" + mf.classId.toString() + " method=" + mf.methodId.toString() };
            }
            let r = AmqpReader091::new(mf.args);
            r.shortstr(); // consumer-tag (unused in v1)
            let deliveryTag = r.longlong();
            r.octet(); // redelivered (its own bit byte)
            let exchange = r.shortstr();
            let routingKey = r.shortstr();

            let f2 = recv this.inbox;
            if f2.frameType != 2 {
                return AmqpMessage091 { deliveryTag: -1, exchange: "", routingKey: "", contentType: "", body: [], ok: false, errorMessage: "expected content-header frame (frameType=" + f2.frameType.toString() + ")" };
            }
            let hr = AmqpReader091::new(f2.payload);
            hr.short(); // class-id (60, not checked)
            hr.short(); // weight (unused)
            let bodySize = hr.longlong();
            let flags = hr.short();
            var contentType: String = "";
            if (flags & 32768) != 0 {
                contentType = hr.shortstr();
            }
            if (flags & 16384) != 0 { hr.longstr(); }      // content-encoding
            if (flags & 8192) != 0 { hr.fieldTable(); }    // headers
            if (flags & 4096) != 0 { hr.octet(); }         // delivery-mode
            if (flags & 2048) != 0 { hr.octet(); }         // priority
            if (flags & 1024) != 0 { hr.shortstr(); }      // correlation-id
            if (flags & 512) != 0 { hr.shortstr(); }       // reply-to
            if (flags & 256) != 0 { hr.shortstr(); }       // expiration
            if (flags & 128) != 0 { hr.shortstr(); }       // message-id
            if (flags & 64) != 0 { hr.longlong(); }        // timestamp
            if (flags & 32) != 0 { hr.shortstr(); }        // type
            if (flags & 16) != 0 { hr.shortstr(); }        // user-id
            if (flags & 8) != 0 { hr.shortstr(); }         // app-id
            if (flags & 4) != 0 { hr.shortstr(); }         // cluster-id

            var body: List<Int64> = [];
            while body.len() < bodySize {
                let f3 = recv this.inbox;
                if f3.frameType != 3 {
                    return AmqpMessage091 { deliveryTag: -1, exchange: "", routingKey: "", contentType: "", body: [], ok: false, errorMessage: "expected body frame (frameType=" + f3.frameType.toString() + ")" };
                }
                for i in 0..f3.payload.len() {
                    body.push(f3.payload[i]);
                }
            }

            return AmqpMessage091 { deliveryTag: deliveryTag, exchange: exchange, routingKey: routingKey, contentType: contentType, body: body, ok: true, errorMessage: "" };
        }

        /* `basic.ack` (no `-ok`, asynchronous per spec). */
        fn ack(deliveryTag: Int64) -> Nothing
        {
            let w = AmqpWriter091::new();
            w.longlong(deliveryTag);
            w.octet(0); // multiple = false
            let payload = Amqp091::encodeMethodPayload(60, 80, w.bytes);
            Amqp091::writeFrame(this.conn, 1, this.chanId, payload);
        }

        /*
         * Blocking pull: reads ONE publisher confirm (`basic.ack` or
         * `basic.nack`, the latter a RabbitMQ extension — same wire
         * structure as `basic.ack`, just class+method 60/120 instead of
         * 60/80, plus an extra requeue bit that v1 ignores) — analogous
         * to `nextMessage()` for consumers. Assumes `confirmSelect()`
         * was called. Frames from a DIFFERENT channel never end up here
         * (issue #123: its own inbox per channel, see the class comment
         * above) — but consuming AND waiting for confirms on the SAME
         * channel at the same time remains unsafe: `basic.deliver`
         * frames would be wrongly interpreted as a confirm here, because
         * dispatch within a channel still isn't done by method type
         * (deliver vs. ack/nack), only by chanId.
         */
        fn waitForConfirm() -> AmqpConfirmResult091
        {
            let f = recv this.inbox;
            if f.frameType != 1 {
                return AmqpConfirmResult091 { deliveryTag: -1, multiple: false, ack: false, ok: false, errorMessage: "expected basic.ack/basic.nack (frameType=" + f.frameType.toString() + ")" };
            }
            let mf = Amqp091::decodeMethodPayload(f.payload);
            if mf.classId == 20 && mf.methodId == 40 {
                let msg = Amqp091::describeAndAckClose(this.conn, this.chanId, mf, 41);
                return AmqpConfirmResult091 { deliveryTag: -1, multiple: false, ack: false, ok: false, errorMessage: msg };
            }
            if mf.classId != 60 || (mf.methodId != 80 && mf.methodId != 120) {
                return AmqpConfirmResult091 { deliveryTag: -1, multiple: false, ack: false, ok: false, errorMessage: "expected basic.ack/basic.nack, got class=" + mf.classId.toString() + " method=" + mf.methodId.toString() };
            }
            let r = AmqpReader091::new(mf.args);
            let deliveryTag = r.longlong();
            let bits = r.octet();
            let multiple = (bits & 1) != 0;
            let ack = mf.methodId == 80;
            return AmqpConfirmResult091 { deliveryTag: deliveryTag, multiple: multiple, ack: ack, ok: true, errorMessage: "" };
        }
    }
}

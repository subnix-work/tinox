module tinox.core.amqp091;

import tinox.core.socket;

namespace tinox.core.amqp091
{
    /*
     * Generic wrapper for a METHOD frame payload (§4.2.4): class-id +
     * method-id + argument bytes. The concrete argument order per
     * method (e.g. connection.start-ok) is built/read via a fresh
     * AmqpWriter091/AmqpReader091 over `args`.
     */
    class AmqpMethodFrame091
    {
        var classId: Int64;
        var methodId: Int64;
        var args: List<Int64>;
    }
}

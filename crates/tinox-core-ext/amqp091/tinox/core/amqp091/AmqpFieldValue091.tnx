module tinox.core.amqp091;

import tinox.core.socket;

namespace tinox.core.amqp091
{
    /*
     * A tagged AMQP field value (field-table/field-array elements).
     * Type markers follow the RabbitMQ convention (t/I/L/S/T/F/A/V) —
     * see AmqpWriter091::fieldValue/AmqpReader091::fieldValue for the
     * bytes. ErrorVal carries a decode error (unknown type marker) as a
     * value instead of an exception — caller MUST check (no silent
     * garbage), analogous to WsFrame.opcode -1/-2 for WebSocket.
     */
    enum AmqpFieldValue091
    {
        BoolVal(Bool);
        Int32Val(Int64);
        Int64Val(Int64);
        StrVal(String);
        TimestampVal(Int64);
        TableVal(Map<String, AmqpFieldValue091>);
        ArrayVal(List<AmqpFieldValue091>);
        VoidVal;
        ErrorVal(String);
    }
}

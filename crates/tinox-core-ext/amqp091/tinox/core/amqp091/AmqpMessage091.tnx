module tinox.core.amqp091

import tinox.core.socket
import tinox.core.bytes

namespace tinox.core.amqp091
{
    /*
     * A message received via `nextMessage()`. `ok == false` on any
     * error (caller MUST check, no silent garbage) — `errorMessage`
     * then describes the cause.
     */
    class AmqpMessage091
    {
        // Explicit copying adapter: no aliasing with the mutable legacy body.
        fn bodyBytes() -> Bytes { return Bytes::fromList(this.body) }
        fn setBodyBytes(bytes: Bytes) -> Nothing { this.body = bytes.toList() }

        var deliveryTag: Int64
        var exchange: String
        var routingKey: String
        var contentType: String
        var body: List<Int64>
        var ok: Bool
        var errorMessage: String
        /** True if the broker marks this delivery as redelivered (an earlier delivery was not acknowledged) */
        var redelivered: Bool
        /** The message-id property, "" if the publisher set none; the natural idempotency key */
        var messageId: String
    }
}

module tinox.core.http;

namespace tinox.core.http
{
    // Renamed from HttpResponse (issue #139) -- see Http.tnx's comment for
    // why: this bare name collided with tinox.core.http_server's own
    // HttpResponse class in the compiler's codegen layout table.
    class HttpClientResponse
    {
        fn statusCode() -> Int64
        {
            return httpStatusCode(this);
        }

        fn body() -> String
        {
            return httpBody(this);
        }

        fn header(name: String) -> String
        {
            return httpHeader(this, name);
        }
    }
}

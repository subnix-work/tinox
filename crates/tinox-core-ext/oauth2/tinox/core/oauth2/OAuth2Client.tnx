module tinox.core.oauth2;

import tinox.core.http;
import tinox.core.uri;
import tinox.core.crypto;
import tinox.core.base64;
import tinox.core.hex;
import tinox.core.json;

namespace tinox.core.oauth2
{
    /*
     * OAuth2 client for the Authorization Code grant with PKCE (RFC 6749
     * + RFC 7636, issue #131) — the recommended standard flow for both
     * server and public clients. `authorizeUrl`/`tokenUrl` are the two
     * provider endpoints (e.g. Google:
     * "https://accounts.google.com/o/oauth2/v2/auth" /
     * "https://oauth2.googleapis.com/token"), `redirectUri` this
     * application's callback URL registered with the provider.
     *
     * Flow:
     *   1. buildAuthorizeUrl(scope) -> caller redirects the user agent to
     *      .url, stores .state + .codeVerifier session-side (see
     *      OAuth2AuthorizeRequest).
     *   2. Callback handler: check .state against the stored value
     *      (CSRF), then call exchangeCode(code, codeVerifier) with the
     *      stored codeVerifier.
     *   3. Later, as needed, refresh(refreshToken).
     *
     * Deliberate v1 gaps (see issue #131 for the full rationale):
     *   - No OIDC ID-token verification (would need RS256/JWKS in Jwt,
     *     AND Jwt itself still has its own wire-format issue, see issue
     *     #137 — both their own, larger follow-up work).
     *   - Only authorization code + PKCE, no client_credentials/
     *     implicit/device_code.
     *   - No token storage/session integration — the caller's concern,
     *     same as with the rest of the rest/http_server framework.
     */
    class OAuth2Client
    {
        var authorizeUrl: String;
        var tokenUrl: String;
        var clientId: String;
        var clientSecret: String;
        var redirectUri: String;

        fn new(authorizeUrl: String, tokenUrl: String, clientId: String, clientSecret: String, redirectUri: String) -> OAuth2Client
        {
            return OAuth2Client { authorizeUrl: authorizeUrl, tokenUrl: tokenUrl, clientId: clientId, clientSecret: clientSecret, redirectUri: redirectUri };
        }

        /*
         * Builds the authorization URL + generates `state` (CSRF) and
         * the PKCE `code_verifier` (RFC 7636 §4.1: 32 cryptographically
         * secure random bytes, base64url-encoded -> 43 characters,
         * satisfies the required 43-128 characters from the allowed
         * alphabet). `code_challenge` is SHA-256 of the verifier, also
         * base64url — the S256 method (RFC 7636 §4.2), not the insecure
         * "plain".
         */
        fn buildAuthorizeUrl(scope: String) -> OAuth2AuthorizeRequest
        {
            let stateBytes: List<Int64> = Crypto::secureRandomBytes(32);
            let state: String = Base64::encodeUrlBytes(stateBytes);

            let verifierBytes: List<Int64> = Crypto::secureRandomBytes(32);
            let codeVerifier: String = Base64::encodeUrlBytes(verifierBytes);

            // Crypto::sha256 returns hex text (no raw-bytes primitive in
            // Crypto, see issue #137); Hex::decodeBytes safely recovers
            // the raw 32 digest bytes (no string-based detour via
            // fromCharCode, which would have silently truncated on an
            // embedded 0 byte in the digest).
            let challengeHex: String = Crypto::sha256(codeVerifier);
            let challengeBytes: List<Int64> = Hex::decodeBytes(challengeHex);
            let codeChallenge: String = Base64::encodeUrlBytes(challengeBytes);

            var url: String = this.authorizeUrl;
            if url.contains("?")
            {
                url = url + "&";
            }
            else
            {
                url = url + "?";
            }
            url = url + "response_type=code";
            url = url + "&client_id=" + Uri::encodeComponent(this.clientId);
            url = url + "&redirect_uri=" + Uri::encodeComponent(this.redirectUri);
            url = url + "&scope=" + Uri::encodeComponent(scope);
            url = url + "&state=" + Uri::encodeComponent(state);
            url = url + "&code_challenge=" + Uri::encodeComponent(codeChallenge);
            url = url + "&code_challenge_method=S256";

            return OAuth2AuthorizeRequest { url: url, state: state, codeVerifier: codeVerifier };
        }

        /*
         * Exchanges the authorization code for an access/refresh token
         * (RFC 6749 §4.1.3). `codeVerifier` MUST be the value returned
         * by buildAuthorizeUrl() and stored by the caller — the server
         * checks it against the `code_challenge` it saw in the
         * authorize request (the core PKCE mechanism: only whoever knows
         * the original verifier can redeem the code).
         */
        fn exchangeCode(code: String, codeVerifier: String) -> OAuth2TokenResponse
        {
            var body: String = "grant_type=authorization_code";
            body = body + "&code=" + Uri::encodeComponent(code);
            body = body + "&redirect_uri=" + Uri::encodeComponent(this.redirectUri);
            body = body + "&client_id=" + Uri::encodeComponent(this.clientId);
            body = body + "&client_secret=" + Uri::encodeComponent(this.clientSecret);
            body = body + "&code_verifier=" + Uri::encodeComponent(codeVerifier);
            return OAuth2Client::postToken(this.tokenUrl, body);
        }

        /* Exchanges a refresh token for a fresh token pair (RFC 6749 §6). */
        fn refresh(refreshToken: String) -> OAuth2TokenResponse
        {
            var body: String = "grant_type=refresh_token";
            body = body + "&refresh_token=" + Uri::encodeComponent(refreshToken);
            body = body + "&client_id=" + Uri::encodeComponent(this.clientId);
            body = body + "&client_secret=" + Uri::encodeComponent(this.clientSecret);
            return OAuth2Client::postToken(this.tokenUrl, body);
        }

        /*
         * Shared POST core for exchangeCode()/refresh(): sends
         * `application/x-www-form-urlencoded` (RFC 6749 §4.1.3 requires
         * exactly that, not JSON) and parses the JSON response.
         * `ok == false` on any error — network/TLS errors (Http then
         * returns statusCode()==0, see issue #131's TLS work on
         * Http.tnx), an HTTP error status, an RFC-6749-§5.2 error
         * response (`error`/`error_description`), or a 2xx response with
         * no `access_token` field are all reported as hard errors
         * instead of silently passing through an empty/wrong token.
         */
        fn postToken(url: String, body: String) -> OAuth2TokenResponse
        {
            Http::clearHeaders();
            Http::setHeader("Content-Type", "application/x-www-form-urlencoded");
            Http::setHeader("Accept", "application/json");
            let resp = Http::post(url, body);
            Http::clearHeaders();

            if resp.statusCode() == 0
            {
                return OAuth2TokenResponse { accessToken: "", refreshToken: "", tokenType: "", expiresIn: 0, idToken: "", ok: false, errorMessage: "network error contacting token endpoint (connection failed or TLS/certificate error)" };
            }

            let fields: Map<String, JsonValue> = Json::parse(resp.body()).asTable();

            if fields.contains("error")
            {
                var msg: String = fields["error"].getString();
                if fields.contains("error_description")
                {
                    msg = msg + ": " + fields["error_description"].getString();
                }
                return OAuth2TokenResponse { accessToken: "", refreshToken: "", tokenType: "", expiresIn: 0, idToken: "", ok: false, errorMessage: msg };
            }

            if resp.statusCode() < 200 || resp.statusCode() >= 300
            {
                return OAuth2TokenResponse { accessToken: "", refreshToken: "", tokenType: "", expiresIn: 0, idToken: "", ok: false, errorMessage: "token endpoint returned HTTP " + resp.statusCode().toString() };
            }

            if !fields.contains("access_token")
            {
                return OAuth2TokenResponse { accessToken: "", refreshToken: "", tokenType: "", expiresIn: 0, idToken: "", ok: false, errorMessage: "token endpoint response has no access_token field" };
            }

            var refreshTok: String = "";
            if fields.contains("refresh_token")
            {
                refreshTok = fields["refresh_token"].getString();
            }
            var tokType: String = "Bearer";
            if fields.contains("token_type")
            {
                tokType = fields["token_type"].getString();
            }
            var expIn: Int64 = 0;
            if fields.contains("expires_in")
            {
                expIn = fields["expires_in"].asInt();
            }
            var idTok: String = "";
            if fields.contains("id_token")
            {
                idTok = fields["id_token"].getString();
            }

            return OAuth2TokenResponse { accessToken: fields["access_token"].getString(), refreshToken: refreshTok, tokenType: tokType, expiresIn: expIn, idToken: idTok, ok: true, errorMessage: "" };
        }
    }
}

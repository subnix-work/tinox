module tinox.core.oauth2;

namespace tinox.core.oauth2
{
    /*
     * Return value of OAuth2Client::buildAuthorizeUrl() (issue #131).
     * `state` and `codeVerifier` MUST be stored by the caller on the
     * session/request side (e.g. in the user session or a signed
     * cookie) — after the redirect to the authorization server and
     * back, the caller MUST:
     *   1. compare the callback's `state` query parameter against the
     *      `state` stored here (CSRF protection — OAuth2Client itself
     *      can't do this, because it deliberately holds no state of its
     *      own between the two calls, so as not to mandate any
     *      particular server-session semantics);
     *   2. pass the stored `codeVerifier` back to exchangeCode().
     */
    class OAuth2AuthorizeRequest
    {
        var url: String;
        var state: String;
        var codeVerifier: String;
    }
}

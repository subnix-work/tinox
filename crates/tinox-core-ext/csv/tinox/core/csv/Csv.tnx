module tinox.core.csv;

namespace tinox.core.csv
{
    class Csv
    {
        fn parse(content: String) -> List<List<String>>
        {
            let lines: List<String> = content.split("\n");
            var result: List<List<String>> = [];
            var i: Int64 = 0;
            while i < lines.len()
            {
                let line: String = lines[i];
                if line.len() > 0
                {
                    result.push(Csv::parseRow(line));
                }
                i = i + 1;
            }
            return result;
        }

        fn parseRow(line: String) -> List<String>
        {
            var result: List<String> = [];
            var current: String = "";
            var inQuotes: Bool = false;
            var i: Int64 = 0;
            while i < line.len()
            {
                let c: String = line.substring(i, i + 1);
                if c == "\""
                {
                    inQuotes = !inQuotes;
                }
                else if c == "," && inQuotes == false
                {
                    result.push(current);
                    current = "";
                }
                else
                {
                    current = current + c;
                }
                i = i + 1;
            }
            result.push(current);
            return result;
        }

        fn toString(data: List<List<String>>) -> String
        {
            var result: String = "";
            var i: Int64 = 0;
            while i < data.len()
            {
                result = result + Csv::rowToString(data[i]) + "\n";
                i = i + 1;
            }
            return result;
        }

        fn rowToString(row: List<String>) -> String
        {
            var result: String = "";
            var i: Int64 = 0;
            while i < row.len()
            {
                if i > 0
                {
                    result = result + ",";
                }
                if row[i].contains(",") || row[i].contains("\"")
                {
                    result = result + "\"" + row[i].replace("\"", "\"\"") + "\"";
                }
                else
                {
                    result = result + row[i];
                }
                i = i + 1;
            }
            return result;
        }
    }
}

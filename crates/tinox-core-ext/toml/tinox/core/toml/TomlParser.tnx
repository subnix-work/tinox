module tinox.core.toml;

import tinox.core.string;

namespace tinox.core.toml
{
    class TomlParser
    {
        fn parse(content: String) -> TomlValue
        {
            const root: Map<String, TomlValue> = Map::new();
            var currentSection: String = "";
            const lines: List<String> = content.split("\n");
            var i: Int64 = 0;
            while i < lines.len()
            {
                const line: String = Strings::trim(lines[i]);
                if (line.len() == 0 || line.startsWith("#"))
                {
                    i = i + 1;
                    continue;
                }
                if (line.startsWith("["))
                {
                    const endSection: Int64 = line.indexOf("]");
                    if (endSection != -1)
                    {
                        currentSection = line.substring(1, endSection);
                        root[currentSection] = TomlValue { kind: "table", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: false, tableValue: Map::new(), arrayValue: [] };
                    }
                }
                else
                {
                    const eqPos: Int64 = line.indexOf("=");
                    if (eqPos != -1)
                    {
                        const key: String = Strings::trim(line.substring(0, eqPos));
                        const value: String = Strings::trim(line.substring(eqPos + 1, line.len()));
                        const tomv: TomlValue = TomlParser::parseValue(value);
                        root[key] = tomv;
                    }
                }
                i = i + 1;
            }
            return TomlValue { kind: "table", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: false, tableValue: root, arrayValue: [] };
        }

        fn parseValue(value: String) -> TomlValue
        {
            if (value.startsWith("\""))
            {
                return TomlValue { kind: "string", stringValue: value.replace("\"", ""), intValue: 0, floatValue: 0.0, boolValue: false, tableValue: Map::new(), arrayValue: [] };
            }
            if (value == "true")
            {
                return TomlValue { kind: "bool", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: true, tableValue: Map::new(), arrayValue: [] };
            }
            if (value == "false")
            {
                return TomlValue { kind: "bool", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: false, tableValue: Map::new(), arrayValue: [] };
            }
            if (value.indexOf(".") != -1)
            {
                return TomlValue { kind: "float", stringValue: "", intValue: 0, floatValue: (Float64)value, boolValue: false, tableValue: Map::new(), arrayValue: [] };
            }
            return TomlValue { kind: "int", stringValue: "", intValue: (Int64)value, floatValue: 0.0, boolValue: false, tableValue: Map::new(), arrayValue: [] };
        }
    }
}

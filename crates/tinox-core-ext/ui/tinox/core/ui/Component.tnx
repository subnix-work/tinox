module tinox.core.ui;

import tinox.core.json;

namespace tinox.core.ui
{
    // A node in a Tinox-UI component tree. Deliberately ONE concrete class
    // (not a typed subclass per widget kind) -- `type` + `props` carry the
    // widget-specific shape, dispatched client-side by a small lookup
    // table (see the bundled ui.js). This avoids an open question this
    // module doesn't need to answer yet: whether a `Component` subclass
    // round-trips correctly through the generic @JsonSerializable base-
    // class field type (untested; revisit only once the widget set has
    // grown enough that stringly-typed `props` genuinely hurts).
    //
    // `onEvent` is deliberately NOT part of what gets sent to the client
    // (@DoNotSerialize) -- the client only ever needs to know THAT an
    // interaction happened and report it back, never what runs on the
    // server for it. Every factory sets `onEvent` (even non-interactive
    // ones, to an inert handler) so `TinoxUIRuntime.finalize` never has to
    // special-case "does this component even have a handler" -- it just
    // always registers one, which is harmless since the client only ever
    // emits an event for elements it actually renders as interactive.
    @JsonSerializable
    class Component
    {
        var id: String;
        var type: String;
        var text: String;
        var props: Map<String, String>;
        var children: List<Component>;
        var visible: Bool;

        @DoNotSerialize
        var onEvent: fnc(String) -> Nothing;

        fnc inert(value: String) -> Nothing
        {
        }

        // Inert placeholder used by TinoxUIPatchOp's `node` field when an
        // op kind (update/remove) doesn't actually carry a subtree --
        // never rendered, just a well-formed value to satisfy the field.
        fnc none() -> Component
        {
            return Component { id: "", type: "", text: "", props: Map::new(), children: [], visible: false, onEvent: fn(v: String) { } };
        }

        fnc label(text: String) -> Component
        {
            return Component { id: "", type: "Label", text: text, props: Map::new(), children: [], visible: true, onEvent: fn(v: String) { } };
        }

        // onClick is invoked with an always-empty value ("") -- Button
        // has nothing meaningful to report beyond "it was clicked".
        fnc button(text: String, onClick: fnc(String) -> Nothing) -> Component
        {
            return Component { id: "", type: "Button", text: text, props: Map::new(), children: [], visible: true, onEvent: onClick };
        }

        fnc textField(value: String, onChange: fnc(String) -> Nothing) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("value", value);
            return Component { id: "", type: "TextField", text: "", props: props, children: [], visible: true, onEvent: onChange };
        }

        fnc checkbox(checked: Bool, onChange: fnc(String) -> Nothing) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("checked", checked ? "true" : "false");
            return Component { id: "", type: "Checkbox", text: "", props: props, children: [], visible: true, onEvent: onChange };
        }

        fnc textArea(value: String, onChange: fnc(String) -> Nothing) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("value", value);
            return Component { id: "", type: "TextArea", text: "", props: props, children: [], visible: true, onEvent: onChange };
        }

        // "Typed widget" (Phase 5): wraps a plain TextField-shaped element
        // with server-side Float64<->String conversion, so the app deals
        // in real numbers instead of always parsing/formatting Strings
        // itself. A malformed client-side value (shouldn't normally
        // happen -- the client only ever sends what a <input type=number>
        // itself accepted) falls back to 0.0 rather than throwing, since
        // there's no user-visible error channel for a single field's
        // onChange to report through yet -- same tradeoff textField's own
        // caller already has for any value it chooses not to validate.
        fnc numberField(value: Float64, onChange: fnc(Float64) -> Nothing) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("value", value.toString());
            let wrapped: fnc(String) -> Nothing = fn(v: String) { onChange(v.toFloat()); };
            return Component { id: "", type: "NumberField", text: "", props: props, children: [], visible: true, onEvent: wrapped };
        }

        // Same wrapping idea as numberField, for Int64 fields (e.g. a
        // quantity stepper) -- kept as a separate factory rather than one
        // parameterized over a type, since Tinox has no generic top-level
        // function type parameter that could stand for "Int64 or Float64"
        // here.
        fnc intField(value: Int64, onChange: fnc(Int64) -> Nothing) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("value", value.toString());
            let wrapped: fnc(String) -> Nothing = fn(v: String) { onChange(v.toInt()); };
            return Component { id: "", type: "IntField", text: "", props: props, children: [], visible: true, onEvent: wrapped };
        }

        // level: 1-6, matching h1..h6 -- clamped client-side to that range
        // (see ui.js's own build()) rather than trusting the caller.
        fnc heading(text: String, level: Int64) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("level", level.toString());
            return Component { id: "", type: "Heading", text: text, props: props, children: [], visible: true, onEvent: fn(v: String) { } };
        }

        fnc image(src: String, alt: String) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("src", src);
            props.insert("alt", alt);
            return Component { id: "", type: "Image", text: "", props: props, children: [], visible: true, onEvent: fn(v: String) { } };
        }

        // A flex-grow spacer div -- the only widget with no text/props of
        // its own, useful inside an hbox/vbox to push siblings apart.
        fnc spacer() -> Component
        {
            return Component { id: "", type: "Spacer", text: "", props: Map::new(), children: [], visible: true, onEvent: fn(v: String) { } };
        }

        // value: 0.0-100.0 (a percentage, not a 0.0-1.0 fraction) --
        // matches the native <progress> element's own `value`/`max=100`
        // convention ui.js renders this as, so no extra scaling step is
        // needed on either side.
        fnc progressBar(value: Float64) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("value", value.toString());
            return Component { id: "", type: "ProgressBar", text: "", props: props, children: [], visible: true, onEvent: fn(v: String) { } };
        }

        // options/selected as plain Strings, not a List<String> field on
        // Component itself (props stays Map<String,String>, the one
        // shape every widget already shares -- adding a second,
        // list-typed field just for this one widget isn't worth the
        // extra @JsonSerializable surface). Joined with "|" -- a
        // documented v1 limitation: an option value containing "|"
        // itself would be misparsed client-side. Fine for the common
        // case (labels/enum-like choices); revisit only if a real app
        // actually needs "|" in an option label.
        // Named `dropdown`, not `select` -- `select` is a reserved Tinox
        // keyword (the channel select statement), not available as a
        // method name.
        fnc dropdown(options: List<String>, selected: String, onChange: fnc(String) -> Nothing) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("options", options.join("|"));
            props.insert("selected", selected);
            return Component { id: "", type: "Select", text: "", props: props, children: [], visible: true, onEvent: onChange };
        }

        // Client-side (pushState-based) navigation link -- the routing
        // primitive for multi-view apps (Phase 5): clicking it updates the
        // browser's URL bar without a real page reload, then reports the
        // target `path` back to the server through the SAME onEvent/
        // dispatchEvent pipeline every other interactive widget already
        // uses (onNavigate receives `path` as its String value, exactly
        // like textField's onChange receives the field's new value) --
        // apps store it in an instance field and switch on it inside
        // their own @View/build() method (see
        // examples/tinox_ui_routed_demo for the full pattern). No new
        // compiler/annotation surface needed for this -- deliberately
        // reuses the existing event mechanism rather than adding a
        // parallel one.
        //
        // Deep-linking to a non-root path (e.g. sharing a "/pods" URL) is
        // handled by the separate @Route annotation, not by link() itself:
        // an app using @Route declares `var currentRoute: String;` and
        // annotates its per-path builder methods, and the compiler seeds
        // that field from the browser's real initial path at WS-connect
        // time (see annotations.rs's "Route" registry entry) -- link()'s
        // own onNavigate handler just needs to keep assigning the SAME
        // field on every click, same as it always did. An app that never
        // adopts @Route keeps exactly the pre-@Route behavior: a fresh
        // load always starts at whatever @View/build() renders for a
        // brand-new instance, regardless of the address bar.
        fnc link(text: String, path: String, onNavigate: fnc(String) -> Nothing) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("href", path);
            return Component { id: "", type: "Link", text: text, props: props, children: [], visible: true, onEvent: onNavigate };
        }

        // value: "YYYY-MM-DD" (native <input type="date"> format) -- no
        // separate Date/DateTime type in Tinox's stdlib to bind to instead.
        fnc datePicker(value: String, onChange: fnc(String) -> Nothing) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("value", value);
            return Component { id: "", type: "DatePicker", text: "", props: props, children: [], visible: true, onEvent: onChange };
        }

        // Same "|"-joined options convention as dropdown (see its own doc
        // comment for the v1 limitation this implies).
        fnc radioGroup(options: List<String>, selected: String, onChange: fnc(String) -> Nothing) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("options", options.join("|"));
            props.insert("selected", selected);
            return Component { id: "", type: "RadioGroup", text: "", props: props, children: [], visible: true, onEvent: onChange };
        }

        // v1 reports only the selected FILE NAME, not its binary content --
        // uploading real file content would need a new wire-protocol path
        // (base64 chunking or a separate HTTP upload endpoint), out of
        // scope for this widget addition. Enough for e.g. showing what was
        // picked, or driving a filename-based workflow; real content
        // upload is a documented, real follow-up, not silently unsupported.
        fnc fileUpload(onChange: fnc(String) -> Nothing) -> Component
        {
            return Component { id: "", type: "FileUpload", text: "", props: Map::new(), children: [], visible: true, onEvent: onChange };
        }

        // Renders a clickable header strip (one entry per label) plus
        // whatever `content` the caller passes for the CURRENTLY active
        // tab -- Tabs itself holds no per-tab content or active-index
        // state; the app tracks that itself (a plain instance field) and
        // picks `content`/`activeIndex` accordingly inside its own @View,
        // the exact same pattern Component::link's routing already
        // established (see its own doc comment) rather than a second,
        // inconsistent state-management mechanism just for tabs.
        // onTabChange receives the clicked tab's index as a String
        // (`.toInt()` it in the handler).
        fnc tabs(labels: List<String>, activeIndex: Int64, content: Component, onTabChange: fnc(String) -> Nothing) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("labels", labels.join("|"));
            props.insert("active", activeIndex.toString());
            return Component { id: "", type: "Tabs", text: "", props: props, children: [content], visible: true, onEvent: onTabChange };
        }

        // A modal overlay; `open` is a plain Bool the app controls (e.g.
        // toggled from a button's onClick) -- same explicit-state
        // convention as everything else in this module, no separate
        // show()/hide() imperative API. onClose fires when the backdrop or
        // the dialog's own close button is clicked (value is always "").
        fnc dialog(title: String, content: Component, open: Bool, onClose: fnc(String) -> Nothing) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("title", title);
            props.insert("open", open ? "true" : "false");
            return Component { id: "", type: "Dialog", text: "", props: props, children: [content], visible: true, onEvent: onClose };
        }

        // kind: "info" | "success" | "error" (anything else falls back to
        // "info" client-side) -- purely presentational, no interaction.
        // The app controls whether it's shown at all via Component.visible
        // (already a field every Component has) rather than a separate
        // open/closed prop -- one fewer thing to keep in sync.
        fnc notification(message: String, kind: String) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("kind", kind);
            return Component { id: "", type: "Notification", text: message, props: props, children: [], visible: true, onEvent: fn(v: String) { } };
        }

        // Expand/collapse is handled entirely client-side (a header click
        // toggles the section's body visibility in the DOM directly, no
        // server round-trip) -- unlike Tabs/routing, there's no reason an
        // app would need to know server-side which section is open. A
        // real, documented consequence for full-resend (the default
        // rendering mode, see TinoxUIRuntime's own docs): an unrelated
        // event triggering a re-render replaces the whole subtree and
        // resets every section back to `expanded`'s value from the LAST
        // render, losing whatever the user toggled client-side in the
        // meantime -- the same category of tradeoff full-resend already
        // has for "typed but not committed" input state; diff-based
        // rendering (Phase 3) doesn't have this problem, since an
        // unrelated update only patches the parts that actually changed.
        fnc accordionSection(header: String, content: Component, expanded: Bool) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("header", header);
            props.insert("expanded", expanded ? "true" : "false");
            return Component { id: "", type: "AccordionSection", text: "", props: props, children: [content], visible: true, onEvent: fn(v: String) { } };
        }

        fnc accordion(sections: List<Component>) -> Component
        {
            return Component { id: "", type: "Accordion", text: "", props: Map::new(), children: sections, visible: true, onEvent: fn(v: String) { } };
        }

        // --- DataGrid support (see GridColumn.tnx/DataGrid.tnx for the
        // actual DataGrid::of<T> factory) -- these two are the internal
        // building blocks DataGrid::of assembles into a full table, but
        // are plain (non-generic) Component factories themselves like
        // everything else here, so they live on Component, not DataGrid.
        fnc gridRow(cells: List<Component>) -> Component
        {
            return Component { id: "", type: "GridRow", text: "", props: Map::new(), children: cells, visible: true, onEvent: fn(v: String) { } };
        }

        fnc gridCell(text: String, isHeader: Bool) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("header", isHeader ? "true" : "false");
            return Component { id: "", type: "GridCell", text: text, props: props, children: [], visible: true, onEvent: fn(v: String) { } };
        }

        // Rich-content cell (status pill, action button, sparkline, ...)
        // -- `content` becomes the cell's one child, rendered inside a
        // <th>/<td> exactly like any other Component's children (ui.js's
        // GridCell case sets text unconditionally, harmlessly empty here,
        // then the generic children-append loop adds `content` -- no
        // client-side change needed for this at all). See
        // GridColumn::ofComponent, the actual entry point apps use.
        fnc gridCellComponent(content: Component, isHeader: Bool) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("header", isHeader ? "true" : "false");
            return Component { id: "", type: "GridCell", text: "", props: props, children: [content], visible: true, onEvent: fn(v: String) { } };
        }

        fnc vbox(children: List<Component>) -> Component
        {
            return Component { id: "", type: "VBox", text: "", props: Map::new(), children: children, visible: true, onEvent: fn(v: String) { } };
        }

        fnc hbox(children: List<Component>) -> Component
        {
            return Component { id: "", type: "HBox", text: "", props: Map::new(), children: children, visible: true, onEvent: fn(v: String) { } };
        }

        // Vaadin-@Tag/@JsModule equivalent: wraps a real, third-party or
        // custom browser custom element (xterm.js, a live log viewer, ...)
        // as a typed, reusable widget instead of hand-rolling
        // Component::html() + a manually stitched <script> bootstrap. `tag`
        // is the custom element's tag name (reused via the `text` field,
        // unused by every other non-label widget); `moduleUrl` is dynamic-
        // import()ed client-side once, and is expected to
        // `customElements.define(tag, ...)` itself -- see ui.js's own
        // "JsComponent" case for the exact client-side contract. Every
        // entry in `props` is set as a real HTML attribute on the element,
        // so the widget's own `observedAttributes`/`attributeChangedCallback`
        // (standard Custom Elements API, nothing Tinox-specific) is how it
        // reacts to server-side state changes -- same idiom a real Vaadin
        // JS-wrapper component uses. Deliberately does NOT tear the element
        // down on a prop-only re-render (see ui.js's applyUpdate): a
        // JsComponent slot's `type` never changes across renders, so
        // TinoxUIRuntime.diff always emits an in-place "update" for it, not
        // a "replace" -- this is what lets the widget's own internal state
        // (an open WebSocket, a terminal's scrollback, ...) survive an
        // unrelated re-render elsewhere on the page, without a
        // window-global survival hack.
        //
        // `__tinoxModule` is a reserved props key carrying `moduleUrl` --
        // never set as a real DOM attribute (ui.js's build()/applyUpdate
        // both skip it) -- chosen over a dedicated Component field since
        // `props: Map<String,String>` is already the one shape every
        // widget shares, and adding a second field just for this one
        // widget isn't worth the extra @JsonSerializable surface (same
        // reasoning dropdown's own doc comment gives for options/selected).
        //
        // `moduleUrl` shape: a same-origin path (e.g. "/widget.js",
        // served by this SAME @TinoxUIApp/app's own HTTP shell) resolves
        // the normal way, no special handling needed. For a module served
        // by a DIFFERENT port on the same machine (e.g. a companion static
        // -asset HttpServer, needed whenever the app's own HTTP shell port
        // is compiler-generated and can't take extra routes -- see
        // tinox-k8s-ui's PodsView for a real example), prefix it with just
        // a colon+port instead of a full URL: ":8302/widget.js". ui.js
        // expands that against the BROWSER's own actual hostname at
        // import time, never a compile-time "localhost" -- the exact same
        // rule connect()'s own WebSocket URL construction already follows
        // (a Docker port mapping / reverse proxy / remote dev box would
        // otherwise silently try to load the module from the wrong host).
        // A literal `moduleUrl` never needs to know or guess that
        // hostname itself.
        //
        // Cross-port note, found live (not obvious ahead of time): a
        // dynamic `import()` of a cross-ORIGIN module is a real CORS-mode
        // fetch -- unlike a plain cross-origin `<script src>`, the browser
        // enforces this even though both ports are on the SAME machine.
        // The companion server backing a ":port/path" moduleUrl therefore
        // MUST send `Access-Control-Allow-Origin` on that response (e.g.
        // `ctx.response.content(...).header("Access-Control-Allow-Origin", "*")`)
        // or the import silently fails with a CORS console error -- a
        // same-origin plain-path moduleUrl needs no such header.
        fnc jsComponent(tag: String, moduleUrl: String, props: Map<String, String>, onEvent: fnc(String) -> Nothing) -> Component
        {
            let p: Map<String, String> = Map::new();
            let keys: List<String> = props.keys();
            var i: Int64 = 0;
            while i < keys.len()
            {
                p.insert(keys[i], props.get(keys[i]));
                i = i + 1;
            }
            p.insert("__tinoxModule", moduleUrl);
            return Component { id: "", type: "JsComponent", text: tag, props: p, children: [], visible: true, onEvent: onEvent };
        }

        // Escape hatch for anything the v1 widget set doesn't cover yet --
        // raw HTML string, rendered as-is client-side. Mirrors the same
        // "generic client alongside the typed convenience layer" shape
        // tinox.core.kubernetes' GenericResourceOperations already
        // established for this project.
        fnc html(rawHtml: String) -> Component
        {
            return Component { id: "", type: "Html", text: rawHtml, props: Map::new(), children: [], visible: true, onEvent: fn(v: String) { } };
        }

        // Sets an inline CSS style string (v1's only styling mechanism --
        // see the module's own docs for why no theming system exists yet).
        fn withStyle(style: String) -> Component
        {
            this.props.insert("style", style);
            return this;
        }

        // Sets a native title-attribute tooltip, shown by the browser on
        // hover -- v1's only tooltip mechanism (no custom-styled popover
        // yet), the same "ship the simple native-HTML version first"
        // tradeoff numberField/datePicker/etc. already make for their own
        // widget. Works on ANY component, not just a dedicated Tooltip
        // widget -- e.g. Component::button("Save", onClick).withTooltip("Saves the form").
        fn withTooltip(text: String) -> Component
        {
            this.props.insert("tooltip", text);
            return this;
        }

        // --- Phase 6 (Vaadin-comparison gap-fill) -------------------------
        // Same-shaped TextField variants for the native HTML input types
        // Vaadin ships as dedicated fields. All three follow textField's
        // exact wire shape (a "value" prop, onChange reports the new
        // string) -- only the client-side <input type="..."> differs.

        fnc passwordField(value: String, onChange: fnc(String) -> Nothing) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("value", value);
            return Component { id: "", type: "PasswordField", text: "", props: props, children: [], visible: true, onEvent: onChange };
        }

        fnc emailField(value: String, onChange: fnc(String) -> Nothing) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("value", value);
            return Component { id: "", type: "EmailField", text: "", props: props, children: [], visible: true, onEvent: onChange };
        }

        // value: "HH:MM" (native <input type="time"> format).
        fnc timePicker(value: String, onChange: fnc(String) -> Nothing) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("value", value);
            return Component { id: "", type: "TimePicker", text: "", props: props, children: [], visible: true, onEvent: onChange };
        }

        // value: "YYYY-MM-DDTHH:MM" (native <input type="datetime-local"> format).
        fnc dateTimePicker(value: String, onChange: fnc(String) -> Nothing) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("value", value);
            return Component { id: "", type: "DateTimePicker", text: "", props: props, children: [], visible: true, onEvent: onChange };
        }

        // A range input. Reports on every drag movement (not just on
        // release/blur like every other field here) -- the expected UX for
        // a slider, matching Vaadin's own Slider addon. Float64<->String
        // conversion mirrors numberField's own wrapping.
        fnc slider(value: Float64, min: Float64, max: Float64, onChange: fnc(Float64) -> Nothing) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("value", value.toString());
            props.insert("min", min.toString());
            props.insert("max", max.toString());
            let wrapped: fnc(String) -> Nothing = fn(v: String) { onChange(v.toFloat()); };
            return Component { id: "", type: "Slider", text: "", props: props, children: [], visible: true, onEvent: wrapped };
        }

        // A filterable/searchable dropdown (Vaadin ComboBox equivalent),
        // built on the browser's native <input list="..."> + <datalist> --
        // no custom filtering JS needed, the browser does it. A real
        // free-text value not among `options` is still reported as-is
        // (same as a plain textField); validating against the option list
        // is left to the app, same as every other widget here.
        fnc comboBox(options: List<String>, value: String, onChange: fnc(String) -> Nothing) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("options", options.join("|"));
            props.insert("value", value);
            return Component { id: "", type: "ComboBox", text: "", props: props, children: [], visible: true, onEvent: onChange };
        }

        // A group of checkboxes (Vaadin CheckboxGroup equivalent) --
        // multi-select counterpart to radioGroup. onChange reports the
        // FULL new selection as a "|"-joined string on every toggle (the
        // app splits it back into a List<String> itself), same convention
        // dropdown/radioGroup already use for their own options encoding.
        fnc checkboxGroup(options: List<String>, selected: List<String>, onChange: fnc(String) -> Nothing) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("options", options.join("|"));
            props.insert("selected", selected.join("|"));
            return Component { id: "", type: "CheckboxGroup", text: "", props: props, children: [], visible: true, onEvent: onChange };
        }

        // A resizable two-pane layout (Vaadin SplitLayout equivalent).
        // Dragging the divider is handled entirely client-side, same
        // "no server round-trip for a purely visual, client-owned
        // interaction" tradeoff accordionSection's own expand/collapse
        // already makes -- the app never learns the user's chosen split
        // position, same documented v1 limitation.
        fnc splitLayout(first: Component, second: Component, initialSplitPercent: Float64) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("split", initialSplitPercent.toString());
            return Component { id: "", type: "SplitLayout", text: "", props: props, children: [first, second], visible: true, onEvent: fn(v: String) { } };
        }

        // A horizontal menu bar with one dropdown per top-level item
        // (Vaadin MenuBar equivalent). Each entry in `menus` is
        // "Label:Sub1,Sub2,Sub3" (e.g. "File:New,Open,Save") -- kept as a
        // single List<String> rather than a nested List<List<String>>, the
        // same flat-string-encoding convention dropdown/radioGroup/
        // checkboxGroup already use for their own option lists. onSelect
        // reports "TopLabel:SubLabel" for whichever sub-item was clicked.
        fnc menuBar(menus: List<String>, onSelect: fnc(String) -> Nothing) -> Component
        {
            let props: Map<String, String> = Map::new();
            props.insert("menus", menus.join("|"));
            return Component { id: "", type: "MenuBar", text: "", props: props, children: [], visible: true, onEvent: onSelect };
        }

        // --- The following are pure server-side compositions of the
        // widgets above -- no new client-side rendering needed, same as
        // this project's general preference for composing existing,
        // already-battle-tested pieces over inventing new ones when the
        // existing wire protocol already covers the visual/behavioral need.

        // A circular avatar (Vaadin Avatar equivalent): an image if
        // `imageUrl` is set, otherwise up to two initials derived from
        // `name`.
        fnc avatar(name: String, imageUrl: String) -> Component
        {
            let style: String = "width:2.5rem;height:2.5rem;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--tinox-primary-10);color:var(--tinox-primary-text);font-weight:600;overflow:hidden;";
            if (imageUrl != "")
            {
                return Component::image(imageUrl, name).withStyle(style + "object-fit:cover;");
            }
            let initials: String = Component.initialsOf(name);
            return Component::label(initials).withStyle(style);
        }

        fnc initialsOf(name: String) -> String
        {
            let parts: List<String> = name.split(" ");
            var result: String = "";
            var i: Int64 = 0;
            while i < parts.len() && i < 2
            {
                let part: String = parts[i];
                if (part.len() > 0)
                {
                    result = result + part.charAt(0);
                }
                i = i + 1;
            }
            return result.toUpper();
        }

        // A small colored pill (Vaadin Badge equivalent) -- a persistent,
        // inline status marker, as opposed to notification()'s toast-like
        // one-off message. kind: "info" | "success" | "error" | "warning".
        fnc badge(text: String, kind: String) -> Component
        {
            var color: String = "#93a4bd";
            if (kind == "success") { color = "#34d399"; }
            if (kind == "error") { color = "#fb7185"; }
            if (kind == "warning") { color = "#fbbf24"; }
            let style: String = "display:inline-block;padding:2px 10px;border-radius:999px;font-size:0.75rem;font-weight:600;border:1px solid " + color + ";color:" + color + ";background:" + color + "1a;";
            return Component::label(text).withStyle(style);
        }

        // A titled, bordered content box (Vaadin Card equivalent).
        fnc card(title: String, content: Component) -> Component
        {
            let style: String = "border:1px solid var(--tinox-glass-border);border-radius:var(--tinox-radius-l);padding:1rem;background:var(--tinox-glass);";
            return Component::vbox([
                Component::heading(title, 4),
                content
            ]).withStyle(style);
        }

        // A single collapsible panel (Vaadin Details equivalent) -- an
        // accordion with exactly one section.
        fnc details(summary: String, content: Component, expanded: Bool) -> Component
        {
            return Component::accordion([Component::accordionSection(summary, content, expanded)]);
        }

        // A "Confirm"/"Cancel" convenience wrapper over dialog() (Vaadin
        // ConfirmDialog equivalent). onCancel also fires for the
        // backdrop/close-button click, same as a plain dialog's onClose.
        fnc confirmDialog(title: String, message: String, open: Bool, onConfirm: fnc(String) -> Nothing, onCancel: fnc(String) -> Nothing) -> Component
        {
            let body: Component = Component::vbox([
                Component::label(message),
                Component::hbox([
                    Component::button("Confirm", onConfirm),
                    Component::button("Cancel", onCancel)
                ])
            ]);
            return Component::dialog(title, body, open, onCancel);
        }

        // A breadcrumb trail (Vaadin Breadcrumb equivalent): every item
        // except the last is a Link (path from the matching `paths`
        // entry); the last is plain text (the current page).
        fnc breadcrumb(items: List<String>, paths: List<String>, onNavigate: fnc(String) -> Nothing) -> Component
        {
            var parts: List<Component> = [];
            var i: Int64 = 0;
            while i < items.len()
            {
                let isLast: Bool = (i == items.len() - 1);
                if (isLast)
                {
                    parts.push(Component::label(items[i]));
                }
                else
                {
                    parts.push(Component::link(items[i], paths[i], onNavigate));
                    parts.push(Component::label("/").withStyle("color:var(--tinox-text2);"));
                }
                i = i + 1;
            }
            return Component::hbox(parts);
        }
    }
}

module tinox.core.ui;

namespace tinox.core.ui
{
    // The two static assets every Tinox-UI app needs to serve over plain
    // HTTP: a minimal shell page (one mount `<div>`, nothing else) and
    // the generic client runtime (~130 lines, hand-written -- see the
    // module's own docs for why this is deliberately NOT generated from
    // Tinox: it's the one piece of the whole framework that has to run
    // as real client-side JS, same as Vaadin's/Phoenix LiveView's own
    // client isn't Java/Elixir either).
    //
    // Baked in as string constants (not read from disk via Fs::readFile)
    // so a compiled app never has a "forgot to ship ui.js next to the
    // binary" deployment footgun.
    class Assets
    {
        // wsPort: only the WebSocket server's PORT, not a full URL --
        // deliberately NOT "ws://localhost:port/path" baked in as a
        // compile-time constant (that was this widget's own original
        // design, and a real bug: it silently broke for anyone reaching
        // the HTTP shell through any hostname other than literally
        // "localhost" -- a remote dev server, a Docker port mapping, a
        // reverse proxy, a cloud sandbox's own forwarded URL, ... -- the
        // page would load, but the WebSocket connection would silently
        // try to reach the VIEWER'S OWN machine instead of the actual
        // server, fail, and never retry successfully, leaving the page
        // permanently blank with nothing to indicate why). The client JS
        // (see clientJs() below) now builds the real WS URL itself from
        // `window.location.hostname` (whatever host the browser actually
        // used to reach this page) plus this port, at connect time.
        fnc shellHtml(wsPort: Int64) -> String
        {
            let template: String = Assets::shellHtmlTemplate();
            return template.replace("__TINOX_UI_WS_PORT__", wsPort.toString());
        }

        // Design tokens (dark, glassy, cyan/purple neon-accented) ported
        // from tinox-central's own registry-frontend theme
        // (registry-frontend/src/main/frontend/themes/tinox-central/
        // styles.css in the tinox-central repo) -- same color values,
        // gradients and fonts, just targeting plain HTML elements
        // (button/input/table/...) instead of Vaadin web components,
        // since ui.js renders plain DOM, not Vaadin. Every Tinox-UI app
        // gets this by default (no opt-in) -- an app that wants its own
        // look can still override via Component::withStyle's inline
        // style hook, or by not using this shell template at all
        // (Assets::clientJs() works standalone against any HTML page
        // with a `#tinox-ui-root` element).
        fnc shellHtmlTemplate() -> String
        {
            return r#"<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Tinox-UI</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --tinox-base: #070b14;
    --tinox-text: #e2e8f0;
    --tinox-text2: #93a4bd;
    --tinox-primary: #22d3ee;
    --tinox-primary-10: rgba(34, 211, 238, 0.12);
    --tinox-primary-text: #67e8f9;
    --tinox-primary-contrast: #041018;
    --tinox-accent-2: #a78bfa;
    --tinox-error: #fb7185;
    --tinox-success: #34d399;
    --tinox-glass: rgba(17, 25, 43, 0.6);
    --tinox-glass-border: rgba(103, 232, 249, 0.16);
    --tinox-font: 'Inter', ui-sans-serif, system-ui, sans-serif;
    --tinox-font-display: 'Space Grotesk', 'JetBrains Mono', var(--tinox-font);
    --tinox-font-mono: 'JetBrains Mono', ui-monospace, monospace;
    --tinox-radius-m: 10px;
    --tinox-radius-l: 16px;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    font-family: var(--tinox-font);
    color: var(--tinox-text);
    background:
      radial-gradient(60rem 32rem at 12% -10%, rgba(34, 211, 238, 0.14), transparent 60%),
      radial-gradient(50rem 30rem at 110% 10%, rgba(167, 139, 250, 0.12), transparent 55%),
      linear-gradient(180deg, #05070d 0%, #070b14 40%, #060910 100%);
    background-attachment: fixed;
  }
  #tinox-ui-root {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 48rem;
    margin: 0 auto;
    padding: 2.5rem clamp(1.25rem, 4vw, 3rem);
  }
  h1, h2, h3, h4, h5, h6 {
    margin: 0.4rem 0;
    font-family: var(--tinox-font-display);
    font-weight: 700;
    letter-spacing: 0.01em;
    background: linear-gradient(120deg, #f8fafc 0%, #67e8f9 55%, #a78bfa 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  a {
    color: var(--tinox-primary-text);
    text-decoration: none;
    font-weight: 500;
  }
  button {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 1px solid rgba(103, 232, 249, 0.28);
    background: rgba(34, 211, 238, 0.06);
    color: var(--tinox-primary-text);
    font-family: var(--tinox-font);
    font-weight: 500;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  button:hover {
    background: rgba(34, 211, 238, 0.16);
    border-color: var(--tinox-primary);
    box-shadow: 0 0 16px -2px rgba(34, 211, 238, 0.55);
  }
  input, textarea, select {
    font-family: var(--tinox-font);
    color: var(--tinox-text);
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid var(--tinox-glass-border);
    border-radius: var(--tinox-radius-m);
    padding: 0.5rem 0.7rem;
    font-size: 0.9rem;
  }
  input:focus, textarea:focus, select:focus {
    outline: none;
    border-color: var(--tinox-primary);
    box-shadow: 0 0 0 3px var(--tinox-primary-10);
  }
  a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    border: 1px solid rgba(103, 232, 249, 0.28);
    background: rgba(34, 211, 238, 0.06);
    transition: background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  a:hover {
    background: rgba(34, 211, 238, 0.16);
    border-color: var(--tinox-primary);
    box-shadow: 0 0 16px -2px rgba(34, 211, 238, 0.55);
  }
  progress {
    width: 100%;
    height: 0.6rem;
    border-radius: 999px;
    overflow: hidden;
    border: none;
    background: rgba(148, 163, 184, 0.14);
  }
  progress::-webkit-progress-bar { background: rgba(148, 163, 184, 0.14); }
  progress::-webkit-progress-value { background: var(--tinox-primary); }
  progress::-moz-progress-bar { background: var(--tinox-primary); }
  .tinox-datagrid-wrap { display: block; width: 100%; }
  .tinox-datagrid-toolbar {
    display: flex;
    justify-content: flex-end;
    position: relative;
    margin-bottom: 0.35rem;
    min-height: 1.6rem;
  }
  .tinox-datagrid-menu-btn {
    padding: 0.1rem 0.55rem;
    font-size: 1rem;
    line-height: 1.4;
    min-width: unset;
  }
  .tinox-datagrid-menu-panel {
    position: absolute;
    top: 100%;
    right: 0;
    z-index: 20;
    margin-top: 0.3rem;
    background: #0c1220;
    border: 1px solid var(--tinox-glass-border);
    border-radius: var(--tinox-radius-m);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    padding: 0.5rem 0.7rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 11rem;
    max-height: 16rem;
    overflow-y: auto;
    box-shadow: 0 10px 30px -8px rgba(0, 0, 0, 0.55);
  }
  /* The `hidden` IDL attribute's UA-stylesheet `display:none` loses to
     this rule's own `display: flex` above (author CSS always beats a
     user-agent default, regardless of selector specificity) unless
     re-asserted here explicitly -- found live: without this, the panel
     rendered permanently open, overlapping the table underneath and
     intercepting its clicks. */
  .tinox-datagrid-menu-panel[hidden] { display: none; }
  .tinox-datagrid-menu-item {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    color: var(--tinox-text);
    cursor: pointer;
    white-space: nowrap;
  }
  .tinox-datagrid-menu-item input { margin: 0; accent-color: var(--tinox-primary); }
  table.tinox-datagrid {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--tinox-font);
    background: var(--tinox-glass);
    border: 1px solid var(--tinox-glass-border);
    border-radius: var(--tinox-radius-l);
    overflow: hidden;
  }
  table.tinox-datagrid th, table.tinox-datagrid td {
    border-right: 1px solid rgba(148, 163, 184, 0.12);
  }
  table.tinox-datagrid th:last-child, table.tinox-datagrid td:last-child { border-right: none; }
  table.tinox-datagrid th:nth-child(even), table.tinox-datagrid td:nth-child(even) {
    background: rgba(148, 163, 184, 0.045);
  }
  table.tinox-datagrid th {
    background: rgba(34, 211, 238, 0.05);
    color: var(--tinox-primary-text);
    text-transform: uppercase;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-align: left;
    padding: 0.6rem 1.5rem 0.6rem 0.8rem;
    border-bottom: 1px solid rgba(103, 232, 249, 0.2);
    position: relative;
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
  }
  table.tinox-datagrid th:hover { color: #fff; }
  table.tinox-datagrid th::after {
    content: "";
    position: absolute;
    right: 0.6rem;
    top: 50%;
    margin-top: -3px;
    border: 4px solid transparent;
    opacity: 0.3;
  }
  table.tinox-datagrid th.tinox-sort-asc::after { border-bottom-color: var(--tinox-primary-text); opacity: 1; margin-top: -6px; }
  table.tinox-datagrid th.tinox-sort-desc::after { border-top-color: var(--tinox-primary-text); opacity: 1; }
  table.tinox-datagrid td {
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid rgba(148, 163, 184, 0.07);
  }
  table.tinox-datagrid th.tinox-col-hidden, table.tinox-datagrid td.tinox-col-hidden { display: none; }
  table.tinox-datagrid tr:hover td { background: rgba(34, 211, 238, 0.055); }
  .tinox-radio-group { display: flex; flex-direction: column; gap: 0.4rem; }
  .tinox-radio-group label { display: flex; align-items: center; gap: 0.4rem; font-size: 0.9rem; }
  .tinox-tabs-header { display: flex; gap: 0.4rem; border-bottom: 1px solid var(--tinox-glass-border); padding-bottom: 0.5rem; margin-bottom: 0.75rem; }
  .tinox-tab { padding: 0.35rem 0.9rem; border-radius: 999px; cursor: pointer; color: var(--tinox-text2); font-size: 0.85rem; }
  .tinox-tab:hover { color: var(--tinox-text); }
  .tinox-tab-active { background: var(--tinox-primary-10); color: var(--tinox-primary-text); font-weight: 600; }
  .tinox-dialog-backdrop {
    position: fixed; inset: 0; z-index: 100;
    display: flex; align-items: center; justify-content: center;
    background: rgba(5, 7, 13, 0.65);
  }
  .tinox-dialog-box {
    background: var(--tinox-glass);
    border: 1px solid var(--tinox-glass-border);
    border-radius: var(--tinox-radius-l);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    padding: 1.25rem;
    min-width: 20rem;
    max-width: 90vw;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .tinox-dialog-title {
    display: flex; align-items: center; justify-content: space-between;
    font-family: var(--tinox-font-display); font-weight: 700; font-size: 1.1rem; color: var(--tinox-text);
  }
  .tinox-dialog-close { padding: 0.1rem 0.5rem; border-radius: 999px; min-width: unset; }
  .tinox-notification {
    padding: 0.6rem 1rem;
    border-radius: var(--tinox-radius-m);
    background: var(--tinox-glass);
    border: 1px solid var(--tinox-glass-border);
    font-size: 0.9rem;
  }
  .tinox-notification-success { border-color: rgba(52, 211, 153, 0.4); color: var(--tinox-success); }
  .tinox-notification-error { border-color: rgba(251, 113, 133, 0.4); color: var(--tinox-error); }
  .tinox-accordion { display: flex; flex-direction: column; gap: 0.5rem; }
  .tinox-accordion-section {
    background: var(--tinox-glass);
    border: 1px solid var(--tinox-glass-border);
    border-radius: var(--tinox-radius-m);
    overflow: hidden;
  }
  .tinox-accordion-header { padding: 0.6rem 0.9rem; cursor: pointer; font-weight: 600; color: var(--tinox-primary-text); }
  .tinox-accordion-body { padding: 0 0.9rem 0.75rem; }
  .tinox-checkbox-group { display: flex; flex-direction: column; gap: 0.4rem; }
  .tinox-checkbox-group label { display: flex; align-items: center; gap: 0.4rem; font-size: 0.9rem; }
  .tinox-combobox { display: flex; }
  .tinox-combobox input { width: 100%; }
  .tinox-fileupload { display: flex; flex-direction: column; gap: 0.4rem; }
  .tinox-fileupload-progress { display: flex; align-items: center; gap: 0.6rem; font-size: 0.85rem; color: var(--tinox-text2); }
  .tinox-fileupload-progress progress { flex: 1; accent-color: var(--tinox-primary); height: 6px; }
  input[type="range"] { accent-color: var(--tinox-primary); padding: 0; background: none; border: none; }
  .tinox-split { display: flex; align-items: stretch; gap: 0; min-height: 8rem; }
  .tinox-split-pane { flex-shrink: 0; overflow: auto; padding: 0.5rem; }
  .tinox-split-divider { width: 6px; flex-shrink: 0; cursor: col-resize; background: var(--tinox-glass-border); border-radius: 999px; }
  .tinox-split-divider:hover { background: var(--tinox-primary); }
  .tinox-menubar { display: flex; gap: 0.25rem; }
  .tinox-menubar-item { position: relative; }
  .tinox-menubar-top { padding: 0.4rem 0.9rem; border-radius: 999px; cursor: pointer; font-size: 0.85rem; color: var(--tinox-text2); }
  .tinox-menubar-top:hover { color: var(--tinox-text); background: rgba(34, 211, 238, 0.08); }
  .tinox-menubar-dropdown {
    position: absolute; top: 100%; left: 0; z-index: 50;
    background: var(--tinox-glass); border: 1px solid var(--tinox-glass-border);
    border-radius: var(--tinox-radius-m); padding: 0.35rem; min-width: 9rem;
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
  }
  .tinox-menubar-sub { padding: 0.4rem 0.6rem; border-radius: 6px; cursor: pointer; font-size: 0.85rem; white-space: nowrap; }
  .tinox-menubar-sub:hover { background: rgba(34, 211, 238, 0.12); color: var(--tinox-primary-text); }
</style>
</head>
<body>
<div id="tinox-ui-root"></div>
<script>window.TINOX_UI_WS_PORT = "__TINOX_UI_WS_PORT__";</script>
<script src="/ui.js"></script>
</body>
</html>
"#;
        }

        fnc clientJs() -> String
        {
            return r#"(function () {
  "use strict";
  var mount = document.getElementById("tinox-ui-root");
  var ws = null;
  var reconnectDelayMs = 500;
  var reconnectTimer = null;

  // Phase 6 (issue #215): a dropped connection retries with exponential
  // backoff (0.5s, 1s, 2s, ... capped at 10s, reset back to 0.5s once a
  // connection actually opens) instead of just stopping updates forever.
  // `data-tinox-ui-status` on the mount element ("connected"/
  // "reconnecting") lets an app's own CSS show a banner/spinner if it
  // wants one -- nothing renders one by default.
  //
  // A reconnect always starts a brand-new session: the server allocates a
  // fresh app instance per accepted WS connection (see
  // TinoxUIRuntime's/Component's own docs on why -- no static/global
  // state in Tinox to hold a session registry in), so whatever state the
  // dropped connection had (form input, click counts, ...) is gone, same
  // as a real page reload would lose it. This is a deliberate, documented
  // v1 scope limit, not an oversight -- a real session store surviving a
  // reconnect would need genuinely new server-side infrastructure
  // (a session-id-keyed instance registry with its own TTL/expiry, which
  // Tinox's current "no global mutable state" design has nowhere to put)
  // disproportionate to what reconnect resilience alone needs.
  function connect() {
    // Built from the page's OWN actual hostname (whatever the browser
    // used to reach this page -- localhost, a LAN IP, a Docker-mapped
    // host, a reverse-proxied domain, ...), not a compile-time-baked
    // "localhost" -- see shellHtml's own doc comment for the real bug
    // this fixes. wss:// when the page itself was loaded over https:,
    // matching the browser's own mixed-content rules (a wss:// server
    // is required for a plain ws:// connection to succeed).
    var wsProto = window.location.protocol === "https:" ? "wss://" : "ws://";
    var wsUrl = wsProto + window.location.hostname + ":" + window.TINOX_UI_WS_PORT + "/__tinoxui";
    ws = new WebSocket(wsUrl);
    ws.onopen = function () {
      reconnectDelayMs = 500;
      mount.setAttribute("data-tinox-ui-status", "connected");
      // Every app's worker reads and discards exactly one initial frame
      // before its first render (see codegen's emit_tinoxui_code) -- a
      // @Route-using app additionally seeds its `currentRoute` field from
      // it, so a hard reload / directly-typed URL / shared deep link lands
      // on the right view immediately. Sent unconditionally (harmless for
      // a plain, non-routed app, which just discards it) so there's one
      // client protocol regardless of whether the server app uses @Route.
      ws.send(window.location.pathname);
    };
    ws.onmessage = function (ev) {
      var msg = JSON.parse(ev.data);
      if (msg.kind === "init" || msg.kind === "update") {
        mount.replaceChildren(build(msg.root));
      } else if (msg.kind === "patch") {
        applyPatch(msg.ops);
      }
    };
    ws.onclose = function () {
      mount.setAttribute("data-tinox-ui-status", "reconnecting");
      if (reconnectTimer) clearTimeout(reconnectTimer);
      reconnectTimer = setTimeout(function () {
        reconnectDelayMs = Math.min(reconnectDelayMs * 2, 10000);
        connect();
      }, reconnectDelayMs);
    };
    ws.onerror = function () {
      // onclose always fires after onerror for a WebSocket -- no separate
      // reconnect scheduling needed here, just make sure the socket is
      // actually closed rather than left half-open.
      ws.close();
    };
  }

  function findEl(id) {
    return mount.querySelector('[data-tinox-id="' + id + '"]');
  }

  // Applies a Phase-3 diff patch (TinoxUIRuntime.diff's op list) without
  // rebuilding the whole subtree -- an "update" op re-applies text/props
  // onto the SAME DOM element in place (so focus/scroll/typed-but-not-yet-
  // committed input state on it survives), "replace"/"remove"/"insert"
  // still (re)build via build() for the affected node only.
  function applyPatch(ops) {
    for (var i = 0; i < ops.length; i++) {
      var op = ops[i];
      if (op.op === "update") {
        var el = findEl(op.id);
        if (el) applyUpdate(el, op);
      } else if (op.op === "replace") {
        var old = findEl(op.id);
        if (old && old.parentNode) {
          old.parentNode.replaceChild(build(op.node), old);
        }
      } else if (op.op === "remove") {
        var toRemove = findEl(op.id);
        if (toRemove && toRemove.parentNode) {
          toRemove.parentNode.removeChild(toRemove);
        }
      } else if (op.op === "insert") {
        var parent = findEl(op.parentId);
        if (!parent) continue;
        var newEl = build(op.node);
        if (op.index >= parent.children.length) {
          parent.appendChild(newEl);
        } else {
          parent.insertBefore(newEl, parent.children[op.index]);
        }
      }
    }
  }

  // Mirrors build()'s own per-type text/prop application, WITHOUT
  // recreating the element or re-attaching its event listener -- the
  // existing listener (from when this element was first built) already
  // reads the live DOM value at event time (el.value/el.checked), not a
  // stale captured snapshot, and its target id doesn't change on an
  // "update" op, so it stays correct across repeated updates with no
  // rewiring needed.
  function applyUpdate(el, op) {
    var props = op.props || {};
    // Custom-element tag names are required (by spec) to contain a hyphen
    // -- JsComponent is the only widget kind that ever builds one, so this
    // is a reliable, bookkeeping-free way to recognize a live JsComponent
    // instance here and update it via real DOM attributes (letting its own
    // observedAttributes/attributeChangedCallback react), instead of
    // falling through the switch below (which has no case for an
    // arbitrary custom tag) and silently doing nothing beyond `style`.
    // Never touches innerHTML/children -- see build()'s own "JsComponent"
    // case doc comment for why that's exactly what keeps the widget's own
    // internal state (an open WebSocket, a terminal's scrollback, ...)
    // alive across this update instead of being torn down.
    if (el.tagName.indexOf("-") !== -1) {
      for (var jk in props) {
        if (props.hasOwnProperty(jk) && jk !== "__tinoxModule") {
          el.setAttribute(jk, props[jk]);
        }
      }
      return;
    }
    switch (el.tagName) {
      case "SPAN":
      case "BUTTON":
      case "A":
        el.textContent = op.text;
        if (el.tagName === "A" && props.href !== undefined) el.setAttribute("href", props.href);
        break;
      case "INPUT":
        if ((el.type === "text" || el.type === "number" || el.type === "date" ||
             el.type === "password" || el.type === "email" || el.type === "time" ||
             el.type === "datetime-local" || el.type === "range") && props.value !== undefined) {
          el.value = props.value;
        }
        if (el.type === "checkbox" && props.checked !== undefined) el.checked = props.checked === "true";
        if (el.type === "range") {
          if (props.min !== undefined) el.min = props.min;
          if (props.max !== undefined) el.max = props.max;
        }
        break;
      case "TH": case "TD":
        el.textContent = op.text;
        break;
      case "DIV":
        // Notification and Html are the only two DIV-rendered types with
        // real text/markup to patch here -- every other DIV-rendered type
        // (VBox, HBox, RadioGroup, Tabs, Dialog, Accordion,
        // AccordionSection, FileUpload's container...) is structural (its
        // "content" is child elements it built itself in build(), not a
        // single text/innerHTML string) and must NOT be touched here --
        // a props-only diff "update" on one of those only ever needs to
        // re-apply `style` (see the bottom of this function).
        //
        // Found and fixed live (issue tracked separately) while verifying
        // Component::jsComponent against a real app: this branch used to
        // unconditionally `el.innerHTML = op.text` for every non-
        // notification DIV, which for a Dialog/etc (whose own `text` is
        // always "") silently WIPED its entire built structure (title,
        // close button, every child) the instant its `open`/other props
        // changed and the diff picked "update" over "replace" -- exactly
        // the class of bug this project's own "no silent garbage"
        // philosophy targets, just never caught before since no existing
        // example clicked a dialog open through the newer diff-based
        // rendering path. `build()`'s "Html" case below now tags its own
        // div with `tinox-html` specifically so this branch can tell it
        // apart from every structural container, which all render as a
        // plain, unmarked `<div>` (or their own distinct className).
        if (el.className.indexOf("tinox-notification") === 0) {
          el.textContent = op.text;
        } else if (el.className === "tinox-html") {
          el.innerHTML = op.text;
        } else if (el.className === "tinox-combobox") {
          var cbInputEl = el.querySelector("input");
          if (cbInputEl && props.value !== undefined) cbInputEl.value = props.value;
        } else if (el.className === "tinox-checkbox-group") {
          var cgSelectedNew = (props.selected || "").split("|").filter(function (s) { return s.length > 0; });
          var cgBoxes = el.querySelectorAll("input[type=checkbox]");
          for (var cgj = 0; cgj < cgBoxes.length; cgj = cgj + 1) {
            cgBoxes[cgj].checked = cgSelectedNew.indexOf(cgBoxes[cgj].value) !== -1;
          }
        } else if (el.className === "tinox-fileupload") {
          // uploadUrl/showProgress live on `el` (see build()'s "FileUpload"
          // case doc comment for why) -- this is the one place that keeps
          // them in sync with a later props-only "update" patch, e.g. a
          // checkbox elsewhere on the page toggling showProgress. Lazily
          // creates the progress row via ensureFileUploadProgressRow if
          // showProgress just turned true and none exists yet; an
          // already-existing row just gets hidden again if it turned
          // false (never destroyed -- a mid-upload toggle-off-then-on
          // shouldn't lose whatever percent it was showing).
          if (props.uploadUrl !== undefined) el.tinoxUploadUrl = props.uploadUrl;
          if (props.showProgress !== undefined) {
            el.tinoxShowProgress = props.showProgress === "true";
            ensureFileUploadProgressRow(el);
            if (!el.tinoxShowProgress && el.tinoxProgressRow) el.tinoxProgressRow.hidden = true;
          }
        }
        break;
      case "TEXTAREA":
        if (props.value !== undefined) el.value = props.value;
        break;
      case "SELECT":
        if (props.selected !== undefined) el.value = props.selected;
        break;
      case "PROGRESS":
        if (props.value !== undefined) el.value = parseFloat(props.value) || 0;
        break;
      case "IMG":
        if (props.src !== undefined) el.src = props.src;
        if (props.alt !== undefined) el.alt = props.alt;
        break;
      case "H1": case "H2": case "H3": case "H4": case "H5": case "H6":
        el.textContent = op.text;
        break;
    }
    el.setAttribute("style", props.style || "");
    if (props.tooltip !== undefined) {
      el.title = props.tooltip;
    }
  }

  function sendEvent(id, value) {
    if (ws && ws.readyState === WebSocket.OPEN) {
      ws.send(JSON.stringify({ kind: "event", id: id, value: value }));
    }
  }

  // A url starting with ":" is a cross-port reference (a companion
  // HttpServer on a different port than this page's own -- see
  // Component::jsComponent's own doc comment for why @TinoxUIApp's
  // generated HTTP shell can't just take extra routes itself) -- expanded
  // against the browser's OWN actual hostname here, never a compile-time
  // "localhost", same rule connect()'s wsUrl already follows. A plain path
  // resolves as a normal same-origin URL untouched. Shared by JsComponent's
  // moduleUrl and FileUpload's uploadUrl -- same convention, same fix.
  function resolveCrossPortUrl(url) {
    return url.charAt(0) === ":"
      ? (window.location.protocol === "https:" ? "https://" : "http://") + window.location.hostname + url
      : url;
  }

  // "3m 12s remaining" / "48s remaining" -- used by FileUpload's optional
  // progress readout. Whole seconds only (an ETA down to the millisecond
  // would be false precision given it's extrapolated from a handful of
  // upload.onprogress samples).
  function formatRemaining(seconds) {
    var s = Math.max(0, Math.round(seconds));
    var m = Math.floor(s / 60);
    var rem = s % 60;
    return m > 0 ? (m + "m " + rem + "s remaining") : (rem + "s remaining");
  }

  // Lazily creates FileUpload's progress row (bar + text) the first time
  // it's actually needed, so a widget built with showProgress=false that
  // later gets toggled true by an "update" patch (see applyUpdate's own
  // "tinox-fileupload" branch, the only other caller) still gets one --
  // build()'s FileUpload case only runs once per element, at initial
  // creation. A no-op if el.tinoxProgressRow already exists.
  function ensureFileUploadProgressRow(el) {
    if (el.tinoxProgressRow || !el.tinoxShowProgress) return;
    var row = document.createElement("div");
    row.className = "tinox-fileupload-progress";
    row.hidden = true;
    var bar = document.createElement("progress");
    bar.max = 100;
    bar.value = 0;
    var text = document.createElement("span");
    row.appendChild(bar);
    row.appendChild(text);
    row.tinoxBar = bar;
    row.tinoxText = text;
    el.appendChild(row);
    el.tinoxProgressRow = row;
  }

  // Uploads `file` to `uploadUrl` (already resolved through
  // resolveCrossPortUrl by the caller... actually resolved per-chunk
  // below, since it's cheap and keeps this function's inputs simple) in
  // fixed-size chunks, sequentially, instead of one single request --
  // two hard reasons, not just an optimization:
  //
  //  1. tinox.core.http_server's request reader rejects any body over
  //     4 MB with a 413 (TINOX_MAX_BODY in runtime.c) -- a whole
  //     multi-hundred-MB/GB file base64-encoded in one request would
  //     always hit that, every time, regardless of network speed.
  //  2. FileReader.readAsDataURL(file) on the WHOLE file loads it
  //     entirely into memory as one JS string before anything is even
  //     sent -- for a multi-GB file that's minutes of unresponsive,
  //     unreported "reading" time before the first byte goes anywhere,
  //     which is what made a 3.7 GB pick look permanently stuck at 0%.
  //  3. Measured directly (curl, body sizes from 4 KB to 1 MB, while a
  //     Tinox-UI page's WebSocket connection stays open so the process
  //     has real background allocation activity to collect around):
  //     conn_read_request's buffer, which starts at 4 KB and doubles to
  //     fit the request, hands each doubling to a Boehm GC-instrumented
  //     realloc -- and each of THOSE can trigger a full stop-the-world
  //     collection across every thread in the process (30+ for this
  //     demo's SO_REUSEPORT HTTP worker pool alone). Cost isn't linear
  //     in body size, it's a cliff: 256 KB took 0.49s, 512 KB 1.6s, and
  //     1 MB 12s. A single request anywhere near the old 2 MB chunk size
  //     could cost the better part of a minute for exactly this reason
  //     -- not a network/CORS/server-logic problem, a GC one, and not
  //     something this change can fix from client-side JS. Staying at
  //     32 KB keeps every chunk in the flat, sub-10ms part of that curve
  //     regardless of how large the whole file is or how busy the
  //     WS-rendering side of the same process gets.
  //
  // file.slice() is a lazy Blob view (no copy), so memory use stays
  // bounded to one chunk regardless of the total file size.
  //
  // Progress is real, aggregate file-byte progress (bytes of completed
  // chunks + the in-flight chunk's own upload.onprogress, scaled back
  // down from the base64-inflated wire size to the original chunk's raw
  // byte count) -- not "chunks done / chunks total", which would report
  // the same percentage for a 1 KB last chunk as for a full-size one.
  function uploadFileInChunks(file, uploadUrl, bar, text) {
    var CHUNK_SIZE = 32 * 1024;
    var totalBytes = file.size;
    var totalChunks = Math.max(1, Math.ceil(totalBytes / CHUNK_SIZE));
    var chunkIndex = 0;
    var bytesDoneBeforeChunk = 0;
    var startedAt = Date.now();

    function updateProgress(loadedInCurrentChunk) {
      if (!bar) return;
      var loadedTotal = bytesDoneBeforeChunk + loadedInCurrentChunk;
      var pct = totalBytes > 0 ? Math.min(100, Math.round((loadedTotal / totalBytes) * 100)) : 100;
      bar.value = pct;
      var elapsedMs = Date.now() - startedAt;
      var etaText = "";
      if (loadedTotal > 0 && pct < 100 && elapsedMs > 200) {
        var bytesPerMs = loadedTotal / elapsedMs;
        var remainingMs = (totalBytes - loadedTotal) / bytesPerMs;
        etaText = " -- " + formatRemaining(remainingMs / 1000);
      }
      text.textContent = pct + "%" + etaText;
    }

    function sendChunk() {
      if (chunkIndex >= totalChunks) {
        if (text) text.textContent = "100% -- done";
        if (bar) bar.value = 100;
        return;
      }
      var start = chunkIndex * CHUNK_SIZE;
      var end = Math.min(start + CHUNK_SIZE, totalBytes);
      var chunkBytes = end - start;
      var reader = new FileReader();
      reader.onload = function () {
        var dataUrl = String(reader.result);
        var commaIdx = dataUrl.indexOf(",");
        var b64 = commaIdx >= 0 ? dataUrl.substring(commaIdx + 1) : "";
        var xhr = new XMLHttpRequest();
        // Filename/chunk position ride the query string, not custom
        // headers: a custom request header makes this a CORS-"non-simple"
        // request, which needs a matching OPTIONS-preflight route the
        // app's companion HttpServer doesn't register (see
        // Component::fileUpload's own doc comment on why uploadUrl is
        // cross-port at all). Content-Type: text/plain is itself one of
        // the CORS-safelisted values, so this stays preflight-free, same
        // as the plain GET codeblock.js already is.
        var url = resolveCrossPortUrl(uploadUrl) +
          "?filename=" + encodeURIComponent(file.name) +
          "&chunkIndex=" + chunkIndex +
          "&totalChunks=" + totalChunks;
        xhr.open("POST", url, true);
        xhr.setRequestHeader("Content-Type", "text/plain;charset=utf-8");
        xhr.upload.addEventListener("progress", function (ev) {
          if (!ev.lengthComputable) return;
          // ev.loaded/ev.total are over THIS chunk's base64-inflated wire
          // body, not the original file bytes -- scale back down so the
          // aggregate percentage tracks real file bytes, matching what
          // `total` (file.size) below is measured in.
          var approxRawLoaded = Math.min(chunkBytes, (ev.loaded / ev.total) * chunkBytes);
          updateProgress(approxRawLoaded);
        });
        xhr.addEventListener("loadend", function () {
          if (xhr.status < 200 || xhr.status >= 300) {
            if (text) {
              text.textContent = "Upload failed at chunk " + (chunkIndex + 1) + "/" + totalChunks +
                " (" + (xhr.status || "network error") + ")";
            }
            return;
          }
          bytesDoneBeforeChunk += chunkBytes;
          chunkIndex += 1;
          updateProgress(0);
          sendChunk();
        });
        xhr.send(b64);
      };
      reader.readAsDataURL(file.slice(start, end));
    }

    sendChunk();
  }

  // Exposed globally so a Component::html()-embedded <script> (see the
  // "Html" case's own doc comment on why those actually run now) can
  // trigger a real server round trip -- e.g. a polling timer that
  // re-sends an event on a fixed interval to force a periodic re-render,
  // since the framework has no separate built-in polling primitive.
  // `id` doesn't need to match any real component's id: dispatchEvent
  // (TinoxUIRuntime.tnx) already silently no-ops on an unknown id via
  // its own `handlers.contains(id)` check, and the generated msg_loop
  // unconditionally rebuilds+resends the tree after every message
  // regardless of whether a handler actually ran -- so a bogus id (e.g.
  // "__poll__") is a safe, deliberate no-op-triggered-refresh, not a
  // hack around a missing check.
  window.tinoxSendEvent = sendEvent;

  // The one place that needs a matching entry whenever a new widget
  // `type` is added server-side (Component.tnx) -- documented as a real
  // two-sided contract in the module's own docs, the same way e.g. HTTP
  // status codes have to stay in sync across this project's own
  // HttpStatusHelper.
  function build(node) {
    if (!node || node.visible === false) {
      // Found and fixed live alongside the DIV-innerHTML-wipe bug above
      // (same investigation, same root cause class): this placeholder
      // used to come back with NO data-tinox-id at all, so a later
      // "replace" patch addressing it by that id (e.g. a dialog's
      // content going from Component::none() while closed to the real
      // content once opened -- see TinoxUIRuntime.diff, which always
      // treats a visible/type change as a replace) could never find it
      // via findEl() and silently no-opped -- the dialog's box/title
      // would show (once the DIV-wipe bug above was fixed) but its
      // actual content never appeared. `node` is null for a couple of
      // call sites (this same function's own recursion has none that
      // pass null today, but the guard was already defensive for it),
      // hence the extra null check.
      var placeholder = document.createElement("span");
      if (node && node.id) {
        placeholder.setAttribute("data-tinox-id", node.id);
      }
      return placeholder;
    }
    var el;
    // Most widgets append their `children` directly into `el` itself --
    // a few (Dialog, AccordionSection) need children nested inside an
    // inner wrapper instead (the dialog's content box, an accordion
    // section's collapsible body), so a case can redirect the generic
    // children-append loop below by setting this.
    var childrenTarget = null;
    // Set by a widget that places every child itself (currently only
    // SplitLayout, which needs two SEPARATE targets, not one) -- stops the
    // shared children-append loop below from placing them a second time.
    var skipChildren = false;
    var props = node.props || {};
    switch (node.type) {
      case "Label":
        el = document.createElement("span");
        el.textContent = node.text;
        break;
      case "Button":
        el = document.createElement("button");
        el.textContent = node.text;
        el.addEventListener("click", function () { sendEvent(node.id, ""); });
        break;
      case "TextField":
        el = document.createElement("input");
        el.type = "text";
        el.value = props.value || "";
        el.addEventListener("change", function () { sendEvent(node.id, el.value); });
        break;
      case "TextArea":
        el = document.createElement("textarea");
        el.value = props.value || "";
        el.addEventListener("change", function () { sendEvent(node.id, el.value); });
        break;
      case "NumberField":
        el = document.createElement("input");
        el.type = "number";
        el.step = "any";
        el.value = props.value || "0";
        el.addEventListener("change", function () { sendEvent(node.id, el.value); });
        break;
      case "IntField":
        el = document.createElement("input");
        el.type = "number";
        el.step = "1";
        el.value = props.value || "0";
        el.addEventListener("change", function () { sendEvent(node.id, el.value); });
        break;
      case "Checkbox":
        el = document.createElement("input");
        el.type = "checkbox";
        el.checked = props.checked === "true";
        el.addEventListener("change", function () {
          sendEvent(node.id, el.checked ? "true" : "false");
        });
        break;
      case "Select":
        el = document.createElement("select");
        var opts = (props.options || "").split("|").filter(function (s) { return s.length > 0; });
        for (var oi = 0; oi < opts.length; oi++) {
          var optEl = document.createElement("option");
          optEl.value = opts[oi];
          optEl.textContent = opts[oi];
          if (opts[oi] === props.selected) optEl.selected = true;
          el.appendChild(optEl);
        }
        el.addEventListener("change", function () { sendEvent(node.id, el.value); });
        break;
      case "Heading":
        var lvl = Math.max(1, Math.min(6, parseInt(props.level, 10) || 1));
        el = document.createElement("h" + lvl);
        el.textContent = node.text;
        break;
      case "Image":
        el = document.createElement("img");
        el.src = props.src || "";
        el.alt = props.alt || "";
        break;
      case "Spacer":
        el = document.createElement("div");
        el.style.flex = "1 1 auto";
        break;
      case "ProgressBar":
        el = document.createElement("progress");
        el.max = 100;
        el.value = parseFloat(props.value) || 0;
        break;
      case "Link":
        el = document.createElement("a");
        el.textContent = node.text;
        el.href = props.href || '#';
        el.addEventListener("click", function (ev) {
          ev.preventDefault();
          var href = ev.currentTarget.getAttribute("href");
          history.pushState(null, "", href);
          sendEvent(node.id, href);
        });
        break;
      case "VBox":
        el = document.createElement("div");
        el.style.display = "flex";
        el.style.flexDirection = "column";
        el.style.gap = "0.5rem";
        break;
      case "HBox":
        el = document.createElement("div");
        el.style.display = "flex";
        el.style.flexDirection = "row";
        el.style.gap = "0.5rem";
        break;
      case "Html":
        el = document.createElement("div");
        el.className = "tinox-html";
        el.innerHTML = node.text;
        // <script> tags set via innerHTML are inert -- a standard DOM
        // safety behavior, not a bug in this code -- so a naive
        // Component::html(...) embedding a <script> (e.g. a polling
        // timer, or a third-party widget's init code) would silently
        // never run. Re-create each one as a real script element (which
        // browsers DO execute when inserted via createElement+
        // appendChild/replaceChild) so Component::html's own docs
        // ("renders arbitrary markup") actually cover embedded scripts
        // too, not just static markup. Copies attributes too (src, type,
        // ...), not just inline text content, so an externally-sourced
        // <script src="..."> embedded this way also loads correctly.
        var embeddedScripts = el.querySelectorAll("script");
        for (var esi = 0; esi < embeddedScripts.length; esi++) {
          var oldScript = embeddedScripts[esi];
          var newScript = document.createElement("script");
          for (var eai = 0; eai < oldScript.attributes.length; eai++) {
            newScript.setAttribute(oldScript.attributes[eai].name, oldScript.attributes[eai].value);
          }
          newScript.textContent = oldScript.textContent;
          oldScript.parentNode.replaceChild(newScript, oldScript);
        }
        break;
      case "JsComponent":
        // Vaadin-@Tag/@JsModule equivalent -- see Component::jsComponent's
        // own doc comment (Component.tnx) for the server-side contract.
        // `node.text` is the tag name; every prop except the reserved
        // "__tinoxModule"/"style" keys becomes a real HTML attribute, so
        // the module's own standard observedAttributes/
        // attributeChangedCallback is how it reacts -- nothing
        // Tinox-specific for it to implement beyond that. "style" is left
        // to the shared trailing block below (same as every other widget
        // case), not applied here.
        el = document.createElement(node.text);
        for (var jck in props) {
          if (props.hasOwnProperty(jck) && jck !== "__tinoxModule" && jck !== "style") {
            el.setAttribute(jck, props[jck]);
          }
        }
        // Bridges the loaded module's own element back to this
        // connection's real event pipe -- the per-instance counterpart to
        // window.tinoxSendEvent (exposed globally further down for
        // Component::html()-embedded scripts): a JsComponent widget
        // behaves like a real DOM element with its own method, not a
        // global.
        el.tinoxSendEvent = function (value) { sendEvent(node.id, value); };
        // Dynamic import() is idempotent per resolved URL (the browser's
        // own ES module cache) -- safe to call again on every build(),
        // including once per additional instance of the same widget on
        // one page. The module is expected to
        // customElements.define(tag, ...) itself; until that resolves,
        // the browser just treats this as a plain, un-upgraded element --
        // standard Custom Elements behavior, not an error state.
        var jsModuleUrl = props.__tinoxModule;
        if (jsModuleUrl) {
          var resolvedModuleUrl = resolveCrossPortUrl(jsModuleUrl);
          import(resolvedModuleUrl).catch(function (e) {
            console.error("tinox-ui: failed to load JsComponent module", resolvedModuleUrl, e);
          });
        }
        break;
      case "DatePicker":
        el = document.createElement("input");
        el.type = "date";
        el.value = props.value || "";
        el.addEventListener("change", function () { sendEvent(node.id, el.value); });
        break;
      case "RadioGroup":
        el = document.createElement("div");
        el.className = "tinox-radio-group";
        var ropts = (props.options || "").split("|").filter(function (s) { return s.length > 0; });
        for (var roi = 0; roi < ropts.length; roi++) {
          (function (optVal) {
            var label = document.createElement("label");
            var radio = document.createElement("input");
            radio.type = "radio";
            radio.name = node.id;
            radio.value = optVal;
            radio.checked = optVal === props.selected;
            radio.addEventListener("change", function () { sendEvent(node.id, optVal); });
            label.appendChild(radio);
            label.appendChild(document.createTextNode(optVal));
            el.appendChild(label);
          })(ropts[roi]);
        }
        break;
      // --- Phase 6 (Vaadin-comparison gap-fill) additions ---
      case "PasswordField":
        el = document.createElement("input");
        el.type = "password";
        el.value = props.value || "";
        el.addEventListener("change", function () { sendEvent(node.id, el.value); });
        break;
      case "EmailField":
        el = document.createElement("input");
        el.type = "email";
        el.value = props.value || "";
        el.addEventListener("change", function () { sendEvent(node.id, el.value); });
        break;
      case "TimePicker":
        el = document.createElement("input");
        el.type = "time";
        el.value = props.value || "";
        el.addEventListener("change", function () { sendEvent(node.id, el.value); });
        break;
      case "DateTimePicker":
        el = document.createElement("input");
        el.type = "datetime-local";
        el.value = props.value || "";
        el.addEventListener("change", function () { sendEvent(node.id, el.value); });
        break;
      case "Slider":
        el = document.createElement("input");
        el.type = "range";
        el.min = props.min || "0";
        el.max = props.max || "100";
        el.step = "any";
        el.value = props.value || "0";
        // "input" (not "change"), same live-feedback-while-dragging
        // convention every real slider UI uses -- see Component::slider's
        // own doc comment.
        el.addEventListener("input", function () { sendEvent(node.id, el.value); });
        break;
      case "ComboBox":
        // Native <input list="..."> + <datalist> -- the browser itself
        // filters the suggestion list as the user types, no custom
        // filtering JS needed. A free-text value not in `options` is still
        // reported as-is, same as a plain TextField.
        el = document.createElement("div");
        el.className = "tinox-combobox";
        var cbInput = document.createElement("input");
        cbInput.type = "text";
        cbInput.value = props.value || "";
        var cbListId = "tinox-dl-" + node.id;
        cbInput.setAttribute("list", cbListId);
        var cbList = document.createElement("datalist");
        cbList.id = cbListId;
        var cbOpts = (props.options || "").split("|").filter(function (s) { return s.length > 0; });
        for (var cbi = 0; cbi < cbOpts.length; cbi++) {
          var cbOptEl = document.createElement("option");
          cbOptEl.value = cbOpts[cbi];
          cbList.appendChild(cbOptEl);
        }
        cbInput.addEventListener("change", function () { sendEvent(node.id, cbInput.value); });
        el.appendChild(cbInput);
        el.appendChild(cbList);
        break;
      case "CheckboxGroup":
        el = document.createElement("div");
        el.className = "tinox-checkbox-group";
        var cgOpts = (props.options || "").split("|").filter(function (s) { return s.length > 0; });
        var cgSelected = (props.selected || "").split("|").filter(function (s) { return s.length > 0; });
        for (var cgi = 0; cgi < cgOpts.length; cgi++) {
          (function (optVal) {
            var cgLabel = document.createElement("label");
            var cgBox = document.createElement("input");
            cgBox.type = "checkbox";
            cgBox.value = optVal;
            cgBox.checked = cgSelected.indexOf(optVal) !== -1;
            cgBox.addEventListener("change", function () {
              var boxes = el.querySelectorAll("input[type=checkbox]");
              var newSelected = [];
              for (var bi = 0; bi < boxes.length; bi++) {
                if (boxes[bi].checked) newSelected.push(boxes[bi].value);
              }
              sendEvent(node.id, newSelected.join("|"));
            });
            cgLabel.appendChild(cgBox);
            cgLabel.appendChild(document.createTextNode(optVal));
            el.appendChild(cgLabel);
          })(cgOpts[cgi]);
        }
        break;
      case "SplitLayout":
        // Two children rendered into two separate panes -- the generic
        // single-childrenTarget mechanism every other multi-child widget
        // uses doesn't fit (there's no ONE target to redirect into), so
        // this case builds both children itself and sets `skipChildren`
        // to stop the shared loop below from placing them a second time.
        // Dragging is entirely client-side (see Component::splitLayout's
        // own doc comment on why the split position is never reported
        // back to the server).
        el = document.createElement("div");
        el.className = "tinox-split";
        var splitPct = parseFloat(props.split) || 50;
        var paneA = document.createElement("div");
        paneA.className = "tinox-split-pane";
        paneA.style.flexBasis = splitPct + "%";
        var splitDivider = document.createElement("div");
        splitDivider.className = "tinox-split-divider";
        var paneB = document.createElement("div");
        paneB.className = "tinox-split-pane";
        paneB.style.flexBasis = (100 - splitPct) + "%";
        var splitChildren = node.children || [];
        if (splitChildren[0]) paneA.appendChild(build(splitChildren[0]));
        if (splitChildren[1]) paneB.appendChild(build(splitChildren[1]));
        el.appendChild(paneA);
        el.appendChild(splitDivider);
        el.appendChild(paneB);
        (function () {
          var dragging = false;
          splitDivider.addEventListener("mousedown", function (ev) { dragging = true; ev.preventDefault(); });
          window.addEventListener("mousemove", function (ev) {
            if (!dragging) return;
            var rect = el.getBoundingClientRect();
            var pct = Math.max(10, Math.min(90, ((ev.clientX - rect.left) / rect.width) * 100));
            paneA.style.flexBasis = pct + "%";
            paneB.style.flexBasis = (100 - pct) + "%";
          });
          window.addEventListener("mouseup", function () { dragging = false; });
        })();
        skipChildren = true;
        break;
      case "MenuBar":
        // Each `menus` entry is "Label:Sub1,Sub2,Sub3" -- see
        // Component::menuBar's own doc comment. A document-level click
        // listener closes any open dropdown when clicking outside this
        // menu bar instance.
        el = document.createElement("div");
        el.className = "tinox-menubar";
        var menuEntries = (props.menus || "").split("|").filter(function (s) { return s.length > 0; });
        for (var mi = 0; mi < menuEntries.length; mi++) {
          (function (entry) {
            var entryParts = entry.split(":");
            var topLabel = entryParts[0];
            var subLabels = (entryParts[1] || "").split(",").filter(function (s) { return s.length > 0; });
            var menuItemEl = document.createElement("div");
            menuItemEl.className = "tinox-menubar-item";
            var menuTop = document.createElement("div");
            menuTop.className = "tinox-menubar-top";
            menuTop.textContent = topLabel;
            var menuDropdown = document.createElement("div");
            menuDropdown.className = "tinox-menubar-dropdown";
            menuDropdown.style.display = "none";
            for (var si = 0; si < subLabels.length; si++) {
              (function (subLabel) {
                var subEl = document.createElement("div");
                subEl.className = "tinox-menubar-sub";
                subEl.textContent = subLabel;
                subEl.addEventListener("click", function () {
                  menuDropdown.style.display = "none";
                  sendEvent(node.id, topLabel + ":" + subLabel);
                });
                menuDropdown.appendChild(subEl);
              })(subLabels[si]);
            }
            menuTop.addEventListener("click", function () {
              var isOpen = menuDropdown.style.display !== "none";
              var allDropdowns = el.querySelectorAll(".tinox-menubar-dropdown");
              for (var di = 0; di < allDropdowns.length; di++) allDropdowns[di].style.display = "none";
              menuDropdown.style.display = isOpen ? "none" : "";
            });
            menuItemEl.appendChild(menuTop);
            menuItemEl.appendChild(menuDropdown);
            el.appendChild(menuItemEl);
          })(menuEntries[mi]);
        }
        document.addEventListener("click", function (ev) {
          if (!el.contains(ev.target)) {
            var openDropdowns = el.querySelectorAll(".tinox-menubar-dropdown");
            for (var odi = 0; odi < openDropdowns.length; odi++) openDropdowns[odi].style.display = "none";
          }
        });
        break;
      case "FileUpload":
        // v2: real content transfer (base64 POSTed to props.uploadUrl,
        // resolved via resolveCrossPortUrl -- see Component::fileUpload's
        // own doc comment for why base64-over-text rather than raw bytes)
        // plus an optional inline percent+ETA readout driven by the
        // browser's real xhr.upload.onprogress events. uploadUrl === ""
        // keeps v1's exact old behavior: report the picked name, no
        // network transfer at all.
        //
        // uploadUrl/showProgress live on `el` itself (tinoxUploadUrl/
        // tinoxShowProgress), not captured in the "change" listener's
        // closure: a props-only change (the common case for a checkbox
        // toggling showProgress, say) is an "update" patch, which reuses
        // this SAME element and never re-runs this build() case (see
        // applyUpdate's own "tinox-fileupload" branch, which is the one
        // thing that keeps these fields in sync afterwards) -- a closure
        // captured here would go stale the moment that happens.
        el = document.createElement("div");
        el.className = "tinox-fileupload";
        el.tinoxUploadUrl = props.uploadUrl || "";
        el.tinoxShowProgress = props.showProgress === "true";
        var fuInput = document.createElement("input");
        fuInput.type = "file";
        el.appendChild(fuInput);
        ensureFileUploadProgressRow(el);
        fuInput.addEventListener("change", function () {
          var file = fuInput.files && fuInput.files[0];
          sendEvent(node.id, file ? file.name : "");
          if (!file || !el.tinoxUploadUrl) return;
          // Guarded by tinoxShowProgress, not just the row's existence: a
          // row created while showProgress was once true is kept (not
          // destroyed) across a later toggle-off (see applyUpdate's own
          // "tinox-fileupload" branch), so its mere presence doesn't mean
          // the user wants it shown for THIS upload.
          var fuActive = el.tinoxShowProgress && el.tinoxProgressRow;
          var fuBar = fuActive ? el.tinoxProgressRow.tinoxBar : null;
          var fuText = fuActive ? el.tinoxProgressRow.tinoxText : null;
          if (fuActive) {
            el.tinoxProgressRow.hidden = false;
            fuBar.value = 0;
            fuText.textContent = "0%";
          }
          uploadFileInChunks(file, el.tinoxUploadUrl, fuBar, fuText);
        });
        break;
      case "Tabs":
        el = document.createElement("div");
        el.className = "tinox-tabs";
        var tabHeader = document.createElement("div");
        tabHeader.className = "tinox-tabs-header";
        var tabLabels = (props.labels || "").split("|").filter(function (s) { return s.length > 0; });
        var activeIdx = parseInt(props.active, 10) || 0;
        for (var ti = 0; ti < tabLabels.length; ti++) {
          (function (idx, label) {
            var tabBtn = document.createElement("div");
            tabBtn.className = "tinox-tab" + (idx === activeIdx ? " tinox-tab-active" : "");
            tabBtn.textContent = label;
            tabBtn.addEventListener("click", function () { sendEvent(node.id, String(idx)); });
            tabHeader.appendChild(tabBtn);
          })(ti, tabLabels[ti]);
        }
        el.appendChild(tabHeader);
        break;
      case "Dialog":
        el = document.createElement("div");
        el.className = "tinox-dialog-backdrop";
        el.style.display = props.open === "true" ? "" : "none";
        var dialogBox = document.createElement("div");
        dialogBox.className = "tinox-dialog-box";
        var dialogTitle = document.createElement("div");
        dialogTitle.className = "tinox-dialog-title";
        dialogTitle.textContent = props.title || "";
        var dialogClose = document.createElement("button");
        dialogClose.type = "button";
        dialogClose.className = "tinox-dialog-close";
        dialogClose.textContent = "×";
        dialogClose.addEventListener("click", function () { sendEvent(node.id, ""); });
        dialogTitle.appendChild(dialogClose);
        dialogBox.appendChild(dialogTitle);
        el.addEventListener("click", function (ev) {
          if (ev.target === el) sendEvent(node.id, "");
        });
        el.appendChild(dialogBox);
        childrenTarget = dialogBox;
        break;
      case "Notification":
        el = document.createElement("div");
        el.className = "tinox-notification tinox-notification-" + (props.kind || "info");
        el.textContent = node.text;
        break;
      case "Accordion":
        el = document.createElement("div");
        el.className = "tinox-accordion";
        break;
      case "AccordionSection":
        el = document.createElement("div");
        el.className = "tinox-accordion-section";
        var accHeader = document.createElement("div");
        accHeader.className = "tinox-accordion-header";
        accHeader.textContent = props.header || "";
        var accBody = document.createElement("div");
        accBody.className = "tinox-accordion-body";
        accBody.style.display = props.expanded === "true" ? "" : "none";
        accHeader.addEventListener("click", function () {
          accBody.style.display = accBody.style.display === "none" ? "" : "none";
        });
        el.appendChild(accHeader);
        el.appendChild(accBody);
        childrenTarget = accBody;
        break;
      case "DataGrid":
        // Wrapper (not the <table> itself) is the returned `el` so a
        // toolbar (the column-visibility "⋮" menu) can sit above the
        // table without living inside any <th>/<td> -- those get their
        // textContent wholesale-reassigned by applyUpdate's TH/TD case on
        // every server-side text patch, which would silently wipe any DOM
        // we injected directly into a header cell. `childrenTarget` (the
        // generic per-child append loop further down already supports
        // redirecting it, same mechanism Dialog/AccordionSection use)
        // routes GridRow children into the real <table>, not the wrapper.
        el = document.createElement("div");
        el.className = "tinox-datagrid-wrap";
        var gridToolbar = document.createElement("div");
        gridToolbar.className = "tinox-datagrid-toolbar";
        var gridMenuBtn = document.createElement("button");
        gridMenuBtn.type = "button";
        gridMenuBtn.className = "tinox-datagrid-menu-btn";
        gridMenuBtn.textContent = "⋮";
        gridMenuBtn.setAttribute("aria-label", "Choose visible columns");
        var gridMenuPanel = document.createElement("div");
        gridMenuPanel.className = "tinox-datagrid-menu-panel";
        gridMenuPanel.hidden = true;
        gridMenuBtn.addEventListener("click", function (ev) {
          ev.stopPropagation();
          gridMenuPanel.hidden = !gridMenuPanel.hidden;
        });
        gridMenuPanel.addEventListener("click", function (ev) { ev.stopPropagation(); });
        document.addEventListener("click", function () { gridMenuPanel.hidden = true; });
        gridToolbar.appendChild(gridMenuBtn);
        gridToolbar.appendChild(gridMenuPanel);
        var gridTable = document.createElement("table");
        gridTable.className = "tinox-datagrid";
        el.appendChild(gridToolbar);
        el.appendChild(gridTable);
        el.tinoxGridTable = gridTable;
        el.tinoxGridMenuPanel = gridMenuPanel;
        childrenTarget = gridTable;
        break;
      case "GridRow":
        el = document.createElement("tr");
        break;
      case "GridCell":
        el = document.createElement(props.header === "true" ? "th" : "td");
        el.textContent = node.text;
        break;
      default:
        el = document.createElement("div");
    }
    el.setAttribute("data-tinox-id", node.id);
    if (props.style) {
      el.setAttribute("style", (el.getAttribute("style") || "") + ";" + props.style);
    }
    if (props.tooltip) {
      el.title = props.tooltip;
    }
    if (!skipChildren) {
      var appendTarget = childrenTarget || el;
      var children = node.children || [];
      for (var i = 0; i < children.length; i++) {
        appendTarget.appendChild(build(children[i]));
      }
    }
    if (node.type === "DataGrid" && el.tinoxGridTable) {
      setupDataGrid(el.tinoxGridTable, el.tinoxGridMenuPanel);
    }
    return el;
  }

  // Client-only DataGrid behavior (sorting, column show/hide) layered on
  // top of the already-rendered table -- DataGrid::of's own Component
  // tree (DataGrid.tnx/GridColumn.tnx) has no notion of "sorted" or
  // "hidden" state, this is pure display behavior, same spirit as
  // Tabs/Accordion's own client-side-only expand/collapse. Column
  // identity is purely positional (a header/body cell's index within its
  // row), matching DataGrid's own "no stable per-item key" v1 scope note.
  //
  // Runs once per <table> (guarded by data-tinox-grid-ready) the first
  // time it's built -- since issue #225, unchanged rows/cells are reused
  // across server-side re-renders (an "update" patch op only ever touches
  // textContent/style on the SAME element, never className or DOM
  // position), so sort order and hidden-column state normally survive
  // ordinary interactions elsewhere on the page. The one gap: a row or
  // column that's genuinely NEW (the underlying items list grew, or the
  // caller changed its GridColumn list) arrives via a fresh build() call
  // and won't inherit the current sort/hidden state until the user
  // re-applies it -- acceptable v1 scope, not silently wrong data (every
  // cell's actual value is always correct, only the sort/visibility
  // convenience can lag).
  function setupDataGrid(table, menuPanel) {
    if (table.dataset.tinoxGridReady === "1") return;
    table.dataset.tinoxGridReady = "1";
    var headerRow = table.rows[0];
    if (!headerRow) return;
    var headerCells = Array.prototype.slice.call(headerRow.cells);
    var sortCol = -1;
    var sortDir = 1;

    function bodyRows() {
      return Array.prototype.slice.call(table.rows).slice(1);
    }

    headerCells.forEach(function (th, colIdx) {
      th.addEventListener("click", function () {
        sortDir = sortCol === colIdx ? -sortDir : 1;
        sortCol = colIdx;
        headerCells.forEach(function (h) { h.classList.remove("tinox-sort-asc", "tinox-sort-desc"); });
        th.classList.add(sortDir === 1 ? "tinox-sort-asc" : "tinox-sort-desc");
        var rows = bodyRows();
        rows.sort(function (a, b) {
          var av = a.cells[colIdx] ? a.cells[colIdx].textContent.trim() : "";
          var bv = b.cells[colIdx] ? b.cells[colIdx].textContent.trim() : "";
          var an = parseFloat(av);
          var bn = parseFloat(bv);
          var cmp = (av !== "" && bv !== "" && !isNaN(an) && !isNaN(bn))
            ? (an - bn)
            : av.localeCompare(bv, undefined, { numeric: true, sensitivity: "base" });
          return cmp * sortDir;
        });
        // appendChild on an already-attached row MOVES it -- the header
        // (never re-appended here) stays first, and re-appending every
        // body row in sorted order re-establishes the full sequence
        // after it. Doesn't touch any element's data-tinox-id/className,
        // so later id-addressed patches (findEl) still resolve correctly
        // regardless of this reordering.
        rows.forEach(function (r) { table.appendChild(r); });
      });

      if (!menuPanel) return;
      var item = document.createElement("label");
      item.className = "tinox-datagrid-menu-item";
      var cb = document.createElement("input");
      cb.type = "checkbox";
      cb.checked = true;
      cb.addEventListener("change", function () {
        // A CSS class (not inline style) survives applyUpdate's TH/TD
        // case -- that only ever reassigns textContent -- AND its own
        // trailing `el.setAttribute("style", props.style || "")`, which
        // would otherwise clobber an inline `display:none` the next time
        // that specific cell's text/props happen to get patched.
        bodyRows().concat([headerRow]).forEach(function (r) {
          var cell = r.cells[colIdx];
          if (cell) cell.classList.toggle("tinox-col-hidden", !cb.checked);
        });
      });
      item.appendChild(cb);
      item.appendChild(document.createTextNode(th.textContent || ("Column " + (colIdx + 1))));
      menuPanel.appendChild(item);
    });
  }

  connect();
})();
"#;
        }
    }
}

module tinox.core.ui;

namespace tinox.core.ui
{
    // The two static assets every Tinox-UI app needs to serve over plain
    // HTTP: a minimal shell page (one mount `<div>`, nothing else) and
    // the generic client runtime (~130 lines, hand-written -- see the
    // module's own docs for why this is deliberately NOT generated from
    // Tinox: it's the one piece of the whole framework that has to run
    // as real client-side JS, same as Vaadin's/Phoenix LiveView's own
    // client isn't Java/Elixir either).
    //
    // Baked in as string constants (not read from disk via Fs::readFile)
    // so a compiled app never has a "forgot to ship ui.js next to the
    // binary" deployment footgun.
    class Assets
    {
        // wsUrl: the full "ws://host:port/path" the client should connect
        // to -- substituted in verbatim (no templating engine needed for
        // one placeholder). Callers are responsible for the value being
        // safe to embed in a `<script>` block (a compile-time constant
        // the app itself controls, not untrusted input).
        fnc shellHtml(wsUrl: String) -> String
        {
            let template: String = Assets::shellHtmlTemplate();
            return template.replace("__TINOX_UI_WS_URL__", wsUrl);
        }

        // Design tokens (dark, glassy, cyan/purple neon-accented) ported
        // from tinox-central's own registry-frontend theme
        // (registry-frontend/src/main/frontend/themes/tinox-central/
        // styles.css in the tinox-central repo) -- same color values,
        // gradients and fonts, just targeting plain HTML elements
        // (button/input/table/...) instead of Vaadin web components,
        // since ui.js renders plain DOM, not Vaadin. Every Tinox-UI app
        // gets this by default (no opt-in) -- an app that wants its own
        // look can still override via Component::withStyle's inline
        // style hook, or by not using this shell template at all
        // (Assets::clientJs() works standalone against any HTML page
        // with a `#tinox-ui-root` element).
        fnc shellHtmlTemplate() -> String
        {
            return r#"<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Tinox-UI</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --tinox-base: #070b14;
    --tinox-text: #e2e8f0;
    --tinox-text2: #93a4bd;
    --tinox-primary: #22d3ee;
    --tinox-primary-10: rgba(34, 211, 238, 0.12);
    --tinox-primary-text: #67e8f9;
    --tinox-primary-contrast: #041018;
    --tinox-accent-2: #a78bfa;
    --tinox-error: #fb7185;
    --tinox-success: #34d399;
    --tinox-glass: rgba(17, 25, 43, 0.6);
    --tinox-glass-border: rgba(103, 232, 249, 0.16);
    --tinox-font: 'Inter', ui-sans-serif, system-ui, sans-serif;
    --tinox-font-display: 'Space Grotesk', 'JetBrains Mono', var(--tinox-font);
    --tinox-font-mono: 'JetBrains Mono', ui-monospace, monospace;
    --tinox-radius-m: 10px;
    --tinox-radius-l: 16px;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    font-family: var(--tinox-font);
    color: var(--tinox-text);
    background:
      radial-gradient(60rem 32rem at 12% -10%, rgba(34, 211, 238, 0.14), transparent 60%),
      radial-gradient(50rem 30rem at 110% 10%, rgba(167, 139, 250, 0.12), transparent 55%),
      linear-gradient(180deg, #05070d 0%, #070b14 40%, #060910 100%);
    background-attachment: fixed;
  }
  #tinox-ui-root {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 48rem;
    margin: 0 auto;
    padding: 2.5rem clamp(1.25rem, 4vw, 3rem);
  }
  h1, h2, h3, h4, h5, h6 {
    margin: 0.4rem 0;
    font-family: var(--tinox-font-display);
    font-weight: 700;
    letter-spacing: 0.01em;
    background: linear-gradient(120deg, #f8fafc 0%, #67e8f9 55%, #a78bfa 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  a {
    color: var(--tinox-primary-text);
    text-decoration: none;
    font-weight: 500;
  }
  button {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 1px solid rgba(103, 232, 249, 0.28);
    background: rgba(34, 211, 238, 0.06);
    color: var(--tinox-primary-text);
    font-family: var(--tinox-font);
    font-weight: 500;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  button:hover {
    background: rgba(34, 211, 238, 0.16);
    border-color: var(--tinox-primary);
    box-shadow: 0 0 16px -2px rgba(34, 211, 238, 0.55);
  }
  input, textarea, select {
    font-family: var(--tinox-font);
    color: var(--tinox-text);
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid var(--tinox-glass-border);
    border-radius: var(--tinox-radius-m);
    padding: 0.5rem 0.7rem;
    font-size: 0.9rem;
  }
  input:focus, textarea:focus, select:focus {
    outline: none;
    border-color: var(--tinox-primary);
    box-shadow: 0 0 0 3px var(--tinox-primary-10);
  }
  a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    border: 1px solid rgba(103, 232, 249, 0.28);
    background: rgba(34, 211, 238, 0.06);
    transition: background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  a:hover {
    background: rgba(34, 211, 238, 0.16);
    border-color: var(--tinox-primary);
    box-shadow: 0 0 16px -2px rgba(34, 211, 238, 0.55);
  }
  progress {
    width: 100%;
    height: 0.6rem;
    border-radius: 999px;
    overflow: hidden;
    border: none;
    background: rgba(148, 163, 184, 0.14);
  }
  progress::-webkit-progress-bar { background: rgba(148, 163, 184, 0.14); }
  progress::-webkit-progress-value { background: var(--tinox-primary); }
  progress::-moz-progress-bar { background: var(--tinox-primary); }
  table.tinox-datagrid {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--tinox-font);
    background: var(--tinox-glass);
    border: 1px solid var(--tinox-glass-border);
    border-radius: var(--tinox-radius-l);
    overflow: hidden;
  }
  table.tinox-datagrid th {
    background: rgba(34, 211, 238, 0.05);
    color: var(--tinox-primary-text);
    text-transform: uppercase;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-align: left;
    padding: 0.6rem 0.8rem;
    border-bottom: 1px solid rgba(103, 232, 249, 0.2);
  }
  table.tinox-datagrid td {
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid rgba(148, 163, 184, 0.07);
  }
  table.tinox-datagrid tr:hover td { background: rgba(34, 211, 238, 0.055); }
  .tinox-radio-group { display: flex; flex-direction: column; gap: 0.4rem; }
  .tinox-radio-group label { display: flex; align-items: center; gap: 0.4rem; font-size: 0.9rem; }
  .tinox-tabs-header { display: flex; gap: 0.4rem; border-bottom: 1px solid var(--tinox-glass-border); padding-bottom: 0.5rem; margin-bottom: 0.75rem; }
  .tinox-tab { padding: 0.35rem 0.9rem; border-radius: 999px; cursor: pointer; color: var(--tinox-text2); font-size: 0.85rem; }
  .tinox-tab:hover { color: var(--tinox-text); }
  .tinox-tab-active { background: var(--tinox-primary-10); color: var(--tinox-primary-text); font-weight: 600; }
  .tinox-dialog-backdrop {
    position: fixed; inset: 0; z-index: 100;
    display: flex; align-items: center; justify-content: center;
    background: rgba(5, 7, 13, 0.65);
  }
  .tinox-dialog-box {
    background: var(--tinox-glass);
    border: 1px solid var(--tinox-glass-border);
    border-radius: var(--tinox-radius-l);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    padding: 1.25rem;
    min-width: 20rem;
    max-width: 90vw;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .tinox-dialog-title {
    display: flex; align-items: center; justify-content: space-between;
    font-family: var(--tinox-font-display); font-weight: 700; font-size: 1.1rem; color: var(--tinox-text);
  }
  .tinox-dialog-close { padding: 0.1rem 0.5rem; border-radius: 999px; min-width: unset; }
  .tinox-notification {
    padding: 0.6rem 1rem;
    border-radius: var(--tinox-radius-m);
    background: var(--tinox-glass);
    border: 1px solid var(--tinox-glass-border);
    font-size: 0.9rem;
  }
  .tinox-notification-success { border-color: rgba(52, 211, 153, 0.4); color: var(--tinox-success); }
  .tinox-notification-error { border-color: rgba(251, 113, 133, 0.4); color: var(--tinox-error); }
  .tinox-accordion { display: flex; flex-direction: column; gap: 0.5rem; }
  .tinox-accordion-section {
    background: var(--tinox-glass);
    border: 1px solid var(--tinox-glass-border);
    border-radius: var(--tinox-radius-m);
    overflow: hidden;
  }
  .tinox-accordion-header { padding: 0.6rem 0.9rem; cursor: pointer; font-weight: 600; color: var(--tinox-primary-text); }
  .tinox-accordion-body { padding: 0 0.9rem 0.75rem; }
</style>
</head>
<body>
<div id="tinox-ui-root"></div>
<script>window.TINOX_UI_WS_URL = "__TINOX_UI_WS_URL__";</script>
<script src="/ui.js"></script>
</body>
</html>
"#;
        }

        fnc clientJs() -> String
        {
            return r#"(function () {
  "use strict";
  var mount = document.getElementById("tinox-ui-root");
  var ws = null;
  var reconnectDelayMs = 500;
  var reconnectTimer = null;

  // Phase 6 (issue #215): a dropped connection retries with exponential
  // backoff (0.5s, 1s, 2s, ... capped at 10s, reset back to 0.5s once a
  // connection actually opens) instead of just stopping updates forever.
  // `data-tinox-ui-status` on the mount element ("connected"/
  // "reconnecting") lets an app's own CSS show a banner/spinner if it
  // wants one -- nothing renders one by default.
  //
  // A reconnect always starts a brand-new session: the server allocates a
  // fresh app instance per accepted WS connection (see
  // TinoxUIRuntime's/Component's own docs on why -- no static/global
  // state in Tinox to hold a session registry in), so whatever state the
  // dropped connection had (form input, click counts, ...) is gone, same
  // as a real page reload would lose it. This is a deliberate, documented
  // v1 scope limit, not an oversight -- a real session store surviving a
  // reconnect would need genuinely new server-side infrastructure
  // (a session-id-keyed instance registry with its own TTL/expiry, which
  // Tinox's current "no global mutable state" design has nowhere to put)
  // disproportionate to what reconnect resilience alone needs.
  function connect() {
    ws = new WebSocket(window.TINOX_UI_WS_URL);
    ws.onopen = function () {
      reconnectDelayMs = 500;
      mount.setAttribute("data-tinox-ui-status", "connected");
    };
    ws.onmessage = function (ev) {
      var msg = JSON.parse(ev.data);
      if (msg.kind === "init" || msg.kind === "update") {
        mount.replaceChildren(build(msg.root));
      } else if (msg.kind === "patch") {
        applyPatch(msg.ops);
      }
    };
    ws.onclose = function () {
      mount.setAttribute("data-tinox-ui-status", "reconnecting");
      if (reconnectTimer) clearTimeout(reconnectTimer);
      reconnectTimer = setTimeout(function () {
        reconnectDelayMs = Math.min(reconnectDelayMs * 2, 10000);
        connect();
      }, reconnectDelayMs);
    };
    ws.onerror = function () {
      // onclose always fires after onerror for a WebSocket -- no separate
      // reconnect scheduling needed here, just make sure the socket is
      // actually closed rather than left half-open.
      ws.close();
    };
  }

  function findEl(id) {
    return mount.querySelector('[data-tinox-id="' + id + '"]');
  }

  // Applies a Phase-3 diff patch (TinoxUIRuntime.diff's op list) without
  // rebuilding the whole subtree -- an "update" op re-applies text/props
  // onto the SAME DOM element in place (so focus/scroll/typed-but-not-yet-
  // committed input state on it survives), "replace"/"remove"/"insert"
  // still (re)build via build() for the affected node only.
  function applyPatch(ops) {
    for (var i = 0; i < ops.length; i++) {
      var op = ops[i];
      if (op.op === "update") {
        var el = findEl(op.id);
        if (el) applyUpdate(el, op);
      } else if (op.op === "replace") {
        var old = findEl(op.id);
        if (old && old.parentNode) {
          old.parentNode.replaceChild(build(op.node), old);
        }
      } else if (op.op === "remove") {
        var toRemove = findEl(op.id);
        if (toRemove && toRemove.parentNode) {
          toRemove.parentNode.removeChild(toRemove);
        }
      } else if (op.op === "insert") {
        var parent = findEl(op.parentId);
        if (!parent) continue;
        var newEl = build(op.node);
        if (op.index >= parent.children.length) {
          parent.appendChild(newEl);
        } else {
          parent.insertBefore(newEl, parent.children[op.index]);
        }
      }
    }
  }

  // Mirrors build()'s own per-type text/prop application, WITHOUT
  // recreating the element or re-attaching its event listener -- the
  // existing listener (from when this element was first built) already
  // reads the live DOM value at event time (el.value/el.checked), not a
  // stale captured snapshot, and its target id doesn't change on an
  // "update" op, so it stays correct across repeated updates with no
  // rewiring needed.
  function applyUpdate(el, op) {
    var props = op.props || {};
    switch (el.tagName) {
      case "SPAN":
      case "BUTTON":
      case "A":
        el.textContent = op.text;
        if (el.tagName === "A" && props.href !== undefined) el.setAttribute("href", props.href);
        break;
      case "INPUT":
        if ((el.type === "text" || el.type === "number" || el.type === "date") && props.value !== undefined) el.value = props.value;
        if (el.type === "checkbox" && props.checked !== undefined) el.checked = props.checked === "true";
        break;
      case "TH": case "TD":
        el.textContent = op.text;
        break;
      case "DIV":
        // Notification is the one DIV-rendered leaf with real text to
        // patch here -- every other DIV-rendered type (RadioGroup, Tabs,
        // Dialog, Accordion, AccordionSection, FileUpload's container...)
        // is structural (its "content" is child elements it built itself
        // in build(), not a single text/innerHTML string) and isn't safe
        // to blindly overwrite with `op.text` the way the plain Html
        // widget's DIV already is below -- a props-only diff "update" on
        // one of those currently only re-applies `style` (see the bottom
        // of this function), same pre-existing gap this comment already
        // documented for any unlisted tag before this widget batch.
        if (el.className.indexOf("tinox-notification") === 0) {
          el.textContent = op.text;
        } else {
          el.innerHTML = op.text;
        }
        break;
      case "TEXTAREA":
        if (props.value !== undefined) el.value = props.value;
        break;
      case "SELECT":
        if (props.selected !== undefined) el.value = props.selected;
        break;
      case "PROGRESS":
        if (props.value !== undefined) el.value = parseFloat(props.value) || 0;
        break;
      case "IMG":
        if (props.src !== undefined) el.src = props.src;
        if (props.alt !== undefined) el.alt = props.alt;
        break;
      case "H1": case "H2": case "H3": case "H4": case "H5": case "H6":
        el.textContent = op.text;
        break;
    }
    el.setAttribute("style", props.style || "");
  }

  function sendEvent(id, value) {
    if (ws && ws.readyState === WebSocket.OPEN) {
      ws.send(JSON.stringify({ kind: "event", id: id, value: value }));
    }
  }

  // The one place that needs a matching entry whenever a new widget
  // `type` is added server-side (Component.tnx) -- documented as a real
  // two-sided contract in the module's own docs, the same way e.g. HTTP
  // status codes have to stay in sync across this project's own
  // HttpStatusHelper.
  function build(node) {
    if (!node || node.visible === false) {
      return document.createElement("span");
    }
    var el;
    // Most widgets append their `children` directly into `el` itself --
    // a few (Dialog, AccordionSection) need children nested inside an
    // inner wrapper instead (the dialog's content box, an accordion
    // section's collapsible body), so a case can redirect the generic
    // children-append loop below by setting this.
    var childrenTarget = null;
    var props = node.props || {};
    switch (node.type) {
      case "Label":
        el = document.createElement("span");
        el.textContent = node.text;
        break;
      case "Button":
        el = document.createElement("button");
        el.textContent = node.text;
        el.addEventListener("click", function () { sendEvent(node.id, ""); });
        break;
      case "TextField":
        el = document.createElement("input");
        el.type = "text";
        el.value = props.value || "";
        el.addEventListener("change", function () { sendEvent(node.id, el.value); });
        break;
      case "TextArea":
        el = document.createElement("textarea");
        el.value = props.value || "";
        el.addEventListener("change", function () { sendEvent(node.id, el.value); });
        break;
      case "NumberField":
        el = document.createElement("input");
        el.type = "number";
        el.step = "any";
        el.value = props.value || "0";
        el.addEventListener("change", function () { sendEvent(node.id, el.value); });
        break;
      case "IntField":
        el = document.createElement("input");
        el.type = "number";
        el.step = "1";
        el.value = props.value || "0";
        el.addEventListener("change", function () { sendEvent(node.id, el.value); });
        break;
      case "Checkbox":
        el = document.createElement("input");
        el.type = "checkbox";
        el.checked = props.checked === "true";
        el.addEventListener("change", function () {
          sendEvent(node.id, el.checked ? "true" : "false");
        });
        break;
      case "Select":
        el = document.createElement("select");
        var opts = (props.options || "").split("|").filter(function (s) { return s.length > 0; });
        for (var oi = 0; oi < opts.length; oi++) {
          var optEl = document.createElement("option");
          optEl.value = opts[oi];
          optEl.textContent = opts[oi];
          if (opts[oi] === props.selected) optEl.selected = true;
          el.appendChild(optEl);
        }
        el.addEventListener("change", function () { sendEvent(node.id, el.value); });
        break;
      case "Heading":
        var lvl = Math.max(1, Math.min(6, parseInt(props.level, 10) || 1));
        el = document.createElement("h" + lvl);
        el.textContent = node.text;
        break;
      case "Image":
        el = document.createElement("img");
        el.src = props.src || "";
        el.alt = props.alt || "";
        break;
      case "Spacer":
        el = document.createElement("div");
        el.style.flex = "1 1 auto";
        break;
      case "ProgressBar":
        el = document.createElement("progress");
        el.max = 100;
        el.value = parseFloat(props.value) || 0;
        break;
      case "Link":
        el = document.createElement("a");
        el.textContent = node.text;
        el.href = props.href || '#';
        el.addEventListener("click", function (ev) {
          ev.preventDefault();
          var href = ev.currentTarget.getAttribute("href");
          history.pushState(null, "", href);
          sendEvent(node.id, href);
        });
        break;
      case "VBox":
        el = document.createElement("div");
        el.style.display = "flex";
        el.style.flexDirection = "column";
        el.style.gap = "0.5rem";
        break;
      case "HBox":
        el = document.createElement("div");
        el.style.display = "flex";
        el.style.flexDirection = "row";
        el.style.gap = "0.5rem";
        break;
      case "Html":
        el = document.createElement("div");
        el.innerHTML = node.text;
        break;
      case "DatePicker":
        el = document.createElement("input");
        el.type = "date";
        el.value = props.value || "";
        el.addEventListener("change", function () { sendEvent(node.id, el.value); });
        break;
      case "RadioGroup":
        el = document.createElement("div");
        el.className = "tinox-radio-group";
        var ropts = (props.options || "").split("|").filter(function (s) { return s.length > 0; });
        for (var roi = 0; roi < ropts.length; roi++) {
          (function (optVal) {
            var label = document.createElement("label");
            var radio = document.createElement("input");
            radio.type = "radio";
            radio.name = node.id;
            radio.value = optVal;
            radio.checked = optVal === props.selected;
            radio.addEventListener("change", function () { sendEvent(node.id, optVal); });
            label.appendChild(radio);
            label.appendChild(document.createTextNode(optVal));
            el.appendChild(label);
          })(ropts[roi]);
        }
        break;
      case "FileUpload":
        // v1 reports only the picked file's NAME, not its content -- see
        // Component::fileUpload's own doc comment.
        el = document.createElement("input");
        el.type = "file";
        el.addEventListener("change", function () {
          sendEvent(node.id, el.files && el.files[0] ? el.files[0].name : "");
        });
        break;
      case "Tabs":
        el = document.createElement("div");
        el.className = "tinox-tabs";
        var tabHeader = document.createElement("div");
        tabHeader.className = "tinox-tabs-header";
        var tabLabels = (props.labels || "").split("|").filter(function (s) { return s.length > 0; });
        var activeIdx = parseInt(props.active, 10) || 0;
        for (var ti = 0; ti < tabLabels.length; ti++) {
          (function (idx, label) {
            var tabBtn = document.createElement("div");
            tabBtn.className = "tinox-tab" + (idx === activeIdx ? " tinox-tab-active" : "");
            tabBtn.textContent = label;
            tabBtn.addEventListener("click", function () { sendEvent(node.id, String(idx)); });
            tabHeader.appendChild(tabBtn);
          })(ti, tabLabels[ti]);
        }
        el.appendChild(tabHeader);
        break;
      case "Dialog":
        el = document.createElement("div");
        el.className = "tinox-dialog-backdrop";
        el.style.display = props.open === "true" ? "" : "none";
        var dialogBox = document.createElement("div");
        dialogBox.className = "tinox-dialog-box";
        var dialogTitle = document.createElement("div");
        dialogTitle.className = "tinox-dialog-title";
        dialogTitle.textContent = props.title || "";
        var dialogClose = document.createElement("button");
        dialogClose.type = "button";
        dialogClose.className = "tinox-dialog-close";
        dialogClose.textContent = "×";
        dialogClose.addEventListener("click", function () { sendEvent(node.id, ""); });
        dialogTitle.appendChild(dialogClose);
        dialogBox.appendChild(dialogTitle);
        el.addEventListener("click", function (ev) {
          if (ev.target === el) sendEvent(node.id, "");
        });
        el.appendChild(dialogBox);
        childrenTarget = dialogBox;
        break;
      case "Notification":
        el = document.createElement("div");
        el.className = "tinox-notification tinox-notification-" + (props.kind || "info");
        el.textContent = node.text;
        break;
      case "Accordion":
        el = document.createElement("div");
        el.className = "tinox-accordion";
        break;
      case "AccordionSection":
        el = document.createElement("div");
        el.className = "tinox-accordion-section";
        var accHeader = document.createElement("div");
        accHeader.className = "tinox-accordion-header";
        accHeader.textContent = props.header || "";
        var accBody = document.createElement("div");
        accBody.className = "tinox-accordion-body";
        accBody.style.display = props.expanded === "true" ? "" : "none";
        accHeader.addEventListener("click", function () {
          accBody.style.display = accBody.style.display === "none" ? "" : "none";
        });
        el.appendChild(accHeader);
        el.appendChild(accBody);
        childrenTarget = accBody;
        break;
      case "DataGrid":
        el = document.createElement("table");
        el.className = "tinox-datagrid";
        break;
      case "GridRow":
        el = document.createElement("tr");
        break;
      case "GridCell":
        el = document.createElement(props.header === "true" ? "th" : "td");
        el.textContent = node.text;
        break;
      default:
        el = document.createElement("div");
    }
    el.setAttribute("data-tinox-id", node.id);
    if (props.style) {
      el.setAttribute("style", (el.getAttribute("style") || "") + ";" + props.style);
    }
    var appendTarget = childrenTarget || el;
    var children = node.children || [];
    for (var i = 0; i < children.length; i++) {
      appendTarget.appendChild(build(children[i]));
    }
    return el;
  }

  connect();
})();
"#;
        }
    }
}

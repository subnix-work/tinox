module tinox.core.websocket;

/*
 * WebSocket server (RFC 6455) on top of the HTTP server's conn-handle
 * architecture.
 *
 * Bytes flow as List<Int64> (one byte 0..255 per slot) over the
 * binary-safe primitives httpConnReadN/httpConnWriteBytes — the
 * C-string-based paths (httpConnReadRequest/SendRaw) are used ONLY for
 * the textual handshake.
 *
 * Deliberate v1 gaps: no permessage-deflate. Fragmented messages
 * (continuation frames, RFC 6455 §5.4) are reassembled by
 * Ws::readMessage (issue #120); outgoing connections as a client are
 * covered by WsClient::connect (issue #121).
 *
 * Usage (echo server):
 *   let srv = WsServer::listen(8080);
 *   let conn = WsServer::accept(srv);        // includes the handshake, -1 on error
 *   while true {
 *       let f = Ws::readMessage(conn);        // ping/pong+close handled automatically
 *       if f.opcode != 1 { break; }           // 1 = text
 *       Ws::sendText(conn, Ws::text(f));
 *   }
 *   Ws::close(conn);
 */

namespace tinox.core.websocket
{
    /*
     * A frame that was read. opcode as per RFC 6455 (1 text, 2 binary,
     * 8 close, 9 ping, 10 pong); additionally as a read result:
     *   -1 = connection closed/EOF, -2 = protocol error (readMessage
     *   already responded to the connection with close).
     */
    class WsFrame
    {
        var fin: Bool;
        var opcode: Int64;
        var payload: List<Int64>;
        /*
         * RSV1 bit (RFC 7692 §7.2.1, issue #122): set on the FIRST frame
         * of a permessage-deflate-compressed message (never on
         * continuation frames, never on control frames). readFrameGeneric
         * only lets this be true when the connection actually negotiated
         * the extension (wsIsCompressed) — otherwise it's rejected as a
         * protocol error, same as any other unexpected RSV bit.
         */
        var rsv1: Bool;
    }
}

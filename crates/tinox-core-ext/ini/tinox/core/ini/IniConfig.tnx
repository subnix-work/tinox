module tinox.core.ini;

namespace tinox.core.ini
{
    class IniConfig
    {
        var sections: Map<String, Map<String, String>>;

        fn new() -> IniConfig
        {
            return IniConfig { sections: Map::new() };
        }

        fn getString(config: IniConfig, section: String, key: String, default: String) -> String
        {
            if config.sections.contains(section) == false
            {
                return default;
            }
            if config.sections[section].contains(key) == false
            {
                return default;
            }
            return config.sections[section][key];
        }

        fn getInt(config: IniConfig, section: String, key: String, default: Int64) -> Int64
        {
            let strVal: String = IniConfig::getString(config, section, key, "");
            if strVal == ""
            {
                return default;
            }
            return (Int64)strVal;
        }

        fn setString(config: IniConfig, section: String, key: String, value: String) -> Nothing
        {
            if config.sections.contains(section) == false
            {
                config.sections[section] = Map::new();
            }
            config.sections[section][key] = value;
        }
    }
}

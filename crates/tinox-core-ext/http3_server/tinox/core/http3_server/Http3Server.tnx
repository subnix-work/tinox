/**
 * Tinox Standard Library - HTTP/3 Server Module (RFC 9114, QUIC/RFC 9000)
 *
 * Unlike HttpServer (protocol parsed entirely in C) and Http2Server
 * (raw byte I/O in C, framing/HPACK hand-rolled in pure Tinox), this
 * module cannot push protocol logic into Tinox: QUIC transport (loss
 * recovery, congestion control, AEAD) and HTTP/3 framing + QPACK are
 * implemented by the ngtcp2/nghttp3 C libraries, whose callback-table
 * APIs cannot invoke back into a Tinox closure mid-callback. So ALL
 * QUIC/HTTP-3/QPACK state lives in runtime.c behind opaque Int64
 * handles (mirroring the existing TinoxConn pointer-cast convention);
 * this file only registers routes and pumps the native event loop,
 * then reuses HttpRequest/HttpResponse/HttpContext/Route/RouteMatcher
 * from tinox.core.http_server unmodified -- same fluent API shape as
 * HttpServer/Http2Server.
 *
 * TLS is mandatory (QUIC has no plaintext mode), so unlike HttpServer
 * there is no separate listen()/listenTls() split -- cert/key go
 * directly to the constructor.
 *
 * Requires the runtime to be built with TINOX_HTTP3=1 (opt-in, unlike
 * TINOX_TLS which defaults on -- ngtcp2/nghttp3 are far less
 * universally installed than OpenSSL, so defaulting this on would
 * break `tinox build` with a compile error on any system lacking them).
 */
module tinox.core.http3_server;

import tinox.core.http_server;

namespace tinox.core.http3_server
{
    extern fn http3ServerCreate(port: Int64, certPath: String, keyPath: String, requireRetry: Bool, earlyDataEnabled: Bool, maxEarlyDataSize: Int64) -> Int64;
    extern fn http3ServerPumpOnce(serverHandle: Int64) -> Int64;
    extern fn http3RequestMethod(requestId: Int64) -> String;
    extern fn http3RequestPath(requestId: Int64) -> String;
    extern fn http3RequestHeaders(requestId: Int64) -> Map<String, String>;
    extern fn http3RequestBody(requestId: Int64) -> String;
    extern fn http3RequestWasEarlyData(requestId: Int64) -> Bool;
    extern fn http3SubmitResponse(requestId: Int64, statusCode: Int64, headers: Map<String, String>, body: String) -> Nothing;
    extern fn http3ReleaseRequest(requestId: Int64) -> Nothing;
    extern fn http3ServerClose(serverHandle: Int64) -> Nothing;

    class Http3Server
    {
        var port: Int64;
        var certPath: String;
        var keyPath: String;
        var routes: List<Route>;
        var middleware: List<fnc(HttpContext) -> Bool>;
        var serverHandle: Int64;
        var running: Bool;
        // Address-validation (Retry mechanism, RFC 9000 §8.1). Default true
        // (secure default); opt-out is mainly useful for local dev loops,
        // since it costs curl (or any correct client) one extra round trip.
        var requireRetry: Bool;
        // 0-RTT early data (RFC 9001 §4.6.1 / RFC 8470). Default false --
        // replayable-request risk means this must be an explicit opt-in,
        // not a default-on convenience.
        var earlyDataEnabled: Bool;
        var maxEarlyDataSize: Int64;

        fn new(port: Int64, certPath: String, keyPath: String) -> Http3Server
        {
            return Http3Server {
                port: port,
                certPath: certPath,
                keyPath: keyPath,
                routes: [],
                middleware: [],
                serverHandle: -1,
                running: false,
                requireRetry: true,
                earlyDataEnabled: false,
                maxEarlyDataSize: 0
            };
        }

        fn get(path: String, handler: fnc(HttpContext) -> Nothing) -> Http3Server
        {
            this.routes.push(Route { method: "GET", path: path, handler: handler });
            return this;
        }

        fn post(path: String, handler: fnc(HttpContext) -> Nothing) -> Http3Server
        {
            this.routes.push(Route { method: "POST", path: path, handler: handler });
            return this;
        }

        fn put(path: String, handler: fnc(HttpContext) -> Nothing) -> Http3Server
        {
            this.routes.push(Route { method: "PUT", path: path, handler: handler });
            return this;
        }

        fn patch(path: String, handler: fnc(HttpContext) -> Nothing) -> Http3Server
        {
            this.routes.push(Route { method: "PATCH", path: path, handler: handler });
            return this;
        }

        fn delete(path: String, handler: fnc(HttpContext) -> Nothing) -> Http3Server
        {
            this.routes.push(Route { method: "DELETE", path: path, handler: handler });
            return this;
        }

        fn use(mware: fnc(HttpContext) -> Bool) -> Http3Server
        {
            this.middleware.push(mware);
            return this;
        }

        // RFC 9000 §8.1 address validation (Retry). Set false to skip the
        // extra round trip during local development; keep true (default)
        // whenever the server is reachable from untrusted networks.
        fn requireAddressValidation(v: Bool) -> Http3Server
        {
            this.requireRetry = v;
            return this;
        }

        // Opts into accepting TLS 1.3 0-RTT early data (RFC 9001 §4.6.1).
        // Early-data requests are replayable by a network attacker, so by
        // default (see runtime.c's http3_apply_early_data_policy) only
        // GET/HEAD requests arriving as early data are actually processed;
        // anything else gets a 425 Too Early (RFC 8470) forcing a 1-RTT
        // retry, unless allowNonIdempotentEarlyData() is also called.
        fn enableEarlyData(maxSize: Int64) -> Http3Server
        {
            this.earlyDataEnabled = true;
            this.maxEarlyDataSize = maxSize;
            return this;
        }

        fn stop() -> Nothing
        {
            this.running = false;
        }

        /**
         * Binds the UDP socket, completes TLS/QUIC setup, and enters the
         * pump loop. Each http3ServerPumpOnce() call performs one unit of
         * native work (drain ready datagrams, service ngtcp2 timer
         * expiries, drive the nghttp3<->ngtcp2 write pump) and returns a
         * requestId once some stream's HTTP/3 request has fully arrived,
         * -1 if there was nothing to dispatch this tick, or -2 on a fatal
         * socket error.
         */
        fn listen() -> Nothing
        {
            this.serverHandle = http3ServerCreate(this.port, this.certPath, this.keyPath, this.requireRetry, this.earlyDataEnabled, this.maxEarlyDataSize);
            if this.serverHandle < 0
            {
                throw "Failed to create HTTP/3 (QUIC) server on port " + this.port.toString() + " (runtime built without TINOX_HTTP3, or TLS cert/key invalid)";
            }
            this.running = true;
            while this.running
            {
                let requestId: Int64 = http3ServerPumpOnce(this.serverHandle);
                if requestId >= 0
                {
                    this.dispatchRequest(requestId);
                }
                else if requestId == -2
                {
                    this.running = false;
                }
            }
            http3ServerClose(this.serverHandle);
        }

        /**
         * Builds an HttpRequest/HttpContext from the C-side request slot,
         * runs middleware + route matching (identical to HttpServer/
         * Http2Server), calls the matched handler, then submits the
         * response back through http3SubmitResponse. Mirrors
         * Http2Server.dispatchStream's tail without any frame-parsing --
         * nghttp3 already did that part in C.
         */
        fn dispatchRequest(requestId: Int64) -> Nothing
        {
            let headers: Map<String, String> = http3RequestHeaders(requestId);
            let request: HttpRequest = HttpRequest::new(http3RequestMethod(requestId), http3RequestPath(requestId), "", headers, http3RequestBody(requestId));
            request.wasEarlyData = http3RequestWasEarlyData(requestId);

            let response: HttpResponse = HttpResponse::new();
            let ctx: HttpContext = HttpContext::new(request, response);

            let middlewareContinue: Bool = this.runMiddleware(ctx);
            if middlewareContinue == false
            {
                ctx.response.statusCode = 403;
                ctx.response.text("Forbidden");
            }
            else
            {
                let matched: Bool = this.matchRoute(ctx);
                if matched == false
                {
                    ctx.response.statusCode = 404;
                    ctx.response.text("Not Found");
                }
            }

            http3SubmitResponse(requestId, ctx.response.statusCode, ctx.response.headers, ctx.response.body);
            http3ReleaseRequest(requestId);
        }

        fn runMiddleware(ctx: HttpContext) -> Bool
        {
            var i: Int64 = 0;
            while i < this.middleware.len()
            {
                let result: Bool = this.middleware[i](ctx);
                if result == false
                {
                    return false;
                }
                i = i + 1;
            }
            return true;
        }

        fn matchRoute(ctx: HttpContext) -> Bool
        {
            var i: Int64 = 0;
            while i < this.routes.len()
            {
                let route: Route = this.routes[i];
                if route.method == ctx.request.method && RouteMatcher::matches(route.path, ctx.request.path)
                {
                    let params: Map<String, String> = RouteMatcher::extractParams(route.path, ctx.request.path);
                    ctx.request.setParams(params);
                    route.handler(ctx);
                    return true;
                }
                i = i + 1;
            }
            return false;
        }
    }
}

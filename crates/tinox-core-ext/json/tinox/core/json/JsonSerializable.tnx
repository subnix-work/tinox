module tinox.core.json;

namespace tinox.core.json
{
    // ========================================================================
    // Serialization Annotations
    // ========================================================================

    /**
     * Marks a class for automatic JSON serialization and deserialization.
     * The compiler generates toJson() and fromJson(JsonValue) methods.
     *
     * Usage:
     *   @JsonSerializable
     *   class User
     *   {
     *       var id: Int64;
     *       var name: String;
     *   }
     *
     *   const json: String = Json::serialize(user);
     *   const user: User = Json::deserialize<User>(json);
     */
    @annotation
    class JsonSerializable {}
}

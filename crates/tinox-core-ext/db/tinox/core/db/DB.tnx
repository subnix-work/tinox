module tinox.core.db

namespace tinox.core.db
{
    class DB
    {
        fnc of(cls: Any) -> Any
        {
            return EntityQuery {}
        }

        // Raw-SQL escape hatch (issue: ai-vault vector search prerequisite).
        // Intercepted at the call site by the codegen (gen_orm_raw), exactly
        // like `of(...)`'s chain is -- this body never actually runs. Kept
        // String-only (no Any/dynamic value) deliberately: Tinox has no real
        // runtime `Any`, so a genuinely heterogeneous row/param type can't be
        // marshaled safely. Postgres sends/receives everything as text
        // anyway (PQexecParams resultFormat=0), so String is a natural fit,
        // not a workaround -- a NULL column is simply absent from its row's
        // Map (check with .contains(col)) rather than a sentinel value.
        fnc raw(sql: String, params: List<String>) -> List<Map<String, String>>
        {
            return []
        }
    }
}

/**
 * Tinox Standard Library - MessagePack Module
 * Compact binary serialization (https://msgpack.org/), a binary
 * counterpart to tinox.core.json's text-based JsonValue tree -- useful
 * for AMQP message payloads, inter-service RPC, or just storing
 * structured data more compactly than JSON. No schema/codegen step,
 * same self-describing dynamic-value model as JSON (object/array/
 * string/int/float/bool/null).
 *
 *   let payload: MsgpackValue = MsgpackValue { kind: "object", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: fields };
 *   let bytes: List<Int64> = Msgpack::encode(payload);
 *   let decoded: MsgpackValue = Msgpack::decode(bytes);
 *
 * Encoding always picks the most compact representation that fits
 * (fixint/fixstr/fixarray/fixmap where possible, otherwise the smallest
 * width that holds the value; floats always encode as float64, Tinox
 * has no separate float32 type to justify the smaller width). Decoding
 * handles every core MessagePack type an external encoder could
 * legitimately produce (all int widths signed/unsigned, both float
 * widths, all string/array/map length-prefix widths).
 *
 * v1 scope, deliberately not covered (see issue #136):
 *   - bin8/16/32 (raw byte strings) and the ext family (application-
 *     specific extension types) -- decoding either fails the whole
 *     decode (MsgpackReader.failed), same as any other unrecognized
 *     byte would. Neither has a JsonValue-model equivalent to represent
 *     it as (JSON has no "bytes" or "ext" concept either).
 *   - A decoded map with a non-string key fails the decode -- this
 *     module's object model (Map<String, MsgpackValue>, matching
 *     JsonValue) has no way to represent one.
 *   - uint64 values >= 2^63 decode by reinterpreting the same 64 raw
 *     bits as a signed Int64 (i.e. they come out negative) -- an
 *     unavoidable consequence of Tinox's Int64 being signed with no
 *     wider/unsigned integer type to hold the full uint64 range, not a
 *     bug specific to this decoder.
 */
module tinox.core.msgpack;

namespace tinox.core.msgpack
{
    extern fn msgpackFloat64ToBits(f: Float64) -> Int64;
    extern fn msgpackBitsToFloat64(bits: Int64) -> Float64;
    extern fn msgpackBitsToFloat32(bits32: Int64) -> Float64;
    extern fn tinoxBytesToString(bytes: List<Int64>) -> String;

    class Msgpack
    {
        fn encode(value: MsgpackValue) -> List<Int64>
        {
            var out: List<Int64> = [];
            Msgpack::encodeInto(value, out);
            return out;
        }

        fn decode(bytes: List<Int64>) -> MsgpackValue
        {
            let reader: MsgpackReader = MsgpackReader::new(bytes);
            return Msgpack::decodeValue(reader);
        }

        // =====================================================================
        // Encoding
        // =====================================================================

        fn encodeInto(value: MsgpackValue, out: List<Int64>) -> Nothing
        {
            if value.isNull() { out.push(0xc0); return; }
            if value.isBool() { out.push(value.getBool() ? 0xc3 : 0xc2); return; }
            if value.isInt() { Msgpack::encodeInt(value.getInt(), out); return; }
            if value.isFloat() { Msgpack::encodeFloat(value.getFloat(), out); return; }
            if value.isString() { Msgpack::encodeString(value.getString(), out); return; }
            if value.isArray() { Msgpack::encodeArray(value.asArray(), out); return; }
            if value.isObject() { Msgpack::encodeMap(value.asMap(), out); return; }
        }

        fn encodeInt(n: Int64, out: List<Int64>) -> Nothing
        {
            if n >= 0 && n <= 127
            {
                out.push(n);
                return;
            }
            if n >= -32 && n < 0
            {
                out.push(n & 0xff);
                return;
            }
            if n >= -128 && n <= 127
            {
                out.push(0xd0);
                out.push(n & 0xff);
                return;
            }
            if n >= -32768 && n <= 32767
            {
                out.push(0xd1);
                Msgpack::pushBE(n, 2, out);
                return;
            }
            if n >= -2147483648 && n <= 2147483647
            {
                out.push(0xd2);
                Msgpack::pushBE(n, 4, out);
                return;
            }
            out.push(0xd3);
            Msgpack::pushBE(n, 8, out);
        }

        fn encodeFloat(f: Float64, out: List<Int64>) -> Nothing
        {
            out.push(0xcb);
            Msgpack::pushBE(msgpackFloat64ToBits(f), 8, out);
        }

        fn encodeString(s: String, out: List<Int64>) -> Nothing
        {
            let len: Int64 = s.len();
            if len < 32
            {
                out.push(0xa0 | len);
            }
            else if len <= 255
            {
                out.push(0xd9);
                out.push(len);
            }
            else if len <= 65535
            {
                out.push(0xda);
                Msgpack::pushBE(len, 2, out);
            }
            else
            {
                out.push(0xdb);
                Msgpack::pushBE(len, 4, out);
            }
            var i: Int64 = 0;
            while i < len
            {
                out.push(s.charCodeAt(i));
                i = i + 1;
            }
        }

        fn encodeArray(items: List<MsgpackValue>, out: List<Int64>) -> Nothing
        {
            let len: Int64 = items.len();
            if len < 16
            {
                out.push(0x90 | len);
            }
            else if len <= 65535
            {
                out.push(0xdc);
                Msgpack::pushBE(len, 2, out);
            }
            else
            {
                out.push(0xdd);
                Msgpack::pushBE(len, 4, out);
            }
            var i: Int64 = 0;
            while i < len
            {
                Msgpack::encodeInto(items[i], out);
                i = i + 1;
            }
        }

        fn encodeMap(m: Map<String, MsgpackValue>, out: List<Int64>) -> Nothing
        {
            let keys: List<String> = m.keys();
            let len: Int64 = keys.len();
            if len < 16
            {
                out.push(0x80 | len);
            }
            else if len <= 65535
            {
                out.push(0xde);
                Msgpack::pushBE(len, 2, out);
            }
            else
            {
                out.push(0xdf);
                Msgpack::pushBE(len, 4, out);
            }
            var i: Int64 = 0;
            while i < len
            {
                Msgpack::encodeString(keys[i], out);
                Msgpack::encodeInto(m[keys[i]], out);
                i = i + 1;
            }
        }

        // Big-endian byte push, n bytes (n <= 8) of `v`'s low-order bits.
        fn pushBE(v: Int64, n: Int64, out: List<Int64>) -> Nothing
        {
            var shift: Int64 = (n - 1) * 8;
            while shift >= 0
            {
                out.push((v >> shift) & 0xff);
                shift = shift - 8;
            }
        }

        // =====================================================================
        // Decoding
        // =====================================================================

        fn decodeValue(reader: MsgpackReader) -> MsgpackValue
        {
            let tag: Int64 = reader.readByte();
            if reader.failed
            {
                return MsgpackValue { kind: "null", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() };
            }

            if tag <= 0x7f
            {
                return MsgpackValue { kind: "int", stringValue: "", intValue: tag, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() };
            }
            if tag >= 0xe0
            {
                return MsgpackValue { kind: "int", stringValue: "", intValue: tag - 256, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() };
            }
            if tag >= 0x80 && tag <= 0x8f
            {
                return Msgpack::decodeMap(reader, tag & 0x0f);
            }
            if tag >= 0x90 && tag <= 0x9f
            {
                return Msgpack::decodeArray(reader, tag & 0x0f);
            }
            if tag >= 0xa0 && tag <= 0xbf
            {
                return Msgpack::decodeString(reader, tag & 0x1f);
            }
            if tag == 0xc0
            {
                return MsgpackValue { kind: "null", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() };
            }
            if tag == 0xc2
            {
                return MsgpackValue { kind: "bool", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() };
            }
            if tag == 0xc3
            {
                return MsgpackValue { kind: "bool", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: true, arrayValue: [], objectValue: Map::new() };
            }
            if tag == 0xca
            {
                let bits: Int64 = reader.readBE(4);
                if reader.failed { return MsgpackValue { kind: "null", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() }; }
                return MsgpackValue { kind: "float", stringValue: "", intValue: 0, floatValue: msgpackBitsToFloat32(bits), boolValue: false, arrayValue: [], objectValue: Map::new() };
            }
            if tag == 0xcb
            {
                let bits: Int64 = reader.readBE(8);
                if reader.failed { return MsgpackValue { kind: "null", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() }; }
                return MsgpackValue { kind: "float", stringValue: "", intValue: 0, floatValue: msgpackBitsToFloat64(bits), boolValue: false, arrayValue: [], objectValue: Map::new() };
            }
            if tag == 0xcc { return Msgpack::intResult(reader, reader.readBE(1)); }
            if tag == 0xcd { return Msgpack::intResult(reader, reader.readBE(2)); }
            if tag == 0xce { return Msgpack::intResult(reader, reader.readBE(4)); }
            if tag == 0xcf { return Msgpack::intResult(reader, reader.readBE(8)); }
            if tag == 0xd0 { return Msgpack::intResult(reader, Msgpack::signExtend(reader.readBE(1), 1)); }
            if tag == 0xd1 { return Msgpack::intResult(reader, Msgpack::signExtend(reader.readBE(2), 2)); }
            if tag == 0xd2 { return Msgpack::intResult(reader, Msgpack::signExtend(reader.readBE(4), 4)); }
            if tag == 0xd3 { return Msgpack::intResult(reader, reader.readBE(8)); }
            if tag == 0xd9 { return Msgpack::decodeString(reader, reader.readBE(1)); }
            if tag == 0xda { return Msgpack::decodeString(reader, reader.readBE(2)); }
            if tag == 0xdb { return Msgpack::decodeString(reader, reader.readBE(4)); }
            if tag == 0xdc { return Msgpack::decodeArray(reader, reader.readBE(2)); }
            if tag == 0xdd { return Msgpack::decodeArray(reader, reader.readBE(4)); }
            if tag == 0xde { return Msgpack::decodeMap(reader, reader.readBE(2)); }
            if tag == 0xdf { return Msgpack::decodeMap(reader, reader.readBE(4)); }

            // 0xc1 (never used), bin8/16/32 (0xc4-0xc6), ext8/16/32
            // (0xc7-0xc9), fixext1/2/4/8/16 (0xd4-0xd8): not supported in
            // v1 -- fail the decode rather than silently misreading the
            // following bytes as something else.
            reader.failed = true;
            return MsgpackValue { kind: "null", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() };
        }

        fn intResult(reader: MsgpackReader, v: Int64) -> MsgpackValue
        {
            if reader.failed
            {
                return MsgpackValue { kind: "null", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() };
            }
            return MsgpackValue { kind: "int", stringValue: "", intValue: v, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() };
        }

        fn signExtend(v: Int64, byteWidth: Int64) -> Int64
        {
            let bits: Int64 = byteWidth * 8;
            let signBit: Int64 = 1 << (bits - 1);
            if (v & signBit) != 0
            {
                return v - (signBit << 1);
            }
            return v;
        }

        fn decodeString(reader: MsgpackReader, len: Int64) -> MsgpackValue
        {
            if reader.failed || len < 0 || len > reader.remaining()
            {
                reader.failed = true;
                return MsgpackValue { kind: "null", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() };
            }
            // Collects bytes into a List<Int64> first, then converts in
            // one pass (tinoxBytesToString) -- NOT `s = s + fromCharCode(...)`
            // in the loop, which was the fuzzer-found O(n^2) bug here
            // (every `+` on a Tinox string mallocs+copies both operands,
            // so N chained appends over a string growing to length n cost
            // O(n^2) total; List::push is genuinely O(1) amortized).
            var bytes: List<Int64> = [];
            var i: Int64 = 0;
            while i < len
            {
                bytes.push(reader.readByte());
                i = i + 1;
            }
            return MsgpackValue { kind: "string", stringValue: tinoxBytesToString(bytes), intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() };
        }

        fn decodeArray(reader: MsgpackReader, len: Int64) -> MsgpackValue
        {
            if reader.failed || len < 0 || len > reader.remaining()
            {
                reader.failed = true;
                return MsgpackValue { kind: "null", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() };
            }
            var items: List<MsgpackValue> = [];
            var i: Int64 = 0;
            while i < len
            {
                if reader.failed
                {
                    return MsgpackValue { kind: "null", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() };
                }
                items.push(Msgpack::decodeValue(reader));
                i = i + 1;
            }
            return MsgpackValue { kind: "array", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: items, objectValue: Map::new() };
        }

        fn decodeMap(reader: MsgpackReader, len: Int64) -> MsgpackValue
        {
            if reader.failed || len < 0 || len > reader.remaining()
            {
                reader.failed = true;
                return MsgpackValue { kind: "null", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() };
            }
            var m: Map<String, MsgpackValue> = Map::new();
            var i: Int64 = 0;
            while i < len
            {
                if reader.failed
                {
                    return MsgpackValue { kind: "null", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() };
                }
                let keyValue: MsgpackValue = Msgpack::decodeValue(reader);
                let value: MsgpackValue = Msgpack::decodeValue(reader);
                if !keyValue.isString()
                {
                    reader.failed = true;
                    return MsgpackValue { kind: "null", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: Map::new() };
                }
                m[keyValue.getString()] = value;
                i = i + 1;
            }
            return MsgpackValue { kind: "object", stringValue: "", intValue: 0, floatValue: 0.0, boolValue: false, arrayValue: [], objectValue: m };
        }
    }
}

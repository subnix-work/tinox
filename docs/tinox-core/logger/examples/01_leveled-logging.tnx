import tinox.core.logger
class Main
{
    fnc main() -> Int32
    {
        const log: Logger = Logger::new("Main")
        log.setLevel(LogLevel::Warn)
        log.debug("this is filtered out")
        log.info("this is filtered out too")
        log.warn("disk usage above 80%")
        log.error("connection refused")
        return 0
    }
}

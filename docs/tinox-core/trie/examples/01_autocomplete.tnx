import tinox.core.trie
class Main
{
    fnc main() -> Int32
    {
        const dict: Trie = Trie::new()
        Trie::insert(dict, "cat")
        Trie::insert(dict, "car")
        Trie::insert(dict, "card")
        Trie::insert(dict, "dog")
        println(Trie::search(dict, "car").toString())       // true
        println(Trie::search(dict, "ca").toString())        // false (not a full word)
        println(Trie::startsWith(dict, "ca").toString())     // true

        const suggestions: List<String> = Trie::autocomplete(dict, "ca")
        var i: Int64 = 0
        while i < suggestions.len()
        {
            println(suggestions[i])
            i = i + 1
        }

        return 0
    }
}

import tinox.core.complex
class Main
{
    fnc main() -> Int32
    {
        const a: Complex = Complex::new(3.0, 4.0)
        const b: Complex = Complex::new(1.0, 2.0)
        const sum: Complex = Complex::add(a, b)
        println(Complex::toString(sum))
        const mag: Float64 = Complex::magnitude(a)
        println("magnitude of a: " + mag.toString())
        return 0
    }
}

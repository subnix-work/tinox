// Tinox Programming Language
// Example Programs

import Point;
import Direction;
import Drawable;
import Circle;
import Rectangle;

class Main
{
    // ============================================================
    // Example 1: Hello World
    // ============================================================
    fnc example_hello() -> Int32
    {
        print("Hello, World!");
        return 0;
    }

    // ============================================================
    // Example 2: Functions and Arithmetic
    // ============================================================
    fnc add(a: Int32, b: Int32) -> Int32
    {
        return a + b;
    }

    fnc multiply(x: Int32, y: Int32) -> Int32
    {
        return x * y;
    }

    fnc factorial(n: Int32) -> Int32
    {
        if (n <= 1)
        {
            return 1;
        }
        return n * factorial(n - 1);
    }

    fnc example_arithmetic() -> Int32
    {
        let a: Int32 = 10;
        let b: Int32 = 20;

        let sum: Int32 = add(a, b);
        let product: Int32 = multiply(a, b);
        let fact: Int32 = factorial(5);

        print("Sum: ");
        print(sum);
        print("\n");

        print("Product: ");
        print(product);
        print("\n");

        print("Factorial(5): ");
        print(fact);
        print("\n");

        return 0;
    }

    // ============================================================
    // Example 3: Control Flow
    // ============================================================
    fnc example_control_flow(x: Int32) -> Int32
    {
        // If-else
        if (x > 0)
        {
            print("positive\n");
        }
        else if (x < 0)
        {
            print("negative\n");
        }
        else
        {
            print("zero\n");
        }

        // While loop
        var counter: Int32 = 0;
        while counter < 5
        {
            print(counter);
            print(" ");
            counter = counter + 1;
        }
        print("\n");

        // For loop (sum 1 to 10)
        var sum: Int32 = 0;
        for i in 1..11
        {
            sum = sum + i;
        }
        print("Sum 1-10: ");
        print(sum);
        print("\n");

        // Match expression
        let message: String = match x
        {
            1 => "one";
            2 => "two";
            3 => "three";
            _ => "other";
        };
        print(message);
        print("\n");

        return 0;
    }

    // ============================================================
    // Example 4: Classes and Objects
    // ============================================================
    fnc example_classes() -> Int32
    {
        let p1: Point = Point.new(0.0, 0.0);
        let p2: Point = Point.new(3.0, 4.0);

        p1.describe();
        p2.describe();

        let dist: Float64 = p1.distanceTo(p2);
        print("Distance: ");
        print(dist);
        print("\n");

        return 0;
    }

    // ============================================================
    // Example 5: Enums and Pattern Matching
    // ============================================================
    fnc move(d: Direction, steps: Int32) -> Point
    {
        match d
        {
            North    => return Point.new(0.0, steps as Float64);
            South    => return Point.new(0.0, -(steps as Float64));
            East     => return Point.new(steps as Float64, 0.0);
            West     => return Point.new(-(steps as Float64), 0.0);
            Diagonal(dx, dy) => return Point.new((dx * steps) as Float64, (dy * steps) as Float64);
        }
    }

    fnc example_enums() -> Int32
    {
        let dirs: List<Direction> = [
            Direction.North,
            Direction.South,
            Direction.East,
            Direction.West,
            Direction.Diagonal(dx: 1, dy: 1)
        ];

        for dir in dirs
        {
            match dir
            {
                North => print("Going North\n");
                South => print("Going South\n");
                East  => print("Going East\n");
                West  => print("Going West\n");
                Diagonal(dx, dy) =>
                {
                    print("Diagonal: ");
                    print(dx);
                    print(", ");
                    print(dy);
                    print("\n");
                }
            }
        }

        return 0;
    }

    // ============================================================
    // Example 6: Interfaces
    // ============================================================
    fnc example_interfaces() -> Int32
    {
        let shapes: List<Drawable> = [
            Circle.new(5.0),
            Rectangle.new(4.0, 3.0)
        ];

        for shape in shapes
        {
            shape.draw();
            print("Area: ");
            print(shape.getArea());
            print("\n");
        }

        return 0;
    }

    // ============================================================
    // Example 7: Error Handling
    // ============================================================
    fnc divide(a: Int32, b: Int32) -> Int32
    {
        if (b == 0)
        {
            throw "Division by zero";
        }
        return a / b;
    }

    fnc example_error_handling() -> Int32
    {
        try
        {
            let result: Int32 = divide(10, 0);
            print("Result: ");
            print(result);
            print("\n");
        }
        catch e: String
        {
            print("Error caught: ");
            print(e);
            print("\n");
        }
        finally
        {
            print("Cleanup done\n");
        }

        return 0;
    }

    // ============================================================
    // Example 8: Recursion
    // ============================================================
    fnc fibonacci(n: Int32) -> Int32
    {
        if (n <= 1)
        {
            return n;
        }
        return fibonacci(n - 1) + fibonacci(n - 2);
    }

    fnc example_recursion() -> Int32
    {
        for i in 0..10
        {
            let fib: Int32 = fibonacci(i);
            print(fib);
            print(" ");
        }
        print("\n");
        return 0;
    }

    // ============================================================
    // Main entry point
    // ============================================================
    fnc main() -> Int32
    {
        print("=== Tinox Examples ===\n\n");

        print("--- Hello World ---\n");
        example_hello();

        print("\n--- Arithmetic ---\n");
        example_arithmetic();

        print("\n--- Control Flow ---\n");
        example_control_flow(5);

        print("\n--- Classes ---\n");
        example_classes();

        print("\n--- Enums ---\n");
        example_enums();

        print("\n--- Error Handling ---\n");
        example_error_handling();

        print("\n--- Recursion ---\n");
        example_recursion();

        print("\n=== Done ===\n");
        return 0;
    }
}

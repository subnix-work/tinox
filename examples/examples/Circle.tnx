import Drawable

class Circle implements Drawable
{
    radius: Float64

    fn new(radius: Float64) -> Circle
    {
        return Circle { radius: radius }
    }

    fn draw() -> Nothing
    {
        print("Drawing circle with radius ")
        print(this.radius)
        print("\n")
    }

    fn getArea() -> Float64
    {
        return 3.14159 * this.radius * this.radius
    }
}

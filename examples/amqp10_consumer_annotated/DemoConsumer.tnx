// Annotation-driven AMQP-1.0 consumer, analogous to the
// @WebsocketEndpoint/@OnOpen/@OnMessage/@OnClose annotations
// (examples/ws_echo_annotated/EchoEndpoint.tnx). The compiler generates a
// complete connect/begin/attach/grantCredit/nextMessage/ack loop, spawned
// alongside Main::main() (see sibling Main.tnx) instead of providing its own
// implicit main -- exactly one @Amqp10Consumer class per program.
//
// The handler receives the whole Amqp10Message (body/contentType/
// deliveryId/ok/errorMessage), not a decoded String — body decoding stays
// on the user, same as the existing manual receiver loop in
// examples/amqp10_publish_consume.tnx.

import tinox.core.amqp10;

@Amqp10Consumer("localhost", 5873, "guest", "guest", "/queues/tinox-demo-queue")
class DemoConsumer {
    @OnMessage
    fn onMessage(msg: Amqp10Message) -> Nothing {
        var text: String = "";
        for i in 0..msg.body.len() {
            text = text + fromCharCode(msg.body[i]);
        }
        println("received (" + msg.contentType + "): " + text);
    }
}

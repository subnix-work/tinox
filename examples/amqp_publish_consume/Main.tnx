// AMQP-0-9-1 publish/consume example.
// Needs a running broker, e.g.:
//   docker run -d --name rabbitmq -p 5672:5672 rabbitmq:3-management
// Start:  tinox run examples/amqp_publish_consume/Main.tnx
//
// Connects, declares a durable queue, publishes 3 messages via the default
// exchange (routing key = queue name -- queues are implicitly bound there
// under their own name; an explicit queue.bind would even be a protocol
// error on the default exchange), consumes them back, and acks each one
// individually.

import tinox.core.amqp091;

class Main
{
    fnc main() -> Int32 {
        let conn = AmqpConnection091::connect("127.0.0.1", 5672, "/", "guest", "guest");
        if (conn.conn <= 0) {
            println("connect failed: " + conn.errorMessage);
            return 1;
        }

        let ch = AmqpChannel091::open(conn);
        if (ch.chanId <= 0) {
            println("channel failed: " + ch.errorMessage);
            return 1;
        }

        let queueName = ch.declareQueue("tinox-demo-queue", true, false, false);
        if (queueName.len() == 0) {
            println("queue.declare failed: " + ch.errorMessage);
            return 1;
        }
        println("queue: " + queueName);

        ch.qos(10);

        var i: Int64 = 0;
        while i < 3 {
            var body: List<Int64> = [];
            let text = "message #" + i.toString();
            for j in 0..text.len() {
                body.push(text.charCodeAt(j) & 0xFF);
            }
            ch.publish("", queueName, body, "text/plain");
            println("sent: " + text);
            i = i + 1;
        }

        let consumerTag = ch.consume(queueName);
        if (consumerTag.len() == 0) {
            println("basic.consume failed: " + ch.errorMessage);
            return 1;
        }

        var received: Int64 = 0;
        while received < 3 {
            let m = ch.nextMessage();
            if (!m.ok) {
                println("receive failed: " + m.errorMessage);
                return 1;
            }
            var text: String = "";
            for j in 0..m.body.len() {
                text = text + fromCharCode(m.body[j]);
            }
            println("received: " + text + " (tag " + m.deliveryTag.toString() + ")");
            ch.ack(m.deliveryTag);
            received = received + 1;
        }

        conn.close();
        println("done");
        return 0;
    }
}

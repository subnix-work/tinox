// Declarative counterpart to examples/http3_rest_api/src/Main.tnx's
// hand-written Http3Server::new()/.get()/.post()/... version -- same Task
// CRUD surface, but every route is just a @GET/@POST/@PUT/@PATCH/@DELETE +
// @Path method, exactly like the plain (TCP) REST annotations in
// examples/rest_minimal. The single @Http3RestController(port, cert, key)
// annotation is what routes these through tinox.core.http3_server.Http3Server
// (QUIC) instead of the TCP auto-server -- the compiler generates the
// Http3Server::new/.get/.post/.../listen() wiring, spawned alongside
// Main.main() (see sibling Main.tnx) instead of providing its own implicit
// main.
//
// @ApplicationComponent makes the compiler reuse ONE TaskController
// instance across every request (via a generated _di_get() singleton
// getter) instead of allocating a fresh, zeroed instance per call --
// required here since `tasks` needs to persist between requests. That
// getter zero-allocates the instance (it does not call any constructor),
// so `tasks`/`initialized` start out as null/false; ensureInit() lazily
// seeds `tasks` on first use rather than relying on a constructor that
// never runs.
import tinox.core.http3_server;
import tinox.core.json;
import Task;

@ApplicationComponent
@Http3RestController(8843, "cert.pem", "key.pem")
class TaskController
{
    var tasks: List<Task>;
    var initialized: Bool;

    // Issue #149 stage 2: these three were free top-level functions;
    // now static `fnc` siblings, called bare from the instance methods
    // below exactly as before (resolved via check_call's same-class
    // fallback, not `this.` -- they don't need a TaskController receiver).
    fnc findTaskIndex(tasks: List<Task>, id: Int64) -> Int64
    {
        var i: Int64 = 0;
        while i < tasks.len()
        {
            if (tasks[i].id == id)
            {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    fnc nextTaskId(tasks: List<Task>) -> Int64
    {
        var maxId: Int64 = 0;
        var i: Int64 = 0;
        while i < tasks.len()
        {
            if (tasks[i].id > maxId)
            {
                maxId = tasks[i].id;
            }
            i = i + 1;
        }
        return maxId + 1;
    }

    fnc removeTaskAt(tasks: List<Task>, index: Int64) -> Nothing
    {
        var i: Int64 = index;
        while i < tasks.len() - 1
        {
            tasks[i] = tasks[i + 1];
            i = i + 1;
        }
        tasks.pop();
    }

    fn ensureInit() -> Nothing
    {
        if (!this.initialized)
        {
            this.tasks = [
                Task { id: 1, title: "Try tinox.core.http3_server", done: false },
                Task { id: 2, title: "curl --http3-only this API", done: false }
            ];
            this.initialized = true;
        }
    }

    @GET
    @Path("/tasks")
    fn listTasks() -> List<Task>
    {
        this.ensureInit();
        return this.tasks;
    }

    @GET
    @Path("/tasks/:id")
    fn getTask(@PathParam id: Int64, @HttpContext ctx: HttpContext) -> HttpContext
    {
        this.ensureInit();
        let idx: Int64 = findTaskIndex(this.tasks, id);
        if (idx < 0)
        {
            ctx.response.status(404).json("{\"error\":\"task not found\"}");
            return ctx;
        }
        ctx.response.json(Json::serialize(this.tasks[idx]));
        return ctx;
    }

    @POST
    @Path("/tasks")
    @StatusCode(201)
    fn createTask(@PostParam task: Task) -> Task
    {
        this.ensureInit();
        task.id = nextTaskId(this.tasks);
        this.tasks.push(task);
        return task;
    }

    @PUT
    @Path("/tasks/:id")
    fn updateTask(@PathParam id: Int64, @PostParam task: Task, @HttpContext ctx: HttpContext) -> HttpContext
    {
        this.ensureInit();
        let idx: Int64 = findTaskIndex(this.tasks, id);
        if (idx < 0)
        {
            ctx.response.status(404).json("{\"error\":\"task not found\"}");
            return ctx;
        }
        task.id = id;
        this.tasks[idx] = task;
        ctx.response.json(Json::serialize(task));
        return ctx;
    }

    @PATCH
    @Path("/tasks/:id/done")
    fn toggleDone(@PathParam id: Int64, @HttpContext ctx: HttpContext) -> HttpContext
    {
        this.ensureInit();
        let idx: Int64 = findTaskIndex(this.tasks, id);
        if (idx < 0)
        {
            ctx.response.status(404).json("{\"error\":\"task not found\"}");
            return ctx;
        }
        this.tasks[idx].done = !this.tasks[idx].done;
        ctx.response.json(Json::serialize(this.tasks[idx]));
        return ctx;
    }

    @DELETE
    @Path("/tasks/:id")
    @StatusCode(204)
    fn deleteTask(@PathParam id: Int64, @HttpContext ctx: HttpContext) -> HttpContext
    {
        this.ensureInit();
        let idx: Int64 = findTaskIndex(this.tasks, id);
        if (idx < 0)
        {
            ctx.response.status(404).json("{\"error\":\"task not found\"}");
            return ctx;
        }
        removeTaskAt(this.tasks, idx);
        ctx.response.text("");
        return ctx;
    }
}

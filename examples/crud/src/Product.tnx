import tinox.core.json;

@Entity
@Table("products")
@JsonSerializable
class Product
{
    @Id
    @GeneratedValue
    var id: Int64;

    @Column("name")
    @NotNull
    var name: String;

    @Column("price_cents")
    @NotNull
    var priceCents: Int64;

    @Column("stock")
    var stock: Int64;
}

import tinox.core.json;

@Entity
@Table("reviews")
@JsonSerializable
class Review
{
    @Id
    @GeneratedValue
    var id: Int64;

    @Column("product_id")
    @NotNull
    var productId: Int64;

    @Column("customer_id")
    @NotNull
    var customerId: Int64;

    @Column("rating")
    @NotNull
    var rating: Int64;

    @Column("comment")
    var comment: String;
}

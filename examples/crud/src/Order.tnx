import tinox.core.json;

@Entity
@Table("orders")
@JsonSerializable
class Order
{
    @Id
    @GeneratedValue
    var id: Int64;

    @Column("customer_id")
    @NotNull
    var customerId: Int64;

    @Column("status")
    var status: String;

    @Column("total_cents")
    var totalCents: Int64;
}

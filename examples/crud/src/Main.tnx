import tinox.core.http_server;
import tinox.core.json;
import tinox.core.db;
import Customer;
import Product;
import Order;
import OrderItem;
import Review;

class Main
{
    // ─────────────────────────────────────────────
    // Customer routes
    // ─────────────────────────────────────────────

    fnc registerCustomerRoutes(server: HttpServer) -> Nothing
    {
        server.get("/customers", ctx => {
            const customers: List<Customer> = DB::of(Customer).list();
            ctx.response.json(Json::serialize(customers));
        });

        server.get("/customers/:id", ctx => {
            const id: Int64 = ctx.request.getParam("id").toInt();
            const customer: Customer = DB::of(Customer).filter(c => c.id == id).first();
            ctx.response.json(Json::serialize(customer));
        });

        server.post("/customers", ctx => {
            const customer: Customer = Json::deserialize<Customer>(ctx.request.body);
            DB::of(Customer).save(customer);
            ctx.response.status(201).json(Json::serialize(customer));
        });

        server.put("/customers/:id", ctx => {
            const id: Int64 = ctx.request.getParam("id").toInt();
            const customer: Customer = Json::deserialize<Customer>(ctx.request.body);
            customer.id = id;
            DB::of(Customer).save(customer);
            ctx.response.json(Json::serialize(customer));
        });

        server.delete("/customers/:id", ctx => {
            const id: Int64 = ctx.request.getParam("id").toInt();
            const customer: Customer = DB::of(Customer).filter(c => c.id == id).first();
            DB::of(Customer).delete(customer);
            ctx.response.status(204).text("");
        });
    }

    // ─────────────────────────────────────────────
    // Product routes
    // ─────────────────────────────────────────────

    fnc registerProductRoutes(server: HttpServer) -> Nothing
    {
        server.get("/products", ctx => {
            const products: List<Product> = DB::of(Product).orderBy(p => p.name).list();
            ctx.response.json(Json::serialize(products));
        });

        server.get("/products/:id", ctx => {
            const id: Int64 = ctx.request.getParam("id").toInt();
            const product: Product = DB::of(Product).filter(p => p.id == id).first();
            ctx.response.json(Json::serialize(product));
        });

        server.post("/products", ctx => {
            const product: Product = Json::deserialize<Product>(ctx.request.body);
            DB::of(Product).save(product);
            ctx.response.status(201).json(Json::serialize(product));
        });

        server.put("/products/:id", ctx => {
            const id: Int64 = ctx.request.getParam("id").toInt();
            const product: Product = Json::deserialize<Product>(ctx.request.body);
            product.id = id;
            DB::of(Product).save(product);
            ctx.response.json(Json::serialize(product));
        });

        server.delete("/products/:id", ctx => {
            const id: Int64 = ctx.request.getParam("id").toInt();
            const product: Product = DB::of(Product).filter(p => p.id == id).first();
            DB::of(Product).delete(product);
            ctx.response.status(204).text("");
        });
    }

    // ─────────────────────────────────────────────
    // Order routes
    // ─────────────────────────────────────────────

    fnc registerOrderRoutes(server: HttpServer) -> Nothing
    {
        server.get("/orders", ctx => {
            const orders: List<Order> = DB::of(Order).orderByDesc(o => o.id).list();
            ctx.response.json(Json::serialize(orders));
        });

        server.get("/orders/:id", ctx => {
            const id: Int64 = ctx.request.getParam("id").toInt();
            const order: Order = DB::of(Order).filter(o => o.id == id).first();
            ctx.response.json(Json::serialize(order));
        });

        server.get("/customers/:id/orders", ctx => {
            const customerId: Int64 = ctx.request.getParam("id").toInt();
            const orders: List<Order> = DB::of(Order).filter(o => o.customerId == customerId).list();
            ctx.response.json(Json::serialize(orders));
        });

        server.post("/orders", ctx => {
            const order: Order = Json::deserialize<Order>(ctx.request.body);
            order.status = "pending";
            DB::of(Order).save(order);
            ctx.response.status(201).json(Json::serialize(order));
        });

        server.put("/orders/:id", ctx => {
            const id: Int64 = ctx.request.getParam("id").toInt();
            const order: Order = Json::deserialize<Order>(ctx.request.body);
            order.id = id;
            DB::of(Order).save(order);
            ctx.response.json(Json::serialize(order));
        });

        server.delete("/orders/:id", ctx => {
            const id: Int64 = ctx.request.getParam("id").toInt();
            const order: Order = DB::of(Order).filter(o => o.id == id).first();
            DB::of(Order).delete(order);
            ctx.response.status(204).text("");
        });
    }

    // ─────────────────────────────────────────────
    // OrderItem routes
    // ─────────────────────────────────────────────

    fnc registerOrderItemRoutes(server: HttpServer) -> Nothing
    {
        server.get("/orders/:id/items", ctx => {
            const orderId: Int64 = ctx.request.getParam("id").toInt();
            const items: List<OrderItem> = DB::of(OrderItem).filter(i => i.orderId == orderId).list();
            ctx.response.json(Json::serialize(items));
        });

        server.post("/orders/:id/items", ctx => {
            const orderId: Int64 = ctx.request.getParam("id").toInt();
            const item: OrderItem = Json::deserialize<OrderItem>(ctx.request.body);
            item.orderId = orderId;
            DB::of(OrderItem).save(item);
            ctx.response.status(201).json(Json::serialize(item));
        });

        server.put("/orders/:orderId/items/:itemId", ctx => {
            const itemId: Int64 = ctx.request.getParam("itemId").toInt();
            const item: OrderItem = Json::deserialize<OrderItem>(ctx.request.body);
            item.id = itemId;
            DB::of(OrderItem).save(item);
            ctx.response.json(Json::serialize(item));
        });

        server.delete("/orders/:orderId/items/:itemId", ctx => {
            const itemId: Int64 = ctx.request.getParam("itemId").toInt();
            const item: OrderItem = DB::of(OrderItem).filter(i => i.id == itemId).first();
            DB::of(OrderItem).delete(item);
            ctx.response.status(204).text("");
        });
    }

    // ─────────────────────────────────────────────
    // Review routes
    // ─────────────────────────────────────────────

    fnc registerReviewRoutes(server: HttpServer) -> Nothing
    {
        server.get("/products/:id/reviews", ctx => {
            const productId: Int64 = ctx.request.getParam("id").toInt();
            const reviews: List<Review> = DB::of(Review)
                .filter(r => r.productId == productId)
                .orderByDesc(r => r.id)
                .list();
            ctx.response.json(Json::serialize(reviews));
        });

        server.post("/products/:id/reviews", ctx => {
            const productId: Int64 = ctx.request.getParam("id").toInt();
            const review: Review = Json::deserialize<Review>(ctx.request.body);
            review.productId = productId;
            DB::of(Review).save(review);
            ctx.response.status(201).json(Json::serialize(review));
        });

        server.put("/reviews/:id", ctx => {
            const id: Int64 = ctx.request.getParam("id").toInt();
            const review: Review = Json::deserialize<Review>(ctx.request.body);
            review.id = id;
            DB::of(Review).save(review);
            ctx.response.json(Json::serialize(review));
        });

        server.delete("/reviews/:id", ctx => {
            const id: Int64 = ctx.request.getParam("id").toInt();
            const review: Review = DB::of(Review).filter(r => r.id == id).first();
            DB::of(Review).delete(review);
            ctx.response.status(204).text("");
        });
    }

    // ─────────────────────────────────────────────
    // Entry point
    // ─────────────────────────────────────────────

    fnc main() -> Int32
    {
        const server: HttpServer = HttpServer::new(8080);

        registerCustomerRoutes(server);
        registerProductRoutes(server);
        registerOrderRoutes(server);
        registerOrderItemRoutes(server);
        registerReviewRoutes(server);

        print("CRUD API listening on http://localhost:8080");
        server.listen();

        return 0;
    }
}

// AMQP-1.0 publish/consume example.
// Needs a running broker with native AMQP-1.0 support, e.g.:
//   docker run -d --name rabbitmq -p 5672:5672 rabbitmq:4-management
// (RabbitMQ 4.x speaks AMQP 1.0 directly in the core broker, no plugin
// needed. For queues, "AMQP Address v2" applies: /queues/<name>.)
// Start:  tinox run examples/amqp10_publish_consume/Main.tnx
//
// Connects via SASL PLAIN, opens a session + sender link, publishes 3
// credit-based messages, then attaches a receiver link to the same queue,
// consumes them back, and acks each one individually.

import tinox.core.amqp10;

class Main
{
    fnc main() -> Int32 {
        let conn = Amqp10Connection::connect("127.0.0.1", 5672, "guest", "guest");
        if (conn.conn <= 0) {
            println("connect failed: " + conn.errorMessage);
            return 1;
        }

        let session = Amqp10Session::begin(conn);
        if (session.errorMessage.len() > 0) {
            println("begin failed: " + session.errorMessage);
            return 1;
        }

        var sender = Amqp10Link::attach(session, "tinox-demo-sender", false, "/queues/tinox-demo-queue");
        if (sender.errorMessage.len() > 0) {
            println("attach (sender) failed: " + sender.errorMessage);
            return 1;
        }

        var i: Int64 = 0;
        while i < 3 {
            var body: List<Int64> = [];
            let text = "message #" + i.toString();
            for j in 0..text.len() {
                body.push(text.charCodeAt(j) & 0xFF);
            }
            sender.publish(body, "text/plain");
            if (sender.errorMessage.len() > 0) {
                println("publish failed: " + sender.errorMessage);
                return 1;
            }
            println("sent: " + text);
            i = i + 1;
        }
        sender.detach();

        var receiver = Amqp10Link::attach(session, "tinox-demo-receiver", true, "/queues/tinox-demo-queue");
        if (receiver.errorMessage.len() > 0) {
            println("attach (receiver) failed: " + receiver.errorMessage);
            return 1;
        }
        receiver.grantCredit(10);

        var received: Int64 = 0;
        while received < 3 {
            let m = receiver.nextMessage();
            if (!m.ok) {
                println("receive failed: " + m.errorMessage);
                return 1;
            }
            var text: String = "";
            for j in 0..m.body.len() {
                text = text + fromCharCode(m.body[j]);
            }
            println("received: " + text + " (delivery " + m.deliveryId.toString() + ")");
            receiver.ack(m.deliveryId);
            received = received + 1;
        }
        receiver.detach();

        session.end();
        conn.close();
        println("done");
        return 0;
    }
}

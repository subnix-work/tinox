// Start: tinox run examples/tinox_ui_diff_counter/Main.tnx
// Open:  http://localhost:8284/
import tinox.core.ui;
import tinox.core.http_server;
import DiffCounterApp;

class Main
{
    fnc main() -> Int32
    {
        let srv: HttpServer = HttpServer::new(8284);
        srv.get("/", ctx => {
            ctx.response.html(Assets::shellHtml("ws://localhost:8285/__tinoxui"));
        });
        srv.get("/ui.js", ctx => {
            ctx.response.content(Assets::clientJs(), "application/javascript");
        });
        srv.listen();
        return 0;
    }
}

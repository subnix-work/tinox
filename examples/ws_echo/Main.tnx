// WebSocket echo server.
// Start:  tinox run examples/ws_echo/Main.tnx
// Test:   browser console:  s = new WebSocket("ws://localhost:8790");
//         s.onmessage = e => console.log(e.data); s.onopen = () => s.send("hello");
// Serves one connection at a time (blocking, v1).

import tinox.core.websocket;

class Main
{
    fnc main() -> Int32 {
        let srv = WsServer::listen(8790);
        if (srv < 0) {
            println("port 8790 in use");
            return 1;
        }
        println("ws://localhost:8790 ready");
        while true {
            let conn = WsServer::accept(srv);
            if (conn <= 0) {
                continue;
            }
            println("client connected");
            while true {
                let f = Ws::readMessage(conn);
                if (f.opcode == 1) {
                    let msg = Ws::text(f);
                    println("received: " + msg);
                    Ws::sendText(conn, "echo: " + msg);
                    continue;
                }
                if (f.opcode == 2) {
                    Ws::sendBinary(conn, f.payload);
                    continue;
                }
                // Close (8), EOF (-1), or protocol error (-2): end the connection
                break;
            }
            Ws::close(conn);
            println("client disconnected");
        }
        return 0;
    }
}

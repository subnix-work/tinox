// Annotation-driven AMQP-0-9-1 consumer, analogous to the AMQP-1.0
// @Amqp10Consumer annotation (examples/amqp10_consumer_annotated/
// DemoConsumer.tnx). The compiler generates a complete connect/open/qos/
// consume/nextMessage/ack loop, spawned alongside Main::main() (see sibling
// Main.tnx) instead of providing its own implicit main -- exactly one
// @Amqp091Consumer class per program.
//
// The handler receives the whole AmqpMessage091 (deliveryTag/exchange/
// routingKey/contentType/body/ok/errorMessage), not a decoded String —
// body decoding stays on the user, same as the existing manual receiver
// loop in examples/amqp_publish_consume.tnx.

import tinox.core.amqp091;

@Amqp091Consumer("localhost", 5672, "/", "guest", "guest", "tinox-demo-queue")
class DemoConsumer091 {
    @OnMessage
    fn onMessage(msg: AmqpMessage091) -> Nothing {
        var text: String = "";
        for i in 0..msg.body.len() {
            text = text + fromCharCode(msg.body[i]);
        }
        println("received (" + msg.contentType + "): " + text);
    }
}

// WebSocket echo server over TLS (wss://).
// OpenSSL is linked by default, no extra flag needed:
//   tinox run examples/wss_echo/Main.tnx
// (Opt out via TINOX_TLS=0 if no OpenSSL is available to build with.)
// Generate a self-signed test certificate:
//   openssl req -x509 -newkey rsa:2048 -keyout key.pem -out cert.pem \
//     -days 1 -nodes -subj "/CN=localhost"
// Test: browser console (accept the certificate as trusted first)
//         s = new WebSocket("wss://localhost:8791");
//         s.onmessage = e => console.log(e.data); s.onopen = () => s.send("hello");
// Serves one connection at a time (blocking, v1 -- same as ws_echo).

import tinox.core.websocket;

class Main
{
    fnc main() -> Int32 {
        let srv = WsServer::listenTls(8791, "cert.pem", "key.pem");
        if (srv < 0) {
            println("listenTls failed (port in use, runtime built with TINOX_TLS=0, or cert.pem/key.pem missing/invalid)");
            return 1;
        }
        println("wss://localhost:8791 ready");
        while true {
            let conn = WsServer::acceptTls(srv);
            if (conn <= 0) {
                continue;
            }
            println("client connected");
            while true {
                let f = Ws::readMessage(conn);
                if (f.opcode == 1) {
                    let msg = Ws::text(f);
                    println("received: " + msg);
                    Ws::sendText(conn, "echo: " + msg);
                    continue;
                }
                if (f.opcode == 2) {
                    Ws::sendBinary(conn, f.payload);
                    continue;
                }
                // Close (8), EOF (-1), or protocol error (-2): end the connection
                break;
            }
            Ws::close(conn);
            println("client disconnected");
        }
        return 0;
    }
}
